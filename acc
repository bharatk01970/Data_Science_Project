    Dim btn As Button

    On Error Resume Next
    Set ws = ThisWorkbook.Sheets("Search")
    On Error GoTo 0

    If ws Is Nothing Then
        Set ws = ThisWorkbook.Sheets.Add
        ws.Name = "Search"
    End If

    Application.ScreenUpdating = False

