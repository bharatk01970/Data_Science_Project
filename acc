Option Explicit

Function SearchFilesForKeyword(folderPath As String, keyword As String) As Variant
    Dim fso As Object
    Dim folder As Object
    Dim file As Object
    Dim results As Collection
    Dim fileName As String
    Dim matchFound As Boolean
    
    ' Create FileSystemObject
    Set fso = CreateObject("Scripting.FileSystemObject")
    Set results = New Collection
    
    ' Check if folder exists
    If Not fso.FolderExists(folderPath) Then
        SearchFilesForKeyword = Array("Error: Folder not found")
        Exit Function
    End If
    
    Set folder = fso.GetFolder(folderPath)
    keyword = LCase(keyword) ' Case-insensitive search
    
    ' Loop through all files in the folder
    For Each file In folder.Files
        matchFound = False
        fileName = file.Name
        
        ' First, check if keyword is in file name
        If InStr(1, LCase(fileName), keyword, vbTextCompare) > 0 Then
            matchFound = True
        End If
        
        ' Then check file contents (for text-based files only and under 10MB)
        If file.Size < 10485760 Then ' Skip files larger than 10MB
            If SearchFileContent(file.Path, keyword) Then
                matchFound = True
            End If
        End If
        
        ' Add to results if match found
        If matchFound Then
            results.Add fileName
        End If
    Next file
    
    ' Return results
    If results.Count > 0 Then
        Dim arr() As Variant
        ReDim arr(0 To results.Count - 1)
        Dim i As Long
        For i = 1 To results.Count
            arr(i - 1) = results(i)
        Next i
        SearchFilesForKeyword = arr
    Else
        SearchFilesForKeyword = Array("No matches found")
    End If
    
    Set fso = Nothing
    Set folder = Nothing
    Set results = Nothing
End Function

Function SearchFileContent(filePath As String, keyword As String) As Boolean
    Dim fso As Object
    Dim textStream As Object
    Dim fileContent As String
    Dim chunkSize As Long
    Dim chunk As String
    
    On Error GoTo ErrorHandler
    
    SearchFileContent = False
    
    ' Only search text-based files
    If Not IsTextFile(filePath) Then
        Exit Function
    End If
    
    Set fso = CreateObject("Scripting.FileSystemObject")
    
    ' Try to open file
    Set textStream = fso.OpenTextFile(filePath, 1, False) ' 1 = ForReading
    
    ' Read in chunks to avoid memory issues
    Do While Not textStream.AtEndOfStream
        If textStream.AtEndOfStream Then Exit Do
        
        ' Read up to 50000 characters at a time
        chunk = textStream.Read(50000)
        
        If InStr(1, LCase(chunk), keyword, vbTextCompare) > 0 Then
            SearchFileContent = True
            Exit Do
        End If
    Loop
    
    textStream.Close
    Set textStream = Nothing
    Set fso = Nothing
    
    Exit Function
    
ErrorHandler:
    ' If any error occurs, just skip this file
    SearchFileContent = False
    If Not textStream Is Nothing Then
        On Error Resume Next
        textStream.Close
        On Error GoTo 0
    End If
    Set textStream = Nothing
    Set fso = Nothing
End Function

Function IsTextFile(filePath As String) As Boolean
    Dim ext As String
    Dim pos As Long
    
    IsTextFile = False
    
    pos = InStrRev(filePath, ".")
    If pos = 0 Then Exit Function
    
    ext = LCase(Mid(filePath, pos + 1))
    
    ' Add or remove extensions as needed
    Select Case ext
        Case "txt", "csv", "log", "xml", "json", "ini", "cfg", "md", "html", "htm", "sql", "vbs", "bat", "js", "py", "java", "c", "cpp", "h"
            IsTextFile = True
        Case Else
            IsTextFile = False
    End Select
End Function

Sub RunSearch()
    Dim folderPath As String
    Dim keyword As String
    Dim results As Variant
    Dim ws As Worksheet
    Dim i As Long
    Dim startTime As Double
    
    Set ws = ActiveSheet
    
    ' Get inputs from worksheet
    folderPath = ws.Range("B2").Value
    keyword = ws.Range("B3").Value
    
    If folderPath = "" Or keyword = "" Then
        MsgBox "Please enter both folder path and keyword", vbExclamation
        Exit Sub
    End If
    
    ' Clear previous results
    ws.Range("A6:A1000").ClearContents
    ws.Range("A6").Value = "Searching..."
    DoEvents
    
    ' Run search with timer
    startTime = Timer
    Application.ScreenUpdating = False
    results = SearchFilesForKeyword(folderPath, keyword)
    Application.ScreenUpdating = True
    
    ' Output results
    ws.Range("A6").Value = "Results:"
    For i = LBound(results) To UBound(results)
        ws.Range("A" & (7 + i)).Value = results(i)
    Next i
    
    MsgBox "Search complete in " & Round(Timer - startTime, 2) & " seconds. Found " & (UBound(results) - LBound(results) + 1) & " result(s)", vbInformation
End Sub