"""Main class for automated data extraction from Excel/CSV files."""
class DataExtractor:
    def __init__(self):
        """Initialize the DataExtractor with configured settings."""
        self._setup_logging()
        self.logger.info("="*80)
        self.logger.info("Data Extractor initialized successfully")
        self.logger.info("="*80)

    def _setup_logging(self):
        """Configure logging to file and console."""
        # Create log directory if it doesn't exist
        Path(LOG_DIRECTORY).mkdir(parents=True, exist_ok=True)
        
        # Generate log filename with timestamp
        log_filename = f"Rate_load_{datetime.now().strftime('%Y%m%d_%H%M%S')}.log"
        log_path = os.path.join(LOG_DIRECTORY, log_filename)
        
        # Configure logging format
        logging.basicConfig(
            level=getattr(logging, LOG_LEVEL.upper()),
            format='%(asctime)s - %(levelname)s - %(message)s',
            handlers=[
                logging.FileHandler(log_path),
                logging.StreamHandler(sys.stdout)
            ]
        )
        
        self.logger = logging.getLogger(__name__)

        
    def _validate_folders(self) -> bool:
        """
        Validate that input and output folders exist and are accessible.
        Returns:
            True if folders are valid, False otherwise
        """
        # Check input folder exists
        if not os.path.exists(INPUT_FOLDER):
            self.logger.error(f"Input folder does not exist: {INPUT_FOLDER}")
            return False
        
        # Check read permission on input folder
        if not os.access(INPUT_FOLDER, os.R_OK):
            self.logger.error(f"No read permission for input folder: {INPUT_FOLDER}")
            return False
        
        # Create output folder if it doesn't exist
        try:
            Path(OUTPUT_FOLDER).mkdir(parents=True, exist_ok=True)
            self.logger.info(f"Output folder ready: {OUTPUT_FOLDER}")
        except PermissionError:
            self.logger.error(f"No write permission for output folder: {OUTPUT_FOLDER}")
            return False
        except Exception as e:
            self.logger.error(f"Error creating output folder: {e}")
            return False
        
        self.logger.info(f"Input folder validated: {INPUT_FOLDER}")
        return True


    def _detect_new_file(self) -> Optional[str]:
        """
        Monitor input folder and detect new files matching configured patterns.
        Returns:
            Full path to detected file, or None if no file found
        """
        try:
            # List all files in input folder
            for file in os.listdir(INPUT_FOLDER):
                file_path = os.path.join(INPUT_FOLDER, file)
                
                # Skip directories
                if os.path.isdir(file_path):
                    continue
                
                # Check if file matches any configured pattern
                file_lower = file.lower()
                for pattern in FILE_PATTERNS:
                    if file_lower.endswith(pattern.lower()):
                        self.logger.info(f"New file detected: {file}")
                        return file_path
            
            return None
        
        except PermissionError:
            self.logger.error(f"Permission denied accessing input folder: {INPUT_FOLDER}")
            return None
        except Exception as e:
            self.logger.error(f"Error detecting files: {e}")
            return None

    def _read_file(self, file_path: str, has_header: bool) -> Optional[Dict[str, pd.DataFrame]]:
        """
        Read input file (Excel or CSV) in read-only mode.
        
        Args:
            file_path: Full path to input file
            has_header: Whether the file has a header row
            
        Returns:
            Dictionary mapping sheet names to DataFrames, or None on error
        """
        self.logger.info(f"Reading file: {file_path}")
        
        try:
            # Determine file type by extension
            file_ext = os.path.splitext(file_path)[1].lower()

            # Set header parameter based on configuration
            # If has_header=True, header=0 (use first row as header)
            # If has_header=False, header=None (no header, all rows are data)
            header_param = 0 if has_header else None
            
            if file_ext in ['.xlsx', '.xls', '.xlsm']:
                # Read Excel file - all sheets
                engine = 'openpyxl' if file_ext == '.xlsx' else None
                sheets_dict = pd.read_excel(
                    file_path, 
                    sheet_name=None, 
                    engine=engine,
                    header=header_param,  # Control header reading
                    dtype=str             # Preserve exact decimal/string format
                )
                self.logger.info(f"Excel file read successfully. Sheets: {list(sheets_dict.keys())}")
                return sheets_dict
            
            elif file_ext == '.csv':
                # Read CSV file - treat as single sheet
                df = pd.read_csv(
                    file_path,
                    header=header_param,  # Control header reading
                    dtype=str             # Preserve exact decimal/string format
                )
                sheets_dict = {'Sheet1': df}
                self.logger.info(f"CSV file read successfully. Rows: {len(df)}")
                return sheets_dict
            
            else:
                self.logger.error(f"Unsupported file format: {file_ext}")
                return None
        
        except FileNotFoundError:
            self.logger.error(f"File not found: {file_path}")
            return None
        except PermissionError:
            self.logger.error(f"Permission denied reading file: {file_path}")
            return None
        except Exception as e:
            self.logger.error(f"Error reading file: {e}")
            return None


    def _convert_column_letter_to_index(self, column_letter: str) -> int:
        """
        Convert Excel column letter (e.g., 'A', 'AB') to zero-based index.
        Args:
            column_letter: Column letter (e.g., 'A', 'B', 'AA') 
        Returns:
            Zero-based column index
        """
        column_letter = column_letter.upper()
        index = 0
        for i, char in enumerate(reversed(column_letter)):
            index += (ord(char) - ord('A') + 1) * (26 ** i)
        return index - 1

        """
        Example: "AB"
        Reversed: "BA"
        Iter 1 (char='B', i=0): (ord('B')-ord('A')+1) * (26**0) = 
         = 2
        Iter 2 (char='A', i=1): (ord('A')-ord('A')+1) * (26**1) = 
         = 26
        Total: 
        Return: 
         27 (0-based: A=0, Z=25, AA=26, AB=27) 
        """

    

    def _extract_data_from_sheet(self, df: pd.DataFrame, sheet_config: Dict) -> Optional[pd.DataFrame]:
        """
        Extract specific columns and rows from a DataFrame based on configuration.
        Args:
            df: Source DataFrame
            sheet_config: Configuration for this sheet (columns, rows)
            
        Returns:
            Extracted DataFrame, or None on error
        """
        try:
            # Get column configuration
            columns = sheet_config.get('columns', [])
            if not columns:
                self.logger.error("No columns specified in configuration")
                return None
            
            # Convert column letters to indices
            column_indices = []
            for col in columns:
                if isinstance(col, str):
                    # Column specified as letter (e.g., 'A', 'B')
                    col_index = self._convert_column_letter_to_index(col)
                else:
                    # Column specified as number (0-based)
                    col_index = col
                
                column_indices.append(col_index)
            
            # Validate column indices
            max_col = df.shape[1]
            for idx in column_indices:
                if idx >= max_col:
                    self.logger.error(f"Column index {idx} out of range (max: {max_col-1})")
                    return None
            
            # Extract columns by position
            extracted_df = df.iloc[:, column_indices].copy()
            
            # Get row range configuration
            row_start = sheet_config.get('row_start', 1)  # 1-based in config
            row_end = sheet_config.get('row_end', len(df))  # 1-based in config
            
            # Convert to 0-based indexing for pandas
            row_start_idx = row_start - 1
            row_end_idx = row_end
            
            # Validate row range
            if row_start_idx < 0:
                self.logger.warning(f"row_start < 1, using 1")
                row_start_idx = 0
            
            if row_end_idx > len(df):
                self.logger.warning(f"row_end exceeds data length, using {len(df)}")
                row_end_idx = len(df)
            
            # Extract rows
            extracted_df = extracted_df.iloc[row_start_idx:row_end_idx]
            
            self.logger.info(f"Extracted data: {extracted_df.shape[0]} rows, {extracted_df.shape[1]} columns")
            
            return extracted_df
        
        except Exception as e:
            self.logger.error(f"Error extracting data from sheet: {e}")
            return None

    # ── Enhancement 1 ──────────────────────────────────────────────────────
    def _parse_month_year_from_filename(self, filename: str) -> Tuple[Optional[str], Optional[str]]:
        """
        Extract the month abbreviation and 4-digit year from an input filename.

        The filename is expected to follow the pattern:
            <MonthAbbr><YY><Suffix>   e.g. "Jan26TOR"

        Where:
            <MonthAbbr> is a 3-letter month name  (Jan, Feb, … Dec)
            <YY>        is a 2-digit year          (26 → 2026)
            <Suffix>    is any trailing text        (TOR, etc.)

        Args:
            filename: Bare filename without directory path (extension stripped)

        Returns:
            Tuple (month_abbr, year_4digit) e.g. ("Jan", "2026"),
            or (None, None) if the pattern is not matched.
        """
        # Match 3-letter month + 2-digit year at the START of the filename
        # (case-insensitive for robustness, then title-cased for display)
        pattern = r'^([A-Za-z]{3})(\d{2})'
        match = re.match(pattern, filename)

        if not match:
            self.logger.warning(
                f"Could not parse month/year from filename '{filename}'. "
                f"Expected format like 'Jan26TOR'. "
                f"Output filenames will use system date as fallback."
            )
            return None, None

        month_raw = match.group(1).capitalize()   # e.g. "jan" → "Jan"
        year_2digit = match.group(2)               # e.g. "26"

        # Validate that the 3-letter token is actually a real month name
        valid_months = {
            'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun',
            'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'
        }
        if month_raw not in valid_months:
            self.logger.warning(
                f"Token '{month_raw}' in filename '{filename}' is not a valid month abbreviation. "
                f"Output filenames will use system date as fallback."
            )
            return None, None

        # Convert 2-digit year → 4-digit year
        # Assumes years 00-99 map to 2000-2099
        year_4digit = f"20{year_2digit}"

        self.logger.info(
            f"Parsed from input filename '{filename}': "
            f"month={month_raw}, year={year_4digit}"
        )
        return month_raw, year_4digit

    def _build_month_year_suffix(self, input_filename: str) -> str:
        """
        Build the MonMYYYY suffix (e.g. "Jan2026") used in output filenames.

        Tries to derive it from the input filename first.  Falls back to the
        previous calendar month (system date) if parsing fails — preserving
        the original behaviour.

        Args:
            input_filename: Bare input filename (no path, no extension)

        Returns:
            String like "Jan2026"
        """
        month_abbr, year_4digit = self._parse_month_year_from_filename(input_filename)

        if month_abbr and year_4digit:
            return f"{month_abbr}{year_4digit}"                    # e.g. "Jan2026"

        # Fallback: use previous calendar month derived from system clock
        fallback = (datetime.now() - relativedelta(months=1)).strftime('%b%Y')
        self.logger.warning(f"Using fallback month/year suffix: {fallback}")
        return fallback

    # ── Enhancement 2 ──────────────────────────────────────────────────────
    def _archive_existing_output_files(self):
        """
        Before writing new output files, move every existing file in OUTPUT_FOLDER
        into an 'Archive' sub-folder, appending a timestamp to each filename.

        Timestamp format:  YYYYMMDD_HHMMSS   (matches the input-file archive format)

        Sub-folders (including the Archive folder itself) are left in place.
        """
        archive_subdir = os.path.join(OUTPUT_FOLDER, "Archive")

        try:
            # Gather files that need to be archived (skip directories)
            existing_files = [
                f for f in os.listdir(OUTPUT_FOLDER)
                if os.path.isfile(os.path.join(OUTPUT_FOLDER, f))
            ]

            if not existing_files:
                self.logger.info("No existing output files to archive.")
                return

            # Create Archive sub-folder if it doesn't exist
            Path(archive_subdir).mkdir(parents=True, exist_ok=True)
            self.logger.info(f"Output Archive folder ready: {archive_subdir}")

            timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')
            archived_count = 0

            for filename in existing_files:
                src_path = os.path.join(OUTPUT_FOLDER, filename)
                name, ext = os.path.splitext(filename)
                archived_name = f"{name}_{timestamp}{ext}"
                dst_path = os.path.join(archive_subdir, archived_name)

                try:
                    os.rename(src_path, dst_path)
                    self.logger.info(f"Archived output file: {filename}  →  {archived_name}")
                    archived_count += 1
                except Exception as e:
                    self.logger.error(f"Failed to archive output file '{filename}': {e}")

            self.logger.info(
                f"Output file archiving complete: {archived_count}/{len(existing_files)} file(s) archived."
            )

        except PermissionError:
            self.logger.error(f"Permission denied accessing output folder for archiving: {OUTPUT_FOLDER}")
        except Exception as e:
            self.logger.error(f"Unexpected error during output file archiving: {e}")

