    ws.Range("B" & (folderSection + 1)).Value = "C:\Your\Folder\Path"
    With ws.Range("B" & (folderSection + 1))
        .Font.Italic = True: .Font.Color = RGB(128, 128, 128)
        .Interior.Color = RGB(255, 245, 245)
        .Borders.LineStyle = xlContinuous: .Borders.Color = RGB(192, 128, 128)
    End With
    ws.Range("A" & folderSection & ":B" & (folderSection + 1)).BorderAround _
        LineStyle:=xlContinuous, Weight:=xlMedium, Color:=RGB(139, 0, 0)

    ' ---- SECTION 3: Keywords ----
    Dim paramSection As Integer: paramSection = folderSection + 3
    ws.Range("A" & paramSection & ":C" & paramSection).Merge
    ws.Range("A" & paramSection).Value = "SEARCH PARAMETERS (Keywords)"
    With ws.Range("A" & paramSection)
        .Font.Bold = True: .Font.Size = 11
        .Font.Color = RGB(255, 255, 255)
        .Interior.Color = RGB(176, 0, 32)
        .HorizontalAlignment = xlLeft: .VerticalAlignment = xlCenter: .RowHeight = 25
    End With

    ws.Range("A" & (paramSection + 1)).Value = "Keyword"
    ws.Range("B" & (paramSection + 1)).Value = "Search Term"
    ws.Range("C" & (paramSection + 1)).Value = "Logic (AND/OR)"
    With ws.Range("A" & (paramSection + 1) & ":C" & (paramSection + 1))
        .Font.Bold = True
        .Interior.Color = RGB(255, 200, 200)
        .HorizontalAlignment = xlCenter
        .Borders.LineStyle = xlContinuous
    End With

    For i = 1 To MAX_KEYWORDS
        Dim currentRow As Integer: currentRow = paramSection + 1 + i
        ws.Range("A" & currentRow).Value = "Keyword " & i
        With ws.Range("A" & currentRow)
            .Font.Bold = True: .HorizontalAlignment = xlCenter
            .Interior.Color = RGB(255, 230, 230)
        End With
        With ws.Range("B" & currentRow)
            .Value = "": .Interior.Color = RGB(255, 255, 255)
            .Borders.LineStyle = xlContinuous: .Borders.Color = RGB(192, 128, 128)
        End With
        With ws.Range("C" & currentRow)
            .Value = "AND": .Font.Color = RGB(139, 0, 0): .Font.Bold = True
            .HorizontalAlignment = xlCenter
            .Interior.Color = RGB(255, 230, 230)
            .Borders.LineStyle = xlContinuous: .Borders.Color = RGB(192, 128, 128)
        End With
    Next i
    ws.Range("A" & paramSection & ":C" & (paramSection + 1 + MAX_KEYWORDS)).BorderAround _
        LineStyle:=xlContinuous, Weight:=xlMedium, Color:=RGB(176, 0, 32)

    ' ---- SECTION 4: Macro Controls ----
    Dim controlSection As Integer: controlSection = paramSection + MAX_KEYWORDS + 3
    ws.Range("A" & controlSection & ":D" & controlSection).Merge
    ws.Range("A" & controlSection).Value = "MACRO CONTROLS"
    With ws.Range("A" & controlSection)
        .Font.Bold = True: .Font.Size = 11
        .Font.Color = RGB(255, 255, 255)
        .Interior.Color = RGB(101, 0, 0)
        .HorizontalAlignment = xlLeft: .VerticalAlignment = xlCenter: .RowHeight = 25
    End With

    Dim btnTop As Long, btnLeft As Long, btnWidth As Long, btnHeight As Long, btnSpacing As Long
    btnTop = ws.Range("A" & (controlSection + 1)).Top
    btnLeft = ws.Range("A" & (controlSection + 1)).Left
    btnWidth = 140: btnHeight = 30: btnSpacing = 10

    Set btn = ws.Buttons.Add(btnLeft, btnTop, btnWidth, btnHeight)
    btn.OnAction = "RunSearchByNameOnly": btn.Caption = "Search: Name Only"
    btn.Font.Bold = True: btn.Font.Size = 9

    Set btn = ws.Buttons.Add(btnLeft + btnWidth + btnSpacing, btnTop, btnWidth, btnHeight)
    btn.OnAction = "RunSearch": btn.Caption = "Search: Name + Content"
    btn.Font.Bold = True: btn.Font.Size = 9

    btnTop = btnTop + btnHeight + btnSpacing
    Set btn = ws.Buttons.Add(btnLeft, btnTop, btnWidth, btnHeight)
    btn.OnAction = "RunSearchWithContentPreview": btn.Caption = "Search: With Preview"
    btn.Font.Bold = True: btn.Font.Size = 9

    Set btn = ws.Buttons.Add(btnLeft + btnWidth + btnSpacing, btnTop, btnWidth, btnHeight)
    btn.OnAction = "RunRefineSearch": btn.Caption = "Refine Results"
    btn.Font.Bold = True: btn.Font.Size = 9

    btnTop = btnTop + btnHeight + btnSpacing
    Set btn = ws.Buttons.Add(btnLeft, btnTop, btnWidth, btnHeight)
    btn.OnAction = "ClearFilteredContentSheets": btn.Caption = "Clear Preview Sheets"
    btn.Font.Bold = True: btn.Font.Size = 9

    Set btn = ws.Buttons.Add(btnLeft + btnWidth + btnSpacing, btnTop, btnWidth, btnHeight)
    btn.OnAction = "SetupSearchSheet": btn.Caption = "Reset Dashboard"
    btn.Font.Bold = True: btn.Font.Size = 9

    Dim btnEndRow As Integer: btnEndRow = controlSection + 8
    ws.Range("A" & (controlSection + 1) & ":D" & btnEndRow).Interior.Color = RGB(255, 235, 235)
    ws.Range("A" & controlSection & ":D" & btnEndRow).BorderAround _
        LineStyle:=xlContinuous, Weight:=xlMedium, Color:=RGB(101, 0, 0)

    ' ---- SECTION 5: Instructions ----
    Dim instructionSection As Integer: instructionSection = btnEndRow + 2
    ws.Range("A" & instructionSection & ":D" & instructionSection).Merge
    ws.Range("A" & instructionSection).Value = "HOW TO USE"
    With ws.Range("A" & instructionSection)
        .Font.Bold = True: .Font.Size = 11
        .Font.Color = RGB(255, 255, 255)
        .Interior.Color = RGB(160, 32, 32)
        .HorizontalAlignment = xlLeft: .VerticalAlignment = xlCenter: .RowHeight = 25
    End With

    Dim instrRow As Integer: instrRow = instructionSection + 1
    Dim instructions(5) As String
    instructions(0) = "1. Enter folder path in the Folder Location section"
    instructions(1) = "2. Enter 1-" & MAX_KEYWORDS & " keywords. Set AND/OR logic per keyword"
    instructions(2) = "3. Click a Macro Control button to run the search"
    instructions(3) = "4. Results appear to the right (column F) | AND = all keywords in same row | OR = any keyword in file"
    instructions(4) = "5. After 'Name Only' search, update keywords then click 'Refine Results' to narrow down"
    instructions(5) = "6. In 'With Preview' results, click '[ Click to Preview ]' to open a filtered row view"

    Dim k As Integer
    For k = 0 To 5
        ws.Range("A" & instrRow & ":D" & instrRow).Merge
        ws.Range("A" & instrRow).Value = instructions(k)
        ws.Range("A" & instrRow).WrapText = True
        If k = 3 Then
            ws.Range("A" & instrRow).Font.Italic = True
            ws.Range("A" & instrRow).Font.Color = RGB(139, 0, 0)
        End If
        instrRow = instrRow + 1
    Next k

    Dim instrEndRow As Integer: instrEndRow = instrRow - 1
    ws.Range("A" & (instructionSection + 1) & ":D" & instrEndRow).Interior.Color = RGB(255, 235, 235)
    ws.Range("A" & instructionSection & ":D" & instrEndRow).BorderAround _
        LineStyle:=xlContinuous, Weight:=xlMedium, Color:=RGB(160, 32, 32)

    ' ---- Column E: Gap / separator ----
    ws.Columns("E").ColumnWidth = 2
    ws.Range("E1:E" & instrEndRow).Interior.Color = RGB(200, 200, 200)
    ws.Range("E1:E" & instrEndRow).Borders.LineStyle = xlNone

    ' ---- Column widths (dashboard side) ----
    ws.Columns("A").ColumnWidth = 18
    ws.Columns("B").ColumnWidth = 32
    ws.Columns("C").ColumnWidth = 15
    ws.Columns("D").ColumnWidth = 5

    ' FIX: Draw the Results section header NOW so it is always visible
    ' even before any search has been run
    Call WriteResultsSectionHeader(ws, GetOutputStartColumn(), False)

    ws.Range("B" & (folderSection + 1)).Select
    Application.ScreenUpdating = True

    MsgBox "Dashboard Setup Complete!" & vbCrLf & vbCrLf & _
           "Maximum Keywords: " & MAX_KEYWORDS & vbCrLf & vbCrLf & _
           "No extra sheet module code required - preview links work automatically." & vbCrLf & vbCrLf & _
           "Click any search button to begin.", vbInformation, "Dashboard Ready"
End Sub