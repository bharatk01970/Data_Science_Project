    def _generate_output_filename(self, config_filename: str, original_filename: str) -> str:
        """
        Generate the output filename by appending the month/year suffix derived
        from the input filename to the base name defined in SHEETS_CONFIG.

        Args:
            config_filename:   Base name from SHEETS_CONFIG['output_file']
                               e.g. 'eom-spot_mena_mi'
            original_filename: The detected input filename (with extension)
                               e.g. 'Jan26TOR.xlsx'
        Returns:
            Final filename string (without extension), e.g. 'eom-spot_mena_mi_Jan2026'
        """
        # Strip extension from the input filename to get the bare name for parsing
        input_name_only = os.path.splitext(os.path.basename(original_filename))[0]

        # Build the MonYYYY suffix (Enhancement 1)
        month_year_suffix = self._build_month_year_suffix(input_name_only)

        # Append suffix to the config base name
        filename = f"{config_filename}_{month_year_suffix}"
        self.logger.info(f"Generated output filename: {filename}")
        return filename


    def _save_output_file(self, df: pd.DataFrame, output_path: str, file_format: str, include_header: bool):
        """
        Save extracted data to output file preserving exact decimal format.
        
        Args:
            df: DataFrame to save (all values are strings preserving exact format)
            output_path: Full path for output file
            file_format: Format to save ('csv', 'xlsx', etc.)
            include_header: Whether to include header row in output
        """
        try:
            if file_format.lower() == 'csv':
                # Save as CSV with exact string representation (no formatting)
                # Data is already in string format, so it will preserve exact decimals
                df.to_csv(
                    output_path, 
                    index=False, 
                    header=include_header,  # Control header output
                    quoting=1  # Quote non-numeric fields only
                )
                self.logger.info(f"CSV file saved: {output_path}")
            
            elif file_format.lower() in ['xlsx', 'excel']:
                # Save as Excel with full numeric precision
                with pd.ExcelWriter(output_path, engine='openpyxl') as writer:
                    df.to_excel(
                        writer, 
                        index=False, 
                        header=include_header,  # Control header output
                        sheet_name='Data'
                    )
                self.logger.info(f"Excel file saved: {output_path}")
            
            else:
                self.logger.error(f"Unsupported output format: {file_format}")
        
        except PermissionError:
            self.logger.error(f"Permission denied writing to: {output_path}")
        except Exception as e:
            self.logger.error(f"Error saving output file: {e}")

    def _process_file(self, file_path: str):
        """
        Main processing logic: read file, extract data, generate outputs.
        Args:
            file_path: Full path to input file
        """
        self.logger.info("="*80)
        self.logger.info(f"Starting file processing: {os.path.basename(file_path)}")
        self.logger.info("="*80)

        # ── Enhancement 2: Archive any existing output files first ──────────
        self._archive_existing_output_files()
        # ────────────────────────────────────────────────────────────────────

        # Process each configured sheet
        for sheet_config in SHEETS_CONFIG:
            sheet_name = sheet_config.get('sheet_name')
            input_has_header = sheet_config.get('input_has_header', False)
            output_has_header = sheet_config.get('output_has_header', False)
            
            self.logger.info(f"\nProcessing sheet: {sheet_name}")
            
            # Read input file
            sheets_dict = self._read_file(file_path, input_has_header)
            if sheets_dict is None:
                self.logger.error("Failed to read input file. Skipping this sheet.")
                continue
                   
            # Check if sheet exists in file
            if sheet_name not in sheets_dict:
                self.logger.error(f"Sheet '{sheet_name}' not found in file. Available sheets: {list(sheets_dict.keys())}")
                continue
            
            # Get DataFrame for this sheet
            df = sheets_dict[sheet_name]
            
            # Extract data based on configuration
            extracted_df = self._extract_data_from_sheet(df, sheet_config)
            if extracted_df is None or extracted_df.empty:
                self.logger.error(f"No data extracted from sheet '{sheet_name}'")
                continue
            
            # Generate output filename
            # Enhancement 1: filename derived from input file name, not system date
            output_filename = self._generate_output_filename(
                sheet_config.get('output_file', 'output'),
                os.path.basename(file_path)
            )
            
            # Get output format
            output_format = sheet_config.get('output_format', 'csv')
            
            # Ensure output filename has correct extension
            if not output_filename.endswith(f'.{output_format}'):
                output_filename = f"{os.path.splitext(output_filename)[0]}.{output_format}"
            
            # Create full output path
            output_path = os.path.join(OUTPUT_FOLDER, output_filename)
            
            # Save output file with header control
            self._save_output_file(extracted_df, output_path, output_format, output_has_header)
        
        self.logger.info("="*80)
        self.logger.info(f"File processing completed: {os.path.basename(file_path)}")
        self.logger.info("="*80)


    def _move_processed_file(self, file_path: str):
        """
        Move or delete processed file based on configuration.
        Args:
            file_path: Path to processed file
        """
        if POST_PROCESS_ACTION == 'delete':
            try:
                os.remove(file_path)
                self.logger.info(f"Deleted processed file: {file_path}")
            except Exception as e:
                self.logger.error(f"Error deleting file: {e}")
        
        elif POST_PROCESS_ACTION == 'move':
            try:
                # Create archive folder if it doesn't exist
                Path(ARCHIVE_FOLDER).mkdir(parents=True, exist_ok=True)
                
                # Generate archive filename with timestamp
                timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')
                filename = os.path.basename(file_path)
                name, ext = os.path.splitext(filename)
                archive_filename = f"{name}_{timestamp}{ext}"
                archive_path = os.path.join(ARCHIVE_FOLDER, archive_filename)
                
                # Move file
                os.rename(file_path, archive_path)
                self.logger.info(f"Moved processed file to: {archive_path}")
            except Exception as e:
                self.logger.error(f"Error moving file to archive: {e}")
        else:
            # 'none' - leave file in place
            self.logger.info(f"File left in place: {file_path}")


    def run(self):
        """
        Main execution loop: monitor input folder and process files as they arrive.
        """
        # Validate folders before starting
        if not self._validate_folders():
            self.logger.error("Folder validation failed. Exiting.")
            return
        
        self.logger.info(f"Starting monitoring loop (polling every {POLL_INTERVAL} seconds)")
        self.logger.info("Press Ctrl+C to stop")
        
        try:
            while True:
                # Check for new file
                file_path = self._detect_new_file()
                
                if file_path:
                    # Process the detected file
                    self._process_file(file_path)
                    # Handle processed file (move/delete/leave)
                    self._move_processed_file(file_path)
                
                # Wait before next check
                time.sleep(POLL_INTERVAL)
        
        except KeyboardInterrupt:
            self.logger.info("\nMonitoring stopped by user")
        except Exception as e:
            self.logger.error(f"Unexpected error in main loop: {e}")


