Sub RunPythonGUI()
    Dim shell As Object
    Dim command As String
    
    Set shell = CreateObject("WScript.Shell")
    
    ' Keep command window open with /k instead of /c
    command = "cmd /k python C:\path\to\your\script.py"
    
    ' Or run directly with full Python path
    ' command = "C:\Python311\pythonw.exe C:\path\to\your\script.py"
    
    shell.Run command, 1, False
    
    Set shell = Nothing
End Sub