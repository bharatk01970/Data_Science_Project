    Dim fso As Object
    Dim lastRow As Long
    Dim i As Long
    Dim sourcePath As String
    Dim fileName As String
    Dim copyCount As Long
    Dim errorCount As Long
    Dim errorMsg As String
    Dim resultRowStart As Integer
    
    Set ws = ThisWorkbook.Sheets("Search")
    Set fso = CreateObject("Scripting.FileSystemObject")
    
    ' Get dynamic result row start
    On Error Resume Next
    resultRowStart = ws.Range("Z1").Value
    On Error GoTo 0
    
    If resultRowStart = 0 Then resultRowStart = 6 + MAX_KEYWORDS ' Fallback
    
    ' Check if there are search results
    If ws.Range("A" & (resultRowStart + 1)).Value = "" Or ws.Range("A" & resultRowStart).Value <> "File Name" Then
        MsgBox "No search results found. Please run the search first.", vbExclamation
        Exit Sub
    End If
    
    ' Ask user for destination folder
    With Application.FileDialog(msoFileDialogFolderPicker)
        .Title = "Select Destination Folder to Copy Files"
        .AllowMultiSelect = False
        If .Show = -1 Then
            destFolder = .SelectedItems(1)
        Else
            Exit Sub ' User cancelled
        End If
    End With
    
    ' Ensure destination folder ends with backslash
    If Right(destFolder, 1) <> "\" Then destFolder = destFolder & "\"
    
    ' Find last row with data
    lastRow = ws.Cells(ws.Rows.Count, "B").End(xlUp).Row
    
    ' Copy files
    Application.ScreenUpdating = False
    copyCount = 0
    errorCount = 0
    errorMsg = ""
    
    For i = resultRowStart + 1 To lastRow
        sourcePath = ws.Range("B" & i).Value
        
        If sourcePath <> "" And fso.FileExists(sourcePath) Then
            On Error Resume Next
            fileName = fso.GetFileName(sourcePath)
            fso.CopyFile sourcePath, destFolder & fileName, True ' True = overwrite if exists
            
            If Err.Number = 0 Then
                copyCount = copyCount + 1
            Else
                errorCount = errorCount + 1
                errorMsg = errorMsg & vbCrLf & "- " & fileName & " (Error: " & Err.Description & ")"
                Err.Clear
            End If
            On Error GoTo 0
        End If
    Next i
    
    Application.ScreenUpdating = True
    
    ' Show summary
    Dim msg As String
    msg = "Copy operation complete!" & vbCrLf & vbCrLf & _
          "Successfully copied: " & copyCount & " file(s)" & vbCrLf & _
          "Destination: " & destFolder
    
    If errorCount > 0 Then
        msg = msg & vbCrLf & vbCrLf & "Failed to copy: " & errorCount & " file(s)" & errorMsg
        MsgBox msg, vbExclamation
    Else
        MsgBox msg, vbInformation
    End If
    
    Set fso = Nothing
End Sub

' ========== FILTERED CONTENT VIEW FUNCTIONALITY ==========
' This section provides functionality to view only matching rows from files

Sub RunSearchWithContentPreview()
    ' This macro performs the search AND generates filtered content views
    Dim folderPath As String
    Dim keywords(0 To MAX_KEYWORDS - 1) As String
    Dim keywordLogic(0 To MAX_KEYWORDS - 1) As String
    Dim keywordCount As Integer
    Dim results As Variant
    Dim ws As Worksheet
    Dim i As Long
    Dim j As Integer
    Dim resultParts() As String
    Dim fileName As String
    Dim filePath As String
    Dim keywordList As String
    
    Set ws = ThisWorkbook.Sheets("Search")
    
    ' Get folder path
    folderPath = ws.Range("B2").Value
    
    ' Get keywords and logic operators from worksheet
    keywordCount = 0
    keywordList = ""
    
    For i = 0 To MAX_KEYWORDS - 1
        keywords(i) = Trim(ws.Range("B" & (3 + i)).Value)
        keywordLogic(i) = UCase(Trim(ws.Range("C" & (3 + i)).Value))
        
        ' Default to AND if not specified
        If keywordLogic(i) = "" Then keywordLogic(i) = "AND"
        
        ' Validate logic operator
        If keywordLogic(i) <> "AND" And keywordLogic(i) <> "OR" Then
            MsgBox "Invalid logic operator in row " & (3 + i) & ". Use 'AND' or 'OR' only.", vbExclamation
            Exit Sub
        End If
        
        If keywords(i) <> "" Then
            keywordCount = keywordCount + 1
            If keywordList <> "" Then keywordList = keywordList & ", "
            keywordList = keywordList & """" & keywords(i) & """ (" & keywordLogic(i) & ")"
        End If
    Next i
    
    ' Validation
    If folderPath = "" Then
        MsgBox "Please enter folder path in cell B2", vbExclamation
        Exit Sub
    End If
    
    If keywordCount = 0 Then
        MsgBox "Please enter at least one keyword (cells B3 onwards)", vbExclamation
        Exit Sub
    End If
    
    ' Clear previous results
    Dim outputStartRow As Integer
    On Error Resume Next
    outputStartRow = ws.Range("Z1").Value
    On Error GoTo 0
    
    If outputStartRow = 0 Then outputStartRow = 5 + MAX_KEYWORDS ' Fallback
    
    ws.Range("A" & outputStartRow & ":D1000").ClearContents
    
    ' Run search (file filtering still uses ALL keywords with AND logic)
    Application.ScreenUpdating = False
    Application.StatusBar = "Searching for " & keywordCount & " keyword(s): " & keywordList & "..."
    
    results = SearchFilesForKeywords(folderPath, keywords, keywordCount)
    
    ' Calculate result row start
    Dim resultRowStart As Integer
    resultRowStart = outputStartRow
    
    ' Output results with headers
    ws.Range("A" & resultRowStart).Value = "File Name"
    ws.Range("B" & resultRowStart).Value = "File Path"
    ws.Range("C" & resultRowStart).Value = "Match Info"
    ws.Range("D" & resultRowStart).Value = "Filtered Content"
    
    ' Format headers with styling
    ws.Range("A" & resultRowStart & ":D" & resultRowStart).Font.Bold = True
    ws.Range("A" & resultRowStart & ":D" & resultRowStart).Font.Size = 10
    ws.Range("A" & resultRowStart & ":D" & resultRowStart).Interior.Color = RGB(217, 217, 217)
    ws.Range("A" & resultRowStart & ":D" & resultRowStart).Font.Color = RGB(0, 0, 0)
    ws.Range("A" & resultRowStart & ":D" & resultRowStart).Borders.LineStyle = xlContinuous
    ws.Range("A" & resultRowStart & ":D" & resultRowStart).HorizontalAlignment = xlCenter
    
    ' Check if results contain error or no matches
    If UBound(results) = 0 And InStr(1, results(0), "Error:") > 0 Then
        ws.Range("A" & (resultRowStart + 1)).Value = results(0)
        Application.ScreenUpdating = True
        Application.StatusBar = False
        MsgBox results(0), vbExclamation
        Exit Sub
    ElseIf UBound(results) = 0 And results(0) = "No matches found" Then
        ws.Range("A" & (resultRowStart + 1)).Value = results(0)
        Application.ScreenUpdating = True
        Application.StatusBar = False
        MsgBox "No matches found for all " & keywordCount & " keyword(s)", vbInformation
        Exit Sub
    End If
    
    ' Output results with hyperlinks and create filtered content sheets
    For i = LBound(results) To UBound(results)
        resultParts = Split(results(i), "|")
        fileName = resultParts(0)
        filePath = resultParts(1)
        
        ' Add file name as clickable hyperlink
        ws.Hyperlinks.Add Anchor:=ws.Range("A" & (resultRowStart + 1 + i)), _
                          Address:=filePath, _
                          TextToDisplay:=fileName
        ws.Range("A" & (resultRowStart + 1 + i)).Font.Color = RGB(5, 99, 193)
        ws.Range("A" & (resultRowStart + 1 + i)).Font.Underline = xlUnderlineStyleSingle
        
        ' Add full path in column B
        ws.Range("B" & (resultRowStart + 1 + i)).Value = filePath
        ws.Range("B" & (resultRowStart + 1 + i)).Font.Size = 9
        
        ' Add match information
        ws.Range("C" & (resultRowStart + 1 + i)).Value = "✓ All keywords"
        ws.Range("C" & (resultRowStart + 1 + i)).Font.Color = RGB(0, 128, 0)
        ws.Range("C" & (resultRowStart + 1 + i)).HorizontalAlignment = xlCenter
        
        ' Create filtered content view with AND/OR logic and add hyperlink
        Application.StatusBar = "Creating filtered view for " & fileName & "..."
        Dim filterSheetName As String
        filterSheetName = CreateFilteredContentSheet(filePath, keywords, keywordLogic, keywordCount, i + 1)
        
        If filterSheetName <> "" Then
            ws.Hyperlinks.Add Anchor:=ws.Range("D" & (resultRowStart + 1 + i)), _
                              Address:="", _
                              SubAddress:="'" & filterSheetName & "'!A1", _
                              TextToDisplay:="View Filtered Rows"
            ws.Range("D" & (resultRowStart + 1 + i)).Font.Color = RGB(5, 99, 193)
            ws.Range("D" & (resultRowStart + 1 + i)).Font.Underline = xlUnderlineStyleSingle
            ws.Range("D" & (resultRowStart + 1 + i)).HorizontalAlignment = xlCenter
        Else
            ws.Range("D" & (resultRowStart + 1 + i)).Value = "N/A (Binary)"
            ws.Range("D" & (resultRowStart + 1 + i)).Font.Color = RGB(128, 128, 128)
            ws.Range("D" & (resultRowStart + 1 + i)).Font.Italic = True
            ws.Range("D" & (resultRowStart + 1 + i)).HorizontalAlignment = xlCenter
        End If
        
        ' Add alternating row colors
        If i Mod 2 = 0 Then
            ws.Range("A" & (resultRowStart + 1 + i) & ":D" & (resultRowStart + 1 + i)).Interior.Color = RGB(242, 242, 242)
        End If
    Next i
    
    ' Add borders to results
    Dim lastResultRow As Integer
    lastResultRow = resultRowStart + UBound(results) + 1
    ws.Range("A" & resultRowStart & ":D" & lastResultRow).Borders.LineStyle = xlContinuous
    ws.Range("A" & resultRowStart & ":D" & lastResultRow).BorderAround _
        LineStyle:=xlContinuous, Weight:=xlMedium, Color:=RGB(165, 165, 165)
    
    ' Auto-fit columns
    ws.Columns("A").ColumnWidth = 30
    ws.Columns("B").ColumnWidth = 50
    ws.Columns("C").ColumnWidth = 15
    ws.Columns("D").ColumnWidth = 18
    
    Application.ScreenUpdating = True
    Application.StatusBar = False
    
    MsgBox "Search complete with filtered content views!" & vbCrLf & vbCrLf & _
           "Keywords used: " & keywordList & vbCrLf & _
           "Files found: " & (UBound(results) + 1) & vbCrLf & vbCrLf & _
           "• Click file names to open original files" & vbCrLf & _
           "• Click 'View Filtered Rows' to see matching content only", vbInformation
End Sub

Function CreateFilteredContentSheet(filePath As String, keywords() As String, keywordLogic() As String, keywordCount As Integer, fileIndex As Integer) As String
    ' Creates a new sheet with rows matching the AND/OR keyword logic
    Dim fso As Object
    Dim textStream As Object
    Dim fileContent As String
    Dim lines() As String
    Dim filteredLines As Object
    Dim i As Long
    Dim j As Integer
    Dim ws As Worksheet
    Dim sheetName As String
    Dim fileName As String
    Dim rowNum As Long
    Dim maxSheetNameLength As Integer
    
    ' Variables for AND/OR logic
    Dim andKeywords As Object
    Dim orKeywords As Object
    Dim lineMatchesAnd As Boolean
    Dim lineMatchesOr As Boolean
    Dim hasAndKeywords As Boolean
    Dim hasOrKeywords As Boolean
    
    CreateFilteredContentSheet = ""
    
    ' Only process text files
    If Not IsTextFile(filePath) Then
        Exit Function
    End If
    
    Set fso = CreateObject("Scripting.FileSystemObject")
    Set filteredLines = CreateObject("System.Collections.ArrayList")
    Set andKeywords = CreateObject("System.Collections.ArrayList")
    Set orKeywords = CreateObject("System.Collections.ArrayList")
    
    ' Separate keywords into AND and OR lists
    hasAndKeywords = False
    hasOrKeywords = False
    
    For j = 0 To keywordCount - 1
        If keywords(j) <> "" Then
            If keywordLogic(j) = "AND" Then
                andKeywords.Add keywords(j)
                hasAndKeywords = True
            ElseIf keywordLogic(j) = "OR" Then
                orKeywords.Add keywords(j)
                hasOrKeywords = True
            End If
        End If
    Next j
    
    On Error Resume Next
    
    ' Read file content
    Set textStream = fso.OpenTextFile(filePath, 1, False)
    If Err.Number <> 0 Then
        Exit Function
    End If
    
    fileContent = textStream.ReadAll
    textStream.Close
    
    ' Split into lines
    lines = Split(fileContent, vbCrLf)
    If UBound(lines) = 0 Then
        lines = Split(fileContent, vbLf) ' Try Unix line endings
    End If
    If UBound(lines) = 0 Then
        lines = Split(fileContent, vbCr) ' Try old Mac line endings
    End If
    
    ' Filter lines based on AND/OR logic
    For i = LBound(lines) To UBound(lines)
        If Trim(lines(i)) = "" Then GoTo NextLine
        
        lineMatchesAnd = True
        lineMatchesOr = False
        
        ' Check AND keywords (all must be present)
        If hasAndKeywords Then
            For j = 0 To andKeywords.Count - 1
                If InStr(1, LCase(lines(i)), LCase(andKeywords(j)), vbTextCompare) = 0 Then
                    lineMatchesAnd = False
                    Exit For
                End If
            Next j
        End If
        
        ' Check OR keywords (at least one must be present)
        If hasOrKeywords Then
            For j = 0 To orKeywords.Count - 1
                If InStr(1, LCase(lines(i)), LCase(orKeywords(j)), vbTextCompare) > 0 Then
                    lineMatchesOr = True
                    Exit For
                End If
            Next j
        Else
            ' If no OR keywords specified, consider OR condition as satisfied
            lineMatchesOr = True
        End If
        
        ' Add line if it satisfies the combined logic
        ' Logic: (All AND keywords present) AND (At least one OR keyword present OR no OR keywords specified)
        If lineMatchesAnd And lineMatchesOr Then
            filteredLines.Add "Line " & (i + 1) & ": " & lines(i)
        End If
        
NextLine:
    Next i
    
    ' Create new worksheet for filtered content
    If filteredLines.Count > 0 Then
        fileName = fso.GetFileName(filePath)
        
        ' Create safe sheet name (max 31 characters, no special chars)
        maxSheetNameLength = 31
        sheetName = "Filter_" & fileIndex & "_" & Left(fileName, maxSheetNameLength - 10)
        sheetName = Replace(sheetName, ":", "")
        sheetName = Replace(sheetName, "\", "")
        sheetName = Replace(sheetName, "/", "")
        sheetName = Replace(sheetName, "?", "")
        sheetName = Replace(sheetName, "*", "")
        sheetName = Replace(sheetName, "[", "")
        sheetName = Replace(sheetName, "]", "")
        
        ' Delete sheet if it already exists
        On Error Resume Next
        Application.DisplayAlerts = False
        ThisWorkbook.Sheets(sheetName).Delete
        Application.DisplayAlerts = True
        On Error GoTo 0
        
        ' Create new sheet
        Set ws = ThisWorkbook.Sheets.Add(After:=ThisWorkbook.Sheets(ThisWorkbook.Sheets.Count))
        ws.Name = sheetName
        
        ' Add header information
        ws.Range("A1").Value = "Filtered Content View"
        ws.Range("A1").Font.Bold = True
        ws.Range("A1").Font.Size = 14
        
        ws.Range("A2").Value = "File:"
        ws.Range("A2").Font.Bold = True
        ws.Range("B2").Value = fileName
        
        ws.Range("A3").Value = "Full Path:"
        ws.Range("A3").Font.Bold = True
        ws.Range("B3").Value = filePath
        
        ws.Range("A4").Value = "Filter Logic:"
        ws.Range("A4").Font.Bold = True
        Dim logicDescription As String
        logicDescription = ""
        
        ' Build logic description
        If hasAndKeywords Then
            logicDescription = "AND Keywords: "
            For j = 0 To andKeywords.Count - 1
                If j > 0 Then logicDescription = logicDescription & " + "
                logicDescription = logicDescription & andKeywords(j)
            Next j
        End If
        
        If hasOrKeywords Then
            If logicDescription <> "" Then logicDescription = logicDescription & " | "
            logicDescription = logicDescription & "OR Keywords: "
            For j = 0 To orKeywords.Count - 1
                If j > 0 Then logicDescription = logicDescription & " / "
                logicDescription = logicDescription & orKeywords(j)
            Next j
        End If
        
        ws.Range("B4").Value = logicDescription
        
        ws.Range("A5").Value = "Matching Lines:"
        ws.Range("A5").Font.Bold = True
        ws.Range("B5").Value = filteredLines.Count
        
        ' Add column header
        ws.Range("A7").Value = "Matching Rows (with line numbers)"
        ws.Range("A7").Font.Bold = True
        ws.Range("A7").Interior.Color = RGB(200, 200, 200)
        
        ' Add filtered lines
        rowNum = 8
        For i = 0 To filteredLines.Count - 1
            ws.Range("A" & rowNum).Value = filteredLines(i)
            
            ' Highlight AND keywords in GREEN
            Dim cellText As String
            cellText = ws.Range("A" & rowNum).Value
            
            If hasAndKeywords Then
                For j = 0 To andKeywords.Count - 1
                    Dim kwPos As Long
                    Dim searchStart As Long
                    searchStart = 1
                    
                    ' Find and highlight all occurrences
                    Do
                        kwPos = InStr(searchStart, cellText, andKeywords(j), vbTextCompare)
                        If kwPos > 0 Then
                            ws.Range("A" & rowNum).Characters(kwPos, Len(andKeywords(j))).Font.Color = RGB(0, 128, 0) ' Green for AND
                            ws.Range("A" & rowNum).Characters(kwPos, Len(andKeywords(j))).Font.Bold = True
                            searchStart = kwPos + Len(andKeywords(j))
                        End If
                    Loop While kwPos > 0 And searchStart < Len(cellText)
                Next j
            End If
            
            ' Highlight OR keywords in BLUE
            If hasOrKeywords Then
                For j = 0 To orKeywords.Count - 1
                    searchStart = 1
                    
                    ' Find and highlight all occurrences
                    Do
                        kwPos = InStr(searchStart, cellText, orKeywords(j), vbTextCompare)
                        If kwPos > 0 Then
                            ws.Range("A" & rowNum).Characters(kwPos, Len(orKeywords(j))).Font.Color = RGB(0, 0, 255) ' Blue for OR
                            ws.Range("A" & rowNum).Characters(kwPos, Len(orKeywords(j))).Font.Bold = True
                            searchStart = kwPos + Len(orKeywords(j))
                        End If
                    Loop While kwPos > 0 And searchStart < Len(cellText)
                Next j
            End If
            
            rowNum = rowNum + 1
            
            ' Limit to prevent Excel slowdown
            If rowNum > 10000 Then
                ws.Range("A" & rowNum).Value = "... (More results truncated for performance)"
                Exit For
            End If
        Next i
        
        ' Add legend for color coding
        ws.Range("A" & (rowNum + 2)).Value = "Legend:"
        ws.Range("A" & (rowNum + 2)).Font.Bold = True
        
        If hasAndKeywords Then
            ws.Range("A" & (rowNum + 3)).Value = "AND Keywords (all must be present)"
            ws.Range("A" & (rowNum + 3)).Font.Color = RGB(0, 128, 0)
            ws.Range("A" & (rowNum + 3)).Font.Bold = True
        End If
        
        If hasOrKeywords Then
            Dim legendRow As Integer
            legendRow = IIf(hasAndKeywords, rowNum + 4, rowNum + 3)
            ws.Range("A" & legendRow).Value = "OR Keywords (at least one must be present)"
            ws.Range("A" & legendRow).Font.Color = RGB(0, 0, 255)
            ws.Range("A" & legendRow).Font.Bold = True
        End If
        
        ' Format columns
        ws.Columns("A").ColumnWidth = 150
        ws.Columns("A").WrapText = True
        ws.Columns("B").ColumnWidth = 50
        
        ' Add "Back to Search" button (as hyperlink)
        ws.Range("A" & (rowNum + 6)).Value = "← Back to Search Results"
        ws.Hyperlinks.Add Anchor:=ws.Range("A" & (rowNum + 6)), _
                          Address:="", _
                          SubAddress:="'Search'!A1", _
                          TextToDisplay:="← Back to Search Results"
        ws.Range("A" & (rowNum + 6)).Font.Bold = True
        ws.Range("A" & (rowNum + 6)).Font.Color = RGB(0, 0, 255)
        
        CreateFilteredContentSheet = sheetName
    End If
    
    On Error GoTo 0
    Set fso = Nothing
    Set textStream = Nothing
    Set filteredLines = Nothing
    Set andKeywords = Nothing
    Set orKeywords = Nothing
End Function

Sub ClearFilteredContentSheets()
    ' Utility macro to clean up all filtered content sheets
    Dim ws As Worksheet
    Dim sheetsDeleted As Integer
    
    sheetsDeleted = 0
    
    Application.DisplayAlerts = False
    
    For Each ws In ThisWorkbook.Sheets
        If Left(ws.Name, 7) = "Filter_" Then
            ws.Delete
            sheetsDeleted = sheetsDeleted + 1
        End If
    Next ws
    
    Application.DisplayAlerts = True
    
    MsgBox "Cleared " & sheetsDeleted & " filtered content sheet(s)", vbInformation
End Sub