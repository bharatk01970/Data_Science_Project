' ========== DASHBOARD SETUP ==========

Sub SetupSearchSheet()
    Dim ws As Worksheet
    Dim i As Integer
    Dim btn As Button
    
    On Error Resume Next
    Set ws = ThisWorkbook.Sheets("Search")
    On Error GoTo 0
    
    If ws Is Nothing Then
        Set ws = ThisWorkbook.Sheets.Add
        ws.Name = "Search"
    End If
    
    Application.ScreenUpdating = False
    
    ' Clear existing content
    ws.Cells.Clear
    ws.Buttons.Delete  ' Remove any existing buttons
    
    ' Set tab colour to match branding
    ws.Tab.Color = RGB(192, 0, 0)
    
    ' ========== SECTION 1: HEADER ==========
    ws.Range("A1:D1").Merge
    ws.Range("A1").Value = "UNIVERSAL FILE & CONTENT FINDER"
    ws.Range("A1").Font.Bold = True
    ws.Range("A1").Font.Size = 16
    ws.Range("A1").Font.Color = RGB(255, 255, 255)
    ws.Range("A1").Interior.Color = RGB(139, 0, 0)      ' Dark Red
    ws.Range("A1").HorizontalAlignment = xlCenter
    ws.Range("A1").VerticalAlignment = xlCenter
    ws.Range("A1").RowHeight = 35
    
    ' ========== SECTION 2: FOLDER PATH ==========
    Dim folderSection As Integer
    folderSection = 3
    
    ws.Range("A" & folderSection & ":D" & folderSection).Merge
    ws.Range("A" & folderSection).Value = "FOLDER LOCATION"
    ws.Range("A" & folderSection).Font.Bold = True
    ws.Range("A" & folderSection).Font.Size = 11
    ws.Range("A" & folderSection).Font.Color = RGB(255, 255, 255)
    ws.Range("A" & folderSection).Interior.Color = RGB(192, 48, 48)   ' Medium Red
    ws.Range("A" & folderSection).HorizontalAlignment = xlLeft
    ws.Range("A" & folderSection).VerticalAlignment = xlCenter
    ws.Range("A" & folderSection).RowHeight = 25
    
    ws.Range("A" & (folderSection + 1)).Value = "Folder Path:"
    ws.Range("A" & (folderSection + 1)).Font.Bold = True
    ws.Range("A" & (folderSection + 1)).Font.Size = 10
    ws.Range("C" & (folderSection + 1) & ":D" & (folderSection + 1)).Merge
    ws.Range("B" & (folderSection + 1)).Value = "C:\Your\Folder\Path"
    ws.Range("B" & (folderSection + 1)).Font.Italic = True
    ws.Range("B" & (folderSection + 1)).Font.Color = RGB(128, 128, 128)
    ws.Range("B" & (folderSection + 1)).Interior.Color = RGB(255, 245, 245)
    ws.Range("B" & (folderSection + 1)).Borders.LineStyle = xlContinuous
    ws.Range("B" & (folderSection + 1)).Borders.Color = RGB(192, 128, 128)
    
    ws.Range("A" & folderSection & ":B" & (folderSection + 1)).BorderAround _
        LineStyle:=xlContinuous, Weight:=xlMedium, Color:=RGB(139, 0, 0)
    
    ' ========== SECTION 3: PARAMETERS ==========
    Dim paramSection As Integer
    paramSection = folderSection + 3
    
    ws.Range("A" & paramSection & ":C" & paramSection).Merge
    ws.Range("A" & paramSection).Value = "SEARCH PARAMETERS (Keywords)"
    ws.Range("A" & paramSection).Font.Bold = True
    ws.Range("A" & paramSection).Font.Size = 11
    ws.Range("A" & paramSection).Font.Color = RGB(255, 255, 255)
    ws.Range("A" & paramSection).Interior.Color = RGB(176, 0, 32)     ' Deep Red
    ws.Range("A" & paramSection).HorizontalAlignment = xlLeft
    ws.Range("A" & paramSection).VerticalAlignment = xlCenter
    ws.Range("A" & paramSection).RowHeight = 25
    
    ' Column headers
    ws.Range("A" & (paramSection + 1)).Value = "Keyword"
    ws.Range("B" & (paramSection + 1)).Value = "Search Term"
    ws.Range("C" & (paramSection + 1)).Value = "Logic (AND/OR)"
    ws.Range("A" & (paramSection + 1) & ":C" & (paramSection + 1)).Font.Bold = True
    ws.Range("A" & (paramSection + 1) & ":C" & (paramSection + 1)).Interior.Color = RGB(255, 200, 200)
    ws.Range("A" & (paramSection + 1) & ":C" & (paramSection + 1)).HorizontalAlignment = xlCenter
    ws.Range("A" & (paramSection + 1) & ":C" & (paramSection + 1)).Borders.LineStyle = xlContinuous
    
    ' Keyword input fields
    For i = 1 To MAX_KEYWORDS
        Dim currentRow As Integer
        currentRow = paramSection + 1 + i
        
        ws.Range("A" & currentRow).Value = "Keyword " & i
        ws.Range("A" & currentRow).Font.Bold = True
        ws.Range("A" & currentRow).HorizontalAlignment = xlCenter
        ws.Range("A" & currentRow).Interior.Color = RGB(255, 230, 230)
        
        ws.Range("B" & currentRow).Value = ""
        ws.Range("B" & currentRow).Interior.Color = RGB(255, 255, 255)
        ws.Range("B" & currentRow).Borders.LineStyle = xlContinuous
        ws.Range("B" & currentRow).Borders.Color = RGB(192, 128, 128)
        
        ws.Range("C" & currentRow).Value = "AND"
        ws.Range("C" & currentRow).Font.Color = RGB(139, 0, 0)
        ws.Range("C" & currentRow).Font.Bold = True
        ws.Range("C" & currentRow).HorizontalAlignment = xlCenter
        ws.Range("C" & currentRow).Interior.Color = RGB(255, 230, 230)
        ws.Range("C" & currentRow).Borders.LineStyle = xlContinuous
        ws.Range("C" & currentRow).Borders.Color = RGB(192, 128, 128)
    Next i
    
    ws.Range("A" & paramSection & ":C" & (paramSection + 1 + MAX_KEYWORDS)).BorderAround _
        LineStyle:=xlContinuous, Weight:=xlMedium, Color:=RGB(176, 0, 32)
    
    ' ========== SECTION 4: MACRO CONTROLS ==========
    Dim controlSection As Integer
    controlSection = paramSection + MAX_KEYWORDS + 3
    
    ws.Range("A" & controlSection & ":D" & controlSection).Merge
    ws.Range("A" & controlSection).Value = "MACRO CONTROLS"
    ws.Range("A" & controlSection).Font.Bold = True
    ws.Range("A" & controlSection).Font.Size = 11
    ws.Range("A" & controlSection).Font.Color = RGB(255, 255, 255)
    ws.Range("A" & controlSection).Interior.Color = RGB(101, 0, 0)    ' Very dark red (maroon)
    ws.Range("A" & controlSection).HorizontalAlignment = xlLeft
    ws.Range("A" & controlSection).VerticalAlignment = xlCenter
    ws.Range("A" & controlSection).RowHeight = 25
    
    ' Create buttons
    Dim btnTop As Long
    Dim btnLeft As Long
    Dim btnWidth As Long
    Dim btnHeight As Long
    Dim btnSpacing As Long
    
    btnTop = ws.Range("A" & (controlSection + 1)).Top
    btnLeft = ws.Range("A" & (controlSection + 1)).Left
    btnWidth = 140
    btnHeight = 30
    btnSpacing = 10
    
    ' Button 1: Search Name Only
    Set btn = ws.Buttons.Add(btnLeft, btnTop, btnWidth, btnHeight)
    btn.OnAction = "RunSearchByNameOnly"
    btn.Caption = "Search: Name Only"
    btn.Font.Bold = True
    btn.Font.Size = 9
    
    ' Button 2: Search Name + Content
    Set btn = ws.Buttons.Add(btnLeft + btnWidth + btnSpacing, btnTop, btnWidth, btnHeight)
    btn.OnAction = "RunSearch"
    btn.Caption = "Search: Name + Content"
    btn.Font.Bold = True
    btn.Font.Size = 9
    
    ' Button 3: Search with Preview
    btnTop = btnTop + btnHeight + btnSpacing
    Set btn = ws.Buttons.Add(btnLeft, btnTop, btnWidth, btnHeight)
    btn.OnAction = "RunSearchWithContentPreview"
    btn.Caption = "Search: With Preview"
    btn.Font.Bold = True
    btn.Font.Size = 9
    
    ' Button 4: Refine Results (NEW)
    Set btn = ws.Buttons.Add(btnLeft + btnWidth + btnSpacing, btnTop, btnWidth, btnHeight)
    btn.OnAction = "RunRefineSearch"
    btn.Caption = "Refine Results"
    btn.Font.Bold = True
    btn.Font.Size = 9
    
    ' Button 5: Clear Preview Sheets
    btnTop = btnTop + btnHeight + btnSpacing
    Set btn = ws.Buttons.Add(btnLeft, btnTop, btnWidth, btnHeight)
    btn.OnAction = "ClearFilteredContentSheets"
    btn.Caption = "Clear Preview Sheets"
    btn.Font.Bold = True
    btn.Font.Size = 9
    
    ' Button 6: Reset Dashboard
    Set btn = ws.Buttons.Add(btnLeft + btnWidth + btnSpacing, btnTop, btnWidth, btnHeight)
    btn.OnAction = "SetupSearchSheet"
    btn.Caption = "Reset Dashboard"
    btn.Font.Bold = True
    btn.Font.Size = 9
    
    ' Background for button area
    Dim btnEndRow As Integer
    btnEndRow = controlSection + 8
    ws.Range("A" & (controlSection + 1) & ":D" & btnEndRow).Interior.Color = RGB(255, 235, 235)
    
    ws.Range("A" & controlSection & ":D" & btnEndRow).BorderAround _
        LineStyle:=xlContinuous, Weight:=xlMedium, Color:=RGB(101, 0, 0)
    
    ' ========== SECTION 5: INSTRUCTIONS ==========
    Dim instructionSection As Integer
    instructionSection = btnEndRow + 2
    
    ws.Range("A" & instructionSection & ":D" & instructionSection).Merge
    ws.Range("A" & instructionSection).Value = "HOW TO USE"
    ws.Range("A" & instructionSection).Font.Bold = True
    ws.Range("A" & instructionSection).Font.Size = 11
    ws.Range("A" & instructionSection).Font.Color = RGB(255, 255, 255)
    ws.Range("A" & instructionSection).Interior.Color = RGB(160, 32, 32)   ' Red-orange variant
    ws.Range("A" & instructionSection).HorizontalAlignment = xlLeft
    ws.Range("A" & instructionSection).VerticalAlignment = xlCenter
    ws.Range("A" & instructionSection).RowHeight = 25
    
    Dim instrRow As Integer
    instrRow = instructionSection + 1
    
    ws.Range("A" & instrRow & ":D" & instrRow).Merge
    ws.Range("A" & instrRow).Value = "1. Enter folder path in the Folder Location section"
    ws.Range("A" & instrRow).WrapText = True
    instrRow = instrRow + 1
    
    ws.Range("A" & instrRow & ":D" & instrRow).Merge
    ws.Range("A" & instrRow).Value = "2. Enter 1-" & MAX_KEYWORDS & " keywords. Set AND/OR logic (for row filtering only)"
    ws.Range("A" & instrRow).WrapText = True
    instrRow = instrRow + 1
    
    ws.Range("A" & instrRow & ":D" & instrRow).Merge
    ws.Range("A" & instrRow).Value = "3. Click a button in Macro Controls to run search"
    ws.Range("A" & instrRow).WrapText = True
    instrRow = instrRow + 1
    
    ws.Range("A" & instrRow & ":D" & instrRow).Merge
    ws.Range("A" & instrRow).Value = "4. Results appear " & IIf(UCase(RESULT_DISPLAY_MODE) = "SIDE_BY_SIDE", "to the right (column F)", "in '" & RESULT_SHEET_NAME & "' sheet")
    ws.Range("A" & instrRow).WrapText = True
    ws.Range("A" & instrRow).Font.Italic = True
    ws.Range("A" & instrRow).Font.Color = RGB(139, 0, 0)
    instrRow = instrRow + 1
    
    ws.Range("A" & instrRow & ":D" & instrRow).Merge
    ws.Range("A" & instrRow).Value = "5. After 'Name Only' search, use 'Refine Results' to narrow down further"
    ws.Range("A" & instrRow).WrapText = True
    instrRow = instrRow + 1
    
    ws.Range("A" & instrRow & ":D" & instrRow).Merge
    ws.Range("A" & instrRow).Value = "6. For 'With Preview', click '[ Click to Preview ]' to open a file preview sheet"
    ws.Range("A" & instrRow).WrapText = True
    instrRow = instrRow + 1
    
    Dim instrEndRow As Integer
    instrEndRow = instrRow - 1
    
    ws.Range("A" & (instructionSection + 1) & ":D" & instrEndRow).Interior.Color = RGB(255, 235, 235)
    ws.Range("A" & instructionSection & ":D" & instrEndRow).BorderAround _
        LineStyle:=xlContinuous, Weight:=xlMedium, Color:=RGB(160, 32, 32)
    
    ' ========== COLUMN E: Gap column (greyed out) ==========
    ' Column E acts as a visual separator between dashboard and results
    Dim lastDashboardRow As Integer
    lastDashboardRow = instrEndRow
    
    ws.Columns("E").ColumnWidth = 2
    ws.Range("E1:E" & lastDashboardRow).Interior.Color = RGB(200, 200, 200)  ' Grey
    ws.Range("E1:E" & lastDashboardRow).Borders.LineStyle = xlNone
    
    ' Format columns
    ws.Columns("A").ColumnWidth = 18
    ws.Columns("B").ColumnWidth = 32
    ws.Columns("C").ColumnWidth = 15
    ws.Columns("D").ColumnWidth = 5
    ' Column E already set above (gap column)
    
    ' Select first input
    ws.Range("B" & (folderSection + 1)).Select
    
    Application.ScreenUpdating = True
    
    
    MsgBox "Dashboard Setup Complete!" & vbCrLf & vbCrLf & _
           "Maximum Keywords: " & MAX_KEYWORDS & vbCrLf & vbCrLf & _
           "IMPORTANT: Paste the Worksheet_SelectionChange event code into" & vbCrLf & _
           "the Search sheet's code module to enable on-demand previews." & vbCrLf & vbCrLf & _
           "Use the buttons in the Macro Controls section to run searches!" & vbCrLf & vbCrLf & _
           "Proceed for file Searching", vbInformation, "Dashboard Ready"
End Sub


