Option Explicit

Function SearchFilesForKeyword(folderPath As String, keyword As String) As Variant
    Dim fso As Object
    Dim folder As Object
    Dim file As Object
    Dim results As Object
    Dim fileContent As String
    Dim fileNum As Integer
    Dim fileName As String
    Dim matchFound As Boolean
    
    ' Create FileSystemObject
    Set fso = CreateObject("Scripting.FileSystemObject")
    Set results = CreateObject("System.Collections.ArrayList")
    
    ' Check if folder exists
    If Not fso.FolderExists(folderPath) Then
        SearchFilesForKeyword = Array("Error: Folder not found")
        Exit Function
    End If
    
    Set folder = fso.GetFolder(folderPath)
    keyword = LCase(keyword) ' Case-insensitive search
    
    ' Loop through all files in the folder
    For Each file In folder.Files
        matchFound = False
        fileName = file.Name
        
        ' First, check if keyword is in file name
        If InStr(1, LCase(fileName), keyword, vbTextCompare) > 0 Then
            matchFound = True
        End If
        
        ' Then check file contents (for text-based files)
        If Not matchFound Then
            matchFound = SearchFileContent(file.Path, keyword)
        ElseIf SearchFileContent(file.Path, keyword) Then
            matchFound = True
        End If
        
        ' Add to results if match found (store both name and path)
        If matchFound Then
            results.Add fileName & "|" & file.Path
        End If
    Next file
    
    ' Return results
    If results.Count > 0 Then
        Dim arr() As Variant
        ReDim arr(0 To results.Count - 1)
        Dim i As Long
        For i = 0 To results.Count - 1
            arr(i) = results(i)
        Next i
        SearchFilesForKeyword = arr
    Else
        SearchFilesForKeyword = Array("No matches found")
    End If
    
    Set fso = Nothing
    Set folder = Nothing
    Set results = Nothing
End Function

Function SearchFileContent(filePath As String, keyword As String) As Boolean
    Dim fileNum As Integer
    Dim fileContent As String
    Dim textStream As Object
    Dim fso As Object
    
    On Error Resume Next
    
    SearchFileContent = False
    
    ' Only search text-based files (txt, csv, log, xml, json, etc.)
    If IsTextFile(filePath) Then
        Set fso = CreateObject("Scripting.FileSystemObject")
        Set textStream = fso.OpenTextFile(filePath, 1, False) ' 1 = ForReading
        
        If Err.Number = 0 Then
            fileContent = textStream.ReadAll
            textStream.Close
            
            If InStr(1, LCase(fileContent), keyword, vbTextCompare) > 0 Then
                SearchFileContent = True
            End If
        End If
        
        Set textStream = Nothing
        Set fso = Nothing
    End If
    
    On Error GoTo 0
End Function

Function IsTextFile(filePath As String) As Boolean
    Dim ext As String
    ext = LCase(Right(filePath, Len(filePath) - InStrRev(filePath, ".")))
    
    ' Add or remove extensions as needed
    Select Case ext
        Case "txt", "csv", "log", "xml", "json", "ini", "cfg", "md", "html", "htm", "sql", "vbs", "bat"
            IsTextFile = True
        Case Else
            IsTextFile = False
    End Select
End Function

Sub RunSearch()
    Dim folderPath As String
    Dim keyword As String
    Dim results As Variant
    Dim ws As Worksheet
    Dim i As Long
    Dim resultParts() As String
    Dim fileName As String
    Dim filePath As String
    
    Set ws = ThisWorkbook.Sheets("Search")
    
    ' Get inputs from worksheet
    folderPath = ws.Range("B2").Value
    keyword = ws.Range("B3").Value
    
    If folderPath = "" Or keyword = "" Then
        MsgBox "Please enter both folder path and keyword", vbExclamation
        Exit Sub
    End If
    
    ' Clear previous results
    ws.Range("A6:B1000").ClearContents
    
    ' Run search
    Application.ScreenUpdating = False
    results = SearchFilesForKeyword(folderPath, keyword)
    
    ' Output results with headers
    ws.Range("A6").Value = "File Name"
    ws.Range("B6").Value = "File Path"
    
    ' Format headers
    ws.Range("A6:B6").Font.Bold = True
    
    ' Check if results contain error or no matches
    If UBound(results) = 0 And InStr(1, results(0), "Error:") > 0 Then
        ws.Range("A7").Value = results(0)
        Application.ScreenUpdating = True
        MsgBox results(0), vbExclamation
        Exit Sub
    ElseIf UBound(results) = 0 And results(0) = "No matches found" Then
        ws.Range("A7").Value = results(0)
        Application.ScreenUpdating = True
        MsgBox "No matches found", vbInformation
        Exit Sub
    End If
    
    ' Output results with hyperlinks
    For i = LBound(results) To UBound(results)
        resultParts = Split(results(i), "|")
        fileName = resultParts(0)
        filePath = resultParts(1)
        
        ' Add file name as clickable hyperlink
        ws.Hyperlinks.Add Anchor:=ws.Range("A" & (7 + i)), _
                          Address:=filePath, _
                          TextToDisplay:=fileName
        
        ' Add full path in column B
        ws.Range("B" & (7 + i)).Value = filePath
    Next i
    
    ' Auto-fit columns
    ws.Columns("A:B").AutoFit
    
    Application.ScreenUpdating = True
    
    MsgBox "Search complete! Found " & (UBound(results) + 1) & " result(s)" & vbCrLf & _
           "Click on file names to open them.", vbInformation
End Sub

' ========== OPTIONAL: COPY FILES FUNCTIONALITY ==========
' This macro copies the found files to a destination folder
' Run this separately AFTER running the search if you want to copy the files

Sub CopyFoundFiles()
    Dim ws As Worksheet
    Dim destFolder As String
    Dim fso As Object
    Dim lastRow As Long
    Dim i As Long
    Dim sourcePath As String
    Dim fileName As String
    Dim copyCount As Long
    Dim errorCount As Long
    Dim errorMsg As String
    
    Set ws = ThisWorkbook.Sheets("Search")
    Set fso = CreateObject("Scripting.FileSystemObject")
    
    ' Check if there are search results
    If ws.Range("A7").Value = "" Or ws.Range("A6").Value <> "File Name" Then
        MsgBox "No search results found. Please run the search first.", vbExclamation
        Exit Sub
    End If
    
    ' Ask user for destination folder
    With Application.FileDialog(msoFileDialogFolderPicker)
        .Title = "Select Destination Folder to Copy Files"
        .AllowMultiSelect = False
        If .Show = -1 Then
            destFolder = .SelectedItems(1)
        Else
            Exit Sub ' User cancelled
        End If
    End With
    
    ' Ensure destination folder ends with backslash
    If Right(destFolder, 1) <> "\" Then destFolder = destFolder & "\"
    
    ' Find last row with data
    lastRow = ws.Cells(ws.Rows.Count, "B").End(xlUp).Row
    
    ' Copy files
    Application.ScreenUpdating = False
    copyCount = 0
    errorCount = 0
    errorMsg = ""
    
    For i = 7 To lastRow
        sourcePath = ws.Range("B" & i).Value
        
        If sourcePath <> "" And fso.FileExists(sourcePath) Then
            On Error Resume Next
            fileName = fso.GetFileName(sourcePath)
            fso.CopyFile sourcePath, destFolder & fileName, True ' True = overwrite if exists
            
            If Err.Number = 0 Then
                copyCount = copyCount + 1
            Else
                errorCount = errorCount + 1
                errorMsg = errorMsg & vbCrLf & "- " & fileName & " (Error: " & Err.Description & ")"
                Err.Clear
            End If
            On Error GoTo 0
        End If
    Next i
    
    Application.ScreenUpdating = True
    
    ' Show summary
    Dim msg As String
    msg = "Copy operation complete!" & vbCrLf & vbCrLf & _
          "Successfully copied: " & copyCount & " file(s)" & vbCrLf & _
          "Destination: " & destFolder
    
    If errorCount > 0 Then
        msg = msg & vbCrLf & vbCrLf & "Failed to copy: " & errorCount & " file(s)" & errorMsg
        MsgBox msg, vbExclamation
    Else
        MsgBox msg, vbInformation
    End If
    
    Set fso = Nothing
End Sub