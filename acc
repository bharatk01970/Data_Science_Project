' ========== NEW: REFINE SEARCH (secondary search within first results) ==========
Sub RunRefineSearch()
    ' Reads the file paths stored in hidden col J (from RunSearchByNameOnly),
    ' then re-filters them using the currently entered keywords.
    Dim ws As Worksheet
    Dim outputWs As Worksheet
    Dim keywords(0 To MAX_KEYWORDS - 1) As String
    Dim keywordCount As Integer
    Dim keywordList As String
    Dim startCol As String
    Dim startRow As Integer
    Dim col1 As String, col2 As String
    Dim results As Variant
    Dim i As Long
    Dim resultParts() As String
    Dim fileName As String
    Dim filePath As String
    
    Set ws = ThisWorkbook.Sheets("Search")
    Set outputWs = GetOutputWorksheet()
    startCol = GetOutputStartColumn()
    startRow = GetOutputStartRow()
    col1 = ColumnLetter(ColumnNumber(startCol))
    col2 = ColumnLetter(ColumnNumber(startCol) + 1)
    
    ' Collect file paths from hidden helper column J
    Dim firstResultPaths() As String
    Dim fileCount As Integer
    fileCount = 0
    
    ' Unhide J temporarily to read
    outputWs.Columns("J").Hidden = False
    
    Dim checkRow As Integer
    checkRow = startRow + 1
    Do While outputWs.Range("J" & checkRow).Value <> ""
        ReDim Preserve firstResultPaths(fileCount)
        firstResultPaths(fileCount) = outputWs.Range("J" & checkRow).Value
        fileCount = fileCount + 1
        checkRow = checkRow + 1
    Loop
    
    outputWs.Columns("J").Hidden = True
    
    If fileCount = 0 Then
        MsgBox "No first-search results found to refine." & vbCrLf & _
               "Please run 'Search: Name Only' first.", vbExclamation
        Exit Sub
    End If
    
    ' Get keywords from dashboard
    keywordCount = 0
    keywordList = ""
    For i = 0 To MAX_KEYWORDS - 1
        keywords(i) = Trim(ws.Range("B" & (8 + i)).Value)
        If keywords(i) <> "" Then
            keywordCount = keywordCount + 1
            If keywordList <> "" Then keywordList = keywordList & ", "
            keywordList = keywordList & """" & keywords(i) & """"
        End If
    Next i
    
    If keywordCount = 0 Then
        MsgBox "Please enter at least one keyword to refine with (cells B8 onwards).", vbExclamation
        Exit Sub
    End If
    
    ' Clear current results area (keep col J intact - re-written below)
    outputWs.Range(col1 & "1:" & col2 & "1000").ClearContents
    outputWs.Range(col1 & "1:" & col2 & "1000").ClearFormats
    outputWs.Columns("J").Hidden = False
    outputWs.Range("J1:J1000").ClearContents
    outputWs.Columns("J").Hidden = True
    
    ' Run refined search on first-result files only
    Application.ScreenUpdating = False
    Application.StatusBar = "Refining search within " & fileCount & " file(s)..."
    
    results = SearchFilesInList(firstResultPaths, fileCount, keywords, keywordCount, False)
    
    ' Write results header
    Call WriteResultsSectionHeader(outputWs, startCol, startRow)
    
    outputWs.Range(col1 & startRow).Value = "File Name (Refined)"
    outputWs.Range(col2 & startRow).Value = "File Path"
    outputWs.Range(col1 & startRow & ":" & col2 & startRow).Font.Bold = True
    outputWs.Range(col1 & startRow & ":" & col2 & startRow).Font.Size = 10
    outputWs.Range(col1 & startRow & ":" & col2 & startRow).Interior.Color = RGB(217, 217, 217)
    outputWs.Range(col1 & startRow & ":" & col2 & startRow).Borders.LineStyle = xlContinuous
    outputWs.Range(col1 & startRow & ":" & col2 & startRow).HorizontalAlignment = xlCenter
    
    If UBound(results) = 0 And (InStr(1, results(0), "Error:") > 0 Or results(0) = "No matches found") Then
        outputWs.Range(col1 & (startRow + 1)).Value = results(0)
        Application.ScreenUpdating = True
        Application.StatusBar = False
        MsgBox results(0), vbInformation
        Exit Sub
    End If
    
    ' Output refined results
    outputWs.Columns("J").Hidden = False
    For i = LBound(results) To UBound(results)
        resultParts = Split(results(i), "|")
        fileName = resultParts(0)
        filePath = resultParts(1)
        
        outputWs.Hyperlinks.Add Anchor:=outputWs.Range(col1 & (startRow + 1 + i)), _
                          Address:=filePath, _
                          TextToDisplay:=fileName
        outputWs.Range(col1 & (startRow + 1 + i)).Font.Color = RGB(5, 99, 193)
        outputWs.Range(col1 & (startRow + 1 + i)).Font.Underline = xlUnderlineStyleSingle
        
        outputWs.Range(col2 & (startRow + 1 + i)).Value = filePath
        outputWs.Range(col2 & (startRow + 1 + i)).Font.Size = 9
        
        ' Persist paths for further refine if needed
        outputWs.Range("J" & (startRow + 1 + i)).Value = filePath
        
        If i Mod 2 = 0 Then
            outputWs.Range(col1 & (startRow + 1 + i) & ":" & col2 & (startRow + 1 + i)).Interior.Color = RGB(255, 240, 240)
        End If
    Next i
    outputWs.Columns("J").Hidden = True
    
    Dim lastRow As Integer
    lastRow = startRow + UBound(results) + 1
    outputWs.Range(col1 & startRow & ":" & col2 & lastRow).Borders.LineStyle = xlContinuous
    outputWs.Range(col1 & startRow & ":" & col2 & lastRow).BorderAround _
        LineStyle:=xlContinuous, Weight:=xlMedium, Color:=RGB(165, 165, 165)
    outputWs.Columns(col1).ColumnWidth = 35
    outputWs.Columns(col2).ColumnWidth = 55
    
    Application.ScreenUpdating = True
    Application.StatusBar = False
    
    MsgBox "Refine Search complete!" & vbCrLf & vbCrLf & _
           "Searched within: " & fileCount & " file(s) from first results" & vbCrLf & _
           "Keywords used: " & keywordList & vbCrLf & _
           "Files matched: " & (UBound(results) + 1), vbInformation
End Sub

' ========== FILTERED CONTENT VIEW FUNCTIONALITY ==========
' This section provides functionality to view only matching rows from files

Sub RunSearchWithContentPreview()
    ' This macro performs the search and shows results on the main sheet.
    ' Preview sheets are created ON DEMAND when the user clicks "View Preview" links.
    Dim folderPath As String
    Dim keywords(0 To MAX_KEYWORDS - 1) As String
    Dim keywordLogic(0 To MAX_KEYWORDS - 1) As String
    Dim keywordCount As Integer
    Dim results As Variant
    Dim ws As Worksheet
    Dim outputWs As Worksheet
    Dim i As Long
    Dim resultParts() As String
    Dim fileName As String
    Dim filePath As String
    Dim keywordList As String
    Dim startCol As String
    Dim startRow As Integer
    Dim col1 As String, col2 As String, col3 As String
    
    Set ws = ThisWorkbook.Sheets("Search")
    
    ' Get folder path
    folderPath = ws.Range("B4").Value
    
    ' Get keywords and logic operators
    keywordCount = 0
    keywordList = ""
    
    For i = 0 To MAX_KEYWORDS - 1
        keywords(i) = Trim(ws.Range("B" & (8 + i)).Value)
        keywordLogic(i) = UCase(Trim(ws.Range("C" & (8 + i)).Value))
        
        If keywordLogic(i) = "" Then keywordLogic(i) = "AND"
        
        If keywordLogic(i) <> "AND" And keywordLogic(i) <> "OR" Then
            MsgBox "Invalid logic operator in row " & (8 + i) & ". Use 'AND' or 'OR' only.", vbExclamation
            Exit Sub
        End If
        
        If keywords(i) <> "" Then
            keywordCount = keywordCount + 1
            If keywordList <> "" Then keywordList = keywordList & ", "
            keywordList = keywordList & """" & keywords(i) & """ (" & keywordLogic(i) & ")"
        End If
    Next i
    
    ' Validation
    If folderPath = "" Then
        MsgBox "Please enter folder path in cell B4", vbExclamation
        Exit Sub
    End If
    
    If keywordCount = 0 Then
        MsgBox "Please enter at least one keyword (cells B8 onwards)", vbExclamation
        Exit Sub
    End If
    
    ' Get output worksheet and positions
    Set outputWs = GetOutputWorksheet()
    startCol = GetOutputStartColumn()
    startRow = GetOutputStartRow()
    
    ' Clear previous results
    If UCase(RESULT_DISPLAY_MODE) = "SEPARATE_SHEET" Then
        outputWs.Cells.Clear
        outputWs.Range("A1").Value = "Search Results - " & Format(Now, "yyyy-mm-dd hh:mm:ss")
        outputWs.Range("A1").Font.Bold = True
        outputWs.Range("A1").Font.Size = 12
    Else
        Dim clearCol As Integer
        clearCol = ColumnNumber(startCol)
        outputWs.Range(ColumnLetter(clearCol) & "1:" & ColumnLetter(clearCol + 3) & "1000").ClearContents
        outputWs.Range(ColumnLetter(clearCol) & "1:" & ColumnLetter(clearCol + 3) & "1000").ClearFormats
    End If
    
    ' Run search
    Application.ScreenUpdating = False
    Application.StatusBar = "Searching for " & keywordCount & " keyword(s)..."
    
    results = SearchFilesForKeywords(folderPath, keywords, keywordCount, True)
    
    ' Calculate column letters
    col1 = ColumnLetter(ColumnNumber(startCol))
    col2 = ColumnLetter(ColumnNumber(startCol) + 1)
    col3 = ColumnLetter(ColumnNumber(startCol) + 2)
    
    ' ---- Output Results Header Label ----
    Call WriteResultsSectionHeader(outputWs, startCol, startRow)
    
    ' Output results with headers
    outputWs.Range(col1 & startRow).Value = "File Name"
    outputWs.Range(col2 & startRow).Value = "File Path"
    outputWs.Range(col3 & startRow).Value = "Content Preview"
    
    ' Format headers
    outputWs.Range(col1 & startRow & ":" & col3 & startRow).Font.Bold = True
    outputWs.Range(col1 & startRow & ":" & col3 & startRow).Font.Size = 10
    outputWs.Range(col1 & startRow & ":" & col3 & startRow).Interior.Color = RGB(217, 217, 217)
    outputWs.Range(col1 & startRow & ":" & col3 & startRow).Borders.LineStyle = xlContinuous
    outputWs.Range(col1 & startRow & ":" & col3 & startRow).HorizontalAlignment = xlCenter
    
    ' Check if results contain error or no matches
    If UBound(results) = 0 And InStr(1, results(0), "Error:") > 0 Then
        outputWs.Range(col1 & (startRow + 1)).Value = results(0)
        Application.ScreenUpdating = True
        Application.StatusBar = False
        MsgBox results(0), vbExclamation
        Exit Sub
    ElseIf UBound(results) = 0 And results(0) = "No matches found" Then
        outputWs.Range(col1 & (startRow + 1)).Value = results(0)
        Application.ScreenUpdating = True
        Application.StatusBar = False
        MsgBox "No matches found for all " & keywordCount & " keyword(s)", vbInformation
        Exit Sub
    End If
    
    ' Output results - NO pre-generated preview sheets.
    ' The "Open Preview" link uses a macro that builds the sheet on demand.
    ' We store the file path and keywords in a named range / hidden cell to pass context.
    
    ' Store keyword context for on-demand preview (use a hidden sheet or named cells)
    ' We'll store in a hidden helper sheet "PreviewConfig"
    Call StorePreviewConfig(keywords, keywordLogic, keywordCount)
    
    For i = LBound(results) To UBound(results)
        resultParts = Split(results(i), "|")
        fileName = resultParts(0)
        filePath = resultParts(1)
        
        ' Add file name as clickable hyperlink
        outputWs.Hyperlinks.Add Anchor:=outputWs.Range(col1 & (startRow + 1 + i)), _
                          Address:=filePath, _
                          TextToDisplay:=fileName
        outputWs.Range(col1 & (startRow + 1 + i)).Font.Color = RGB(5, 99, 193)
        outputWs.Range(col1 & (startRow + 1 + i)).Font.Underline = xlUnderlineStyleSingle
        
        ' Add full path
        outputWs.Range(col2 & (startRow + 1 + i)).Value = filePath
        outputWs.Range(col2 & (startRow + 1 + i)).Font.Size = 9
        
        ' Determine if text-previewable
        If IsTextFile(filePath) And Not IsExcelFile(filePath) Then
            ' Store file index + path in col3 as plain text (macro will read it)
            ' We use a special marker so the Worksheet_SelectionChange can trigger preview
            outputWs.Range(col3 & (startRow + 1 + i)).Value = "[ Click to Preview ]"
            outputWs.Range(col3 & (startRow + 1 + i)).Font.Color = RGB(192, 0, 0)
            outputWs.Range(col3 & (startRow + 1 + i)).Font.Bold = True
            outputWs.Range(col3 & (startRow + 1 + i)).Font.Underline = xlUnderlineStyleSingle
            outputWs.Range(col3 & (startRow + 1 + i)).HorizontalAlignment = xlCenter
            ' Tag: store full path in a comment for on-demand retrieval
            outputWs.Range(col3 & (startRow + 1 + i)).AddComment Text:="PREVIEW_PATH:" & filePath
            outputWs.Range(col3 & (startRow + 1 + i)).Comment.Visible = False
        Else
            outputWs.Range(col3 & (startRow + 1 + i)).Value = "N/A (Binary)"
            outputWs.Range(col3 & (startRow + 1 + i)).Font.Color = RGB(128, 128, 128)
            outputWs.Range(col3 & (startRow + 1 + i)).Font.Italic = True
            outputWs.Range(col3 & (startRow + 1 + i)).HorizontalAlignment = xlCenter
        End If
        
        ' Add alternating row colors
        If i Mod 2 = 0 Then
            outputWs.Range(col1 & (startRow + 1 + i) & ":" & col3 & (startRow + 1 + i)).Interior.Color = RGB(242, 242, 242)
        End If
    Next i
    
    ' Add borders to results
    Dim lastResultRow As Integer
    lastResultRow = startRow + UBound(results) + 1
    outputWs.Range(col1 & startRow & ":" & col3 & lastResultRow).Borders.LineStyle = xlContinuous
    outputWs.Range(col1 & startRow & ":" & col3 & lastResultRow).BorderAround _
        LineStyle:=xlContinuous, Weight:=xlMedium, Color:=RGB(165, 165, 165)
    
    ' Set column widths
    outputWs.Columns(col1).ColumnWidth = 30
    outputWs.Columns(col2).ColumnWidth = 50
    outputWs.Columns(col3).ColumnWidth = 20
    
    ' Add back button if separate sheet
    If UCase(RESULT_DISPLAY_MODE) = "SEPARATE_SHEET" Then
        outputWs.Range("D1").Value = "Back to Search"
        outputWs.Hyperlinks.Add Anchor:=outputWs.Range("D1"), _
                          Address:="", _
                          SubAddress:="'Search'!A1", _
                          TextToDisplay:="Back to Search"
        outputWs.Range("D1").Font.Bold = True
        outputWs.Range("D1").Font.Color = RGB(5, 99, 193)
        outputWs.Activate
    End If
    
    Application.ScreenUpdating = True
    Application.StatusBar = False
    
    MsgBox "Search complete!" & vbCrLf & vbCrLf & _
           "Keywords used: " & keywordList & vbCrLf & _
           "Files found: " & (UBound(results) + 1) & vbCrLf & vbCrLf & _
           "Click '[ Click to Preview ]' in the Content Preview column to open a preview sheet for that file.", vbInformation
End Sub

' ========== ON-DEMAND PREVIEW: Called when user clicks a preview cell ==========
Sub OpenPreviewForCell(previewFilePath As String)
    ' Builds (or refreshes) a single preview sheet for the specified file.
    Dim ws As Worksheet
    Dim keywords(0 To MAX_KEYWORDS - 1) As String
    Dim keywordLogic(0 To MAX_KEYWORDS - 1) As String
    Dim keywordCount As Integer
    
    ' Load keyword config from PreviewConfig sheet
    Call LoadPreviewConfig(keywords, keywordLogic, keywordCount)
    
    Dim sheetName As String
    sheetName = CreateFilteredContentSheet(previewFilePath, keywords, keywordLogic, keywordCount, 1)
    
    If sheetName <> "" Then
        ThisWorkbook.Sheets(sheetName).Activate
    Else
        MsgBox "Could not generate preview for this file." & vbCrLf & _
               "It may be a binary file or could not be read.", vbInformation
    End If
End Sub

' ========== HELPER: Store/Load keyword config for on-demand preview ==========
Sub StorePreviewConfig(keywords() As String, keywordLogic() As String, keywordCount As Integer)
    Dim cfgWs As Worksheet
    On Error Resume Next
    Set cfgWs = ThisWorkbook.Sheets("PreviewConfig")
    On Error GoTo 0
    
    If cfgWs Is Nothing Then
        Set cfgWs = ThisWorkbook.Sheets.Add(After:=ThisWorkbook.Sheets(ThisWorkbook.Sheets.Count))
        cfgWs.Name = "PreviewConfig"
    End If
    
    cfgWs.Visible = xlSheetVeryHidden
    cfgWs.Cells.ClearContents
    cfgWs.Range("A1").Value = keywordCount
    
    Dim i As Integer
    For i = 0 To keywordCount - 1
        cfgWs.Range("A" & (2 + i)).Value = keywords(i)
        cfgWs.Range("B" & (2 + i)).Value = keywordLogic(i)
    Next i
End Sub

Sub LoadPreviewConfig(keywords() As String, keywordLogic() As String, keywordCount As Integer)
    Dim cfgWs As Worksheet
    On Error Resume Next
    Set cfgWs = ThisWorkbook.Sheets("PreviewConfig")
    On Error GoTo 0
    
    If cfgWs Is Nothing Then
        keywordCount = 0
        Exit Sub
    End If
    
    keywordCount = CInt(cfgWs.Range("A1").Value)
    ReDim keywords(0 To MAX_KEYWORDS - 1)
    ReDim keywordLogic(0 To MAX_KEYWORDS - 1)
    
    Dim i As Integer
    For i = 0 To keywordCount - 1
        keywords(i) = cfgWs.Range("A" & (2 + i)).Value
        keywordLogic(i) = cfgWs.Range("B" & (2 + i)).Value
    Next i
End Sub

' ========== FILTERED CONTENT VIEW FUNCTIONALITY ==========

Function CreateFilteredContentSheet(filePath As String, keywords() As String, keywordLogic() As String, keywordCount As Integer, fileIndex As Integer) As String
    Dim fso As Object
    Dim textStream As Object
    Dim fileContent As String
    Dim lines() As String
    Dim filteredLines As Object
    Dim i As Long
    Dim j As Integer
    Dim ws As Worksheet
    Dim sheetName As String
    Dim fileName As String
    Dim rowNum As Long
    Dim maxSheetNameLength As Integer
    Dim andKeywords As Object
    Dim orKeywords As Object
    Dim lineMatchesAnd As Boolean
    Dim lineMatchesOr As Boolean
    Dim hasAndKeywords As Boolean
    Dim hasOrKeywords As Boolean
    
    CreateFilteredContentSheet = ""
    
    ' Only process text files (exclude Excel for row extraction)
    If Not IsTextFile(filePath) Or IsExcelFile(filePath) Then
        Exit Function
    End If
    
    Set fso = CreateObject("Scripting.FileSystemObject")
    Set filteredLines = CreateObject("System.Collections.ArrayList")
    Set andKeywords = CreateObject("System.Collections.ArrayList")
    Set orKeywords = CreateObject("System.Collections.ArrayList")
    
    ' Separate keywords into AND and OR lists
    hasAndKeywords = False
    hasOrKeywords = False
    
    For j = 0 To keywordCount - 1
        If keywords(j) <> "" Then
            If keywordLogic(j) = "AND" Then
                andKeywords.Add keywords(j)
                hasAndKeywords = True
            ElseIf keywordLogic(j) = "OR" Then
                orKeywords.Add keywords(j)
                hasOrKeywords = True
            End If
        End If
    Next j
    
    On Error Resume Next
    
    ' Read file content
    Set textStream = fso.OpenTextFile(filePath, 1, False)
    If Err.Number <> 0 Then Exit Function
    
    fileContent = textStream.ReadAll
    textStream.Close
    
    ' Split into lines
    lines = Split(fileContent, vbCrLf)
    If UBound(lines) = 0 Then lines = Split(fileContent, vbLf)
    If UBound(lines) = 0 Then lines = Split(fileContent, vbCr)
    
    ' Filter lines based on AND/OR logic
    For i = LBound(lines) To UBound(lines)
        If Trim(lines(i)) = "" Then GoTo NextLine
        
        lineMatchesAnd = True
        lineMatchesOr = False
        
        ' Check AND keywords
        If hasAndKeywords Then
            For j = 0 To andKeywords.Count - 1
                If InStr(1, LCase(lines(i)), LCase(andKeywords(j)), vbTextCompare) = 0 Then
                    lineMatchesAnd = False
                    Exit For
                End If
            Next j
        End If
        
        ' Check OR keywords
        If hasOrKeywords Then
            For j = 0 To orKeywords.Count - 1
                If InStr(1, LCase(lines(i)), LCase(orKeywords(j)), vbTextCompare) > 0 Then
                    lineMatchesOr = True
                    Exit For
                End If
            Next j
        Else
            lineMatchesOr = True
        End If
        
        ' Add line if matches logic
        If lineMatchesAnd And lineMatchesOr Then
            filteredLines.Add "Line " & (i + 1) & ": " & lines(i)
        End If
        
NextLine:
    Next i
    
    ' Create worksheet for filtered content
    If filteredLines.Count > 0 Then
        fileName = fso.GetFileName(filePath)
        
        ' Create safe sheet name
        maxSheetNameLength = 31
        sheetName = "Preview_" & Left(fileName, maxSheetNameLength - 8)
        sheetName = Replace(sheetName, ":", "")
        sheetName = Replace(sheetName, "\", "")
        sheetName = Replace(sheetName, "/", "")
        sheetName = Replace(sheetName, "?", "")
        sheetName = Replace(sheetName, "*", "")
        sheetName = Replace(sheetName, "[", "")
        sheetName = Replace(sheetName, "]", "")
        
        ' Delete sheet if exists (refresh)
        On Error Resume Next
        Application.DisplayAlerts = False
        ThisWorkbook.Sheets(sheetName).Delete
        Application.DisplayAlerts = True
        On Error GoTo 0
        
        ' Create new sheet
        Set ws = ThisWorkbook.Sheets.Add(After:=ThisWorkbook.Sheets(ThisWorkbook.Sheets.Count))
        ws.Name = sheetName
        ws.Tab.Color = RGB(192, 0, 0)
        
        ' Add header information
        ws.Range("A1:B1").Merge
        ws.Range("A1").Value = "Content Preview"
        ws.Range("A1").Font.Bold = True
        ws.Range("A1").Font.Size = 14
        ws.Range("A1").Font.Color = RGB(255, 255, 255)
        ws.Range("A1").Interior.Color = RGB(192, 0, 0)
        
        ws.Range("A2").Value = "File:"
        ws.Range("A2").Font.Bold = True
        ws.Range("B2").Value = fileName
        
        ws.Range("A3").Value = "Full Path:"
        ws.Range("A3").Font.Bold = True
        ws.Range("B3").Value = filePath
        
        ws.Range("A4").Value = "Filter Logic:"
        ws.Range("A4").Font.Bold = True
        Dim logicDescription As String
        logicDescription = ""
        
        If hasAndKeywords Then
            logicDescription = "AND Keywords: "
            For j = 0 To andKeywords.Count - 1
                If j > 0 Then logicDescription = logicDescription & " + "
                logicDescription = logicDescription & andKeywords(j)
            Next j
        End If
        
        If hasOrKeywords Then
            If logicDescription <> "" Then logicDescription = logicDescription & " | "
            logicDescription = logicDescription & "OR Keywords: "
            For j = 0 To orKeywords.Count - 1
                If j > 0 Then logicDescription = logicDescription & " / "
                logicDescription = logicDescription & orKeywords(j)
            Next j
        End If
        
        ws.Range("B4").Value = logicDescription
        
        ws.Range("A5").Value = "Matching Lines:"
        ws.Range("A5").Font.Bold = True
        ws.Range("B5").Value = filteredLines.Count
        
        ' Add column header
        ws.Range("A7").Value = "Matching Rows (with line numbers)"
        ws.Range("A7").Font.Bold = True
        ws.Range("A7").Font.Color = RGB(255, 255, 255)
        ws.Range("A7").Interior.Color = RGB(192, 0, 0)
        
        ' Add filtered lines with highlighting
        rowNum = 8
        For i = 0 To filteredLines.Count - 1
            ws.Range("A" & rowNum).Value = filteredLines(i)
            
            Dim cellText As String
            cellText = ws.Range("A" & rowNum).Value
            
            ' Highlight AND keywords in GREEN
            If hasAndKeywords Then
                For j = 0 To andKeywords.Count - 1
                    Dim kwPos As Long
                    Dim searchStart As Long
                    searchStart = 1
                    
                    Do
                        kwPos = InStr(searchStart, cellText, andKeywords(j), vbTextCompare)
                        If kwPos > 0 Then
                            ws.Range("A" & rowNum).Characters(kwPos, Len(andKeywords(j))).Font.Color = RGB(0, 128, 0)
                            ws.Range("A" & rowNum).Characters(kwPos, Len(andKeywords(j))).Font.Bold = True
                            searchStart = kwPos + Len(andKeywords(j))
                        End If
                    Loop While kwPos > 0 And searchStart < Len(cellText)
                Next j
            End If
            
            ' Highlight OR keywords in BLUE
            If hasOrKeywords Then
                For j = 0 To orKeywords.Count - 1
                    searchStart = 1
                    
                    Do
                        kwPos = InStr(searchStart, cellText, orKeywords(j), vbTextCompare)
                        If kwPos > 0 Then
                            ws.Range("A" & rowNum).Characters(kwPos, Len(orKeywords(j))).Font.Color = RGB(0, 0, 255)
                            ws.Range("A" & rowNum).Characters(kwPos, Len(orKeywords(j))).Font.Bold = True
                            searchStart = kwPos + Len(orKeywords(j))
                        End If
                    Loop While kwPos > 0 And searchStart < Len(cellText)
                Next j
            End If
            
            rowNum = rowNum + 1
            
            If rowNum > 10000 Then
                ws.Range("A" & rowNum).Value = "... (More results truncated for performance)"
                Exit For
            End If
        Next i
        
        ' Add legend
        ws.Range("A" & (rowNum + 2)).Value = "Legend:"
        ws.Range("A" & (rowNum + 2)).Font.Bold = True
        
        If hasAndKeywords Then
            ws.Range("A" & (rowNum + 3)).Value = "AND Keywords (all must be present)"
            ws.Range("A" & (rowNum + 3)).Font.Color = RGB(0, 128, 0)
            ws.Range("A" & (rowNum + 3)).Font.Bold = True
        End If
        
        If hasOrKeywords Then
            Dim legendRow As Integer
            legendRow = IIf(hasAndKeywords, rowNum + 4, rowNum + 3)
            ws.Range("A" & legendRow).Value = "OR Keywords (at least one must be present)"
            ws.Range("A" & legendRow).Font.Color = RGB(0, 0, 255)
            ws.Range("A" & legendRow).Font.Bold = True
        End If
        
        ' Format columns
        ws.Columns("A").ColumnWidth = 150
        ws.Columns("A").WrapText = True
        ws.Columns("B").ColumnWidth = 50
        
        ' Add back button
        ws.Range("A" & (rowNum + 6)).Value = "Back to Search Results"
        ws.Hyperlinks.Add Anchor:=ws.Range("A" & (rowNum + 6)), _
                          Address:="", _
                          SubAddress:="'Search'!A1", _
                          TextToDisplay:="Back to Search Results"
        ws.Range("A" & (rowNum + 6)).Font.Bold = True
        ws.Range("A" & (rowNum + 6)).Font.Color = RGB(192, 0, 0)
        
        CreateFilteredContentSheet = sheetName
    End If
    
    On Error GoTo 0
    Set fso = Nothing
    Set textStream = Nothing
    Set filteredLines = Nothing
    Set andKeywords = Nothing
    Set orKeywords = Nothing
End Function

Sub ClearFilteredContentSheets()
    Dim ws As Worksheet
    Dim sheetsDeleted As Integer
    
    sheetsDeleted = 0
    Application.DisplayAlerts = False
    
    For Each ws In ThisWorkbook.Sheets
        If Left(ws.Name, 8) = "Preview_" Then
            ws.Delete
            sheetsDeleted = sheetsDeleted + 1
        End If
    Next ws
    
    Application.DisplayAlerts = True
    
    MsgBox "Cleared " & sheetsDeleted & " preview sheet(s)", vbInformation
End Sub


' ========== HELPER: Write Results Section Header ==========
Sub WriteResultsSectionHeader(outputWs As Worksheet, startCol As String, startRow As Integer)
    ' Writes a styled "RESULTS / OUTPUT" header above the results data
    ' Only applies in SIDE_BY_SIDE mode
    If UCase(RESULT_DISPLAY_MODE) <> "SIDE_BY_SIDE" Then Exit Sub
    
    Dim col1 As String
    Dim col2 As String
    col1 = ColumnLetter(ColumnNumber(startCol))
    col2 = ColumnLetter(ColumnNumber(startCol) + 2)
    
    ' Row 1: Results section header (mimics the dashboard input header style)
    outputWs.Range(col1 & "1:" & col2 & "1").Merge
    outputWs.Range(col1 & "1").Value = "RESULTS / OUTPUT"
    outputWs.Range(col1 & "1").Font.Bold = True
    outputWs.Range(col1 & "1").Font.Size = 16
    outputWs.Range(col1 & "1").Font.Color = RGB(255, 255, 255)
    outputWs.Range(col1 & "1").Interior.Color = RGB(139, 0, 0)
    outputWs.Range(col1 & "1").HorizontalAlignment = xlCenter
    outputWs.Range(col1 & "1").VerticalAlignment = xlCenter
    outputWs.Range(col1 & "1").RowHeight = 35
    
    ' Row 2: Subheader with timestamp
    outputWs.Range(col1 & "2:" & col2 & "2").Merge
    outputWs.Range(col1 & "2").Value = "Last updated: " & Format(Now, "yyyy-mm-dd hh:mm:ss")
    outputWs.Range(col1 & "2").Font.Italic = True
    outputWs.Range(col1 & "2").Font.Size = 9
    outputWs.Range(col1 & "2").Font.Color = RGB(255, 255, 255)
    outputWs.Range(col1 & "2").Interior.Color = RGB(192, 0, 0)
    outputWs.Range(col1 & "2").HorizontalAlignment = xlCenter
    outputWs.Range(col1 & "2").RowHeight = 18
End Sub

