' ==========================================
' USER-FACING MACRO 3: SEARCH WITH CONTENT PREVIEW
'
' FIX: Preview links now work via a macro-assigned hyperlink approach.
' Each "Click to Preview" cell gets a hyperlink pointing to
' SubAddress "OpenPreview" which is a named Sub that reads the
' active cell's helper data (file path stored in col HELPER_COL same row)
' to know which file to preview.
'
' AND logic in preview = ROW-LEVEL: all AND keywords must appear on the SAME row.
' OR  logic in preview = FILE-LEVEL: keyword can appear on any row.
' ==========================================

Sub RunSearchWithContentPreview()
    Dim folderPath As String
    Dim keywords(0 To MAX_KEYWORDS - 1) As String
    Dim keywordLogic(0 To MAX_KEYWORDS - 1) As String
    Dim keywordCount As Integer
    Dim results As Variant
    Dim ws As Worksheet, outputWs As Worksheet
    Dim i As Long
    Dim resultParts() As String
    Dim fileName As String, filePath As String
    Dim keywordList As String
    Dim startCol As String, startRow As Integer
    Dim col1 As String, col2 As String, col3 As String

    Set ws = ThisWorkbook.Sheets("Search")
    folderPath = ws.Range("B4").Value

    keywordCount = 0
    keywordList = ""
    For i = 0 To MAX_KEYWORDS - 1
        keywords(i) = Trim(ws.Range("B" & (8 + i)).Value)
        keywordLogic(i) = UCase(Trim(ws.Range("C" & (8 + i)).Value))
        If keywordLogic(i) = "" Then keywordLogic(i) = "AND"
        If keywordLogic(i) <> "AND" And keywordLogic(i) <> "OR" Then
            MsgBox "Invalid logic in row " & (8 + i) & ". Use AND or OR only.", vbExclamation
            Exit Sub
        End If
        If keywords(i) <> "" Then
            keywordCount = keywordCount + 1
            If keywordList <> "" Then keywordList = keywordList & ", "
            keywordList = keywordList & """" & keywords(i) & """ (" & keywordLogic(i) & ")"
        End If
    Next i

    If folderPath = "" Then MsgBox "Please enter a folder path in cell B4.", vbExclamation: Exit Sub
    If keywordCount = 0 Then MsgBox "Please enter at least one keyword (cells B8 onwards).", vbExclamation: Exit Sub

    Set outputWs = GetOutputWorksheet()
    startCol = GetOutputStartColumn()
    startRow = GetOutputStartRow()
    col1 = ColumnLetter(ColumnNumber(startCol))
    col2 = ColumnLetter(ColumnNumber(startCol) + 1)
    col3 = ColumnLetter(ColumnNumber(startCol) + 2)

    Call ClearResultsArea(outputWs, startCol, startRow)

    Application.ScreenUpdating = False
    Application.StatusBar = "Searching for " & keywordCount & " keyword(s)..."

    ' File-level search: uses file-level AND (all keywords exist somewhere in the file)
    results = SearchFilesForKeywords(folderPath, keywords, keywordCount, True)

    Call WriteResultsSectionHeader(outputWs, startCol, True)
    Call WriteResultsColumnHeaders(outputWs, col1, col2, col3, startRow, True)

    If UBound(results) = 0 Then
        If InStr(1, results(0), "Error:") > 0 Or results(0) = "No matches found" Then
            outputWs.Range(col1 & (startRow + 1)).Value = results(0)
            Application.ScreenUpdating = True
            Application.StatusBar = False
            MsgBox results(0), IIf(InStr(results(0), "Error") > 0, vbExclamation, vbInformation)
            Exit Sub
        End If
    End If

    ' Save keyword config for on-demand preview sheet generation
    Call StorePreviewConfig(keywords, keywordLogic, keywordCount)

    ' Unhide helper column to write file paths (used by OpenPreview macro)
    outputWs.Columns(HELPER_COL).Hidden = False

    For i = LBound(results) To UBound(results)
        resultParts = Split(results(i), "|")
        fileName = resultParts(0)
        filePath = resultParts(1)

        Dim dataRow As Long
        dataRow = startRow + 1 + i

        ' File name hyperlink (opens file)
        outputWs.Hyperlinks.Add Anchor:=outputWs.Range(col1 & dataRow), _
            Address:=filePath, TextToDisplay:=fileName
        With outputWs.Range(col1 & dataRow)
            .Font.Color = RGB(5, 99, 193)
            .Font.Underline = xlUnderlineStyleSingle
        End With

        ' File path
        outputWs.Range(col2 & dataRow).Value = filePath
        outputWs.Range(col2 & dataRow).Font.Size = 9

        ' Store path in helper column (read by OpenPreview macro)
        outputWs.Range(HELPER_COL & dataRow).Value = filePath

        ' Preview link column
        If IsTextFile(filePath) And Not IsExcelFile(filePath) Then
            ' FIX: Use a macro hyperlink. SubAddress maps to OpenPreview sub.
            ' The macro reads the active cell row, looks up the file path
            ' from HELPER_COL on the same row, and builds the preview sheet.
            outputWs.Hyperlinks.Add Anchor:=outputWs.Range(col3 & dataRow), _
                Address:="", _
                SubAddress:="OpenPreview", _
                TextToDisplay:="[ Click to Preview ]"
            With outputWs.Range(col3 & dataRow)
                .Font.Color = RGB(192, 0, 0)
                .Font.Bold = True
                .Font.Underline = xlUnderlineStyleSingle
                .HorizontalAlignment = xlCenter
            End With
        Else
            outputWs.Range(col3 & dataRow).Value = "N/A (Binary)"
            With outputWs.Range(col3 & dataRow)
                .Font.Color = RGB(128, 128, 128)
                .Font.Italic = True
                .HorizontalAlignment = xlCenter
            End With
        End If

        If i Mod 2 = 0 Then
            outputWs.Range(col1 & dataRow & ":" & col3 & dataRow).Interior.Color = RGB(242, 242, 242)
        End If
    Next i

    outputWs.Columns(HELPER_COL).Hidden = True

    ' Format results table (3 columns for preview mode)
    Dim lastRow As Long
    lastRow = startRow + UBound(results) + 1
    outputWs.Range(col1 & startRow & ":" & col3 & lastRow).Borders.LineStyle = xlContinuous
    outputWs.Range(col1 & startRow & ":" & col3 & lastRow).BorderAround _
        LineStyle:=xlContinuous, Weight:=xlMedium, Color:=RGB(165, 165, 165)
    outputWs.Columns(col1).ColumnWidth = 30
    outputWs.Columns(col2).ColumnWidth = 50
    outputWs.Columns(col3).ColumnWidth = 20

    If UCase(RESULT_DISPLAY_MODE) = "SEPARATE_SHEET" Then Call AddBackButton(outputWs)

    Application.ScreenUpdating = True
    Application.StatusBar = False

    MsgBox "Search complete!" & vbCrLf & vbCrLf & _
           "Keywords: " & keywordList & vbCrLf & _
           "Files found: " & (UBound(results) + 1) & vbCrLf & vbCrLf & _
           "Click '[ Click to Preview ]' to open a row-filtered preview for that file.", vbInformation
End Sub


' ==========================================
' ON-DEMAND PREVIEW ENTRY POINT
'
' This macro is triggered by the hyperlink SubAddress "OpenPreview".
' When the user clicks a "[ Click to Preview ]" hyperlink, Excel
' calls this sub. It reads the active cell's row, fetches the file
' path from HELPER_COL on the same row, and builds the preview sheet.
'
' No Worksheet_SelectionChange or Sheet module code is needed.
' ==========================================

Sub OpenPreview()
    Dim outputWs As Worksheet
    Dim activeRow As Long
    Dim filePath As String
    Dim keywords(0 To MAX_KEYWORDS - 1) As String
    Dim keywordLogic(0 To MAX_KEYWORDS - 1) As String
    Dim keywordCount As Integer
    Dim sheetName As String

    Set outputWs = GetOutputWorksheet()

    ' Unhide helper column to read file path
    outputWs.Columns(HELPER_COL).Hidden = False
    activeRow = ActiveCell.Row
    filePath = Trim(outputWs.Range(HELPER_COL & activeRow).Value)
    outputWs.Columns(HELPER_COL).Hidden = True

    If filePath = "" Then
        MsgBox "Could not determine the file path for this row." & vbCrLf & _
               "Please run the search again.", vbExclamation
        Exit Sub
    End If

    ' Load keyword config that was saved when the search ran
    Call LoadPreviewConfig(keywords, keywordLogic, keywordCount)

    If keywordCount = 0 Then
        MsgBox "Keyword configuration not found." & vbCrLf & _
               "Please run 'Search: With Preview' again.", vbExclamation
        Exit Sub
    End If

    Application.StatusBar = "Building preview for " & filePath & "..."

    sheetName = CreateFilteredContentSheet(filePath, keywords, keywordLogic, keywordCount)

    Application.StatusBar = False

    If sheetName <> "" Then
        ThisWorkbook.Sheets(sheetName).Activate
    Else
        MsgBox "Preview could not be generated for this file." & vbCrLf & _
               "It may be a binary or unreadable file type.", vbInformation
    End If
End Sub


' ==========================================
' USER-FACING MACRO 4: REFINE SEARCH
'
' Reads file paths stored in HELPER_COL from a previous Name Only search,
' then re-filters that subset using the currently entered keywords.
'
' FIXES applied:
' - searchContent = True  (was False, caused "No matches found")
' - Col HELPER_COL is NOT cleared before results are written
' - Uses End(xlUp) to find last row, skips blanks (no early stop)
' ==========================================

Sub RunRefineSearch()
    Dim ws As Worksheet, outputWs As Worksheet
    Dim keywords(0 To MAX_KEYWORDS - 1) As String
    Dim keywordCount As Integer, keywordList As String
    Dim startCol As String, startRow As Integer
    Dim col1 As String, col2 As String
    Dim results As Variant
    Dim i As Long, resultParts() As String
    Dim fileName As String, filePath As String

    Set ws = ThisWorkbook.Sheets("Search")
    Set outputWs = GetOutputWorksheet()
    startCol = GetOutputStartColumn()
    startRow = GetOutputStartRow()
    col1 = ColumnLetter(ColumnNumber(startCol))
    col2 = ColumnLetter(ColumnNumber(startCol) + 1)

    ' ---- FIX 3: Read all paths from HELPER_COL using End(xlUp), skip blanks ----
    outputWs.Columns(HELPER_COL).Hidden = False

    Dim firstResultPaths() As String
    Dim fileCount As Integer
    fileCount = 0

    Dim lastJRow As Long
    lastJRow = outputWs.Cells(outputWs.Rows.Count, HELPER_COL).End(xlUp).Row

    Dim checkRow As Long
    Dim cellVal As String
    For checkRow = startRow + 1 To lastJRow
        cellVal = Trim(outputWs.Range(HELPER_COL & checkRow).Value)
        If cellVal <> "" Then
            ReDim Preserve firstResultPaths(fileCount)
            firstResultPaths(fileCount) = cellVal
            fileCount = fileCount + 1
        End If
    Next checkRow

    outputWs.Columns(HELPER_COL).Hidden = True

    If fileCount = 0 Then
        MsgBox "No previous Name Only search results found." & vbCrLf & _
               "Please run 'Search: Name Only' first, then use Refine Results.", vbExclamation
        Exit Sub
    End If

    ' Get keywords
    keywordCount = 0
    keywordList = ""
    For i = 0 To MAX_KEYWORDS - 1
        keywords(i) = Trim(ws.Range("B" & (8 + i)).Value)
        If keywords(i) <> "" Then
            keywordCount = keywordCount + 1
            If keywordList <> "" Then keywordList = keywordList & ", "
            keywordList = keywordList & """" & keywords(i) & """"
        End If
    Next i

    If keywordCount = 0 Then
        MsgBox "Please enter at least one keyword to refine with (cells B8 onwards).", vbExclamation
        Exit Sub
    End If

    ' Clear results area (text/format only, do NOT clear HELPER_COL yet)
    outputWs.Range(col1 & startRow & ":" & col2 & "1000").ClearContents
    outputWs.Range(col1 & startRow & ":" & col2 & "1000").ClearFormats

    Application.ScreenUpdating = False
    Application.StatusBar = "Refining search within " & fileCount & " file(s)..."

    ' FIX 1: searchContent = True so file contents are scanned, not just names
    results = SearchFilesInList(firstResultPaths, fileCount, keywords, keywordCount, True)

    Call WriteResultsSectionHeader(outputWs, startCol, True)
    Call WriteResultsColumnHeaders(outputWs, col1, col2, "", startRow, False)

    If UBound(results) = 0 Then
        If InStr(1, results(0), "Error:") > 0 Or results(0) = "No matches found" Then
            outputWs.Range(col1 & (startRow + 1)).Value = results(0)
            Application.ScreenUpdating = True
            Application.StatusBar = False
            MsgBox results(0), IIf(InStr(results(0), "Error") > 0, vbExclamation, vbInformation)
            Exit Sub
        End If
    End If

    ' FIX 2: Write new paths to HELPER_COL AFTER successful results (no premature clear)
    outputWs.Columns(HELPER_COL).Hidden = False
    outputWs.Range(HELPER_COL & (startRow) & ":" & HELPER_COL & "1000").ClearContents

    For i = LBound(results) To UBound(results)
        resultParts = Split(results(i), "|")
        fileName = resultParts(0)
        filePath = resultParts(1)

        outputWs.Hyperlinks.Add Anchor:=outputWs.Range(col1 & (startRow + 1 + i)), _
            Address:=filePath, TextToDisplay:=fileName
        With outputWs.Range(col1 & (startRow + 1 + i))
            .Font.Color = RGB(5, 99, 193)
            .Font.Underline = xlUnderlineStyleSingle
        End With

        outputWs.Range(col2 & (startRow + 1 + i)).Value = filePath
        outputWs.Range(col2 & (startRow + 1 + i)).Font.Size = 9

        ' Persist refined paths so user can refine again if needed
        outputWs.Range(HELPER_COL & (startRow + 1 + i)).Value = filePath

        If i Mod 2 = 0 Then
            outputWs.Range(col1 & (startRow + 1 + i) & ":" & col2 & (startRow + 1 + i)).Interior.Color = RGB(255, 240, 240)
        End If
    Next i

    outputWs.Columns(HELPER_COL).Hidden = True

    Call FormatResultsTable(outputWs, col1, col2, startRow, UBound(results))
    If UCase(RESULT_DISPLAY_MODE) = "SEPARATE_SHEET" Then Call AddBackButton(outputWs)

    Application.ScreenUpdating = True
    Application.StatusBar = False

    MsgBox "Refine Search complete!" & vbCrLf & vbCrLf & _
           "Searched within: " & fileCount & " file(s) from previous results" & vbCrLf & _
           "Keywords: " & keywordList & vbCrLf & _
           "Matched: " & (UBound(results) + 1) & " file(s)", vbInformation
End Sub


' ==========================================
' CREATE FILTERED CONTENT PREVIEW SHEET (ON DEMAND)
'
' Called by OpenPreview. Builds one sheet for one file.
' AND logic = ROW-LEVEL: all AND keywords must be on the same row.
' OR  logic = FILE-LEVEL: keyword can appear on any row.
' ==========================================

Function CreateFilteredContentSheet(filePath As String, keywords() As String, _
                                    keywordLogic() As String, keywordCount As Integer) As String
    Dim fso As Object, textStream As Object
    Dim fileContent As String, lines() As String
    Dim filteredLines As Object
    Dim andKws As Object, orKws As Object
    Dim hasAnd As Boolean, hasOr As Boolean
    Dim i As Long, j As Integer
    Dim ws As Worksheet
    Dim sheetName As String, fileName As String
    Dim rowNum As Long

    CreateFilteredContentSheet = ""

    ' Only process readable text files (not binary / Excel)
    If Not IsTextFile(filePath) Or IsExcelFile(filePath) Then Exit Function

    Set fso = CreateObject("Scripting.FileSystemObject")
    Set filteredLines = CreateObject("System.Collections.ArrayList")
    Set andKws = CreateObject("System.Collections.ArrayList")
    Set orKws = CreateObject("System.Collections.ArrayList")

    ' Separate keywords by logic type
    hasAnd = False
    hasOr = False
    For j = 0 To keywordCount - 1
        If keywords(j) <> "" Then
            If keywordLogic(j) = "AND" Then
                andKws.Add keywords(j)
                hasAnd = True
            ElseIf keywordLogic(j) = "OR" Then
                orKws.Add keywords(j)
                hasOr = True
            End If
        End If
    Next j

    On Error Resume Next
    Set textStream = fso.OpenTextFile(filePath, 1, False)
    If Err.Number <> 0 Then GoTo Cleanup
    fileContent = textStream.ReadAll
    textStream.Close
    On Error GoTo 0

    ' Split into lines
    lines = Split(fileContent, vbCrLf)
    If UBound(lines) <= 0 Then lines = Split(fileContent, vbLf)
    If UBound(lines) <= 0 Then lines = Split(fileContent, vbCr)

    ' Filter lines using row-level AND / OR logic
    For i = LBound(lines) To UBound(lines)
        If Trim(lines(i)) <> "" Then
            If RowMatchesKeywords(lines(i), andKws, orKws, hasAnd, hasOr) Then
                filteredLines.Add "Line " & (i + 1) & ": " & lines(i)
            End If
        End If
    Next i

    If filteredLines.Count = 0 Then GoTo Cleanup

    ' Build safe sheet name
    fileName = fso.GetFileName(filePath)
    sheetName = "Preview_" & Left(fileName, 23)
    sheetName = Replace(Replace(Replace(Replace(Replace(Replace(Replace( _
                sheetName, ":", ""), "\", ""), "/", ""), "?", ""), "*", ""), "[", ""), "]", "")
    If Len(sheetName) > 31 Then sheetName = Left(sheetName, 31)

    ' Delete old preview sheet if it exists (refresh)
    On Error Resume Next
    Application.DisplayAlerts = False
    ThisWorkbook.Sheets(sheetName).Delete
    Application.DisplayAlerts = True
    On Error GoTo 0

    Set ws = ThisWorkbook.Sheets.Add(After:=ThisWorkbook.Sheets(ThisWorkbook.Sheets.Count))
    ws.Name = sheetName
    ws.Tab.Color = RGB(192, 0, 0)

    ' ---- Header ----
    ws.Range("A1:B1").Merge
    ws.Range("A1").Value = "Content Preview"
    With ws.Range("A1")
        .Font.Bold = True: .Font.Size = 14
        .Font.Color = RGB(255, 255, 255)
        .Interior.Color = RGB(139, 0, 0)
    End With
    ws.Range("A2").Value = "File:":      ws.Range("A2").Font.Bold = True: ws.Range("B2").Value = fileName
    ws.Range("A3").Value = "Full Path:": ws.Range("A3").Font.Bold = True: ws.Range("B3").Value = filePath

    Dim logicDesc As String: logicDesc = ""
    If hasAnd Then
        logicDesc = "AND (row-level): "
        For j = 0 To andKws.Count - 1
            If j > 0 Then logicDesc = logicDesc & " + "
            logicDesc = logicDesc & andKws(j)
        Next j
    End If
    If hasOr Then
        If logicDesc <> "" Then logicDesc = logicDesc & "  |  "
        logicDesc = logicDesc & "OR (file-level): "
        For j = 0 To orKws.Count - 1
            If j > 0 Then logicDesc = logicDesc & " / "
            logicDesc = logicDesc & orKws(j)
        Next j
    End If
    ws.Range("A4").Value = "Filter Logic:": ws.Range("A4").Font.Bold = True: ws.Range("B4").Value = logicDesc
    ws.Range("A5").Value = "Matching Lines:": ws.Range("A5").Font.Bold = True: ws.Range("B5").Value = filteredLines.Count

    ws.Range("A7").Value = "Matching Rows"
    With ws.Range("A7")
        .Font.Bold = True: .Font.Color = RGB(255, 255, 255)
        .Interior.Color = RGB(192, 0, 0)
    End With

    ' ---- Write filtered lines with keyword highlighting ----
    rowNum = 8
    For i = 0 To filteredLines.Count - 1
        ws.Range("A" & rowNum).Value = filteredLines(i)

        Dim cellText As String
        cellText = ws.Range("A" & rowNum).Value
        Dim kwPos As Long, srchStart As Long

        ' Highlight AND keywords in green
        If hasAnd Then
            For j = 0 To andKws.Count - 1
                srchStart = 1
                Do
                    kwPos = InStr(srchStart, cellText, andKws(j), vbTextCompare)
                    If kwPos > 0 Then
                        ws.Range("A" & rowNum).Characters(kwPos, Len(andKws(j))).Font.Color = RGB(0, 128, 0)
                        ws.Range("A" & rowNum).Characters(kwPos, Len(andKws(j))).Font.Bold = True
                        srchStart = kwPos + Len(andKws(j))
                    End If
                Loop While kwPos > 0 And srchStart <= Len(cellText)
            Next j
        End If

        ' Highlight OR keywords in blue
        If hasOr Then
            For j = 0 To orKws.Count - 1
                srchStart = 1
                Do
                    kwPos = InStr(srchStart, cellText, orKws(j), vbTextCompare)
                    If kwPos > 0 Then
                        ws.Range("A" & rowNum).Characters(kwPos, Len(orKws(j))).Font.Color = RGB(0, 0, 205)
                        ws.Range("A" & rowNum).Characters(kwPos, Len(orKws(j))).Font.Bold = True
                        srchStart = kwPos + Len(orKws(j))
                    End If
                Loop While kwPos > 0 And srchStart <= Len(cellText)
            Next j
        End If

        rowNum = rowNum + 1
        If rowNum > 10000 Then
            ws.Range("A" & rowNum).Value = "... (truncated for performance - more results exist)"
            rowNum = rowNum + 1
            Exit For
        End If
    Next i

    ' ---- Legend ----
    ws.Range("A" & (rowNum + 1)).Value = "Legend:": ws.Range("A" & (rowNum + 1)).Font.Bold = True
    If hasAnd Then
        ws.Range("A" & (rowNum + 2)).Value = "Green = AND keywords (all must appear on the same row)"
        ws.Range("A" & (rowNum + 2)).Font.Color = RGB(0, 128, 0): ws.Range("A" & (rowNum + 2)).Font.Bold = True
    End If
    If hasOr Then
        ws.Range("A" & (rowNum + 3)).Value = "Blue = OR keywords (any can appear on any row)"
        ws.Range("A" & (rowNum + 3)).Font.Color = RGB(0, 0, 205): ws.Range("A" & (rowNum + 3)).Font.Bold = True
    End If

    ' ---- Back link ----
    ws.Range("A" & (rowNum + 5)).Value = "Back to Search Results"
    ws.Hyperlinks.Add Anchor:=ws.Range("A" & (rowNum + 5)), _
        Address:="", SubAddress:="'Search'!A1", TextToDisplay:="Back to Search Results"
    ws.Range("A" & (rowNum + 5)).Font.Bold = True
    ws.Range("A" & (rowNum + 5)).Font.Color = RGB(192, 0, 0)

    ws.Columns("A").ColumnWidth = 150
    ws.Columns("A").WrapText = True
    ws.Columns("B").ColumnWidth = 60

    CreateFilteredContentSheet = sheetName

Cleanup:
    Set fso = Nothing: Set textStream = Nothing
    Set filteredLines = Nothing: Set andKws = Nothing: Set orKws = Nothing
End Function


' ==========================================
' KEYWORD CONFIG STORE / LOAD (for on-demand preview)
' ==========================================

Sub StorePreviewConfig(keywords() As String, keywordLogic() As String, keywordCount As Integer)
    Dim cfgWs As Worksheet
    On Error Resume Next
    Set cfgWs = ThisWorkbook.Sheets("PreviewConfig")
    On Error GoTo 0
    If cfgWs Is Nothing Then
        Set cfgWs = ThisWorkbook.Sheets.Add(After:=ThisWorkbook.Sheets(ThisWorkbook.Sheets.Count))
        cfgWs.Name = "PreviewConfig"
    End If
    cfgWs.Visible = xlSheetVeryHidden
    cfgWs.Cells.ClearContents
    cfgWs.Range("A1").Value = keywordCount
    Dim i As Integer
    For i = 0 To keywordCount - 1
        cfgWs.Range("A" & (2 + i)).Value = keywords(i)
        cfgWs.Range("B" & (2 + i)).Value = keywordLogic(i)
    Next i
End Sub

Sub LoadPreviewConfig(keywords() As String, keywordLogic() As String, keywordCount As Integer)
    Dim cfgWs As Worksheet
    On Error Resume Next
    Set cfgWs = ThisWorkbook.Sheets("PreviewConfig")
    On Error GoTo 0
    keywordCount = 0
    ReDim keywords(0 To MAX_KEYWORDS - 1)
    ReDim keywordLogic(0 To MAX_KEYWORDS - 1)
    If cfgWs Is Nothing Then Exit Sub
    keywordCount = CInt(cfgWs.Range("A1").Value)
    Dim i As Integer
    For i = 0 To keywordCount - 1
        keywords(i) = cfgWs.Range("A" & (2 + i)).Value
        keywordLogic(i) = cfgWs.Range("B" & (2 + i)).Value
    Next i
End Sub


' ==========================================
' CLEAR PREVIEW SHEETS
' ==========================================

Sub ClearFilteredContentSheets()
    Dim ws As Worksheet
    Dim count As Integer
    count = 0
    Application.DisplayAlerts = False
    For Each ws In ThisWorkbook.Sheets
        If Left(ws.Name, 8) = "Preview_" Then
            ws.Delete
            count = count + 1
        End If
    Next ws
    Application.DisplayAlerts = True
    MsgBox "Cleared " & count & " preview sheet(s).", vbInformation
End Sub


' ==========================================
' SHARED UI HELPERS
' ==========================================

Sub ClearResultsArea(outputWs As Worksheet, startCol As String, startRow As Integer)
    ' Clears results data and formatting. Does NOT clear the Results header (rows 1-2).
    Dim clearCol As Integer
    clearCol = ColumnNumber(startCol)
    ' Clear from the column header row downwards (keep rows 1-2 for the Results header)
    outputWs.Range(ColumnLetter(clearCol) & startRow & ":" & _
                   ColumnLetter(clearCol + 3) & "1000").ClearContents
    outputWs.Range(ColumnLetter(clearCol) & startRow & ":" & _
                   ColumnLetter(clearCol + 3) & "1000").ClearFormats
End Sub

Sub WriteResultsColumnHeaders(outputWs As Worksheet, col1 As String, col2 As String, _
                               col3 As String, startRow As Integer, hasPreview As Boolean)
    outputWs.Range(col1 & startRow).Value = "File Name"
    outputWs.Range(col2 & startRow).Value = "File Path"
    If hasPreview And col3 <> "" Then outputWs.Range(col3 & startRow).Value = "Content Preview"

    Dim headerRange As String
    If hasPreview And col3 <> "" Then
        headerRange = col1 & startRow & ":" & col3 & startRow
    Else
        headerRange = col1 & startRow & ":" & col2 & startRow
    End If

    With outputWs.Range(headerRange)
        .Font.Bold = True
        .Font.Size = 10
        .Interior.Color = RGB(217, 217, 217)
        .Borders.LineStyle = xlContinuous
        .HorizontalAlignment = xlCenter
    End With
End Sub

Sub FormatResultsTable(outputWs As Worksheet, col1 As String, col2 As String, _
                       startRow As Integer, lastIndex As Long)
    Dim lastRow As Long
    lastRow = startRow + lastIndex + 1
    outputWs.Range(col1 & startRow & ":" & col2 & lastRow).Borders.LineStyle = xlContinuous
    outputWs.Range(col1 & startRow & ":" & col2 & lastRow).BorderAround _
        LineStyle:=xlContinuous, Weight:=xlMedium, Color:=RGB(165, 165, 165)
    outputWs.Columns(col1).ColumnWidth = 35
    outputWs.Columns(col2).ColumnWidth = 55
End Sub

Sub AddBackButton(outputWs As Worksheet)
    outputWs.Range("D1").Value = "Back to Search"
    outputWs.Hyperlinks.Add Anchor:=outputWs.Range("D1"), _
        Address:="", SubAddress:="'Search'!A1", TextToDisplay:="Back to Search"
    outputWs.Range("D1").Font.Bold = True
    outputWs.Range("D1").Font.Color = RGB(5, 99, 193)
    outputWs.Activate
End Sub


' ==========================================
' DASHBOARD SETUP
