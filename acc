Option Explicit

' ========== CONFIGURATION ==========
' Change this constant to allow more or fewer keywords without code changes
Const MAX_KEYWORDS As Integer = 8

' ========== MAIN SEARCH FUNCTION ==========
Function SearchFilesForKeywords(folderPath As String, keywords() As String, keywordCount As Integer) As Variant
    Dim fso As Object
    Dim folder As Object
    Dim file As Object
    Dim results As Object
    Dim candidateFiles As Object
    Dim fileName As String
    Dim i As Integer
    Dim currentLevel As Integer
    
    ' Create FileSystemObject
    Set fso = CreateObject("Scripting.FileSystemObject")
    Set results = CreateObject("System.Collections.ArrayList")
    Set candidateFiles = CreateObject("System.Collections.ArrayList")
    
    ' Check if folder exists
    If Not fso.FolderExists(folderPath) Then
        SearchFilesForKeywords = Array("Error: Folder not found")
        Exit Function
    End If
    
    Set folder = fso.GetFolder(folderPath)
    
    ' Level 0: Get all files as initial candidates
    For Each file In folder.Files
        candidateFiles.Add file.Path
    Next file
    
    ' Progressive filtering: Apply each keyword as a filter level
    Dim tempFiles As Object
    For currentLevel = 0 To keywordCount - 1
        If candidateFiles.Count = 0 Then Exit For ' No candidates left
        
        Set tempFiles = FilterFilesByKeyword(candidateFiles, keywords(currentLevel), currentLevel + 1, keywordCount)
        Set candidateFiles = tempFiles
    Next currentLevel
    
    ' Convert final candidates to results array
    If candidateFiles.Count > 0 Then
        Dim arr() As Variant
        ReDim arr(0 To candidateFiles.Count - 1)
        Dim j As Long
        For j = 0 To candidateFiles.Count - 1
            Dim filePath As String
            filePath = candidateFiles(j)
            fileName = fso.GetFileName(filePath)
            arr(j) = fileName & "|" & filePath
        Next j
        SearchFilesForKeywords = arr
    Else
        SearchFilesForKeywords = Array("No matches found")
    End If
    
    Set fso = Nothing
    Set folder = Nothing
    Set results = Nothing
    Set candidateFiles = Nothing
End Function

Function FilterFilesByKeyword(candidateFiles As Object, keyword As String, level As Integer, totalLevels As Integer) As Object
    Dim filteredFiles As Object
    Dim i As Long
    Dim filePath As String
    Dim fileName As String
    Dim fso As Object
    Dim matchFound As Boolean
    
    Set filteredFiles = CreateObject("System.Collections.ArrayList")
    Set fso = CreateObject("Scripting.FileSystemObject")
    
    keyword = LCase(Trim(keyword))
    
    ' Skip empty keywords
    If keyword = "" Then
        Set FilterFilesByKeyword = candidateFiles
        Exit Function
    End If
    
    ' Filter candidates by current keyword
    For i = 0 To candidateFiles.Count - 1
        filePath = candidateFiles(i)
        fileName = fso.GetFileName(filePath)
        matchFound = False
        
        ' Check if keyword is in file name
        If InStr(1, LCase(fileName), keyword, vbTextCompare) > 0 Then
            matchFound = True
        End If
        
        ' Check file contents (for text-based files) if not found in name
        If Not matchFound Then
            matchFound = SearchFileContent(filePath, keyword)
        End If
        
        ' Add to filtered list if match found
        If matchFound Then
            filteredFiles.Add filePath
        End If
    Next i
    
    Set FilterFilesByKeyword = filteredFiles
    Set fso = Nothing
End Function

Function SearchFileContent(filePath As String, keyword As String) As Boolean
    Dim fileNum As Integer
    Dim fileContent As String
    Dim textStream As Object
    Dim fso As Object
    
    On Error Resume Next
    
    SearchFileContent = False
    
    ' Only search text-based files (txt, csv, log, xml, json, etc.)
    If IsTextFile(filePath) Then
        Set fso = CreateObject("Scripting.FileSystemObject")
        Set textStream = fso.OpenTextFile(filePath, 1, False) ' 1 = ForReading
        
        If Err.Number = 0 Then
            fileContent = textStream.ReadAll
            textStream.Close
            
            If InStr(1, LCase(fileContent), keyword, vbTextCompare) > 0 Then
                SearchFileContent = True
            End If
        End If
        
        Set textStream = Nothing
        Set fso = Nothing
    End If
    
    On Error GoTo 0
End Function

Function IsTextFile(filePath As String) As Boolean
    Dim ext As String
    ext = LCase(Right(filePath, Len(filePath) - InStrRev(filePath, ".")))
    
    ' Add or remove extensions as needed
    Select Case ext
        Case "txt", "csv", "log", "xml", "json", "ini", "cfg", "md", "html", "htm", "sql", "vbs", "bat"
            IsTextFile = True
        Case Else
            IsTextFile = False
    End Select
End Function

Sub RunSearch()
    Dim folderPath As String
    Dim keywords(0 To MAX_KEYWORDS - 1) As String
    Dim keywordCount As Integer
    Dim results As Variant
    Dim ws As Worksheet
    Dim i As Long
    Dim j As Integer
    Dim resultParts() As String
    Dim fileName As String
    Dim filePath As String
    Dim keywordList As String
    
    Set ws = ThisWorkbook.Sheets("Search")
    
    ' Get folder path
    folderPath = ws.Range("B2").Value
    
    ' Get keywords from worksheet (B3, B4, B5, ... up to MAX_KEYWORDS)
    keywordCount = 0
    keywordList = ""
    
    For i = 0 To MAX_KEYWORDS - 1
        keywords(i) = Trim(ws.Range("B" & (3 + i)).Value)
        If keywords(i) <> "" Then
            keywordCount = keywordCount + 1
            If keywordList <> "" Then keywordList = keywordList & ", "
            keywordList = keywordList & """" & keywords(i) & """"
        End If
    Next i
    
    ' Validation
    If folderPath = "" Then
        MsgBox "Please enter folder path in cell B2", vbExclamation
        Exit Sub
    End If
    
    If keywordCount = 0 Then
        MsgBox "Please enter at least one keyword (cells B3 onwards)", vbExclamation
        Exit Sub
    End If
    
    ' Clear previous results
    Dim outputStartRow As Integer
    On Error Resume Next
    outputStartRow = ws.Range("Z1").Value
    On Error GoTo 0
    
    If outputStartRow = 0 Then outputStartRow = 5 + MAX_KEYWORDS ' Fallback
    
    ws.Range("A" & outputStartRow & ":C1000").ClearContents
    
    ' Run search
    Application.ScreenUpdating = False
    Application.StatusBar = "Searching for " & keywordCount & " keyword(s): " & keywordList & "..."
    
    results = SearchFilesForKeywords(folderPath, keywords, keywordCount)
    
    ' Calculate result row start
    Dim resultRowStart As Integer
    resultRowStart = outputStartRow
    
    ' Output results with headers
    ws.Range("A" & resultRowStart).Value = "File Name"
    ws.Range("B" & resultRowStart).Value = "File Path"
    ws.Range("C" & resultRowStart).Value = "Match Info"
    
    ' Format headers with styling
    ws.Range("A" & resultRowStart & ":C" & resultRowStart).Font.Bold = True
    ws.Range("A" & resultRowStart & ":C" & resultRowStart).Font.Size = 10
    ws.Range("A" & resultRowStart & ":C" & resultRowStart).Interior.Color = RGB(217, 217, 217)
    ws.Range("A" & resultRowStart & ":C" & resultRowStart).Font.Color = RGB(0, 0, 0)
    ws.Range("A" & resultRowStart & ":C" & resultRowStart).Borders.LineStyle = xlContinuous
    ws.Range("A" & resultRowStart & ":C" & resultRowStart).HorizontalAlignment = xlCenter
    
    ' Check if results contain error or no matches
    If UBound(results) = 0 And InStr(1, results(0), "Error:") > 0 Then
        ws.Range("A" & (resultRowStart + 1)).Value = results(0)
        Application.ScreenUpdating = True
        Application.StatusBar = False
        MsgBox results(0), vbExclamation
        Exit Sub
    ElseIf UBound(results) = 0 And results(0) = "No matches found" Then
        ws.Range("A" & (resultRowStart + 1)).Value = results(0)
        Application.ScreenUpdating = True
        Application.StatusBar = False
        MsgBox "No matches found for all " & keywordCount & " keyword(s)", vbInformation
        Exit Sub
    End If
    
    ' Output results with hyperlinks
    For i = LBound(results) To UBound(results)
        resultParts = Split(results(i), "|")
        fileName = resultParts(0)
        filePath = resultParts(1)
        
        ' Add file name as clickable hyperlink
        ws.Hyperlinks.Add Anchor:=ws.Range("A" & (resultRowStart + 1 + i)), _
                          Address:=filePath, _
                          TextToDisplay:=fileName
        ws.Range("A" & (resultRowStart + 1 + i)).Font.Color = RGB(5, 99, 193)
        ws.Range("A" & (resultRowStart + 1 + i)).Font.Underline = xlUnderlineStyleSingle
        
        ' Add full path in column B
        ws.Range("B" & (resultRowStart + 1 + i)).Value = filePath
        ws.Range("B" & (resultRowStart + 1 + i)).Font.Size = 9
        
        ' Add match information
        ws.Range("C" & (resultRowStart + 1 + i)).Value = "✓ All keywords"
        ws.Range("C" & (resultRowStart + 1 + i)).Font.Color = RGB(0, 128, 0)
        ws.Range("C" & (resultRowStart + 1 + i)).HorizontalAlignment = xlCenter
        
        ' Add alternating row colors
        If i Mod 2 = 0 Then
            ws.Range("A" & (resultRowStart + 1 + i) & ":C" & (resultRowStart + 1 + i)).Interior.Color = RGB(242, 242, 242)
        End If
    Next i
    
    ' Add borders to results
    Dim lastResultRow As Integer
    lastResultRow = resultRowStart + UBound(results) + 1
    ws.Range("A" & resultRowStart & ":C" & lastResultRow).Borders.LineStyle = xlContinuous
    ws.Range("A" & resultRowStart & ":C" & lastResultRow).BorderAround _
        LineStyle:=xlContinuous, Weight:=xlMedium, Color:=RGB(165, 165, 165)
    
    ' Auto-fit columns
    ws.Columns("A:C").AutoFit
    
    Application.ScreenUpdating = True
    Application.StatusBar = False
    
    MsgBox "Search complete!" & vbCrLf & vbCrLf & _
           "Keywords used: " & keywordList & vbCrLf & _
           "Files found: " & (UBound(results) + 1) & vbCrLf & vbCrLf & _
           "Click on file names to open them.", vbInformation
End Sub

