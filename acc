Sub TestFileList()
    Dim fso As Object
    Dim folder As Object
    Dim file As Object
    Dim folderPath As String
    Dim i As Long
    
    folderPath = ActiveSheet.Range("B2").Value
    Set fso = CreateObject("Scripting.FileSystemObject")
    Set folder = fso.GetFolder(folderPath)
    
    i = 7
    For Each file In folder.Files
        ActiveSheet.Range("A" & i).Value = file.Name
        ActiveSheet.Range("B" & i).Value = file.Size & " bytes"
        ActiveSheet.Range("C" & i).Value = file.Type
        i = i + 1
    Next file
    
    MsgBox "Found " & folder.Files.Count & " files"
End Sub





