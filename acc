' ==========================================
' USER-FACING MACRO 3: SEARCH WITH CONTENT PREVIEW
'
' AND logic = all AND keywords must appear on the SAME row.
' OR  logic = keyword can appear on any row.
' Preview links use Form Control Buttons (OnAction = "OpenPreview").
' ==========================================

Sub RunSearchWithContentPreview()
    Dim folderPath As String
    Dim keywords(0 To MAX_KEYWORDS - 1) As String
    Dim keywordLogic(0 To MAX_KEYWORDS - 1) As String
    Dim keywordCount As Integer
    Dim results As Variant
    Dim ws As Worksheet, outputWs As Worksheet
    Dim i As Long
    Dim resultParts() As String
    Dim fileName As String, filePath As String
    Dim keywordList As String
    Dim startCol As String, startRow As Integer
    Dim col1 As String, col2 As String, col3 As String
    Dim startDate As Date, endDate As Date
    Dim useDateFilter As Boolean

    g_AbortRequested = False

    Set ws         = ThisWorkbook.Sheets("Search")
    folderPath     = Trim(ws.Range("B4").Value)
    startCol       = GetOutputStartColumn()
    startRow       = GetOutputStartRow()
    col1           = ColumnLetter(ColumnNumber(startCol))
    col2           = ColumnLetter(ColumnNumber(startCol) + 1)
    col3           = ColumnLetter(ColumnNumber(startCol) + 2)

    Call ReadDateRange(folderPath, startDate, endDate, useDateFilter)
    If Err.Number <> 0 Then Exit Sub

    keywordCount = 0
    keywordList  = ""
    For i = 0 To MAX_KEYWORDS - 1
        keywords(i)    = Trim(ws.Range("B" & (9 + i)).Value)
        keywordLogic(i) = UCase(Trim(ws.Range("C" & (9 + i)).Value))
        If keywordLogic(i) = "" Then keywordLogic(i) = "AND"
        If keywordLogic(i) <> "AND" And keywordLogic(i) <> "OR" Then
            MsgBox "Invalid logic in row " & (9 + i) & ". Use AND or OR only.", vbExclamation
            Exit Sub
        End If
        If keywords(i) <> "" Then
            keywordCount = keywordCount + 1
            If keywordList <> "" Then keywordList = keywordList & ", "
            keywordList = keywordList & """" & keywords(i) & """ (" & keywordLogic(i) & ")"
        End If
    Next i

    If folderPath = "" Then MsgBox "Please enter a folder path in cell B4.", vbExclamation: Exit Sub
    If keywordCount = 0 Then MsgBox "Please enter at least one keyword (cells B9 onwards).", vbExclamation: Exit Sub

    Set outputWs = GetOutputWorksheet()
    Call ClearResultsArea(outputWs, startCol, startRow)

    ' Remove leftover preview buttons from previous run
    Dim btn As Object
    For Each btn In outputWs.Buttons
        If InStr(1, btn.Caption, "Preview") > 0 Then btn.Delete
    Next btn

    Application.ScreenUpdating = False
    Application.StatusBar = "Searching for " & keywordCount & " keyword(s)..."

    results = SearchFilesForKeywords(folderPath, keywords, keywordCount, True, _
                                      startDate, endDate, useDateFilter)

    If UBound(results) = 0 Then
        If results(0) = "Aborted" Then
            Call HandleAbort(outputWs, startCol, startRow)
            Exit Sub
        End If
    End If

    Call WriteResultsSectionHeader(outputWs, startCol, True)
    Call WriteResultsColumnHeaders(outputWs, col1, col2, col3, startRow, True)

    If UBound(results) = 0 Then
        If InStr(1, results(0), "Error:") > 0 Or results(0) = "No matches found" Then
            outputWs.Range(col1 & (startRow + 1)).Value = results(0)
            Application.ScreenUpdating = True
            Application.StatusBar = False
            MsgBox results(0), IIf(InStr(results(0), "Error") > 0, vbExclamation, vbInformation)
            Exit Sub
        End If
    End If

    Call StorePreviewConfig(keywords, keywordLogic, keywordCount)
    outputWs.Columns(HELPER_COL).Hidden = False

    For i = LBound(results) To UBound(results)
        resultParts = Split(results(i), "|")
        fileName    = resultParts(0)
        filePath    = resultParts(1)

        Dim dataRow As Long
        dataRow = startRow + 1 + i

        ' File name hyperlink (opens file directly)
        outputWs.Hyperlinks.Add Anchor:=outputWs.Range(col1 & dataRow), _
            Address:=filePath, TextToDisplay:=fileName
        With outputWs.Range(col1 & dataRow)
            .Font.Color     = RGB(5, 99, 193)
            .Font.Underline = xlUnderlineStyleSingle
        End With

        ' File path column
        outputWs.Range(col2 & dataRow).Value     = filePath
        outputWs.Range(col2 & dataRow).Font.Size = 9

        ' Store path in helper column (read by OpenPreview)
        outputWs.Range(HELPER_COL & dataRow).Value = filePath

        ' Preview button (Form Control - OnAction fires macro reliably)
        If IsTextFile(filePath) And Not IsExcelFile(filePath) Then
            Dim cellRef As Range
            Set cellRef = outputWs.Range(col3 & dataRow)

            Dim previewBtn As Button
            Set previewBtn = outputWs.Buttons.Add( _
                cellRef.Left, cellRef.Top, cellRef.Width, cellRef.Height)
            previewBtn.Caption  = "Click to Preview"
            previewBtn.OnAction = "OpenPreview"
            With previewBtn.Font
                .Color = RGB(192, 0, 0)
                .Bold  = True
                .Size  = 9
            End With
            Set previewBtn = Nothing
            Set cellRef    = Nothing
        Else
            outputWs.Range(col3 & dataRow).Value = "N/A (Binary)"
            With outputWs.Range(col3 & dataRow)
                .Font.Color        = RGB(128, 128, 128)
                .Font.Italic       = True
                .HorizontalAlignment = xlCenter
            End With
        End If

        If i Mod 2 = 0 Then
            outputWs.Range(col1 & dataRow & ":" & col3 & dataRow).Interior.Color = RGB(242, 242, 242)
        End If
    Next i

    outputWs.Columns(HELPER_COL).Hidden = True

    Dim lastRow As Long
    lastRow = startRow + UBound(results) + 1
    outputWs.Range(col1 & startRow & ":" & col3 & lastRow).Borders.LineStyle = xlContinuous
    outputWs.Range(col1 & startRow & ":" & col3 & lastRow).BorderAround _
        LineStyle:=xlContinuous, Weight:=xlMedium, Color:=RGB(165, 165, 165)
    outputWs.Columns(col1).ColumnWidth = 30
    outputWs.Columns(col2).ColumnWidth = 50
    outputWs.Columns(col3).ColumnWidth = 20

    If UCase(RESULT_DISPLAY_MODE) = "SEPARATE_SHEET" Then Call AddBackButton(outputWs)

    Application.ScreenUpdating = True
    Application.StatusBar = False

    MsgBox "Search complete!" & vbCrLf & vbCrLf & _
           "Keywords: " & keywordList & vbCrLf & _
           "Files found: " & (UBound(results) + 1) & vbCrLf & vbCrLf & _
           "Click 'Click to Preview' to open a row-filtered preview for that file.", vbInformation
End Sub


' ==========================================
' ON-DEMAND PREVIEW ENTRY POINT
'
' Called by the Form Control Button in the Preview column.
' Uses Application.Caller to identify which button was clicked,
' then reads HELPER_COL on that row to get the file path.
' ==========================================

Sub OpenPreview()
    Dim outputWs As Worksheet
    Dim targetRow As Long
    Dim filePath As String
    Dim keywords(0 To MAX_KEYWORDS - 1) As String
    Dim keywordLogic(0 To MAX_KEYWORDS - 1) As String
    Dim keywordCount As Integer
    Dim sheetName As String

    Set outputWs = GetOutputWorksheet()

    ' Identify the row from the calling button's vertical position
    Dim callerName As String
    callerName = Application.Caller

    Dim callerBtn As Button
    Set callerBtn = outputWs.Buttons(callerName)

    Dim btnMidY As Double
    btnMidY = callerBtn.Top + callerBtn.Height / 2

    Dim r As Long
    Dim cumHeight As Double
    cumHeight = 0
    For r = 1 To outputWs.Rows.Count
        cumHeight = cumHeight + outputWs.Rows(r).Height
        If cumHeight >= btnMidY Then
            targetRow = r
            Exit For
        End If
    Next r

    outputWs.Columns(HELPER_COL).Hidden = False
    filePath = Trim(outputWs.Range(HELPER_COL & targetRow).Value)
    outputWs.Columns(HELPER_COL).Hidden = True

    Set callerBtn = Nothing

    If filePath = "" Then
        MsgBox "Could not determine the file path for this row." & vbCrLf & _
               "Please run the search again.", vbExclamation
        Exit Sub
    End If

    Call LoadPreviewConfig(keywords, keywordLogic, keywordCount)

    If keywordCount = 0 Then
        MsgBox "Keyword configuration not found." & vbCrLf & _
               "Please run 'Search: With Preview' again.", vbExclamation
        Exit Sub
    End If

    Application.StatusBar = "Building preview for " & filePath & "..."

    sheetName = CreateFilteredContentSheet(filePath, keywords, keywordLogic, keywordCount)

    Application.StatusBar = False

    If sheetName <> "" Then
        ThisWorkbook.Sheets(sheetName).Activate
    Else
        MsgBox "Preview could not be generated for this file." & vbCrLf & _
               "It may be a binary or unreadable file type.", vbInformation
    End If
End Sub


' ==========================================
' USER-FACING MACRO 4: REFINE SEARCH
'
' Reads file paths from HELPER_COL (populated by any previous search).
' Re-filters that subset with the current keywords (AND logic, content scan).
' Date filter is NOT re-applied - the prior result set is already filtered.
' ==========================================

Sub RunRefineSearch()
    Dim ws As Worksheet, outputWs As Worksheet
    Dim keywords(0 To MAX_KEYWORDS - 1) As String
    Dim keywordCount As Integer, keywordList As String
    Dim startCol As String, startRow As Integer
    Dim col1 As String, col2 As String
    Dim results As Variant
    Dim i As Long, resultParts() As String
    Dim fileName As String, filePath As String

    g_AbortRequested = False

    Set ws         = ThisWorkbook.Sheets("Search")
    Set outputWs   = GetOutputWorksheet()
    startCol       = GetOutputStartColumn()
    startRow       = GetOutputStartRow()
    col1           = ColumnLetter(ColumnNumber(startCol))
    col2           = ColumnLetter(ColumnNumber(startCol) + 1)

    ' Read all stored paths from HELPER_COL using End(xlUp) - skip blanks
    outputWs.Columns(HELPER_COL).Hidden = False

    Dim firstResultPaths() As String
    Dim fileCount As Integer
    fileCount = 0

    Dim lastJRow As Long
    lastJRow = outputWs.Cells(outputWs.Rows.Count, HELPER_COL).End(xlUp).Row

    Dim checkRow As Long
    Dim cellVal As String
    For checkRow = startRow + 1 To lastJRow
        cellVal = Trim(outputWs.Range(HELPER_COL & checkRow).Value)
        If cellVal <> "" Then
            ReDim Preserve firstResultPaths(fileCount)
            firstResultPaths(fileCount) = cellVal
            fileCount = fileCount + 1
        End If
    Next checkRow

    outputWs.Columns(HELPER_COL).Hidden = True

    If fileCount = 0 Then
        MsgBox "No previous search results found." & vbCrLf & _
               "Please run any search first, then use Refine Results.", vbExclamation
        Exit Sub
    End If

    ' Collect new keywords
    keywordCount = 0
    keywordList  = ""
    For i = 0 To MAX_KEYWORDS - 1
        keywords(i) = Trim(ws.Range("B" & (9 + i)).Value)
        If keywords(i) <> "" Then
            keywordCount = keywordCount + 1
            If keywordList <> "" Then keywordList = keywordList & ", "
            keywordList = keywordList & """" & keywords(i) & """"
        End If
    Next i

    If keywordCount = 0 Then
        MsgBox "Please enter at least one keyword (cells B9 onwards).", vbExclamation
        Exit Sub
    End If

    ' Clear visible results only (preserve HELPER_COL until new results are ready)
    outputWs.Range(col1 & startRow & ":" & col2 & "1000").ClearContents
    outputWs.Range(col1 & startRow & ":" & col2 & "1000").ClearFormats

    Application.ScreenUpdating = False
    Application.StatusBar = "Refining search within " & fileCount & " file(s)..."

    results = SearchFilesInList(firstResultPaths, fileCount, keywords, keywordCount, True)

    If UBound(results) = 0 Then
        If results(0) = "Aborted" Then
            Call HandleAbort(outputWs, startCol, startRow)
            Exit Sub
        End If
    End If

    Call WriteResultsSectionHeader(outputWs, startCol, True)
    Call WriteResultsColumnHeaders(outputWs, col1, col2, "", startRow, False)

    If UBound(results) = 0 Then
        If InStr(1, results(0), "Error:") > 0 Or results(0) = "No matches found" Then
            outputWs.Range(col1 & (startRow + 1)).Value = results(0)
            Application.ScreenUpdating = True
            Application.StatusBar = False
            MsgBox results(0), IIf(InStr(results(0), "Error") > 0, vbExclamation, vbInformation)
            Exit Sub
        End If
    End If

    ' Now safe to overwrite HELPER_COL with the refined result paths
    outputWs.Columns(HELPER_COL).Hidden = False
    outputWs.Range(HELPER_COL & startRow & ":" & HELPER_COL & "1000").ClearContents

    For i = LBound(results) To UBound(results)
        resultParts = Split(results(i), "|")
        fileName    = resultParts(0)
        filePath    = resultParts(1)

        outputWs.Hyperlinks.Add Anchor:=outputWs.Range(col1 & (startRow + 1 + i)), _
            Address:=filePath, TextToDisplay:=fileName
        With outputWs.Range(col1 & (startRow + 1 + i))
            .Font.Color     = RGB(5, 99, 193)
            .Font.Underline = xlUnderlineStyleSingle
        End With

        outputWs.Range(col2 & (startRow + 1 + i)).Value     = filePath
        outputWs.Range(col2 & (startRow + 1 + i)).Font.Size = 9

        ' Persist refined paths so user can refine again
        outputWs.Range(HELPER_COL & (startRow + 1 + i)).Value = filePath

        If i Mod 2 = 0 Then
            outputWs.Range(col1 & (startRow + 1 + i) & ":" & _
                           col2 & (startRow + 1 + i)).Interior.Color = RGB(255, 240, 240)
        End If
    Next i

    outputWs.Columns(HELPER_COL).Hidden = True

    Call FormatResultsTable(outputWs, col1, col2, startRow, UBound(results))
    If UCase(RESULT_DISPLAY_MODE) = "SEPARATE_SHEET" Then Call AddBackButton(outputWs)

    Application.ScreenUpdating = True
    Application.StatusBar = False

    MsgBox "Refine Search complete!" & vbCrLf & vbCrLf & _
           "Searched within: " & fileCount & " file(s) from previous results" & vbCrLf & _
           "Keywords: " & keywordList & vbCrLf & _
           "Matched: " & (UBound(results) + 1) & " file(s)", vbInformation
End Sub


' ==========================================
' CREATE FILTERED CONTENT PREVIEW SHEET (ON DEMAND)
'
' AND logic = ROW-LEVEL: all AND keywords must be on the same row.
' OR  logic = any row containing at least one OR keyword is included.
' ==========================================

Function CreateFilteredContentSheet(filePath As String, keywords() As String, _
                                     keywordLogic() As String, _
                                     keywordCount As Integer) As String
    Dim fso As Object, textStream As Object
    Dim fileContent As String, lines() As String
    Dim filteredLines As Object
    Dim andKws As Object, orKws As Object
    Dim hasAnd As Boolean, hasOr As Boolean
    Dim i As Long, j As Integer
    Dim ws As Worksheet
    Dim sheetName As String, fileName As String
    Dim rowNum As Long

    CreateFilteredContentSheet = ""

    ' Only process readable text files (not binary / Excel)
    If Not IsTextFile(filePath) Or IsExcelFile(filePath) Then Exit Function

    Set fso           = CreateObject("Scripting.FileSystemObject")
    Set filteredLines = CreateObject("System.Collections.ArrayList")
    Set andKws        = CreateObject("System.Collections.ArrayList")
    Set orKws         = CreateObject("System.Collections.ArrayList")

    ' Separate keywords by logic type
    hasAnd = False
    hasOr  = False
    For j = 0 To keywordCount - 1
        If keywords(j) <> "" Then
            If keywordLogic(j) = "AND" Then
                andKws.Add keywords(j)
                hasAnd = True
            ElseIf keywordLogic(j) = "OR" Then
                orKws.Add keywords(j)
                hasOr = True
            End If
        End If
    Next j

    On Error Resume Next
    Set textStream = fso.OpenTextFile(filePath, 1, False)
    If Err.Number <> 0 Then GoTo Cleanup
    fileContent = textStream.ReadAll
    textStream.Close
    On Error GoTo 0

    ' Split into lines - handle all common line endings
    lines = Split(fileContent, vbCrLf)
    If UBound(lines) <= 0 Then lines = Split(fileContent, vbLf)
    If UBound(lines) <= 0 Then lines = Split(fileContent, vbCr)

    ' Filter lines using row-level AND / OR logic
    For i = LBound(lines) To UBound(lines)
        If Trim(lines(i)) <> "" Then
            If RowMatchesKeywords(lines(i), andKws, orKws, hasAnd, hasOr) Then
                filteredLines.Add "Line " & (i + 1) & ": " & lines(i)
            End If
        End If
    Next i

    If filteredLines.Count = 0 Then GoTo Cleanup

    ' Build safe sheet name
    fileName  = fso.GetFileName(filePath)
    sheetName = "Preview_" & Left(fileName, 23)
    sheetName = Replace(Replace(Replace(Replace(Replace(Replace(Replace( _
                sheetName, ":", ""), "\", ""), "/", ""), "?", ""), "*", ""), "[", ""), "]", "")
    If Len(sheetName) > 31 Then sheetName = Left(sheetName, 31)

    ' Delete old preview sheet if it exists (refresh)
    On Error Resume Next
    Application.DisplayAlerts = False
    ThisWorkbook.Sheets(sheetName).Delete
    Application.DisplayAlerts = True
    On Error GoTo 0

    Set ws         = ThisWorkbook.Sheets.Add(After:=ThisWorkbook.Sheets(ThisWorkbook.Sheets.Count))
    ws.Name        = sheetName
    ws.Tab.Color   = RGB(192, 0, 0)

    ' ---- Header ----
    ws.Range("A1:B1").Merge
    ws.Range("A1").Value = "Content Preview"
    With ws.Range("A1")
        .Font.Bold    = True
        .Font.Size    = 14
        .Font.Color   = RGB(255, 255, 255)
        .Interior.Color = RGB(139, 0, 0)
    End With
    ws.Range("A2").Value = "File:":      ws.Range("A2").Font.Bold = True
    ws.Range("B2").Value = fileName
    ws.Range("A3").Value = "Full Path:": ws.Range("A3").Font.Bold = True
    ws.Range("B3").Value = filePath

    Dim logicDesc As String
    logicDesc = ""
    If hasAnd Then
        logicDesc = "AND (row-level): "
        For j = 0 To andKws.Count - 1
            If j > 0 Then logicDesc = logicDesc & " + "
            logicDesc = logicDesc & andKws(j)
        Next j
    End If
    If hasOr Then
        If logicDesc <> "" Then logicDesc = logicDesc & "  |  "
        logicDesc = logicDesc & "OR (file-level): "
        For j = 0 To orKws.Count - 1
            If j > 0 Then logicDesc = logicDesc & " / "
            logicDesc = logicDesc & orKws(j)
        Next j
    End If
    ws.Range("A4").Value = "Filter Logic:":   ws.Range("A4").Font.Bold = True
    ws.Range("B4").Value = logicDesc
    ws.Range("A5").Value = "Matching Lines:": ws.Range("A5").Font.Bold = True
    ws.Range("B5").Value = filteredLines.Count

    ws.Range("A7").Value = "Matching Rows"
    With ws.Range("A7")
        .Font.Bold      = True
        .Font.Color     = RGB(255, 255, 255)
        .Interior.Color = RGB(192, 0, 0)
    End With

    ' ---- Write filtered lines with keyword highlighting ----
    rowNum = 8
    For i = 0 To filteredLines.Count - 1
        ws.Range("A" & rowNum).Value = filteredLines(i)

        Dim cellText As String
        cellText = ws.Range("A" & rowNum).Value
        Dim kwPos As Long, srchStart As Long

        ' Highlight AND keywords in green
        If hasAnd Then
            For j = 0 To andKws.Count - 1
                srchStart = 1
                Do
                    kwPos = InStr(srchStart, cellText, andKws(j), vbTextCompare)
                    If kwPos > 0 Then
                        ws.Range("A" & rowNum).Characters(kwPos, Len(andKws(j))).Font.Color = RGB(0, 128, 0)
                        ws.Range("A" & rowNum).Characters(kwPos, Len(andKws(j))).Font.Bold  = True
                        srchStart = kwPos + Len(andKws(j))
                    End If
                Loop While kwPos > 0 And srchStart <= Len(cellText)
            Next j
        End If

        ' Highlight OR keywords in blue
        If hasOr Then
            For j = 0 To orKws.Count - 1
                srchStart = 1
                Do
                    kwPos = InStr(srchStart, cellText, orKws(j), vbTextCompare)
                    If kwPos > 0 Then
                        ws.Range("A" & rowNum).Characters(kwPos, Len(orKws(j))).Font.Color = RGB(0, 0, 205)
                        ws.Range("A" & rowNum).Characters(kwPos, Len(orKws(j))).Font.Bold  = True
                        srchStart = kwPos + Len(orKws(j))
                    End If
                Loop While kwPos > 0 And srchStart <= Len(cellText)
            Next j
        End If

        rowNum = rowNum + 1
        If rowNum > 10000 Then
            ws.Range("A" & rowNum).Value = "... (truncated - more results exist)"
            rowNum = rowNum + 1
            Exit For
        End If
    Next i

    ' ---- Legend ----
    ws.Range("A" & (rowNum + 1)).Value = "Legend:"
    ws.Range("A" & (rowNum + 1)).Font.Bold = True
    If hasAnd Then
        ws.Range("A" & (rowNum + 2)).Value      = "Green = AND keywords (all must appear on the same row)"
        ws.Range("A" & (rowNum + 2)).Font.Color = RGB(0, 128, 0)
        ws.Range("A" & (rowNum + 2)).Font.Bold  = True
    End If
    If hasOr Then
        ws.Range("A" & (rowNum + 3)).Value      = "Blue = OR keywords (any can appear on any row)"
        ws.Range("A" & (rowNum + 3)).Font.Color = RGB(0, 0, 205)
        ws.Range("A" & (rowNum + 3)).Font.Bold  = True
    End If

    ' ---- Back link ----
    ws.Range("A" & (rowNum + 5)).Value = "Back to Search Results"
    ws.Hyperlinks.Add Anchor:=ws.Range("A" & (rowNum + 5)), _
        Address:="", SubAddress:="'Search'!A1", TextToDisplay:="Back to Search Results"
    ws.Range("A" & (rowNum + 5)).Font.Bold  = True
    ws.Range("A" & (rowNum + 5)).Font.Color = RGB(192, 0, 0)

    ws.Columns("A").ColumnWidth = 150
    ws.Columns("A").WrapText    = True
    ws.Columns("B").ColumnWidth = 60

    CreateFilteredContentSheet = sheetName

Cleanup:
    Set fso           = Nothing
    Set textStream    = Nothing
    Set filteredLines = Nothing
    Set andKws        = Nothing
    Set orKws         = Nothing
End Function


' ==========================================
' KEYWORD CONFIG STORE / LOAD (for on-demand preview)
' ==========================================

Sub StorePreviewConfig(keywords() As String, keywordLogic() As String, _
                        keywordCount As Integer)
    Dim cfgWs As Worksheet
    On Error Resume Next
    Set cfgWs = ThisWorkbook.Sheets("PreviewConfig")
    On Error GoTo 0
    If cfgWs Is Nothing Then
        Set cfgWs      = ThisWorkbook.Sheets.Add(After:=ThisWorkbook.Sheets(ThisWorkbook.Sheets.Count))
        cfgWs.Name     = "PreviewConfig"
    End If
    cfgWs.Visible = xlSheetVeryHidden
    cfgWs.Cells.ClearContents
    cfgWs.Range("A1").Value = keywordCount
    Dim i As Integer
    For i = 0 To keywordCount - 1
        cfgWs.Range("A" & (2 + i)).Value = keywords(i)
        cfgWs.Range("B" & (2 + i)).Value = keywordLogic(i)
    Next i
End Sub

Sub LoadPreviewConfig(keywords() As String, keywordLogic() As String, _
                       keywordCount As Integer)
    Dim cfgWs As Worksheet
    On Error Resume Next
    Set cfgWs = ThisWorkbook.Sheets("PreviewConfig")
    On Error GoTo 0
    keywordCount = 0
    ReDim keywords(0 To MAX_KEYWORDS - 1)
    ReDim keywordLogic(0 To MAX_KEYWORDS - 1)
    If cfgWs Is Nothing Then Exit Sub
    keywordCount = CInt(cfgWs.Range("A1").Value)
    Dim i As Integer
    For i = 0 To keywordCount - 1
        keywords(i)    = cfgWs.Range("A" & (2 + i)).Value
        keywordLogic(i) = cfgWs.Range("B" & (2 + i)).Value
    Next i
End Sub


' ==========================================
' CLEAR PREVIEW SHEETS
' ==========================================

Sub ClearFilteredContentSheets()
    Dim ws As Worksheet
    Dim count As Integer
    count = 0
    Application.DisplayAlerts = False
    For Each ws In ThisWorkbook.Sheets
        If Left(ws.Name, 8) = "Preview_" Then
            ws.Delete
            count = count + 1
        End If
    Next ws
    Application.DisplayAlerts = True
    MsgBox "Cleared " & count & " preview sheet(s).", vbInformation
End Sub


' ==========================================
' SHARED UI HELPERS
' ==========================================

Sub ClearResultsArea(outputWs As Worksheet, startCol As String, startRow As Integer)
    ' Clears results data and formatting. Does NOT clear the Results header (rows 1-2).
    Dim clearCol As Integer
    clearCol = ColumnNumber(startCol)
    outputWs.Range(ColumnLetter(clearCol) & startRow & ":" & _
                   ColumnLetter(clearCol + 3) & "1000").ClearContents
    outputWs.Range(ColumnLetter(clearCol) & startRow & ":" & _
                   ColumnLetter(clearCol + 3) & "1000").ClearFormats
    ' Remove any Form Control preview buttons left from a previous run
    Dim btn As Object
    For Each btn In outputWs.Buttons
        If InStr(1, btn.Caption, "Preview") > 0 Then btn.Delete
    Next btn
End Sub

Sub WriteResultsColumnHeaders(outputWs As Worksheet, col1 As String, col2 As String, _
                               col3 As String, startRow As Integer, hasPreview As Boolean)
    outputWs.Range(col1 & startRow).Value = "File Name"
    outputWs.Range(col2 & startRow).Value = "File Path"
    If hasPreview And col3 <> "" Then outputWs.Range(col3 & startRow).Value = "Content Preview"

    Dim headerRange As String
    If hasPreview And col3 <> "" Then
        headerRange = col1 & startRow & ":" & col3 & startRow
    Else
        headerRange = col1 & startRow & ":" & col2 & startRow
    End If

    With outputWs.Range(headerRange)
        .Font.Bold           = True
        .Font.Size           = 10
        .Interior.Color      = RGB(217, 217, 217)
        .Borders.LineStyle   = xlContinuous
        .HorizontalAlignment = xlCenter
    End With
End Sub

Sub FormatResultsTable(outputWs As Worksheet, col1 As String, col2 As String, _
                        startRow As Integer, lastIndex As Long)
    Dim lastRow As Long
    lastRow = startRow + lastIndex + 1
    outputWs.Range(col1 & startRow & ":" & col2 & lastRow).Borders.LineStyle = xlContinuous
    outputWs.Range(col1 & startRow & ":" & col2 & lastRow).BorderAround _
        LineStyle:=xlContinuous, Weight:=xlMedium, Color:=RGB(165, 165, 165)
    outputWs.Columns(col1).ColumnWidth = 35
    outputWs.Columns(col2).ColumnWidth = 55
End Sub

Sub AddBackButton(outputWs As Worksheet)
    outputWs.Range("D1").Value = "Back to Search"
    outputWs.Hyperlinks.Add Anchor:=outputWs.Range("D1"), _
        Address:="", SubAddress:="'Search'!A1", TextToDisplay:="Back to Search"
    outputWs.Range("D1").Font.Bold  = True
    outputWs.Range("D1").Font.Color = RGB(5, 99, 193)
    outputWs.Activate
End Sub


' ==========================================
' DASHBOARD SETUP
'
' Layout change vs previous version:
'   Row 3  = "FOLDER LOCATION" section header    (unchanged)
'   Row 4  = Folder Path input                   (unchanged, B4)
'   Row 5  = "DATE RANGE FILTER" section header  (NEW)
'   Row 6  = Start Date input                    (NEW, B6)
'   Row 7  = End Date input                      (NEW, B7)
'   Row 9  = "SEARCH PARAMETERS" section header  (shifted down by 2)
'   Row 10 = Keyword column headers              (shifted down by 2)
'   Rows 11-20 = Keyword input rows              (shifted down by 2, B9:C18)
'
' All keyword reads in the four search macros reference B9 onwards
' (previously B8) to match this shifted layout.
' ==========================================

Sub SetupSearchSheet()
    Dim ws As Worksheet
    Dim i As Integer
    Dim btn As Button

    On Error Resume Next
    Set ws = ThisWorkbook.Sheets("Search")
    On Error GoTo 0

    If ws Is Nothing Then
        Set ws      = ThisWorkbook.Sheets.Add
        ws.Name     = "Search"
    End If

    Application.ScreenUpdating = False

    ws.Cells.Clear
    ws.Buttons.Delete
    ws.Tab.Color = RGB(192, 0, 0)

    ' ---- SECTION 1: Main Header (Row 1) ----
    ws.Range("A1:D1").Merge
    ws.Range("A1").Value = "UNIVERSAL FILE & CONTENT FINDER"
    With ws.Range("A1")
        .Font.Bold    = True
        .Font.Size    = 16
        .Font.Color   = RGB(255, 255, 255)
        .Interior.Color = RGB(139, 0, 0)
        .HorizontalAlignment = xlCenter
        .VerticalAlignment   = xlCenter
        .RowHeight    = 35
    End With

    ' ---- SECTION 2: Folder Path (Rows 3-4) ----
    Dim folderSection As Integer: folderSection = 3
    ws.Range("A" & folderSection & ":D" & folderSection).Merge
    ws.Range("A" & folderSection).Value = "FOLDER LOCATION"
    With ws.Range("A" & folderSection)
        .Font.Bold    = True
        .Font.Size    = 11
        .Font.Color   = RGB(255, 255, 255)
        .Interior.Color = RGB(192, 48, 48)
        .HorizontalAlignment = xlLeft
        .VerticalAlignment   = xlCenter
        .RowHeight    = 25
    End With
    ws.Range("A4").Value = "Folder Path:": ws.Range("A4").Font.Bold = True
    ws.Range("C4:D4").Merge
    ws.Range("B4").Value = "C:\Your\Folder\Path"
    With ws.Range("B4")
        .Font.Italic  = True
        .Font.Color   = RGB(128, 128, 128)
        .Interior.Color = RGB(255, 245, 245)
        .Borders.LineStyle = xlContinuous
        .Borders.Color     = RGB(192, 128, 128)
    End With
    ws.Range("A3:B4").BorderAround LineStyle:=xlContinuous, Weight:=xlMedium, _
        Color:=RGB(139, 0, 0)

    ' ---- SECTION 3: Date Range Filter (Rows 5-7) ----  NEW
    ws.Range("A5:D5").Merge
    ws.Range("A5").Value = "DATE RANGE FILTER  (optional - leave blank to search all files)"
    With ws.Range("A5")
        .Font.Bold    = True
        .Font.Size    = 11
        .Font.Color   = RGB(255, 255, 255)
        .Interior.Color = RGB(160, 32, 32)
        .HorizontalAlignment = xlLeft
        .VerticalAlignment   = xlCenter
        .RowHeight    = 25
    End With

    ' Start Date row (Row 6)
    ws.Range("A6").Value = "Start Date:": ws.Range("A6").Font.Bold = True
    ws.Range("B6").Value = "dd-mmm-yyyy"
    With ws.Range("B6")
        .Font.Italic  = True
        .Font.Color   = RGB(128, 128, 128)
        .Interior.Color = RGB(255, 245, 245)
        .Borders.LineStyle = xlContinuous
        .Borders.Color     = RGB(192, 128, 128)
        .NumberFormat = "@"    ' Store as text to avoid Excel auto-converting dates
    End With
    ws.Range("C6").Value = "Format: dd-mmm-yyyy  (e.g. 01-Jan-2025)"
    With ws.Range("C6")
        .Font.Size    = 8
        .Font.Color   = RGB(150, 150, 150)
        .Font.Italic  = True
    End With

    ' End Date row (Row 7)
    ws.Range("A7").Value = "End Date:": ws.Range("A7").Font.Bold = True
    ws.Range("B7").Value = "dd-mmm-yyyy"
    With ws.Range("B7")
        .Font.Italic  = True
        .Font.Color   = RGB(128, 128, 128)
        .Interior.Color = RGB(255, 245, 245)
        .Borders.LineStyle = xlContinuous
        .Borders.Color     = RGB(192, 128, 128)
        .NumberFormat = "@"
    End With
    ws.Range("C7").Value = "Leave blank = today (if Start given) or no upper limit"
    With ws.Range("C7")
        .Font.Size    = 8
        .Font.Color   = RGB(150, 150, 150)
        .Font.Italic  = True
    End With

    ws.Range("A5:B7").BorderAround LineStyle:=xlContinuous, Weight:=xlMedium, _
        Color:=RGB(160, 32, 32)

    ' ---- SECTION 4: Keywords (Rows 9 onwards) ----
    Dim paramSection As Integer: paramSection = 9
    ws.Range("A" & paramSection & ":C" & paramSection).Merge
    ws.Range("A" & paramSection).Value = "SEARCH PARAMETERS (Keywords)"
    With ws.Range("A" & paramSection)
        .Font.Bold    = True
        .Font.Size    = 11
        .Font.Color   = RGB(255, 255, 255)
        .Interior.Color = RGB(176, 0, 32)
        .HorizontalAlignment = xlLeft
        .VerticalAlignment   = xlCenter
        .RowHeight    = 25
    End With

    ws.Range("A10").Value = "Keyword"
    ws.Range("B10").Value = "Search Term"
    ws.Range("C10").Value = "Logic (AND/OR)"
    With ws.Range("A10:C10")
        .Font.Bold           = True
        .Interior.Color      = RGB(255, 200, 200)
        .HorizontalAlignment = xlCenter
        .Borders.LineStyle   = xlContinuous
    End With

    ' Keyword input rows start at Row 11 (B11:C20 for 10 keywords)
    For i = 1 To MAX_KEYWORDS
        Dim currentRow As Integer: currentRow = 10 + i      ' Rows 11 to 20
        ws.Range("A" & currentRow).Value = "Keyword " & i
        With ws.Range("A" & currentRow)
            .Font.Bold           = True
            .HorizontalAlignment = xlCenter
            .Interior.Color      = RGB(255, 230, 230)
        End With
        With ws.Range("B" & currentRow)
            .Value              = ""
            .Interior.Color     = RGB(255, 255, 255)
            .Borders.LineStyle  = xlContinuous
            .Borders.Color      = RGB(192, 128, 128)
        End With
        With ws.Range("C" & currentRow)
            .Value              = "AND"
            .Font.Color         = RGB(139, 0, 0)
            .Font.Bold          = True
            .HorizontalAlignment = xlCenter
            .Interior.Color     = RGB(255, 230, 230)
            .Borders.LineStyle  = xlContinuous
            .Borders.Color      = RGB(192, 128, 128)
        End With
    Next i
    ws.Range("A9:C" & (10 + MAX_KEYWORDS)).BorderAround _
        LineStyle:=xlContinuous, Weight:=xlMedium, Color:=RGB(176, 0, 32)

    ' ---- SECTION 5: Macro Controls ----
    Dim controlSection As Integer: controlSection = 10 + MAX_KEYWORDS + 2
    ws.Range("A" & controlSection & ":D" & controlSection).Merge
    ws.Range("A" & controlSection).Value = "MACRO CONTROLS"
    With ws.Range("A" & controlSection)
        .Font.Bold    = True
        .Font.Size    = 11
        .Font.Color   = RGB(255, 255, 255)
        .Interior.Color = RGB(101, 0, 0)
        .HorizontalAlignment = xlLeft
        .VerticalAlignment   = xlCenter
        .RowHeight    = 25
    End With

    Dim btnTop As Long, btnLeft As Long
    Dim btnWidth As Long, btnHeight As Long, btnSpacing As Long
    btnTop     = ws.Range("A" & (controlSection + 1)).Top
    btnLeft    = ws.Range("A" & (controlSection + 1)).Left
    btnWidth   = 140
    btnHeight  = 30
    btnSpacing = 10

    ' Row 1 of buttons: search actions
    Set btn = ws.Buttons.Add(btnLeft, btnTop, btnWidth, btnHeight)
    btn.OnAction = "RunSearchByNameOnly": btn.Caption = "Search: Name Only"
    btn.Font.Bold = True: btn.Font.Size = 9

    Set btn = ws.Buttons.Add(btnLeft + btnWidth + btnSpacing, btnTop, btnWidth, btnHeight)
    btn.OnAction = "RunSearch": btn.Caption = "Search: Name + Content"
    btn.Font.Bold = True: btn.Font.Size = 9

    ' Row 2 of buttons: preview + refine
    btnTop = btnTop + btnHeight + btnSpacing
    Set btn = ws.Buttons.Add(btnLeft, btnTop, btnWidth, btnHeight)
    btn.OnAction = "RunSearchWithContentPreview": btn.Caption = "Search: With Preview"
    btn.Font.Bold = True: btn.Font.Size = 9

    Set btn = ws.Buttons.Add(btnLeft + btnWidth + btnSpacing, btnTop, btnWidth, btnHeight)
    btn.OnAction = "RunRefineSearch": btn.Caption = "Refine Results"
    btn.Font.Bold = True: btn.Font.Size = 9

    ' Row 3 of buttons: utilities
    btnTop = btnTop + btnHeight + btnSpacing
    Set btn = ws.Buttons.Add(btnLeft, btnTop, btnWidth, btnHeight)
    btn.OnAction = "ClearFilteredContentSheets": btn.Caption = "Clear Preview Sheets"
    btn.Font.Bold = True: btn.Font.Size = 9

    Set btn = ws.Buttons.Add(btnLeft + btnWidth + btnSpacing, btnTop, btnWidth, btnHeight)
    btn.OnAction = "SetupSearchSheet": btn.Caption = "Reset Dashboard"
    btn.Font.Bold = True: btn.Font.Size = 9

    ' Row 4 of buttons: ABORT (prominent red styling)
    btnTop = btnTop + btnHeight + btnSpacing
    Set btn = ws.Buttons.Add(btnLeft, btnTop, btnWidth * 2 + btnSpacing, btnHeight)
    btn.OnAction = "AbortSearch"
    btn.Caption  = "ABORT / STOP SEARCH"
    btn.Font.Bold = True
    btn.Font.Size = 10

    Dim btnEndRow As Integer: btnEndRow = controlSection + 10
    ws.Range("A" & (controlSection + 1) & ":D" & btnEndRow).Interior.Color = RGB(255, 235, 235)
    ws.Range("A" & controlSection & ":D" & btnEndRow).BorderAround _
        LineStyle:=xlContinuous, Weight:=xlMedium, Color:=RGB(101, 0, 0)

    ' ---- SECTION 6: Instructions ----
    Dim instructionSection As Integer: instructionSection = btnEndRow + 2
    ws.Range("A" & instructionSection & ":D" & instructionSection).Merge
    ws.Range("A" & instructionSection).Value = "HOW TO USE"
    With ws.Range("A" & instructionSection)
        .Font.Bold    = True
        .Font.Size    = 11
        .Font.Color   = RGB(255, 255, 255)
        .Interior.Color = RGB(160, 32, 32)
        .HorizontalAlignment = xlLeft
        .VerticalAlignment   = xlCenter
        .RowHeight    = 25
    End With

    Dim instrRow As Integer: instrRow = instructionSection + 1
    Dim instructions(6) As String
    instructions(0) = "1. Enter the folder path in cell B4"
    instructions(1) = "2. (Optional) Enter Start Date and/or End Date in B6/B7 using dd-mmm-yyyy format to filter by file date"
    instructions(2) = "3. Enter 1-" & MAX_KEYWORDS & " keywords in the Search Parameters section. Set AND/OR logic per keyword (AND/OR only used by Preview search)"
    instructions(3) = "4. Click a search button: Name Only = all keywords in filename | Name+Content = keyword in name OR body | Preview = AND same row, OR any row"
    instructions(4) = "5. After any search, update keywords then click 'Refine Results' to narrow down within the previous result set"
    instructions(5) = "6. In 'With Preview' results, click the 'Click to Preview' button to open a filtered row view"
    instructions(6) = "7. Click 'ABORT / STOP SEARCH' at any time to safely stop a running search without crashing Excel"

    Dim k As Integer
    For k = 0 To 6
        ws.Range("A" & instrRow & ":D" & instrRow).Merge
        ws.Range("A" & instrRow).Value    = instructions(k)
        ws.Range("A" & instrRow).WrapText = True
        If k = 3 Then
            ws.Range("A" & instrRow).Font.Italic = True
            ws.Range("A" & instrRow).Font.Color  = RGB(139, 0, 0)
        End If
        instrRow = instrRow + 1
    Next k

    Dim instrEndRow As Integer: instrEndRow = instrRow - 1
    ws.Range("A" & (instructionSection + 1) & ":D" & instrEndRow).Interior.Color = RGB(255, 235, 235)
    ws.Range("A" & instructionSection & ":D" & instrEndRow).BorderAround _
        LineStyle:=xlContinuous, Weight:=xlMedium, Color:=RGB(160, 32, 32)

    ' ---- Column E: Gap / separator ----
    ws.Columns("E").ColumnWidth = 2
    ws.Range("E1:E" & instrEndRow).Interior.Color  = RGB(200, 200, 200)
    ws.Range("E1:E" & instrEndRow).Borders.LineStyle = xlNone

    ' ---- Column widths (dashboard side) ----
    ws.Columns("A").ColumnWidth = 18
    ws.Columns("B").ColumnWidth = 32
    ws.Columns("C").ColumnWidth = 22
    ws.Columns("D").ColumnWidth = 5

    ' Draw Results section header so it is visible before any search
    Call WriteResultsSectionHeader(ws, GetOutputStartColumn(), False)

    ws.Range("B4").Select
    Application.ScreenUpdating = True

    MsgBox "Dashboard Setup Complete!" & vbCrLf & vbCrLf & _
           "New in this version:" & vbCrLf & _
           "  - Date Range Filter (B6 / B7) to limit files by date" & vbCrLf & _
           "  - ABORT / STOP SEARCH button to safely stop any running search" & vbCrLf & vbCrLf & _
           "Maximum Keywords: " & MAX_KEYWORDS & vbCrLf & vbCrLf & _
           "Click any search button to begin.", vbInformation, "Dashboard Ready"
End Sub