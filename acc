Function IsTextFile(filePath As String) As Boolean
    Dim ext As String
    ext = LCase(Right(filePath, Len(filePath) - InStrRev(filePath, ".")))
    
    ' Add or remove extensions as needed
    Select Case ext
        Case "txt", "csv", "log", "xml", "json", "ini", "cfg", "md", "html", "htm", "sql", "vbs", "bat"
            IsTextFile = True
        Case Else
            IsTextFile = False
    End Select
End Function

Function IsExcelFile(filePath As String) As Boolean
    Dim ext As String
    ext = LCase(Right(filePath, Len(filePath) - InStrRev(filePath, ".")))
    
    Select Case ext
        Case "xlsx", "xlsm", "xls", "xlsb"
            IsExcelFile = True
        Case Else
            IsExcelFile = False
    End Select
End Function

Function SearchFileContent(filePath As String, keyword As String) As Boolean
    Dim fileNum As Integer
    Dim fileContent As String
    Dim textStream As Object
    Dim fso As Object
    
    On Error Resume Next
    
    SearchFileContent = False
    
    ' Search Excel files
    If IsExcelFile(filePath) Then
        SearchFileContent = SearchExcelFile(filePath, keyword)
    ' Search text-based files
    ElseIf IsTextFile(filePath) Then
        Set fso = CreateObject("Scripting.FileSystemObject")
        Set textStream = fso.OpenTextFile(filePath, 1, False) ' 1 = ForReading
        
        If Err.Number = 0 Then
            fileContent = textStream.ReadAll
            textStream.Close
            
            If InStr(1, LCase(fileContent), keyword, vbTextCompare) > 0 Then
                SearchFileContent = True
            End If
        End If
        
        Set textStream = Nothing
        Set fso = Nothing
    End If
    
    On Error GoTo 0
End Function

Function SearchExcelFile(filePath As String, keyword As String) As Boolean
    Dim xlApp As Object
    Dim xlWb As Object
    Dim xlWs As Object
    Dim cell As Object
    Dim found As Boolean
    
    On Error Resume Next
    found = False
    
    ' Create Excel application instance
    Set xlApp = CreateObject("Excel.Application")
    xlApp.Visible = False
    xlApp.DisplayAlerts = False
    
    ' Open workbook
    Set xlWb = xlApp.Workbooks.Open(filePath, ReadOnly:=True)
    
    If Err.Number = 0 Then
        ' Search through all worksheets
        For Each xlWs In xlWb.Worksheets
            ' Search for keyword in the worksheet
            Set cell = xlWs.Cells.Find(What:=keyword, LookIn:=-4163, LookAt:=2, SearchOrder:=1, _
                                        SearchDirection:=1, MatchCase:=False)
            If Not cell Is Nothing Then
                found = True
                Exit For
            End If
        Next xlWs
        
        xlWb.Close SaveChanges:=False
    End If
    
    xlApp.Quit
    
    Set cell = Nothing
    Set xlWs = Nothing
    Set xlWb = Nothing
    Set xlApp = Nothing
    
    SearchExcelFile = found
    
    On Error GoTo 0
End Function