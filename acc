Option Explicit

' ========== CONFIGURATION ==========
' Change these constants to customize behavior without modifying code

' Maximum number of keywords (regenerate dashboard after changing)
Const MAX_KEYWORDS As Integer = 8

' Result Display Mode: "SIDE_BY_SIDE" or "SEPARATE_SHEET"
' SIDE_BY_SIDE: Results appear to the right of the dashboard (columns E onwards)
' SEPARATE_SHEET: Results appear in a new worksheet
Const RESULT_DISPLAY_MODE As String = "SIDE_BY_SIDE"

' Name of the separate results sheet (only used if RESULT_DISPLAY_MODE = "SEPARATE_SHEET")
Const RESULT_SHEET_NAME As String = "Search Results"

' ========== HELPER FUNCTIONS FOR OUTPUT ==========

Function GetOutputWorksheet() As Worksheet
    ' Returns the worksheet where results should be displayed based on configuration
    Dim ws As Worksheet
    
    If UCase(RESULT_DISPLAY_MODE) = "SEPARATE_SHEET" Then
        ' Check if results sheet exists
        On Error Resume Next
        Set ws = ThisWorkbook.Sheets(RESULT_SHEET_NAME)
        On Error GoTo 0
        
        ' Create if doesn't exist
        If ws Is Nothing Then
            Set ws = ThisWorkbook.Sheets.Add(After:=ThisWorkbook.Sheets(ThisWorkbook.Sheets.Count))
            ws.Name = RESULT_SHEET_NAME
            ws.Tab.Color = RGB(200, 200, 200)
        Else
            ' Clear existing content
            ws.Cells.Clear
        End If
    Else
        ' Use Search sheet (side-by-side mode)
        Set ws = ThisWorkbook.Sheets("Search")
    End If
    
    Set GetOutputWorksheet = ws
End Function

Function GetOutputStartColumn() As String
    ' Returns the starting column letter for results
    If UCase(RESULT_DISPLAY_MODE) = "SEPARATE_SHEET" Then
        GetOutputStartColumn = "A"
    Else
        GetOutputStartColumn = "E"  ' Side-by-side starts at column E
    End If
End Function

Function GetOutputStartRow() As Integer
    ' Returns the starting row for results
    If UCase(RESULT_DISPLAY_MODE) = "SEPARATE_SHEET" Then
        GetOutputStartRow = 2  ' Row 1 for title, row 2 for headers
    Else
        GetOutputStartRow = 3  ' Start at row 3 for side-by-side
    End If
End Function

Function ColumnLetter(colNum As Integer) As String
    ' Convert column number to letter (1=A, 2=B, etc.)
    Dim temp As Integer
    Dim letter As String
    temp = colNum
    Do While temp > 0
        letter = Chr(65 + ((temp - 1) Mod 26)) & letter
        temp = (temp - 1) \ 26
    Loop
    ColumnLetter = letter
End Function

Function ColumnNumber(colLetter As String) As Integer
    ' Convert column letter to number (A=1, B=2, etc.)
    Dim i As Integer
    Dim result As Integer
    result = 0
    For i = 1 To Len(colLetter)
        result = result * 26 + (Asc(Mid(colLetter, i, 1)) - 64)
    Next i
    ColumnNumber = result
End Function

' ========== MAIN SEARCH FUNCTIONS ==========

Function SearchFilesForKeywords(folderPath As String, keywords() As String, keywordCount As Integer, searchContent As Boolean) As Variant
    Dim fso As Object
    Dim folder As Object
    Dim file As Object
    Dim results As Object
    Dim candidateFiles As Object
    Dim fileName As String
    Dim i As Integer
    Dim currentLevel As Integer
    
    ' Create FileSystemObject
    Set fso = CreateObject("Scripting.FileSystemObject")
    Set results = CreateObject("System.Collections.ArrayList")
    Set candidateFiles = CreateObject("System.Collections.ArrayList")
    
    ' Check if folder exists
    If Not fso.FolderExists(folderPath) Then
        SearchFilesForKeywords = Array("Error: Folder not found")
        Exit Function
    End If
    
    Set folder = fso.GetFolder(folderPath)
    
    ' Level 0: Get all files as initial candidates
    For Each file In folder.Files
        candidateFiles.Add file.Path
    Next file
    
    ' Progressive filtering: Apply each keyword as a filter level
    Dim tempFiles As Object
    For currentLevel = 0 To keywordCount - 1
        If candidateFiles.Count = 0 Then Exit For ' No candidates left
        
        Set tempFiles = FilterFilesByKeyword(candidateFiles, keywords(currentLevel), currentLevel + 1, keywordCount, searchContent)
        Set candidateFiles = tempFiles
    Next currentLevel
    
    ' Convert final candidates to results array
    If candidateFiles.Count > 0 Then
        Dim arr() As Variant
        ReDim arr(0 To candidateFiles.Count - 1)
        Dim j As Long
        For j = 0 To candidateFiles.Count - 1
            Dim filePath As String
            filePath = candidateFiles(j)
            fileName = fso.GetFileName(filePath)
            arr(j) = fileName & "|" & filePath
        Next j
        SearchFilesForKeywords = arr
    Else
        SearchFilesForKeywords = Array("No matches found")
    End If
    
    Set fso = Nothing
    Set folder = Nothing
    Set results = Nothing
    Set candidateFiles = Nothing
End Function

Function FilterFilesByKeyword(candidateFiles As Object, keyword As String, level As Integer, totalLevels As Integer, searchContent As Boolean) As Object
    Dim filteredFiles As Object
    Dim i As Long
    Dim filePath As String
    Dim fileName As String
    Dim fso As Object
    Dim matchFound As Boolean
    
    Set filteredFiles = CreateObject("System.Collections.ArrayList")
    Set fso = CreateObject("Scripting.FileSystemObject")
    
    keyword = LCase(Trim(keyword))
    
    ' Skip empty keywords
    If keyword = "" Then
        Set FilterFilesByKeyword = candidateFiles
        Exit Function
    End If
    
    ' Filter candidates by current keyword
    For i = 0 To candidateFiles.Count - 1
        filePath = candidateFiles(i)
        fileName = fso.GetFileName(filePath)
        matchFound = False
        
        ' Check if keyword is in file name
        If InStr(1, LCase(fileName), keyword, vbTextCompare) > 0 Then
            matchFound = True
        End If
        
        ' Check file contents if not found in name AND searchContent is enabled
        If Not matchFound And searchContent Then
            matchFound = SearchFileContent(filePath, keyword)
        End If
        
        ' Add to filtered list if match found
        If matchFound Then
            filteredFiles.Add filePath
        End If
    Next i
    
    Set FilterFilesByKeyword = filteredFiles
    Set fso = Nothing
End Function

Function SearchFileContent(filePath As String, keyword As String) As Boolean
    Dim fileNum As Integer
    Dim fileContent As String
    Dim textStream As Object
    Dim fso As Object
    
    On Error Resume Next
    
    SearchFileContent = False
    
    ' Check if it's an Excel file
    If IsExcelFile(filePath) Then
        SearchFileContent = SearchExcelContent(filePath, keyword)
        Exit Function
    End If
    
    ' Only search text-based files
    If IsTextFile(filePath) Then
        Set fso = CreateObject("Scripting.FileSystemObject")
        Set textStream = fso.OpenTextFile(filePath, 1, False) ' 1 = ForReading
        
        If Err.Number = 0 Then
            fileContent = textStream.ReadAll
            textStream.Close
            
            If InStr(1, LCase(fileContent), keyword, vbTextCompare) > 0 Then
                SearchFileContent = True
            End If
        End If
        
        Set textStream = Nothing
        Set fso = Nothing
    End If
    
    On Error GoTo 0
End Function

Function SearchExcelContent(filePath As String, keyword As String) As Boolean
    ' Search content within Excel files
    Dim xlApp As Object
    Dim xlBook As Object
    Dim xlSheet As Object
    Dim cell As Object
    Dim found As Boolean
    
    On Error Resume Next
    
    SearchExcelContent = False
    found = False
    
    ' Create Excel application (late binding for compatibility)
    Set xlApp = CreateObject("Excel.Application")
    If xlApp Is Nothing Then Exit Function
    
    xlApp.Visible = False
    xlApp.DisplayAlerts = False
    xlApp.ScreenUpdating = False
    
    ' Open workbook
    Set xlBook = xlApp.Workbooks.Open(filePath, ReadOnly:=True)
    If Err.Number <> 0 Then
        xlApp.Quit
        Set xlApp = Nothing
        Exit Function
    End If
    
    ' Search all sheets
    For Each xlSheet In xlBook.Worksheets
        If found Then Exit For
        
        ' Search in used range
        On Error Resume Next
        Set cell = xlSheet.UsedRange.Find(What:=keyword, LookIn:=-4163, LookAt:=2, _
                                          SearchOrder:=1, SearchDirection:=1, MatchCase:=False)
        
        If Not cell Is Nothing Then
            found = True
            Exit For
        End If
    Next xlSheet
    
    ' Clean up
    xlBook.Close SaveChanges:=False
    xlApp.Quit
    
    Set xlSheet = Nothing
    Set xlBook = Nothing
    Set xlApp = Nothing
    
    SearchExcelContent = found
    
    On Error GoTo 0
End Function

Function IsTextFile(filePath As String) As Boolean
    Dim ext As String
    ext = LCase(Right(filePath, Len(filePath) - InStrRev(filePath, ".")))
    
    ' Text-based and Excel files
    Select Case ext
        Case "txt", "csv", "log", "xml", "json", "ini", "cfg", "md", "html", "htm", "sql", "vbs", "bat", _
             "xls", "xlsx", "xlsm", "xlsb", "xltx", "xltm"
            IsTextFile = True
        Case Else
            IsTextFile = False
    End Select
End Function

Function IsExcelFile(filePath As String) As Boolean
    Dim ext As String
    ext = LCase(Right(filePath, Len(filePath) - InStrRev(filePath, ".")))
    
    Select Case ext
        Case "xls", "xlsx", "xlsm", "xlsb", "xltx", "xltm"
            IsExcelFile = True
        Case Else
            IsExcelFile = False
    End Select
End Function

' ========== USER-FACING SEARCH MACROS ==========

Sub RunSearch()
    Dim folderPath As String
    Dim keywords(0 To MAX_KEYWORDS - 1) As String
    Dim keywordCount As Integer
    Dim results As Variant
    Dim ws As Worksheet
    Dim outputWs As Worksheet
    Dim i As Long
    Dim resultParts() As String
    Dim fileName As String
    Dim filePath As String
    Dim keywordList As String
    Dim startCol As String
    Dim startRow As Integer
    Dim col1 As String, col2 As String
    
    Set ws = ThisWorkbook.Sheets("Search")
    
    ' Get folder path
    folderPath = ws.Range("B2").Value
    
    ' Get keywords
    keywordCount = 0
    keywordList = ""
    
    For i = 0 To MAX_KEYWORDS - 1
        keywords(i) = Trim(ws.Range("B" & (3 + i)).Value)
        If keywords(i) <> "" Then
            keywordCount = keywordCount + 1
            If keywordList <> "" Then keywordList = keywordList & ", "
            keywordList = keywordList & """" & keywords(i) & """"
        End If
    Next i
    
    ' Validation
    If folderPath = "" Then
        MsgBox "Please enter folder path in cell B2", vbExclamation
        Exit Sub
    End If
    
    If keywordCount = 0 Then
        MsgBox "Please enter at least one keyword (cells B3 onwards)", vbExclamation
        Exit Sub
    End If
    
    ' Get output worksheet and positions
    Set outputWs = GetOutputWorksheet()
    startCol = GetOutputStartColumn()
    startRow = GetOutputStartRow()
    
    ' Clear previous results
    If UCase(RESULT_DISPLAY_MODE) = "SEPARATE_SHEET" Then
        outputWs.Cells.Clear
        ' Add title
        outputWs.Range("A1").Value = "Search Results - " & Format(Now, "yyyy-mm-dd hh:mm:ss")
        outputWs.Range("A1").Font.Bold = True
        outputWs.Range("A1").Font.Size = 12
    Else
        Dim clearCol As Integer
        clearCol = ColumnNumber(startCol)
        outputWs.Range(ColumnLetter(clearCol) & startRow & ":" & ColumnLetter(clearCol + 2) & "1000").ClearContents
    End If
    
    ' Run search
    Application.ScreenUpdating = False
    Application.StatusBar = "Searching file names and content for " & keywordCount & " keyword(s)..."
    
    results = SearchFilesForKeywords(folderPath, keywords, keywordCount, True)
    
    ' Calculate column letters
    col1 = ColumnLetter(ColumnNumber(startCol))
    col2 = ColumnLetter(ColumnNumber(startCol) + 1)
    
    ' Output results with headers
    outputWs.Range(col1 & startRow).Value = "File Name"
    outputWs.Range(col2 & startRow).Value = "File Path"
    
    ' Format headers
    outputWs.Range(col1 & startRow & ":" & col2 & startRow).Font.Bold = True
    outputWs.Range(col1 & startRow & ":" & col2 & startRow).Font.Size = 10
    outputWs.Range(col1 & startRow & ":" & col2 & startRow).Interior.Color = RGB(217, 217, 217)
    outputWs.Range(col1 & startRow & ":" & col2 & startRow).Borders.LineStyle = xlContinuous
    outputWs.Range(col1 & startRow & ":" & col2 & startRow).HorizontalAlignment = xlCenter
    
    ' Check if results contain error or no matches
    If UBound(results) = 0 And InStr(1, results(0), "Error:") > 0 Then
        outputWs.Range(col1 & (startRow + 1)).Value = results(0)
        Application.ScreenUpdating = True
        Application.StatusBar = False
        MsgBox results(0), vbExclamation
        Exit Sub
    ElseIf UBound(results) = 0 And results(0) = "No matches found" Then
        outputWs.Range(col1 & (startRow + 1)).Value = results(0)
        Application.ScreenUpdating = True
        Application.StatusBar = False
        MsgBox "No matches found for all " & keywordCount & " keyword(s)", vbInformation
        Exit Sub
    End If
    
    ' Output results with hyperlinks
    For i = LBound(results) To UBound(results)
        resultParts = Split(results(i), "|")
        fileName = resultParts(0)
        filePath = resultParts(1)
        
        ' Add file name as clickable hyperlink
        outputWs.Hyperlinks.Add Anchor:=outputWs.Range(col1 & (startRow + 1 + i)), _
                          Address:=filePath, _
                          TextToDisplay:=fileName
        outputWs.Range(col1 & (startRow + 1 + i)).Font.Color = RGB(5, 99, 193)
        outputWs.Range(col1 & (startRow + 1 + i)).Font.Underline = xlUnderlineStyleSingle
        
        ' Add full path in column 2
        outputWs.Range(col2 & (startRow + 1 + i)).Value = filePath
        outputWs.Range(col2 & (startRow + 1 + i)).Font.Size = 9
        
        ' Add alternating row colors
        If i Mod 2 = 0 Then
            outputWs.Range(col1 & (startRow + 1 + i) & ":" & col2 & (startRow + 1 + i)).Interior.Color = RGB(242, 242, 242)
        End If
    Next i
    
    ' Add borders to results
    Dim lastResultRow As Integer
    lastResultRow = startRow + UBound(results) + 1
    outputWs.Range(col1 & startRow & ":" & col2 & lastResultRow).Borders.LineStyle = xlContinuous
    outputWs.Range(col1 & startRow & ":" & col2 & lastResultRow).BorderAround _
        LineStyle:=xlContinuous, Weight:=xlMedium, Color:=RGB(165, 165, 165)
    
    ' Set column widths
    outputWs.Columns(col1).ColumnWidth = 35
    outputWs.Columns(col2).ColumnWidth = 55
    
    ' Add back button if separate sheet
    If UCase(RESULT_DISPLAY_MODE) = "SEPARATE_SHEET" Then
        outputWs.Range("D1").Value = "← Back to Search"
        outputWs.Hyperlinks.Add Anchor:=outputWs.Range("D1"), _
                          Address:="", _
                          SubAddress:="'Search'!A1", _
                          TextToDisplay:="← Back to Search"
        outputWs.Range("D1").Font.Bold = True
        outputWs.Range("D1").Font.Color = RGB(5, 99, 193)
        outputWs.Activate
    End If
    
    Application.ScreenUpdating = True
    Application.StatusBar = False
    
    MsgBox "Search complete!" & vbCrLf & vbCrLf & _
           "Search Type: File Name + Content" & vbCrLf & _
           "Keywords used: " & keywordList & vbCrLf & _
           "Files found: " & (UBound(results) + 1), vbInformation
End Sub

