Sub RunPythonScript()
    Dim shell As Object
    Dim command As String
    
    ' Create shell object
    Set shell = CreateObject("WScript.Shell")
    
    ' Build command - adjust paths as needed
    command = "python C:\path\to\your\script.py"
    
    ' Run the command
    shell.Run command, 1, True
    
    ' Clean up
    Set shell = Nothing
    
    MsgBox "Python script completed!", vbInformation
End Sub