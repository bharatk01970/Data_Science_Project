Option Explicit

' ==========================================
' CONFIGURATION
' ==========================================

' Maximum number of keywords (run Reset Dashboard after changing)
Const MAX_KEYWORDS As Integer = 10

' Result Display Mode: "SIDE_BY_SIDE" or "SEPARATE_SHEET"
' SIDE_BY_SIDE : Results appear to the right of the dashboard (col F onwards, col E is gap)
' SEPARATE_SHEET: Results appear in a dedicated worksheet
Const RESULT_DISPLAY_MODE As String = "SIDE_BY_SIDE"

' Name of the separate results sheet (only used when RESULT_DISPLAY_MODE = "SEPARATE_SHEET")
Const RESULT_SHEET_NAME As String = "Search Results"

' Hidden helper column used to persist file paths for Refine Search
' Must sit outside the visible results area. Change only if it conflicts.
Const HELPER_COL As String = "J"


' ==========================================
' MODULE-LEVEL STATE
'
' g_AbortRequested  - Boolean flag set by AbortSearch button. Checked
'                     inside every file loop via DoEvents.
'
' g_Stats_*         - Performance counters populated during each search.
'                     Read by ShowSearchSummary at completion.
'                     Reset to zero at the start of every new search.
' ==========================================

Public g_AbortRequested       As Boolean

' Performance / summary counters (Enhancement #3)
Public g_Stats_TotalScanned   As Long     ' Files seen in folder
Public g_Stats_Candidates     As Long     ' Files passing date filter
Public g_Stats_Searched       As Long     ' Files actually opened / name-checked
Public g_Stats_Matches        As Long     ' Final matched files
Public g_Stats_DateSecs       As Double   ' Seconds spent in date-filter phase
Public g_Stats_SearchSecs     As Double   ' Seconds spent in keyword-filter phase
Public g_Stats_WasAborted     As Boolean  ' True if user aborted mid-run
Public g_Stats_AbortPhase     As String   ' "date" | "search" | ""


' ==========================================
' ABORT ENTRY POINT
' Called by the "Abort Search" button on the dashboard.
' ==========================================

Sub AbortSearch()
    g_AbortRequested = True
    Application.StatusBar = "Abort requested - stopping after current file..."
End Sub


' ==========================================
' HELPER FUNCTIONS - OUTPUT POSITIONING
' ==========================================

Function GetOutputWorksheet() As Worksheet
    Dim ws As Worksheet
    If UCase(RESULT_DISPLAY_MODE) = "SEPARATE_SHEET" Then
        On Error Resume Next
        Set ws = ThisWorkbook.Sheets(RESULT_SHEET_NAME)
        On Error GoTo 0
        If ws Is Nothing Then
            Set ws = ThisWorkbook.Sheets.Add(After:=ThisWorkbook.Sheets(ThisWorkbook.Sheets.Count))
            ws.Name = RESULT_SHEET_NAME
            ws.Tab.Color = RGB(192, 0, 0)
        Else
            ws.Cells.Clear
        End If
    Else
        Set ws = ThisWorkbook.Sheets("Search")
    End If
    Set GetOutputWorksheet = ws
End Function

Function GetOutputStartColumn() As String
    If UCase(RESULT_DISPLAY_MODE) = "SEPARATE_SHEET" Then
        GetOutputStartColumn = "A"
    Else
        GetOutputStartColumn = "F"   ' Col E is the greyed-out gap column
    End If
End Function

Function GetOutputStartRow() As Integer
    If UCase(RESULT_DISPLAY_MODE) = "SEPARATE_SHEET" Then
        GetOutputStartRow = 2        ' Row 1 = title, Row 2 = column headers
    Else
        GetOutputStartRow = 3        ' Rows 1-2 = Results section header; Row 3 = column headers
    End If
End Function

Function ColumnLetter(colNum As Integer) As String
    Dim temp As Integer, letter As String
    temp = colNum
    Do While temp > 0
        letter = Chr(65 + ((temp - 1) Mod 26)) & letter
        temp = (temp - 1) \ 26
    Loop
    ColumnLetter = letter
End Function

Function ColumnNumber(colLetter As String) As Integer
    Dim i As Integer, result As Integer
    result = 0
    For i = 1 To Len(colLetter)
        result = result * 26 + (Asc(Mid(colLetter, i, 1)) - 64)
    Next i
    ColumnNumber = result
End Function


' ==========================================
' RESET PERFORMANCE COUNTERS
' Called at the start of every new search.
' ==========================================

Sub ResetStats()
    g_Stats_TotalScanned = 0
    g_Stats_Candidates   = 0
    g_Stats_Searched     = 0
    g_Stats_Matches      = 0
    g_Stats_DateSecs     = 0
    g_Stats_SearchSecs   = 0
    g_Stats_WasAborted   = False
    g_Stats_AbortPhase   = ""
End Sub


' ==========================================
' DATE RANGE HELPERS
'
' ReadDateRange reads Start Date (B6) and End Date (B7) from the
' dashboard sheet. Date format is MM/DD/YY (e.g. 01/15/25).
'
'   Both provided  -> use as-is
'   Start only     -> End = Today
'   End only       -> Start = date of the oldest file in the folder
'   Neither        -> useDateFilter = False  (no filter)
' ==========================================

Sub ReadDateRange(folderPath As String, _
                  ByRef startDate As Date, ByRef endDate As Date, _
                  ByRef useDateFilter As Boolean)

    Dim ws As Worksheet
    Dim rawStart As String, rawEnd As String

    Set ws = ThisWorkbook.Sheets("Search")
    rawStart = Trim(ws.Range("B6").Value)
    rawEnd   = Trim(ws.Range("B7").Value)

    Dim hasStart As Boolean, hasEnd As Boolean
    hasStart = (rawStart <> "" And rawStart <> "MM/DD/YY")
    hasEnd   = (rawEnd   <> "" And rawEnd   <> "MM/DD/YY")

    If hasStart Then
        If Not IsDate(rawStart) Then
            MsgBox "Start Date '" & rawStart & "' is not a valid date." & vbCrLf & _
                   "Please use the format MM/DD/YY (e.g. 01/15/25).", vbExclamation
            useDateFilter = False
            Exit Sub
        End If
    End If
    If hasEnd Then
        If Not IsDate(rawEnd) Then
            MsgBox "End Date '" & rawEnd & "' is not a valid date." & vbCrLf & _
                   "Please use the format MM/DD/YY (e.g. 01/15/25).", vbExclamation
            useDateFilter = False
            Exit Sub
        End If
    End If

    If Not hasStart And Not hasEnd Then
        useDateFilter = False
        Exit Sub
    End If

    useDateFilter = True

    If hasStart Then startDate = CDate(rawStart)
    If hasEnd   Then endDate   = CDate(rawEnd)

    If hasStart And Not hasEnd Then endDate = Date
    If Not hasStart And hasEnd Then startDate = FindOldestFileDate(folderPath)

    startDate = Int(startDate)
    endDate   = Int(endDate)

    If startDate > endDate Then
        MsgBox "Start Date (" & Format(startDate, "MM/DD/YY") & ") is after " & _
               "End Date (" & Format(endDate, "MM/DD/YY") & ")." & vbCrLf & _
               "Please correct the dates and try again.", vbExclamation
        useDateFilter = False
    End If
End Sub


Function FindOldestFileDate(folderPath As String) As Date
    Dim fso As Object, folder As Object, file As Object
    Dim oldest As Date

    oldest = CDate("01/01/70")

    On Error Resume Next
    Set fso    = CreateObject("Scripting.FileSystemObject")
    Set folder = fso.GetFolder(folderPath)
    If Err.Number <> 0 Or folder Is Nothing Then
        FindOldestFileDate = oldest
        Exit Function
    End If
    On Error GoTo 0

    Dim firstFile As Boolean
    firstFile = True

    For Each file In folder.Files
        If firstFile Then
            oldest    = Int(file.DateLastModified)
            firstFile = False
        ElseIf Int(file.DateLastModified) < oldest Then
            oldest = Int(file.DateLastModified)
        End If
    Next file

    FindOldestFileDate = oldest

    Set fso    = Nothing
    Set folder = Nothing
End Function


Function IsFileInDateRange(filePath As String, startDate As Date, endDate As Date, _
                            useDateFilter As Boolean) As Boolean
    If Not useDateFilter Then
        IsFileInDateRange = True
        Exit Function
    End If

    Dim fso As Object
    Dim fileDate As Date

    On Error Resume Next
    Set fso      = CreateObject("Scripting.FileSystemObject")
    fileDate     = Int(fso.GetFile(filePath).DateLastModified)
    On Error GoTo 0

    Set fso = Nothing

    IsFileInDateRange = (fileDate >= startDate And fileDate <= endDate)
End Function


' ==========================================
' RESULTS SECTION HEADER
' Always visible in SIDE_BY_SIDE mode.
' ==========================================

Sub WriteResultsSectionHeader(outputWs As Worksheet, startCol As String, _
                               Optional timestamp As Boolean = False)
    If UCase(RESULT_DISPLAY_MODE) <> "SIDE_BY_SIDE" Then Exit Sub

    Dim col1 As String, col3 As String
    col1 = ColumnLetter(ColumnNumber(startCol))
    col3 = ColumnLetter(ColumnNumber(startCol) + 2)

    On Error Resume Next
    outputWs.Range(col1 & "1:" & col3 & "1").UnMerge
    outputWs.Range(col1 & "2:" & col3 & "2").UnMerge
    On Error GoTo 0

    outputWs.Range(col1 & "1:" & col3 & "1").Merge
    outputWs.Range(col1 & "1").Value = "RESULTS / OUTPUT"
    With outputWs.Range(col1 & "1")
        .Font.Bold = True
        .Font.Size = 16
        .Font.Color = RGB(255, 255, 255)
        .Interior.Color = RGB(139, 0, 0)
        .HorizontalAlignment = xlCenter
        .VerticalAlignment = xlCenter
        .RowHeight = 35
    End With

    outputWs.Range(col1 & "2:" & col3 & "2").Merge
    Dim subText As String
    If timestamp Then
        subText = "Last updated: " & Format(Now, "yyyy-mm-dd hh:mm:ss")
    Else
        subText = "Run a search to see results here"
    End If
    outputWs.Range(col1 & "2").Value = subText
    With outputWs.Range(col1 & "2")
        .Font.Italic = True
        .Font.Size = 9
        .Font.Color = RGB(255, 255, 255)
        .Interior.Color = RGB(192, 0, 0)
        .HorizontalAlignment = xlCenter
        .RowHeight = 18
    End With
End Sub


' ==========================================
' ENHANCEMENT #3: PERFORMANCE SUMMARY DIALOG
'
' Replaces the basic MsgBox completion alert with a rich, formatted
' summary showing file counts and timing for each phase.
' Called after every search (normal completion and abort).
' ==========================================

Sub ShowSearchSummary(searchType As String, keywordList As String)
    Dim totalSecs  As Double
    totalSecs = g_Stats_DateSecs + g_Stats_SearchSecs

    ' Format number with comma separators
    Dim scanned   As String, candidates As String
    Dim searched  As String, matches    As String
    scanned    = Format(g_Stats_TotalScanned, "#,##0")
    candidates = Format(g_Stats_Candidates,  "#,##0")
    searched   = Format(g_Stats_Searched,    "#,##0")
    matches    = Format(g_Stats_Matches,     "#,##0")

    Dim dateSecs   As String, searchSecs As String, totalSecStr As String
    dateSecs   = Format(g_Stats_DateSecs,   "0.0") & " sec"
    searchSecs = Format(g_Stats_SearchSecs, "0.0") & " sec"
    totalSecStr = Format(totalSecs,         "0.0") & " sec"

    Dim msg As String
    Dim title As String

    If g_Stats_WasAborted Then
        title = "Search Aborted - Partial Results"
        msg = "  ** SEARCH WAS ABORTED (" & g_Stats_AbortPhase & " phase) **" & vbCrLf & vbCrLf
    Else
        title = "Search Completed"
        msg = ""
    End If

    msg = msg & String(50, Chr(8213)) & vbCrLf   ' horizontal rule
    msg = msg & "  SEARCH SUMMARY" & vbCrLf
    msg = msg & String(50, Chr(8213)) & vbCrLf & vbCrLf

    msg = msg & "  Type    : " & searchType & vbCrLf
    msg = msg & "  Keywords: " & keywordList & vbCrLf & vbCrLf

    msg = msg & "  FILES" & vbCrLf
    msg = msg & "  " & String(30, "-") & vbCrLf
    msg = msg & "  Total files in folder    : " & scanned    & vbCrLf
    msg = msg & "  After date filter        : " & candidates & vbCrLf
    msg = msg & "  Files actually searched  : " & searched   & vbCrLf
    msg = msg & "  Matches found            : " & matches    & vbCrLf & vbCrLf

    msg = msg & "  TIMING" & vbCrLf
    msg = msg & "  " & String(30, "-") & vbCrLf
    msg = msg & "  Date filtering           : " & dateSecs    & vbCrLf
    msg = msg & "  Keyword searching        : " & searchSecs  & vbCrLf
    msg = msg & "  Total execution time     : " & totalSecStr & vbCrLf

    If g_Stats_WasAborted Then
        msg = msg & vbCrLf & "  Partial results (if any) have been written to the output area."
        MsgBox msg, vbExclamation, title
    Else
        If g_Stats_Matches > 0 Then
            msg = msg & vbCrLf & "  Tip: Click 'Refine Results' to narrow down within these matches."
        End If
        MsgBox msg, vbInformation, title
    End If
End Sub


' ==========================================
' ENHANCEMENT #1: OPTIMISED DATE FILTERING
'
' Loads all file metadata into a sorted array (Newest -> Oldest)
' before any date filtering begins. Once a file older than startDate
' is encountered, a prompt offers to stop scanning and work with the
' already-collected candidates - avoiding full-folder traversal.
'
' Returns: ArrayList of file paths that pass the date filter.
'          Returns special sentinel array on Abort.
'
' Also accumulates g_Stats_TotalScanned, g_Stats_Candidates,
' g_Stats_DateSecs for the summary dialog.
' ==========================================

Function CollectCandidatesByDate(folderPath As String, _
                                  startDate As Date, endDate As Date, _
                                  useDateFilter As Boolean) As Object

    Dim fso As Object, folder As Object, file As Object
    Dim candidateFiles As Object
    Dim t0 As Double
    t0 = Timer

    Set fso            = CreateObject("Scripting.FileSystemObject")
    Set candidateFiles = CreateObject("System.Collections.ArrayList")

    ' If no date filter, just collect all paths immediately
    If Not useDateFilter Then
        Set folder = fso.GetFolder(folderPath)
        Dim f As Object
        Dim fc As Long: fc = 0
        For Each f In folder.Files
            fc = fc + 1
            DoEvents
            If g_AbortRequested Then
                g_Stats_WasAborted  = True
                g_Stats_AbortPhase  = "date scanning"
                g_Stats_TotalScanned = fc
                g_Stats_Candidates  = candidateFiles.Count
                g_Stats_DateSecs    = Timer - t0
                Set CollectCandidatesByDate = candidateFiles
                GoTo CleanupDate
            End If
            Application.StatusBar = "Collecting files: " & fc & " found  |  Click ABORT to stop"
            candidateFiles.Add f.Path
        Next f
        g_Stats_TotalScanned = fc
        g_Stats_Candidates   = candidateFiles.Count
        g_Stats_DateSecs     = Timer - t0
        Set CollectCandidatesByDate = candidateFiles
        GoTo CleanupDate
    End If

    ' ---- Date filter mode: sort all files newest-to-oldest then scan ----
    ' Step 1: Load all file objects into a VBA array for sorting
    Set folder = fso.GetFolder(folderPath)
    Dim totalFiles As Long
    totalFiles = folder.Files.Count
    g_Stats_TotalScanned = totalFiles

    If totalFiles = 0 Then
        g_Stats_DateSecs = Timer - t0
        Set CollectCandidatesByDate = candidateFiles
        GoTo CleanupDate
    End If

    ' Build parallel arrays: paths and dates
    Dim filePaths() As String
    Dim fileDates() As Date
    ReDim filePaths(0 To totalFiles - 1)
    ReDim fileDates(0 To totalFiles - 1)

    Dim idx As Long
    idx = 0
    Application.StatusBar = "Loading file metadata for sorting... (one-time cost)"
    For Each file In folder.Files
        DoEvents
        If g_AbortRequested Then
            g_Stats_WasAborted = True
            g_Stats_AbortPhase = "date scanning (load)"
            g_Stats_Candidates = 0
            g_Stats_DateSecs   = Timer - t0
            Set CollectCandidatesByDate = candidateFiles
            GoTo CleanupDate
        End If
        filePaths(idx) = file.Path
        fileDates(idx) = Int(file.DateLastModified)
        idx = idx + 1
    Next file

    ' Step 2: Sort by date descending (newest first) - Insertion sort
    ' Insertion sort is fine here: optimised for nearly-sorted data and
    ' avoids recursion depth issues with 20 000+ items that QuickSort can hit.
    Application.StatusBar = "Sorting " & totalFiles & " files by date..."
    Dim si As Long, sj As Long
    Dim tmpPath As String, tmpDate As Date
    For si = 1 To totalFiles - 1
        tmpPath = filePaths(si)
        tmpDate = fileDates(si)
        sj = si - 1
        Do While sj >= 0 And fileDates(sj) < tmpDate
            filePaths(sj + 1) = filePaths(sj)
            fileDates(sj + 1) = fileDates(sj)
            sj = sj - 1
        Loop
        filePaths(sj + 1) = tmpPath
        fileDates(sj + 1) = tmpDate
    Next si

    ' Step 3: Scan sorted list and apply date range
    Dim scannedCount As Long
    scannedCount = 0
    Dim hitOlderThanStart As Boolean
    hitOlderThanStart = False

    Dim k As Long
    For k = 0 To totalFiles - 1
        scannedCount = scannedCount + 1

        DoEvents
        If g_AbortRequested Then
            g_Stats_WasAborted  = True
            g_Stats_AbortPhase  = "date scanning"
            g_Stats_Candidates  = candidateFiles.Count
            g_Stats_DateSecs    = Timer - t0
            Set CollectCandidatesByDate = candidateFiles
            GoTo CleanupDate
        End If

        Application.StatusBar = "Date filter: " & scannedCount & " of " & totalFiles & _
                                  "  |  Candidates: " & candidateFiles.Count & _
                                  "  |  Click ABORT to stop"

        Dim fileD As Date
        fileD = fileDates(k)

        ' File is within range
        If fileD >= startDate And fileD <= endDate Then
            candidateFiles.Add filePaths(k)

        ' ENHANCEMENT #1: File is OLDER than start date - all newer files
        ' already processed so no more matches can exist in the sorted list.
        ElseIf fileD < startDate Then
            hitOlderThanStart = True
            ' Offer to stop early - show prompt
            Dim stopNow As Integer
            stopNow = MsgBox( _
                "All files within the selected date range have been identified." & vbCrLf & vbCrLf & _
                "  Files scanned so far : " & Format(scannedCount, "#,##0") & " of " & Format(totalFiles, "#,##0") & vbCrLf & _
                "  Candidate files found: " & Format(candidateFiles.Count, "#,##0") & vbCrLf & vbCrLf & _
                "Do you want to stop date filtering and continue searching" & vbCrLf & _
                "within the already-identified candidate files?" & vbCrLf & vbCrLf & _
                "  Yes = Stop now and search " & Format(candidateFiles.Count, "#,##0") & " candidates (faster)" & vbCrLf & _
                "  No  = Continue scanning remaining files (safer, current behaviour)", _
                vbQuestion + vbYesNo, "Early Stop Possible")

            If stopNow = vbYes Then
                ' User chose early stop - exit date scan loop now
                Exit For
            End If
            ' User chose to continue - file is out of range but keep looping
        End If
        ' Files newer than endDate are simply skipped (no action needed)
    Next k

    g_Stats_Candidates = candidateFiles.Count
    g_Stats_DateSecs   = Timer - t0
    Set CollectCandidatesByDate = candidateFiles

CleanupDate:
    Set fso    = Nothing
    Set folder = Nothing
    Set file   = Nothing
End Function


' ==========================================
' FILE-LEVEL SEARCH  (Name Only  OR  Name + Content)
'
' Now delegates date-filter phase to CollectCandidatesByDate which
' handles sorting, early-stop prompt, and timing.
' Keyword filter phase records g_Stats_Searched and g_Stats_SearchSecs.
' Abort during keyword phase returns partial results (Enhancement #2).
' ==========================================

Function SearchFilesForKeywords(folderPath As String, _
                                 keywords() As String, _
                                 keywordCount As Integer, _
                                 searchContent As Boolean, _
                                 startDate As Date, endDate As Date, _
                                 useDateFilter As Boolean) As Variant

    Dim fso As Object
    Dim candidateFiles As Object, tempFiles As Object
    Dim fileName As String, filePath As String
    Dim currentLevel As Integer, j As Long
    Dim t1 As Double

    Set fso = CreateObject("Scripting.FileSystemObject")

    If Not fso.FolderExists(folderPath) Then
        SearchFilesForKeywords = Array("Error: Folder not found")
        Set fso = Nothing
        Exit Function
    End If

    ' ---- Phase 1: Date filtering (with sort + early stop) ----
    Set candidateFiles = CollectCandidatesByDate(folderPath, startDate, endDate, useDateFilter)

    ' If aborted during date phase, return immediately with no results
    If g_Stats_WasAborted Then
        SearchFilesForKeywords = Array("Aborted")
        Set fso = Nothing
        Set candidateFiles = Nothing
        Exit Function
    End If

    If candidateFiles.Count = 0 Then
        SearchFilesForKeywords = Array("No matches found")
        Set fso = Nothing
        Set candidateFiles = Nothing
        Exit Function
    End If

    ' ---- Phase 2: Keyword filter ----
    t1 = Timer
    g_Stats_Searched = candidateFiles.Count   ' All candidates will be examined

    For currentLevel = 0 To keywordCount - 1
        If candidateFiles.Count = 0 Then Exit For

        Application.StatusBar = "Keyword pass " & (currentLevel + 1) & " of " & keywordCount & _
                                  "  |  Remaining candidates: " & candidateFiles.Count & _
                                  "  |  Click ABORT to stop"

        If searchContent Then
            Set tempFiles = FilterFilesByKeyword(candidateFiles, keywords(currentLevel), True)
        Else
            Set tempFiles = FilterFilesByNameOnly(candidateFiles, keywords(currentLevel))
        End If

        DoEvents
        ' ENHANCEMENT #2: On abort during keyword phase, return partial
        ' results from files processed before the abort - do NOT discard.
        If g_AbortRequested Then
            g_Stats_WasAborted   = True
            g_Stats_AbortPhase   = "keyword searching"
            g_Stats_SearchSecs   = Timer - t1
            g_Stats_Matches      = tempFiles.Count
            ' Return whatever tempFiles has (files processed before abort)
            If tempFiles.Count > 0 Then
                Dim partArr() As Variant
                ReDim partArr(0 To tempFiles.Count - 1)
                For j = 0 To tempFiles.Count - 1
                    filePath = tempFiles(j)
                    fileName = fso.GetFileName(filePath)
                    partArr(j) = fileName & "|" & filePath
                Next j
                SearchFilesForKeywords = partArr
            Else
                SearchFilesForKeywords = Array("Aborted")
            End If
            Set fso = Nothing
            Set candidateFiles = Nothing
            Set tempFiles = Nothing
            Exit Function
        End If

        Set candidateFiles = tempFiles
    Next currentLevel

    g_Stats_SearchSecs = Timer - t1

    ' ---- Build result array ----
    If candidateFiles.Count > 0 Then
        Dim arr() As Variant
        ReDim arr(0 To candidateFiles.Count - 1)
        For j = 0 To candidateFiles.Count - 1
            filePath = candidateFiles(j)
            fileName = fso.GetFileName(filePath)
            arr(j) = fileName & "|" & filePath
        Next j
        g_Stats_Matches = candidateFiles.Count
        SearchFilesForKeywords = arr
    Else
        SearchFilesForKeywords = Array("No matches found")
    End If

    Set fso            = Nothing
    Set candidateFiles = Nothing
    Set tempFiles      = Nothing
End Function


' ==========================================
' SEARCH WITHIN A RESTRICTED FILE LIST (Refine Search)
'
' ENHANCEMENT #2: Abort returns partial results.
' ==========================================

Function SearchFilesInList(filePaths() As String, fileCount As Integer, _
                            keywords() As String, keywordCount As Integer, _
                            searchContent As Boolean) As Variant

    Dim fso As Object
    Dim candidateFiles As Object, tempFiles As Object
    Dim fileName As String, filePath As String
    Dim i As Integer, currentLevel As Integer, j As Long
    Dim t1 As Double

    Set fso            = CreateObject("Scripting.FileSystemObject")
    Set candidateFiles = CreateObject("System.Collections.ArrayList")

    For i = 0 To fileCount - 1
        candidateFiles.Add filePaths(i)
    Next i

    g_Stats_Searched = fileCount
    t1 = Timer

    For currentLevel = 0 To keywordCount - 1
        If candidateFiles.Count = 0 Then Exit For

        Application.StatusBar = "Refine - pass " & (currentLevel + 1) & " of " & keywordCount & _
                                  "  |  Remaining: " & candidateFiles.Count & _
                                  "  |  Click ABORT to stop"

        Set tempFiles = FilterFilesByKeyword(candidateFiles, keywords(currentLevel), searchContent)

        DoEvents
        ' ENHANCEMENT #2: Return partial results on abort
        If g_AbortRequested Then
            g_Stats_WasAborted = True
            g_Stats_AbortPhase = "keyword searching (refine)"
            g_Stats_SearchSecs = Timer - t1
            g_Stats_Matches    = tempFiles.Count
            If tempFiles.Count > 0 Then
                Dim partArr() As Variant
                ReDim partArr(0 To tempFiles.Count - 1)
                For j = 0 To tempFiles.Count - 1
                    filePath = tempFiles(j)
                    fileName = fso.GetFileName(filePath)
                    partArr(j) = fileName & "|" & filePath
                Next j
                SearchFilesInList = partArr
            Else
                SearchFilesInList = Array("Aborted")
            End If
            Set fso = Nothing
            Set candidateFiles = Nothing
            Set tempFiles = Nothing
            Exit Function
        End If

        Set candidateFiles = tempFiles
    Next currentLevel

    g_Stats_SearchSecs = Timer - t1

    If candidateFiles.Count > 0 Then
        Dim arr() As Variant
        ReDim arr(0 To candidateFiles.Count - 1)
        For j = 0 To candidateFiles.Count - 1
            filePath = candidateFiles(j)
            fileName = fso.GetFileName(filePath)
            arr(j) = fileName & "|" & filePath
        Next j
        g_Stats_Matches = candidateFiles.Count
        SearchFilesInList = arr
    Else
        SearchFilesInList = Array("No matches found")
    End If

    Set fso            = Nothing
    Set candidateFiles = Nothing
    Set tempFiles      = Nothing
End Function


' ==========================================
' FILTER A FILE LIST BY A SINGLE KEYWORD - NAME ONLY
' ==========================================

Function FilterFilesByNameOnly(candidateFiles As Object, keyword As String) As Object
    Dim filteredFiles As Object
    Dim fso As Object
    Dim i As Long
    Dim fileName As String

    Set filteredFiles = CreateObject("System.Collections.ArrayList")
    Set fso           = CreateObject("Scripting.FileSystemObject")

    keyword = LCase(Trim(keyword))
    If keyword = "" Then
        Set FilterFilesByNameOnly = candidateFiles
        GoTo Cleanup
    End If

    For i = 0 To candidateFiles.Count - 1
        DoEvents
        If g_AbortRequested Then
            Set FilterFilesByNameOnly = filteredFiles
            GoTo Cleanup
        End If

        fileName = LCase(fso.GetFileName(candidateFiles(i)))
        If InStr(1, fileName, keyword, vbTextCompare) > 0 Then
            filteredFiles.Add candidateFiles(i)
        End If
    Next i

    Set FilterFilesByNameOnly = filteredFiles

Cleanup:
    Set fso = Nothing
End Function


' ==========================================
' FILTER A FILE LIST BY A SINGLE KEYWORD - NAME OR CONTENT
' ==========================================

Function FilterFilesByKeyword(candidateFiles As Object, keyword As String, _
                               searchContent As Boolean) As Object
    Dim filteredFiles As Object
    Dim fso As Object
    Dim i As Long
    Dim filePath As String, fileName As String
    Dim matchFound As Boolean

    Set filteredFiles = CreateObject("System.Collections.ArrayList")
    Set fso           = CreateObject("Scripting.FileSystemObject")

    keyword = LCase(Trim(keyword))
    If keyword = "" Then
        Set FilterFilesByKeyword = candidateFiles
        GoTo Cleanup
    End If

    For i = 0 To candidateFiles.Count - 1
        DoEvents
        If g_AbortRequested Then
            Set FilterFilesByKeyword = filteredFiles
            GoTo Cleanup
        End If

        filePath   = candidateFiles(i)
        fileName   = LCase(fso.GetFileName(filePath))
        matchFound = False

        If InStr(1, fileName, keyword, vbTextCompare) > 0 Then
            matchFound = True
        End If

        If Not matchFound And searchContent Then
            matchFound = SearchFileContent(filePath, keyword)
        End If

        If matchFound Then filteredFiles.Add filePath
    Next i

    Set FilterFilesByKeyword = filteredFiles

Cleanup:
    Set fso = Nothing
End Function


' ==========================================
' CONTENT SEARCH - dispatcher
' ==========================================

Function SearchFileContent(filePath As String, keyword As String) As Boolean
    On Error Resume Next
    SearchFileContent = False

    If IsExcelFile(filePath) Then
        SearchFileContent = SearchExcelContent(filePath, keyword)
    ElseIf IsTextFile(filePath) Then
        Dim fso As Object, ts As Object, content As String
        Set fso = CreateObject("Scripting.FileSystemObject")
        Set ts  = fso.OpenTextFile(filePath, 1, False)
        If Err.Number = 0 Then
            content = ts.ReadAll
            ts.Close
            If InStr(1, LCase(content), LCase(keyword), vbTextCompare) > 0 Then
                SearchFileContent = True
            End If
        End If
        Set ts  = Nothing
        Set fso = Nothing
    End If

    On Error GoTo 0
End Function


' ==========================================
' EXCEL CONTENT SEARCH
' ==========================================

Function SearchExcelContent(filePath As String, keyword As String) As Boolean
    Dim xlApp As Object, xlBook As Object, xlSheet As Object
    Dim cell As Object
    Dim found As Boolean
    Dim cellVal As String

    SearchExcelContent = False
    found = False

    On Error Resume Next
    Set xlApp = CreateObject("Excel.Application")
    If xlApp Is Nothing Then Exit Function

    xlApp.Visible        = False
    xlApp.DisplayAlerts  = False
    xlApp.ScreenUpdating = False

    Set xlBook = xlApp.Workbooks.Open(filePath, ReadOnly:=True, UpdateLinks:=False)
    On Error GoTo 0

    If xlBook Is Nothing Then
        xlApp.Quit
        Set xlApp = Nothing
        Exit Function
    End If

    Dim lowerKeyword As String
    lowerKeyword = LCase(Trim(keyword))

    For Each xlSheet In xlBook.Worksheets
        If found Then Exit For
        Dim usedRng As Object
        Set usedRng = xlSheet.UsedRange
        For Each cell In usedRng
            cellVal = LCase(CStr(cell.Value))
            If InStr(1, cellVal, lowerKeyword, vbTextCompare) > 0 Then
                found = True
                Exit For
            End If
        Next cell
    Next xlSheet

    xlBook.Close SaveChanges:=False
    xlApp.Quit

    Set cell    = Nothing
    Set usedRng = Nothing
    Set xlSheet = Nothing
    Set xlBook  = Nothing
    Set xlApp   = Nothing

    SearchExcelContent = found
End Function

Function IsTextFile(filePath As String) As Boolean
    Dim ext As String
    ext = LCase(Mid(filePath, InStrRev(filePath, ".") + 1))
    Select Case ext
        Case "txt", "csv", "log", "xml", "json", "ini", "cfg", "md", "html", "htm", _
             "sql", "vbs", "bat"
            IsTextFile = True
        Case Else
            IsTextFile = False
    End Select
End Function

Function IsExcelFile(filePath As String) As Boolean
    Dim ext As String
    ext = LCase(Mid(filePath, InStrRev(filePath, ".") + 1))
    Select Case ext
        Case "xls", "xlsx", "xlsm", "xlsb", "xltx", "xltm"
            IsExcelFile = True
        Case Else
            IsExcelFile = False
    End Select
End Function


' ==========================================
' ROW-LEVEL AND/OR FILTER FOR PREVIEW
'
' AND logic: row included ONLY if ALL AND-keywords appear on same row.
' OR  logic: row included if ANY OR-keyword appears on it.
'            File-level gate (all OR-kw must exist in file) is enforced
'            in CreateFilteredContentSheet before this function is called.
' ==========================================

Function RowMatchesKeywords(lineText As String, andKws As Object, orKws As Object, _
                             hasAnd As Boolean, hasOr As Boolean) As Boolean
    Dim j As Integer
    Dim lineMatchesAnd As Boolean, lineMatchesOr As Boolean

    lineMatchesAnd = True
    If hasAnd Then
        For j = 0 To andKws.Count - 1
            If InStr(1, LCase(lineText), LCase(andKws(j)), vbTextCompare) = 0 Then
                lineMatchesAnd = False
                Exit For
            End If
        Next j
    End If

    lineMatchesOr = True
    If hasOr Then
        lineMatchesOr = False
        For j = 0 To orKws.Count - 1
            If InStr(1, LCase(lineText), LCase(orKws(j)), vbTextCompare) > 0 Then
                lineMatchesOr = True
                Exit For
            End If
        Next j
    End If

    RowMatchesKeywords = lineMatchesAnd And lineMatchesOr
End Function


' ==========================================
' SHARED ABORT + CLEANUP HELPER
'
' ENHANCEMENT #2: Now shows partial results if any were collected,
' rather than just discarding everything.
' ==========================================

Sub HandleAbort(outputWs As Worksheet, startCol As String, startRow As Integer, _
                Optional hasPartialResults As Boolean = False, _
                Optional searchType As String = "", _
                Optional keywordList As String = "")

    Application.Cursor = xlDefault
    Application.StatusBar = False
    g_AbortRequested = False   ' Reset flag so next search starts cleanly

    ' Annotate results area
    Dim col1 As String
    col1 = ColumnLetter(ColumnNumber(startCol))

    If hasPartialResults Then
        ' Partial results are already written - add a banner above them
        outputWs.Range(col1 & (startRow + 0)).Value = _
            "** SEARCH ABORTED - Partial results below (only files processed before abort) **"
        With outputWs.Range(col1 & (startRow + 0))
            .Font.Color  = RGB(192, 0, 0)
            .Font.Bold   = True
            .Font.Italic = True
        End With
    Else
        outputWs.Range(col1 & (startRow + 1)).Value = "Search was aborted. No results available."
        outputWs.Range(col1 & (startRow + 1)).Font.Color  = RGB(192, 0, 0)
        outputWs.Range(col1 & (startRow + 1)).Font.Italic = True
    End If

    ' Show summary (will show aborted state via g_Stats_WasAborted)
    If searchType <> "" Then
        Call ShowSearchSummary(searchType, keywordList)
    Else
        MsgBox "Search aborted." & vbCrLf & vbCrLf & _
               "Excel is fully operational. You can run a new search at any time.", _
               vbInformation, "Search Aborted"
    End If
End Sub


' ==========================================
' WRITE OUTPUT ROWS (shared helper)
'
' ENHANCEMENT #5: All output cells have WrapText = False and
' ShrinkToFit = False. Column overflow is prevented by setting
' VerticalAlignment = xlTop and using fixed column widths.
' This ensures file names and paths never bleed into adjacent cells.
' ==========================================

Sub WriteOutputRow(outputWs As Worksheet, col1 As String, col2 As String, _
                   dataRow As Long, fileName As String, filePath As String, _
                   rowIndex As Long)

    ' File name as hyperlink
    outputWs.Hyperlinks.Add Anchor:=outputWs.Range(col1 & dataRow), _
        Address:=filePath, TextToDisplay:=fileName
    With outputWs.Range(col1 & dataRow)
        .Font.Color          = RGB(5, 99, 193)
        .Font.Underline       = xlUnderlineStyleSingle
        ' ENHANCEMENT #5: Prevent overflow
        .WrapText             = False
        .ShrinkToFit          = False
        .HorizontalAlignment  = xlLeft
        .VerticalAlignment    = xlTop
    End With

    ' File path cell
    With outputWs.Range(col2 & dataRow)
        .Value               = filePath
        .Font.Size           = 9
        ' ENHANCEMENT #5: Prevent overflow
        .WrapText             = False
        .ShrinkToFit          = False
        .HorizontalAlignment  = xlLeft
        .VerticalAlignment    = xlTop
    End With

    ' Alternating row shading
    If rowIndex Mod 2 = 0 Then
        outputWs.Range(col1 & dataRow & ":" & col2 & dataRow).Interior.Color = RGB(242, 242, 242)
    End If
End Sub


' ==========================================
' USER-FACING MACRO 1: SEARCH BY NAME ONLY
' ==========================================

Sub RunSearchByNameOnly()
    Dim folderPath As String
    Dim keywords(0 To MAX_KEYWORDS - 1) As String
    Dim keywordCount As Integer
    Dim results As Variant
    Dim ws As Worksheet, outputWs As Worksheet
    Dim i As Long
    Dim resultParts() As String
    Dim fileName As String, filePath As String
    Dim keywordList As String
    Dim startCol As String, startRow As Integer
    Dim col1 As String, col2 As String
    Dim startDate As Date, endDate As Date
    Dim useDateFilter As Boolean

    g_AbortRequested = False
    Call ResetStats

    Set ws         = ThisWorkbook.Sheets("Search")
    folderPath     = Trim(ws.Range("B4").Value)
    startCol       = GetOutputStartColumn()
    startRow       = GetOutputStartRow()
    col1           = ColumnLetter(ColumnNumber(startCol))
    col2           = ColumnLetter(ColumnNumber(startCol) + 1)

    Call ReadDateRange(folderPath, startDate, endDate, useDateFilter)
    If Err.Number <> 0 Then Exit Sub

    keywordCount = 0
    keywordList  = ""
    For i = 0 To MAX_KEYWORDS - 1
        keywords(i) = Trim(ws.Range("B" & (11 + i)).Value)
        If keywords(i) <> "" Then
            keywordCount = keywordCount + 1
            If keywordList <> "" Then keywordList = keywordList & ", "
            keywordList = keywordList & """" & keywords(i) & """"
        End If
    Next i

    If folderPath = "" Then MsgBox "Please enter a folder path in cell B4.", vbExclamation: Exit Sub
    If keywordCount = 0 Then MsgBox "Please enter at least one keyword (cells B11 onwards).", vbExclamation: Exit Sub

    Set outputWs = GetOutputWorksheet()
    Call ClearResultsArea(outputWs, startCol, startRow)

    Application.StatusBar = "Searching file names for " & keywordCount & " keyword(s)..."

    results = SearchFilesForKeywords(folderPath, keywords, keywordCount, False, _
                                      startDate, endDate, useDateFilter)

    ' ---- Handle Abort ----
    If UBound(results) = 0 And results(0) = "Aborted" Then
        Call HandleAbort(outputWs, startCol, startRow, False, "Name Only", keywordList)
        Exit Sub
    End If

    ' ---- Partial abort results (array has real data but was aborted) ----
    Dim wasPartialAbort As Boolean
    wasPartialAbort = g_Stats_WasAborted And Not (UBound(results) = 0 And results(0) = "Aborted")

    Call WriteResultsSectionHeader(outputWs, startCol, True)
    Call WriteResultsColumnHeaders(outputWs, col1, col2, "", startRow, False)

    If UBound(results) = 0 Then
        If InStr(1, results(0), "Error:") > 0 Or results(0) = "No matches found" Then
            outputWs.Range(col1 & (startRow + 1)).Value = results(0)
            Application.StatusBar = False
            MsgBox results(0), IIf(InStr(results(0), "Error") > 0, vbExclamation, vbInformation)
            Exit Sub
        End If
    End If

    outputWs.Columns(HELPER_COL).Hidden = False
    For i = LBound(results) To UBound(results)
        resultParts = Split(results(i), "|")
        fileName    = resultParts(0)
        filePath    = resultParts(1)

        ' ENHANCEMENT #5: Use WriteOutputRow for consistent formatting
        Call WriteOutputRow(outputWs, col1, col2, startRow + 1 + i, fileName, filePath, i)

        outputWs.Range(HELPER_COL & (startRow + 1 + i)).Value = filePath
    Next i

    outputWs.Columns(HELPER_COL).Hidden = True
    Call FormatResultsTable(outputWs, col1, col2, startRow, UBound(results))
    If UCase(RESULT_DISPLAY_MODE) = "SEPARATE_SHEET" Then Call AddBackButton(outputWs)

    Application.StatusBar = False

    If wasPartialAbort Then
        Call HandleAbort(outputWs, startCol, startRow, True, "Name Only", keywordList)
    Else
        Call ShowSearchSummary("Name Only", keywordList)
    End If
End Sub


