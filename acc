"""
═══════════════════════════════════════════════════════════════════════════════
AUTOMATED DATA EXTRACTOR - Configuration-Driven File Processor
═══════════════════════════════════════════════════════════════════════════════

DESCRIPTION:
    Monitors a network folder for incoming Excel/CSV files, automatically extracts
    specified columns and rows from configured sheets, and saves output files to
    a designated output folder.

FEATURES:
    ✓ Configuration-driven (edit CONFIG section below)
    ✓ Automatic file detection and processing
    ✓ Multi-sheet support
    ✓ Flexible column/row selection
    ✓ Configurable header handling (include/exclude headers)
    ✓ Preserves exact decimal precision (no scientific notation)
    ✓ Preserves exact numeric format from source
    ✓ Comprehensive error handling and logging
    ✓ No code changes needed for different sheets/columns

REQUIREMENTS:
    pip install pandas openpyxl xlrd

QUICK START:
    1. Edit the CONFIG section below with your settings
    2. Run: python data_extractor_single.py
    3. Place files in input folder - they'll be processed automatically

CONFIGURATION GUIDE:
    
    INPUT_FOLDER / OUTPUT_FOLDER:
        - Network paths: "//server/share/folder" or "\\\\server\\share\\folder"
        - Local paths: "C:/data/input" or "./input"
    
    SHEETS_CONFIG:
        Each dictionary defines one sheet to process:
        {
            'sheet_name': 'A',              # Exact sheet name (case-sensitive)
            'columns': ['P', 'Q', 'R'],     # Columns to extract (letters or numbers)
            'row_start': 2,                 # First row (1-based)
            'row_end': 100,                 # Last row (1-based, inclusive)
            'input_has_header': False,      # Does INPUT file have header row?
            'output_has_header': False,     # Should OUTPUT file include header?
            'output_file': 'SheetA.csv',    # Output filename
            'output_format': 'csv'          # 'csv' or 'xlsx'
        }
    
    HEADER HANDLING:
        input_has_header:
            - True: First row of input is treated as header (will be skipped in data)
            - False: First row of input contains data (no header row exists)
        
        output_has_header:
            - True: Output file will have a header row
            - False: Output file will have NO header row (pure data only)
        
        Examples:
            # Input has header, output should also have header
            'input_has_header': True, 'output_has_header': True
            
            # Input has NO header, output should also have NO header
            'input_has_header': False, 'output_has_header': False
            
            # Input has header but you want output without header
            'input_has_header': True, 'output_has_header': False
    
    COLUMN SPECIFICATION:
        - Use Excel letters: ['A', 'B', 'C'] or ['P', 'Q', 'R']
        - Use numbers (0-based): [0, 1, 2] or [15, 16, 17]
        - Can mix: ['A', 5, 'Z']
    
    ROW RANGE:
        - row_start and row_end are 1-based (first row = 1)
        - Counts ONLY data rows (excludes header if input_has_header=True)
        - Example: If input has header, row_start=1 means first data row after header
    
    POST_PROCESS_ACTION:
        - 'none': Leave file in input folder
        - 'move': Move to ARCHIVE_FOLDER
        - 'delete': Delete file (be careful!)

DECIMAL PRECISION:
    The script preserves EXACT decimal representation:
    - Input: 0.0000000000673849 → Output: 0.0000000000673849 (NOT 6.73849e-11)
    - Input: 123.456789012345678 → Output: 123.456789012345678
    - No rounding, no scientific notation, exact format preserved

EXAMPLES:

    Example 1: Input has NO header, extract all rows as-is with NO header in output
    {
        'sheet_name': 'Sheet1',
        'columns': ['A', 'B', 'C'],
        'row_start': 1,
        'row_end': 100,
        'input_has_header': False,    # Input file has NO header row
        'output_has_header': False,   # Output file should have NO header
        'output_file': 'data_no_header.csv',
        'output_format': 'csv'
    }
    
    Example 2: Input has header in row 1, extract data rows 1-99, no header in output
    {
        'sheet_name': 'Sheet1',
        'columns': ['A', 'B', 'C'],
        'row_start': 1,
        'row_end': 99,
        'input_has_header': True,     # Row 1 is header (will skip it)
        'output_has_header': False,   # Output should NOT have header
        'output_file': 'data_only.csv',
        'output_format': 'csv'
    }
    
    Example 3: Input has header, output should also have header
    {
        'sheet_name': 'Sheet1',
        'columns': ['P', 'Q', 'R'],
        'row_start': 1,
        'row_end': 50,
        'input_has_header': True,     # Row 1 is header
        'output_has_header': True,    # Output should include header
        'output_file': 'data_with_header.csv',
        'output_format': 'csv'
    }

TROUBLESHOOTING:
    
    Problem: "Input folder does not exist"
    → Check folder path is correct and accessible
    
    Problem: "Sheet 'A' not found"
    → Verify sheet name matches exactly (case-sensitive)
    → Open Excel file to check actual sheet names
    
    Problem: "Column out of range"
    → Verify columns exist in the sheet
    → Check column letters are correct
    
    Problem: Files not detected
    → Check FILE_PATTERNS includes your file extension
    → Ensure file is completely copied (not in progress)
    → Verify file is not locked/open in Excel
    
    Problem: First row missing in output
    → Check input_has_header setting - if True, first row is treated as header
    → Set input_has_header=False if your input has no header
    
    Problem: Output has "Unnamed" headers
    → Set output_has_header=False to remove all headers from output
    
    Problem: Numbers appear in scientific notation
    → This is now fixed - exact decimal format is preserved
    → Check output file in text editor to verify

═══════════════════════════════════════════════════════════════════════════════
"""

import os
import time
import logging
from datetime import datetime
from pathlib import Path
import pandas as pd
from typing import Dict, List, Optional
import sys


# ═══════════════════════════════════════════════════════════════════════════
# CONFIGURATION SECTION - EDIT THIS TO CUSTOMIZE BEHAVIOR
# ═══════════════════════════════════════════════════════════════════════════

# Input and Output Folders
INPUT_FOLDER = "//server/share/FolderX"  # Where input files arrive
OUTPUT_FOLDER = "//server/share/FolderY"  # Where output files are saved

# File Detection Settings
FILE_PATTERNS = ['.csv', '.xlsx', '.xls']  # File types to monitor
POLL_INTERVAL = 5  # Seconds between checks for new files

# Post-Processing Action
POST_PROCESS_ACTION = 'move'  # Options: 'none', 'move', 'delete'
ARCHIVE_FOLDER = "//server/share/archive"  # Where to move processed files

# Sheet Processing Configuration
# Add as many sheets as needed - each becomes a separate output file
SHEETS_CONFIG = [
    {
        'sheet_name': 'A',
        'columns': ['P', 'Q', 'R'],
        'row_start': 1,              # First data row to extract (1-based)
        'row_end': 100,              # Last data row to extract (1-based)
        'input_has_header': False,   # Does the INPUT file have a header row?
        'output_has_header': False,  # Should the OUTPUT file include a header row?
        'output_file': 'SheetA_output.csv',
        'output_format': 'csv'
    },
    {
        'sheet_name': 'B',
        'columns': ['A', 'D', 'E', 'F'],
        'row_start': 1,
        'row_end': 50,
        'input_has_header': False,
        'output_has_header': False,
        'output_file': 'SheetB_output.xlsx',
        'output_format': 'xlsx'
    },
    {
        'sheet_name': 'C',
        'columns': ['B', 'C', 'G', 'H', 'I'],
        'row_start': 1,
        'row_end': 200,
        'input_has_header': True,    # This sheet has header in row 1
        'output_has_header': False,  # But we don't want header in output
        'output_file': 'SheetC_output.csv',
        'output_format': 'csv'
    },
]

# Logging Configuration
LOG_DIRECTORY = 'logs'
LOG_LEVEL = 'INFO'  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# ═══════════════════════════════════════════════════════════════════════════
# END OF CONFIGURATION - DO NOT MODIFY BELOW THIS LINE
# ═══════════════════════════════════════════════════════════════════════════


class DataExtractor:
    """Main class for automated data extraction from Excel/CSV files."""
    
    def __init__(self):
        """Initialize the DataExtractor with configured settings."""
        self._setup_logging()
        self.logger.info("="*80)
        self.logger.info("Data Extractor initialized successfully")
        self.logger.info("="*80)
    
    def _setup_logging(self):
        """Configure logging to file and console."""
        # Create log directory if it doesn't exist
        Path(LOG_DIRECTORY).mkdir(parents=True, exist_ok=True)
        
        # Generate log filename with timestamp
        log_filename = f"data_extractor_{datetime.now().strftime('%Y%m%d_%H%M%S')}.log"
        log_path = os.path.join(LOG_DIRECTORY, log_filename)
        
        # Configure logging format
        logging.basicConfig(
            level=getattr(logging, LOG_LEVEL.upper()),
            format='%(asctime)s - %(levelname)s - %(message)s',
            handlers=[
                logging.FileHandler(log_path),
                logging.StreamHandler(sys.stdout)
            ]
        )
        
        self.logger = logging.getLogger(__name__)
    
    def _validate_folders(self) -> bool:
        """
        Validate that input and output folders exist and are accessible.
        
        Returns:
            True if folders are valid, False otherwise
        """
        # Check input folder exists
        if not os.path.exists(INPUT_FOLDER):
            self.logger.error(f"Input folder does not exist: {INPUT_FOLDER}")
            return False
        
        # Check read permission on input folder
        if not os.access(INPUT_FOLDER, os.R_OK):
            self.logger.error(f"No read permission for input folder: {INPUT_FOLDER}")
            return False
        
        # Create output folder if it doesn't exist
        try:
            Path(OUTPUT_FOLDER).mkdir(parents=True, exist_ok=True)
            self.logger.info(f"Output folder ready: {OUTPUT_FOLDER}")
        except PermissionError:
            self.logger.error(f"No write permission for output folder: {OUTPUT_FOLDER}")
            return False
        except Exception as e:
            self.logger.error(f"Error creating output folder: {e}")
            return False
        
        self.logger.info(f"Input folder validated: {INPUT_FOLDER}")
        return True
    
    def _detect_new_file(self) -> Optional[str]:
        """
        Monitor input folder and detect new files matching configured patterns.
        
        Returns:
            Full path to detected file, or None if no file found
        """
        try:
            # List all files in input folder
            for file in os.listdir(INPUT_FOLDER):
                file_path = os.path.join(INPUT_FOLDER, file)
                
                # Skip directories
                if os.path.isdir(file_path):
                    continue
                
                # Check if file matches any configured pattern
                file_lower = file.lower()
                for pattern in FILE_PATTERNS:
                    if file_lower.endswith(pattern.lower()):
                        self.logger.info(f"New file detected: {file}")
                        return file_path
            
            return None
        
        except PermissionError:
            self.logger.error(f"Permission denied accessing input folder: {INPUT_FOLDER}")
            return None
        except Exception as e:
            self.logger.error(f"Error detecting files: {e}")
            return None
    
    def _read_file(self, file_path: str, has_header: bool) -> Optional[Dict[str, pd.DataFrame]]:
        """
        Read input file (Excel or CSV) in read-only mode.
        
        Args:
            file_path: Full path to input file
            has_header: Whether the file has a header row
            
        Returns:
            Dictionary mapping sheet names to DataFrames, or None on error
        """
        self.logger.info(f"Reading file: {file_path}")
        
        try:
            # Determine file type by extension
            file_ext = os.path.splitext(file_path)[1].lower()
            
            # Set header parameter based on configuration
            # If has_header=True, header=0 (use first row as header)
            # If has_header=False, header=None (no header, all rows are data)
            header_param = 0 if has_header else None
            
            if file_ext in ['.xlsx', '.xls', '.xlsm']:
                # Read Excel file - all sheets
                engine = 'openpyxl' if file_ext == '.xlsx' else None
                sheets_dict = pd.read_excel(
                    file_path, 
                    sheet_name=None, 
                    engine=engine,
                    header=header_param,  # Control header reading
                    dtype=str  # Read all data as strings to preserve exact format
                )
                self.logger.info(f"Excel file read successfully. Sheets: {list(sheets_dict.keys())}")
                return sheets_dict
            
            elif file_ext == '.csv':
                # Read CSV file - treat as single sheet
                df = pd.read_csv(
                    file_path,
                    header=header_param,  # Control header reading
                    dtype=str  # Read all data as strings to preserve exact format
                )
                sheets_dict = {'Sheet1': df}
                self.logger.info(f"CSV file read successfully. Rows: {len(df)}")
                return sheets_dict
            
            else:
                self.logger.error(f"Unsupported file format: {file_ext}")
                return None
        
        except FileNotFoundError:
            self.logger.error(f"File not found: {file_path}")
            return None
        except PermissionError:
            self.logger.error(f"Permission denied reading file: {file_path}")
            return None
        except Exception as e:
            self.logger.error(f"Error reading file: {e}")
            return None
    
    def _convert_column_letter_to_index(self, column_letter: str) -> int:
        """
        Convert Excel column letter (e.g., 'A', 'AB') to zero-based index.
        
        Args:
            column_letter: Column letter (e.g., 'A', 'B', 'AA')
            
        Returns:
            Zero-based column index
        """
        column_letter = column_letter.upper()
        index = 0
        for i, char in enumerate(reversed(column_letter)):
            index += (ord(char) - ord('A') + 1) * (26 ** i)
        return index - 1
    
    def _extract_data_from_sheet(self, df: pd.DataFrame, sheet_config: Dict) -> Optional[pd.DataFrame]:
        """
        Extract specific columns and rows from a DataFrame based on configuration.
        Preserves exact format from source (no scientific notation).
        
        Args:
            df: Source DataFrame
            sheet_config: Configuration for this sheet (columns, rows)
            
        Returns:
            Extracted DataFrame, or None on error
        """
        try:
            # Get column configuration
            columns = sheet_config.get('columns', [])
            if not columns:
                self.logger.error("No columns specified in configuration")
                return None
            
            # Convert column letters to indices
            column_indices = []
            for col in columns:
                if isinstance(col, str):
                    # Column specified as letter (e.g., 'A', 'B')
                    col_index = self._convert_column_letter_to_index(col)
                else:
                    # Column specified as number (0-based)
                    col_index = col
                
                column_indices.append(col_index)
            
            # Validate column indices
            max_col = df.shape[1]
            for idx in column_indices:
                if idx >= max_col:
                    self.logger.error(f"Column index {idx} out of range (max: {max_col-1})")
                    return None
            
            # Extract columns by position
            extracted_df = df.iloc[:, column_indices].copy()
            
            # Get row range configuration
            row_start = sheet_config.get('row_start', 1)  # 1-based in config
            row_end = sheet_config.get('row_end', len(df))  # 1-based in config
            
            # Convert to 0-based indexing for pandas
            # Note: If input had header, pandas already removed it, so row 1 = index 0
            row_start_idx = row_start - 1
            row_end_idx = row_end
            
            # Validate row range
            if row_start_idx < 0:
                self.logger.warning(f"row_start < 1, using 1")
                row_start_idx = 0
            
            if row_end_idx > len(df):
                self.logger.warning(f"row_end exceeds data length, using {len(df)}")
                row_end_idx = len(df)
            
            # Extract rows
            extracted_df = extracted_df.iloc[row_start_idx:row_end_idx]
            
            self.logger.info(f"Extracted data: {extracted_df.shape[0]} rows, {extracted_df.shape[1]} columns")
            
            return extracted_df
        
        except Exception as e:
            self.logger.error(f"Error extracting data from sheet: {e}")
            return None
    
    def _generate_output_filename(self, config_filename: str, original_filename: str) -> str:
        """
        Generate output filename with timestamp if needed.
        
        Args:
            config_filename: Filename from configuration
            original_filename: Original input filename
            
        Returns:
            Generated filename with timestamp
        """
        # Get timestamp
        timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')
        
        # Get original filename without extension
        original_name_only = os.path.splitext(os.path.basename(original_filename))[0]
        
        # If filename contains placeholders, replace them
        filename = config_filename
        if '{timestamp}' in filename:
            filename = filename.replace('{timestamp}', timestamp)
        elif not any(x in filename for x in ['.csv', '.xlsx']):
            # If no extension and no timestamp placeholder, add timestamp
            name, ext = os.path.splitext(filename)
            filename = f"{name}_{timestamp}{ext if ext else '.csv'}"
        
        return filename
    
    def _save_output_file(self, df: pd.DataFrame, output_path: str, file_format: str, include_header: bool):
        """
        Save extracted data to output file preserving exact decimal format.
        
        Args:
            df: DataFrame to save (all values are strings preserving exact format)
            output_path: Full path for output file
            file_format: Format to save ('csv', 'xlsx', etc.)
            include_header: Whether to include header row in output
        """
        try:
            if file_format.lower() == 'csv':
                # Save as CSV with exact string representation (no formatting)
                # Data is already in string format, so it will preserve exact decimals
                df.to_csv(
                    output_path, 
                    index=False, 
                    header=include_header,  # Control header output
                    quoting=1  # Quote non-numeric fields only
                )
                self.logger.info(f"CSV file saved: {output_path}")
                if not include_header:
                    self.logger.info("  Output file has NO header row (pure data only)")
            
            elif file_format.lower() in ['xlsx', 'excel']:
                # Save as Excel preserving exact string representation
                with pd.ExcelWriter(output_path, engine='openpyxl') as writer:
                    df.to_excel(
                        writer, 
                        index=False, 
                        header=include_header,  # Control header output
                        sheet_name='Data'
                    )
                self.logger.info(f"Excel file saved: {output_path}")
                if not include_header:
                    self.logger.info("  Output file has NO header row (pure data only)")
            
            else:
                self.logger.error(f"Unsupported output format: {file_format}")
        
        except PermissionError:
            self.logger.error(f"Permission denied writing to: {output_path}")
        except Exception as e:
            self.logger.error(f"Error saving output file: {e}")
    
    def _process_file(self, file_path: str):
        """
        Main processing logic: read file, extract data, generate outputs.
        
        Args:
            file_path: Full path to input file
        """
        self.logger.info("="*80)
        self.logger.info(f"Starting file processing: {os.path.basename(file_path)}")
        self.logger.info("="*80)
        
        # Process each configured sheet
        for sheet_config in SHEETS_CONFIG:
            sheet_name = sheet_config.get('sheet_name')
            input_has_header = sheet_config.get('input_has_header', False)
            output_has_header = sheet_config.get('output_has_header', False)
            
            self.logger.info(f"\nProcessing sheet: {sheet_name}")
            self.logger.info(f"  Input has header: {input_has_header}")
            self.logger.info(f"  Output should have header: {output_has_header}")
            
            # Read input file with appropriate header setting for this sheet
            sheets_dict = self._read_file(file_path, input_has_header)
            if sheets_dict is None:
                self.logger.error("Failed to read input file. Skipping this sheet.")
                continue
            
            # Check if sheet exists in file
            if sheet_name not in sheets_dict:
                self.logger.error(f"Sheet '{sheet_name}' not found in file. Available sheets: {list(sheets_dict.keys())}")
                continue
            
            # Get DataFrame for this sheet
            df = sheets_dict[sheet_name]
            
            # Extract data based on configuration
            extracted_df = self._extract_data_from_sheet(df, sheet_config)
            if extracted_df is None or extracted_df.empty:
                self.logger.error(f"No data extracted from sheet '{sheet_name}'")
                continue
            
            # Generate output filename
            output_filename = self._generate_output_filename(
                sheet_config.get('output_file', 'output.csv'),
                os.path.basename(file_path)
            )
            
            # Get output format
            output_format = sheet_config.get('output_format', 'csv')
            
            # Ensure output filename has correct extension
            if not output_filename.endswith(f'.{output_format}'):
                output_filename = f"{os.path.splitext(output_filename)[0]}.{output_format}"
            
            # Create full output path
            output_path = os.path.join(OUTPUT_FOLDER, output_filename)
            
            # Save output file with header control
            self._save_output_file(extracted_df, output_path, output_format, output_has_header)
        
        self.logger.info("="*80)
        self.logger.info(f"File processing completed: {os.path.basename(file_path)}")
        self.logger.info("="*80)
    
    def _move_processed_file(self, file_path: str):
        """
        Move or delete processed file based on configuration.
        
        Args:
            file_path: Path to processed file
        """
        if POST_PROCESS_ACTION == 'delete':
            try:
                os.remove(file_path)
                self.logger.info(f"Deleted processed file: {file_path}")
            except Exception as e:
                self.logger.error(f"Error deleting file: {e}")
        
        elif POST_PROCESS_ACTION == 'move':
            try:
                # Create archive folder if it doesn't exist
                Path(ARCHIVE_FOLDER).mkdir(parents=True, exist_ok=True)
                
                # Generate archive filename with timestamp
                timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')
                filename = os.path.basename(file_path)
                name, ext = os.path.splitext(filename)
                archive_filename = f"{name}_{timestamp}{ext}"
                archive_path = os.path.join(ARCHIVE_FOLDER, archive_filename)
                
                # Move file
                os.rename(file_path, archive_path)
                self.logger.info(f"Moved processed file to: {archive_path}")
            except Exception as e:
                self.logger.error(f"Error moving file to archive: {e}")
        
        else:
            # 'none' - leave file in place
            self.logger.info(f"File left in place: {file_path}")
    
    def run(self):
        """
        Main execution loop: monitor input folder and process files as they arrive.
        """
        # Validate folders before starting
        if not self._validate_folders():
            self.logger.error("Folder validation failed. Exiting.")
            return
        
        self.logger.info(f"Starting monitoring loop (polling every {POLL_INTERVAL} seconds)")
        self.logger.info("Press Ctrl+C to stop")
        
        try:
            while True:
                # Check for new file
                file_path = self._detect_new_file()
                
                if file_path:
                    # Process the detected file
                    self._process_file(file_path)
                    
                    # Handle processed file (move/delete/leave)
                    self._move_processed_file(file_path)
                
                # Wait before next check
                time.sleep(POLL_INTERVAL)
        
        except KeyboardInterrupt:
            self.logger.info("\nMonitoring stopped by user")
        except Exception as e:
            self.logger.error(f"Unexpected error in main loop: {e}")


def main():
    """Entry point for the script."""
    print("\n" + "="*80)
    print("DATA EXTRACTOR - Automated File Processing")
    print("="*80)
    print(f"\nConfiguration:")
    print(f"  Input Folder:  {INPUT_FOLDER}")
    print(f"  Output Folder: {OUTPUT_FOLDER}")
    print(f"  Sheets to Process: {len(SHEETS_CONFIG)}")
    for i, config in enumerate(SHEETS_CONFIG, 1):
        print(f"\n  Sheet {i}: {config['sheet_name']}")
        print(f"    - Input has header: {config.get('input_has_header', False)}")
        print(f"    - Output has header: {config.get('output_has_header', False)}")
        print(f"    - Columns: {config['columns']}")
        print(f"    - Rows: {config['row_start']} to {config['row_end']}")
    print(f"\n  Poll Interval: {POLL_INTERVAL} seconds")
    print(f"  Post-Process: {POST_PROCESS_ACTION}")
    print("\n" + "="*80 + "\n")
    
    # Create and run extractor
    extractor = DataExtractor()
    extractor.run()


if __name__ == "__main__":
    main()
