    def delete_file_and_screenshot(self, filekey, path_entry):
        file_path = path_entry.get()
        screenshot_path = file_path.replace(".xlsm", ".png").replace(".xlsx", ".png") # stub
        try:
            if os.path.exists(file_path):
                os.remove(file_path)
            if os.path.exists(screenshot_path):
                os.remove(screenshot_path)
            messagebox.showinfo("Deleted", "File and Screenshot deleted!")
            path_entry.delete(0, tk.END)
        except Exception as e:
            messagebox.showerror("Delete Error", str(e))

    def confirmation_popup(self, parent_popup):
        cp = tk.Toplevel(parent_popup)
        cp.title("Confirmation")
        ttk.Label(cp, text="Draft saved. Continue, Back to File Selection, or Exit?").pack(padx=20, pady=15)
        btn_frame = ttk.Frame(cp)
        btn_frame.pack(pady=10)
        def do_continue():
            parent_popup.del_btn.config(state="disabled")
            cp.destroy()
            parent_popup.del_btn.config(state="normal") # fields reset if needed
        def do_back():
            cp.destroy()
            parent_popup.destroy()
        def do_exit():
            self.root.destroy()
        ttk.Button(btn_frame, text="Continue", command=do_continue).pack(side="left", padx=10)
        ttk.Button(btn_frame, text="Back", command=do_back).pack(side="left", padx=10)
        ttk.Button(btn_frame, text="Exit", command=do_exit).pack(side="left", padx=10)

    def onclosing(self):
        self.root.destroy()

