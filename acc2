### Algorithm 3: Screenshot Capture Engine

```
FUNCTION capture_screenshots()
    INPUT:
        - file_path: String (Excel file path)
        - config: Dictionary (screenshot configuration)
    
    OUTPUT:
        - screenshot_paths: List of screenshot info dictionaries
    
    BEGIN
        1. Initialize screenshot_paths as empty list
        
        2. Initialize COM
           pythoncom.CoInitialize()
        
        3. TRY:
            a. excel ← CREATE Excel.Application (COM object)
            b. excel.Visible ← FALSE
            c. excel.DisplayAlerts ← FALSE
        CATCH Exception:
            TRY alternative COM initialization methods
        
        4. TRY:
            a. workbook ← excel.Workbooks.Open(file_path)
        CATCH Exception:
            LOG error
            CLEANUP and RETURN empty list
        
        5. file_folder ← EXTRACT directory from file_path
        
        6. IF smart_linking is enabled THEN
            a. Capture master sheet:
                i. master_sheet ← config['master_sheet']
                ii. master_range ← config['master_range']
                iii. screenshot_info ← capture_single_screenshot(
                        workbook, master_sheet, master_range, "Master", file_folder
                     )
                iv. APPEND screenshot_info TO screenshot_paths
            
            b. Analyze linked sheets:
                i. conditional_sheets ← analyze_linked_sheets(workbook, config)
                
                ii. FOR EACH sheet_config IN conditional_sheets DO
                    - screenshot_info ← capture_single_screenshot(
                            workbook,
                            sheet_config['sheet_name'],
                            sheet_config['cell_range'],
                            sheet_config['name'],
                            file_folder,
                            sheet_config['embed'],
                            sheet_config['attach']
                      )
                    - APPEND screenshot_info TO screenshot_paths
        
        ELSE (standard mode):
            a. screenshots_config ← config['screenshots']
            
            b. FOR EACH screenshot_config IN screenshots_config DO
                i. screenshot_info ← capture_single_screenshot(
                        workbook,
                        screenshot_config['sheet_name'],
                        screenshot_config['cell_range'],
                        screenshot_config['name'],
                        file_folder,
                        screenshot_config['embed'],
                        screenshot_config['attach']
                   )
                ii. APPEND screenshot_info TO screenshot_paths
        
        7. CLEANUP:
            a. workbook.Close(SaveChanges=FALSE)
            b. excel.Quit()
            c. pythoncom.CoUninitialize()
        
        8. RETURN screenshot_paths
    END


FUNCTION capture_single_screenshot()
    INPUT:
        - workbook: Excel Workbook object
        - sheet_name: String
        - cell_range: String (e.g., "A1:Z50")
        - name: String (screenshot name)
        - folder: String (save folder path)
        - embed: Boolean (default TRUE)
        - attach: Boolean (default FALSE)
    
    OUTPUT:
        - screenshot_info: Dictionary
    
    BEGIN
        1. TRY:
            a. sheet ← workbook.Sheets(sheet_name)
            
            b. range_obj ← sheet.Range(cell_range)
            
            c. Copy range as picture to clipboard:
               range_obj.CopyPicture(Format=2)
            
            d. WAIT 1 second (for clipboard operation)
            
            e. img ← ImageGrab.grabclipboard()
            
            f. IF img is NULL THEN
                LOG "Failed to capture"
                RETURN NULL
            
            g. save_path ← JOIN(folder, name + ".png")
            
            h. img.save(save_path, 'PNG')
            
            i. screenshot_info ← CREATE dictionary:
                {
                    'path': save_path,
                    'name': name,
                    'embed': embed,
                    'attach': attach
                }
            
            j. LOG "Saved: " + name
            
            k. RETURN screenshot_info
        
        CATCH Exception as e:
            LOG "Error capturing " + name + ": " + e
            RETURN NULL
    END
```

**Screenshot Capture Flow:**

```
Excel Range → CopyPicture() → Windows Clipboard → PIL ImageGrab → PNG File
```

