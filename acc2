def apply_column_combination(self, result_rows, columns_to_combine, new_column_name, reference_column='', repeat_columns=None):
    """Combine multiple columns into separate rows with optional reference-based repetition
    
    Args:
        result_rows: List of row dictionaries
        columns_to_combine: List of column names to combine
        new_column_name: Name for the new combined column
        reference_column: Column to use as reference for repetition (optional)
        repeat_columns: List of columns whose values should repeat (optional)
    
    Returns:
        List of row dictionaries with combined column and numbering, each value in separate row
    """
    if not columns_to_combine or not new_column_name:
        return result_rows
    
    if repeat_columns is None:
        repeat_columns = []
    
    combined_rows = []
    
    for row in result_rows:
        # Collect all values from all columns to combine
        column_values = {}  # {column_name: [list of values]}
        
        for col in columns_to_combine:
            if col in row and row[col]:
                value = row[col]
                # Split multi-values
                if isinstance(value, str) and (',' in value or ';' in value):
                    split_vals = self.split_multi_values(value)
                    column_values[col] = [v for v in split_vals if v]
                else:
                    column_values[col] = [str(value)] if value else []
            else:
                column_values[col] = []
        
        # Get reference column values if specified
        ref_values = []
        if reference_column and reference_column in column_values:
            ref_values = column_values[reference_column]
        
        # If no reference or no repeat columns, just combine all values
        if not reference_column or not repeat_columns or not ref_values:
            # Simple combination - all values in order, each in separate row
            all_values = []
            for col in columns_to_combine:
                all_values.extend(column_values.get(col, []))
            
            # Create one row per value
            for value in all_values:
                new_row = {}
                # Copy non-combined columns
                for key, val in row.items():
                    if key not in columns_to_combine:
                        new_row[key] = val
                # Add combined column with single value
                new_row[new_column_name] = value
                combined_rows.append(new_row)
        
        else:
            # Reference-based repetition with CORRECT ordering and numbering
            other_columns = [col for col in columns_to_combine 
                           if col != reference_column and col not in repeat_columns]
            
            # Collect all repeat values (will be the same for each reference iteration)
            all_repeat_values = []
            for repeat_col in repeat_columns:
                all_repeat_values.extend(column_values.get(repeat_col, []))
            
            # For each reference value, add repeated columns + reference value
            for ref_idx, ref_val in enumerate(ref_values):
                # 1. Add all repeat values with sequential numbering
                for seq_num, repeat_val in enumerate(all_repeat_values, start=1):
                    new_row = {}
                    # Copy non-combined columns
                    for key, val_orig in row.items():
                        if key not in columns_to_combine:
                            new_row[key] = val_orig
                    # Add combined column value
                    new_row[new_column_name] = repeat_val
                    # Add numbering column with sequential number
                    new_row['Numbering'] = f"{ref_val}_{seq_num}"
                    combined_rows.append(new_row)
                
                # 2. Add the reference value itself AFTER repeated values
                new_row = {}
                for key, val_orig in row.items():
                    if key not in columns_to_combine:
                        new_row[key] = val_orig
                new_row[new_column_name] = ref_val
                new_row['Numbering'] = f"{ref_val}_o"
                combined_rows.append(new_row)
            
            # 3. Add values from other (non-repeat, non-reference) columns - only once at the end
            for other_col in other_columns:
                other_vals = column_values.get(other_col, [])
                
                for val in other_vals:
                    new_row = {}
                    for key, val_orig in row.items():
                        if key not in columns_to_combine:
                            new_row[key] = val_orig
                    new_row[new_column_name] = val
                    new_row['Numbering'] = f"{other_col}_o"
                    combined_rows.append(new_row)
    
    return combined_rows


def apply_reference_mapping(self, stage1_data, combined_column_name, mapping_df, new_column_name, reference_values, repeat_values):
    """Apply reference-based mapping using the Numbering column
    
    The mapping follows the numbering pattern:
    - If b1 maps to z1, then all rows with numbering b1_1, b1_2, b1_3 get z1
    - If b2 maps to z2, then all rows with numbering b2_1, b2_2, b2_3 get z2
    - Reference rows themselves (b1_o, b2_o) and other rows (C_o) remain blank
    
    Args:
        stage1_data: List of row dictionaries after column combination
        combined_column_name: Name of the combined column (not used in new logic)
        mapping_df: DataFrame with mapping (col1=reference values, col2=mapped values)
        new_column_name: Name for the new mapped column
        reference_values: List of reference values (for validation)
        repeat_values: List of repeated values (not used in new logic)
    
    Returns:
        List of row dictionaries with new mapped column added
    """
    if mapping_df is None or len(mapping_df.columns) < 2:
        return stage1_data
    
    # Create mapping dictionary: reference_value -> mapped_value
    key_col = mapping_df.columns[0]
    value_col = mapping_df.columns[1]
    mapping_dict = dict(zip(mapping_df[key_col].astype(str), mapping_df[value_col].astype(str)))
    
    print(f"\n=== Reference Mapping (New Logic) ===")
    print(f"Mapping dictionary: {mapping_dict}")
    
    result_rows = []
    
    for row in stage1_data:
        new_row = row.copy()
        numbering = row.get('Numbering', '')
        
        # Initialize mapped column as empty
        new_row[new_column_name] = ''
        
        # Extract the reference prefix from numbering (e.g., "b1" from "b1_1")
        if numbering and '_' in numbering:
            parts = numbering.split('_')
            ref_prefix = parts[0]
            suffix = parts[1]
            
            # If this is a repeated row (suffix is numeric), apply mapping
            if suffix.isdigit():
                # Find the mapped value for this reference
                mapped_value = mapping_dict.get(ref_prefix, '')
                new_row[new_column_name] = mapped_value
                print(f"Numbering: {numbering} -> Mapped to: '{mapped_value}'")
            else:
                # For reference rows (_o suffix) and other rows, leave blank
                print(f"Numbering: {numbering} -> Left blank (reference/other row)")
        else:
            print(f"Numbering: '{numbering}' -> Left blank (no valid numbering)")
        
        result_rows.append(new_row)
    
    print(f"=== End Reference Mapping ===\n")
    return result_rows