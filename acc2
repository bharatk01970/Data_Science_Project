def _capture_single_screenshot(self, workbook, sheet_name, cell_range, name, folder, embed=True, attach=False):
    """Helper method to capture a single screenshot (ensures correct sheet activation)"""
    try:
        self.log_message(f"  Capturing {name} from {sheet_name}!{cell_range}", 'info')

        # Activate correct sheet before copying
        sheet = workbook.Sheets(sheet_name)
        sheet.Activate()
        time.sleep(0.8)  # give Excel UI time to refresh

        # Copy as picture
        range_obj = sheet.Range(cell_range)
        range_obj.CopyPicture(Format=2)
        time.sleep(0.5)

        # Wait until image is in clipboard
        img = None
        for _ in range(15):
            img = ImageGrab.grabclipboard()
            if img is not None:
                break
            time.sleep(0.2)

        if img is None:
            self.log_message(f"  ❌ Clipboard empty for {sheet_name}", 'error')
            return

        save_path = os.path.join(folder, f"{name}.png")
        img.save(save_path, 'PNG')

        self.screenshot_paths.append({
            'path': save_path,
            'name': name,
            'embed': embed,
            'attach': attach
        })

        self.log_message(f"  ✓ Saved screenshot for {sheet_name}", 'success')

        # Short delay before next sheet to prevent overwrite
        time.sleep(0.4)

    except Exception as e:
        self.log_message(f"  ⚠ Error capturing {sheet_name}: {str(e)}", 'error')