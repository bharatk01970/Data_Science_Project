def apply_reference_mapping(self, stage1_data, combined_column_name, mapping_df, new_column_name, reference_values, repeat_values):
    """Fix: Correctly map repeated rows that appear before their reference rows."""
    if mapping_df is None or len(mapping_df.columns) < 2:
        return stage1_data

    key_col = mapping_df.columns[0]
    value_col = mapping_df.columns[1]
    mapping_dict = dict(zip(mapping_df[key_col].astype(str), mapping_df[value_col].astype(str)))

    print(f"\n=== Reference Mapping (Revised) ===")
    print(f"Mapping dictionary: {mapping_dict}")

    # Pass 1: identify reference mappings
    ref_mapping_positions = {}
    for idx, row in enumerate(stage1_data):
        val = row.get(combined_column_name, '')
        if val in reference_values:
            mapped_val = mapping_dict.get(val, '')
            ref_mapping_positions[idx] = (val, mapped_val)

    # Pass 2: assign mappings to repeat rows
    result_rows = []
    current_mapped_value = ''
    for idx, row in enumerate(stage1_data):
        new_row = row.copy()
        combined_val = new_row.get(combined_column_name, '')

        # If current row is a reference row → set new context
        if combined_val in reference_values:
            current_mapped_value = mapping_dict.get(combined_val, '')
            new_row[new_column_name] = ''  # keep reference row blank
            print(f"Reference row: {combined_val} -> mapped to ''")

        # If current row is a repeat row
        elif combined_val in repeat_values:
            # Use latest mapping value if available
            new_row[new_column_name] = current_mapped_value
            print(f"Repeat row: {combined_val} -> mapped to '{current_mapped_value}'")

        else:
            new_row[new_column_name] = ''
            print(f"Other row: {combined_val} -> mapped to ''")

        result_rows.append(new_row)

    print(f"=== End Reference Mapping ===\n")
    return result_rows