        self.log_message(f"Opening draft window for {file_key}", 'info')
        
        file_config = self.file_configs.get(file_key, {})
        
        if not file_config:
            self.log_message(f"Configuration not found for {file_key}", 'error')
            messagebox.showerror("Error", f"No configuration found for {file_key}")
            return
        
        smart_enabled = file_config.get('smart_linking', {}).get('enabled', False)
        
        # Create file-specific logger for manual mode too
        file_logger = self.setup_file_specific_logging(file_key)
        
        # Pass logger and auto_mode=False for manual opening
        ReconFile(
            self.root, 
            file_key, 
            file_config, 
            self.email_config, 
            self.log_message, 
            file_logger, 
            auto_mode=False,
            is_last_file=False
        )
    
    def on_closing(self):
        try:
            pythoncom.CoUninitialize()
        except:
            pass
        
        self.root.destroy()


def main():
    """Main function to start the GUI application"""
    root = tk.Tk()
    
    # ============================================================
    # CONFIGURATION FOR AUTO-EXECUTE MODE
    # ============================================================
    
    # Set auto_execute=True to enable automatic file detection and processing
    auto_execute_mode = True  # Change to False for manual mode
    
    # Set the folder where files will be placed for processing
    watch_folder = r'C:\ReconMailDraft\InputFiles'  # CHANGE THIS PATH
    
    # ============================================================
    
    app = ExcelOutlookGUI(root, auto_execute=auto_execute_mode, watch_folder=watch_folder)
    
    root.protocol("WM_DELETE_WINDOW", app.on_closing)
    root.mainloop()


if __name__ == "__main__":
    main()


