    def process_next_file(self):
        """Process the next file in the queue"""
        if self.current_file_index >= len(self.files_to_process):
            print("AUTO MODE: All files processed successfully")
            self.log_message("AUTO MODE: All files completed. Closing application...", 'success')
            self.root.after(2000, self.on_closing)
            return
        
        file_info = self.files_to_process[self.current_file_index]
        file_key = file_info['file_key']
        file_path = file_info['file_path']
        file_name = file_info['file_name']
        file_config = file_info['config'].copy()
        
        # Update config with actual detected file path
        file_config['path'] = file_path
        
        is_last = (self.current_file_index == len(self.files_to_process) - 1)
        
        print(f"AUTO MODE: Processing file {self.current_file_index + 1}/{len(self.files_to_process)}: {file_key}")
        print(f"  File: {file_name}")
        print(f"  Path: {file_path}")
        
        self.log_message(
            f"AUTO MODE: Processing [{self.current_file_index + 1}/{len(self.files_to_process)}] {file_key} ({file_name})", 
            'warning'
        )
        
        # Create file-specific logger with actual filename
        file_logger = self.setup_file_specific_logging(file_key, file_name)
        
        # Increment for next iteration
        self.current_file_index += 1
        
        # Process the file with its own logger
        ReconFile(
