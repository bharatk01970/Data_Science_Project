#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""
Auto-Execute Mail Draft Utility
Automatically processes files and drafts emails on launch
"""

import tkinter as tk
from tkinter import ttk, filedialog, messagebox, scrolledtext
import win32com.client
from PIL import ImageGrab
import pythoncom
from datetime import datetime
import pytz
import os
import time
import threading


class ReconFile:
    def __init__(self, parent, file_key, file_config, email_config, log_callback, auto_mode=False):
        self.parent = parent
        self.file_key = file_key
        self.file_config = file_config
        self.email_config = email_config
        self.log_callback = log_callback
        self.screenshot_paths = []
        self.conditional_screenshots = []
        self.auto_mode = auto_mode  # NEW: Flag for automatic execution

        # Create popup window
        self.popup = tk.Toplevel(parent)
        self.popup.title(f"Draft Email - {file_key}")
        self.popup.geometry("550x560")
        self.popup.grab_set()
        
        pythoncom.CoInitialize()
        self.create_popup_gui()
        
        # NEW: Auto-execute if in auto mode
        if self.auto_mode:
            self.popup.after(500, self.auto_execute_workflow)

    def auto_execute_workflow(self):
        """Automatically execute: Screenshot → Draft → Close"""
        self.log_message("AUTO MODE: Starting automated workflow", 'info')
        
        # Step 1: Capture screenshots
        self.log_message("AUTO MODE: Step 1/2 - Capturing screenshots...", 'info')
        thread = threading.Thread(target=self._auto_screenshot_and_draft)
        thread.daemon = True
        thread.start()

    def _auto_screenshot_and_draft(self):
        """Combined thread for screenshot capture and email drafting"""
        try:
            # Step 1: Take screenshots
            self._take_screenshot_thread()
            
            # Wait a moment to ensure screenshots are saved
            time.sleep(2)
            
            # Step 2: Draft email
            if self.screenshot_paths:
                self.log_message("AUTO MODE: Step 2/2 - Drafting email...", 'info')
                self._draft_email_thread()
                
                # Step 3: Close popup after completion
                time.sleep(2)
                self.popup.after(100, self.auto_close)
            else:
                self.log_message("AUTO MODE: No screenshots captured, aborting", 'error')
                
        except Exception as e:
            self.log_message(f"AUTO MODE ERROR: {str(e)}", 'error')

    def auto_close(self):
        """Close popup automatically after drafting"""
        self.log_message("AUTO MODE: Workflow completed, closing window", 'success')
        self.popup.destroy()

