    def detect_files_in_folder(self):
        """Detect which configured files exist in the watch folder"""
        import fnmatch
        
        detected_files = []
        
        if not os.path.exists(self.watch_folder):
            print(f"ERROR: Watch folder does not exist: {self.watch_folder}")
            return detected_files
        
        # Get all files in watch folder
        folder_files = [f for f in os.listdir(self.watch_folder) 
                       if os.path.isfile(os.path.join(self.watch_folder, f))]
        
        print(f"Scanning watch folder: {self.watch_folder}")
        print(f"Found {len(folder_files)} files in folder")
        
        # Match each file config pattern against folder files
        for file_key, config in self.file_configs.items():
            pattern = config.get('file_pattern', '')
            
            if not pattern:
                print(f"WARNING: {file_key}: No file_pattern configured, skipping")
                continue
            
            # Find matching files
            matched_files = fnmatch.filter(folder_files, pattern)
            
            if matched_files:
                # Use the first matched file
                matched_file = matched_files[0]
                file_path = os.path.join(self.watch_folder, matched_file)
                
                detected_files.append({
                    'file_key': file_key,
                    'file_path': file_path,
                    'file_name': matched_file,
                    'config': config
                })
                
                print(f"✓ Detected: {file_key} → {matched_file}")
                
                if len(matched_files) > 1:
                    print(f"  WARNING: Multiple files match pattern '{pattern}': {matched_files}")
                    print(f"  Using first match: {matched_file}")
            else:
                print(f"✗ Not found: {file_key} (pattern: {pattern})")
        
        return detected_files

    def setup_logging(self):
        """Setup daily log file (for manual mode compatibility)"""
        try:
            if not os.path.exists(self.log_folder):
                os.makedirs(self.log_folder)
                print(f"Created log folder: {self.log_folder}")
            
            log_filename = f"ReconMailDraft_{datetime.now().strftime('%Y%m%d')}.log"
            log_filepath = os.path.join(self.log_folder, log_filename)
            
            logger = logging.getLogger('ReconMailDraft')
            logger.setLevel(logging.DEBUG)
            logger.handlers = []
            
            file_handler = RotatingFileHandler(
                log_filepath,
                maxBytes=10*1024*1024,
                backupCount=5,
                encoding='utf-8'
            )
            file_handler.setLevel(logging.DEBUG)
            
            formatter = logging.Formatter(
                '%(asctime)s | %(levelname)-8s | %(message)s',
                datefmt='%Y-%m-%d %I:%M:%S %p'
            )
            file_handler.setFormatter(formatter)
            logger.addHandler(file_handler)
            
            logger.info(f"Log file initialized: {log_filepath}")
            
            return logger
            
        except Exception as e:
            print(f"Error setting up logging: {str(e)}")
            logger = logging.getLogger('ReconMailDraft')
            logger.setLevel(logging.INFO)
            console_handler = logging.StreamHandler()
            logger.addHandler(console_handler)
            return logger

    def setup_file_specific_logging(self, file_key, actual_filename=None):
        """Setup individual log file for each recon file"""
        try:
            # Use actual filename if provided, otherwise use file_key
            if actual_filename:
                # Extract base name without extension
                base_name = os.path.splitext(actual_filename)[0]
                log_filename = f"ReconMailDraft_{base_name}_{datetime.now().strftime('%Y%m%d_%H%M%S')}.log"
            else:
                log_filename = f"ReconMailDraft_{file_key.replace(' ', '_')}_{datetime.now().strftime('%Y%m%d_%H%M%S')}.log"
            
            log_filepath = os.path.join(self.log_folder, log_filename)
            
            # Create unique logger for this file
            logger_name = f'ReconMailDraft_{file_key}_{datetime.now().strftime("%H%M%S%f")}'
            logger = logging.getLogger(logger_name)
            logger.setLevel(logging.DEBUG)
            logger.handlers = []
            
            file_handler = logging.FileHandler(
                log_filepath,
                encoding='utf-8'
            )
            file_handler.setLevel(logging.DEBUG)
            
            formatter = logging.Formatter(
                '%(asctime)s | %(levelname)-8s | %(message)s',
                datefmt='%Y-%m-%d %I:%M:%S %p'
            )
            file_handler.setFormatter(formatter)
            logger.addHandler(file_handler)
            
            logger.info("="*60)
            logger.info(f"FILE PROCESSING STARTED: {file_key}")
            logger.info("="*60)
            logger.info(f"File-specific log initialized for: {file_key}")
            if actual_filename:
                logger.info(f"Processing file: {actual_filename}")
            logger.info(f"Log file path: {log_filepath}")
            
            print(f"Created log file: {log_filename}")
            
            return logger
            
        except Exception as e:
            print(f"Error setting up file-specific logging: {str(e)}")
            return None

    def prepare_auto_execution(self):
        """Detect files in watch folder and prepare processing queue"""
        detected_files = self.detect_files_in_folder()
        
        if not detected_files:
            print("WARNING: No files detected in watch folder")
            self.log_message("AUTO MODE: No files found to process", 'warning')
            messagebox.showwarning(
                "No Files Found",
                f"No matching files found in watch folder:\n{self.watch_folder}\n\n"
                "Please place files matching the configured patterns in the folder."
            )
            self.root.after(2000, self.on_closing)
            return
        
        self.files_to_process = detected_files
        self.current_file_index = 0
        
        print(f"AUTO MODE: Detected {len(self.files_to_process)} files for processing")
        
        for idx, file_info in enumerate(self.files_to_process, 1):
            print(f"  {idx}. {file_info['file_key']}: {file_info['file_name']}")
        
        self.log_message(f"AUTO MODE: Detected {len(self.files_to_process)} files to process", 'warning')

    def process_next_file(self):
        """Process the next file in the queue"""
        if self.current_file_index >= len(self.files_to_process):
            print("AUTO MODE: All files processed successfully")
            self.log_message("AUTO MODE: All files completed. Closing application...", 'success')
            self.root.after(2000, self.on_closing)
            return
        
        file_info = self.files_to_process[self.current_file_index]
        file_key = file_info['file_key']
        file_path = file_info['file_path']
        file_name = file_info['file_name']
        file_config = file_info['config'].copy()
        
        # Update config with actual detected file path
        file_config['path'] = file_path
        
        is_last = (self.current_file_index == len(self.files_to_process) - 1)
        
        print(f"AUTO MODE: Processing file {self.current_file_index + 1}/{len(self.files_to_process)}: {file_key}")
        print(f"  File: {file_name}")
        print(f"  Path: {file_path}")
        
        self.log_message(
            f"AUTO MODE: Processing [{self.current_file_index + 1}/{len(self.files_to_process)}] {file_key} ({file_name})", 
            'warning'
        )
        
        # Create file-specific logger with actual filename
        file_logger = self.setup_file_specific_logging(file_key, file_name)
        
        # Increment for next iteration
        self.current_file_index += 1
        
        # Process the file with its own logger
        ReconFile(
            self.root, 
            file_key, 
            file_config, 
            self.email_config, 
            self.log_message, 
            file_logger,  # Pass file-specific logger
            auto_mode=True,
            is_last_file=is_last
        )

    def auto_close_main_window(self, event=None):
