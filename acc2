def build_combination_source_map(self, temp_stage1_data, columns_to_combine):
    """Build a mapping of source columns to their values in the combined column
    
    Args:
        temp_stage1_data: Original data before combination
        columns_to_combine: List of columns that were combined
    
    Returns:
        Dictionary mapping column names to lists of their values
    """
    column_to_values = {}
    
    for col in columns_to_combine:
        values_set = set()
        for row in temp_stage1_data:
            if col in row and row[col]:
                value = row[col]
                # Split multi-values
                if isinstance(value, str) and (',' in value or ';' in value):
                    split_vals = self.split_multi_values(value)
                    values_set.update([v for v in split_vals if v])
                else:
                    val_str = str(value) if value else ""
                    if val_str:
                        values_set.add(val_str)
        
        if values_set:
            column_to_values[col] = sorted(list(values_set))
    
    return column_to_values







