    def take_screenshot(self, file_key):
        """
        Capture screenshots from specified Excel file
        Runs in a separate thread to prevent GUI freezing
        
        Args:
            file_key: The file identifier (e.g., 'File 1')
        """
        # Run screenshot capture in separate thread
        thread = threading.Thread(target=self._take_screenshot_thread, args=(file_key,))
        thread.daemon = True  # Thread will close when main program closes
        thread.start()
    
    def _take_screenshot_thread(self, file_key):
        """
        Thread worker function for taking screenshots
        This runs in background to keep GUI responsive
        
        Args:
            file_key: The file identifier (e.g., 'File 1')
        """
        try:
            # Update status
            self.update_file_status(file_key, "Taking screenshots...", 'orange')
            self.log_message(f"{file_key}: Starting screenshot capture", 'info')
            
            # Get file path from entry widget
            file_path = self.file_widgets[file_key]['path_entry'].get()
            
            # Validate file path
            if not file_path or not os.path.exists(file_path):
                self.log_message(f"{file_key}: Invalid file path - {file_path}", 'error')
                self.update_file_status(file_key, "Error: Invalid file path", 'red')
                return
            
            # Get screenshot configurations for this file
            file_config = self.file_configs.get(file_key, {})
            screenshots_config = file_config.get('screenshots', [])
            
            if not screenshots_config:
                self.log_message(f"{file_key}: No screenshot configuration found", 'warning')
                self.update_file_status(file_key, "Warning: No screenshots configured", 'orange')
                return
            
            # Initialize COM for this thread
            pythoncom.CoInitialize()
            
            # Open Excel application
            excel = win32com.client.gencache.EnsureDispatch("Excel.Application")
            excel.Visible = False  # Hide Excel window
            excel.DisplayAlerts = False  # Suppress Excel alerts
            
            # Open the workbook
            workbook = excel.Workbooks.Open(
                Filename=os.path.abspath(file_path),
                UpdateLinks=0,
                ReadOnly=True,
                IgnoreReadOnlyRecommended=True
            )
            
            # Get folder where Excel file is located (for saving screenshots)
            file_folder = os.path.dirname(os.path.abspath(file_path))
            
            # Clear previous screenshot paths for this file
            self.screenshot_paths[file_key] = []
            
            # Capture each screenshot
            for idx, config in enumerate(screenshots_config, 1):
                sheet_name = config['sheet_name']
                cell_range = config['cell_range']
                name = config.get('name', f'screenshot_{idx}')
                
                self.log_message(f"{file_key}: Capturing {name} from {sheet_name}!{cell_range}", 'info')
                
                # Get the sheet
                sheet = workbook.Sheets(sheet_name)
                
                # Get the range
                range_obj = sheet.Range(cell_range)
                
                # Copy range as picture to clipboard
                range_obj.CopyPicture(Format=2)  # 2 = xlBitmap
                time.sleep(0.5)  # Wait for clipboard operation
                
                # Grab image from clipboard
                img = ImageGrab.grabclipboard()
                
                if img is None:
                    self.log_message(f"{file_key}: Failed to capture {name}", 'error')
                    continue
                
                # Determine save location based on checkbox
                if self.auto_delete_var.get():
                    # Save in same folder as Excel file
                    save_path = os.path.join(file_folder, f"{name}.png")
                else:
                    # Save in temp folder
                    save_path = os.path.join(os.environ['TEMP'], f"{name}.png")
                
                # Save the image
                img.save(save_path, 'PNG')
                
                # Store screenshot info
                screenshot_info = {
                    'path': save_path,
                    'name': name,
                    'embed': config.get('embed', True),
                    'attach': config.get('attach', False)
                }
                self.screenshot_paths[file_key].append(screenshot_info)
                
                self.log_message(f"{file_key}: Saved {name} to {save_path}", 'success')
            
            # Close workbook without saving
            workbook.Close(SaveChanges=False)
            
            # Quit Excel application
            excel.Quit()
            
            # Uninitialize COM
            pythoncom.CoUninitialize()
            
            # Update status
            self.update_file_status(file_key, f"Screenshots captured: {len(self.screenshot_paths[file_key])}", 'green')
            self.log_message(f"{file_key}: Screenshot capture completed - {len(self.screenshot_paths[file_key])} images", 'success')
            
        except Exception as e:
            self.log_message(f"{file_key}: Error taking screenshots - {str(e)}", 'error')
            self.update_file_status(file_key, "Error taking screenshots", 'red')
    
    def draft_mail(self, file_key):
        """
        Create Outlook email draft using captured screenshots
        Runs in a separate thread to prevent GUI freezing
        
        Args:
            file_key: The file identifier (e.g., 'File 1')
        """
        # Run email drafting in separate thread
        thread = threading.Thread(target=self._draft_mail_thread, args=(file_key,))
        thread.daemon = True
        thread.start()
    
    def _draft_mail_thread(self, file_key):
        """
        Thread worker function for drafting email
        
        Args:
            file_key: The file identifier (e.g., 'File 1')
        """
        try:
            # Update status
            self.update_file_status(file_key, "Drafting email...", 'orange')
            self.log_message(f"{file_key}: Starting email draft creation", 'info')
            
            # Check if screenshots exist
            if not self.screenshot_paths.get(file_key):
                self.log_message(f"{file_key}: No screenshots found. Please take screenshots first.", 'warning')
                self.update_file_status(file_key, "No screenshots available", 'orange')
                messagebox.showwarning("No Screenshots", f"Please take screenshots for {file_key} first.")
                return
            
            # Verify all screenshot files exist
            missing_files = []
            for screenshot in self.screenshot_paths[file_key]:
                if not os.path.exists(screenshot['path']):
                    missing_files.append(screenshot['name'])
            
            if missing_files:
                self.log_message(f"{file_key}: Missing screenshot files: {', '.join(missing_files)}", 'error')
                self.update_file_status(file_key, "Error: Screenshots not found", 'red')
                return
            
            # Initialize COM for this thread
            pythoncom.CoInitialize()
            
            # Create Outlook application instance
            outlook = win32com.client.gencache.EnsureDispatch("Outlook.Application")
            
            # Create new mail item
            mail = outlook.CreateItem(0)  # 0 = olMailItem
            
            # Set sender email
            sender_email = self.sender_entry.get().strip()
            if sender_email:
                try:
                    # Try to find matching account
                    for account in outlook.Session.Accounts:
                        if hasattr(account, 'SmtpAddress') and \
                           account.SmtpAddress.lower() == sender_email.lower():
                            mail.SendUsingAccount = account
                            self.log_message(f"{file_key}: Using sender account - {sender_email}", 'info')
                            break
                except Exception as e:
                    self.log_message(f"{file_key}: Could not set sender account: {str(e)}", 'warning')
            
            # Set recipients
            to_recipients = self.to_entry.get().strip()
            if to_recipients:
                mail.To = to_recipients
            
            cc_recipients = self.cc_entry.get().strip()
            if cc_recipients:
                mail.CC = cc_recipients
            
            # Get timezone and create timestamp
            timezone = self.email_config.get('timezone', 'IST')
            tz_map = {
                'IST': pytz.timezone('Asia/Kolkata'),
                'UK': pytz.timezone('Europe/London'),
                'GMT': pytz.timezone('GMT')
            }
            tz = tz_map.get(timezone, pytz.timezone('Asia/Kolkata'))
            timestamp = datetime.now(tz).strftime('%Y-%m-%d %H:%M:%S %Z')
            
            # Build subject with timestamp
            base_subject = self.subject_entry.get().strip()
            if not base_subject:
                base_subject = "Excel Report"
            mail.Subject = f"{base_subject} - {timestamp}"
            
            # Build email body
            body_text = self.body_text.get('1.0', tk.END).strip()
            
            # Get signature and disclaimer
            signature = self.email_config.get('signature', '')
            disclaimer = self.email_config.get('disclaimer', '')
            
            # Start HTML body
            html_body = f"""
            <html>
            <body style="font-family: Arial, sans-serif;">
            <p>{body_text.replace(chr(10), '<br>')}</p>
            <p><strong>Generated:</strong> {timestamp}</p>
            <br>
            """
            
            # Add embedded screenshots
            embed_count = 0
            for screenshot in self.screenshot_paths[file_key]:
                if screenshot.get('embed', False):
                    cid = f"image_{embed_count}"
                    html_body += f'<p><strong>{screenshot["name"]}</strong></p>'
                    html_body += f'<img src="cid:{cid}" alt="{screenshot["name"]}" style="max-width: 100%;"><br><br>'
                    
                    # Add as inline attachment
                    attachment = mail.Attachments.Add(screenshot['path'])
                    attachment.PropertyAccessor.SetProperty(
                        "http://schemas.microsoft.com/mapi/proptag/0x3712001F",
                        cid
                    )
                    embed_count += 1
                    self.log_message(f"{file_key}: Embedded {screenshot['name']}", 'info')
                
                # Add file attachments
                if screenshot.get('attach', False):
                    mail.Attachments.Add(screenshot['path'])
                    self.log_message(f"{file_key}: Attached {screenshot['name']}", 'info')
            
            # Add signature (convert newlines to HTML breaks)
            if signature:
                html_body += f'<p>{signature.replace(chr(10), "<br>")}</p>'
            
            # Add disclaimer in smaller font
            if disclaimer:
                html_body += f'<p style="font-size: 10px; color: #666;">{disclaimer.replace(chr(10), "<br>")}</p>'
            
            # Close HTML
            html_body += """
            </body>
            </html>
            """
            
            # Set email body
            mail.HTMLBody = html_body
            
            # Save as draft (don't send)
            mail.Save()
            
            self.log_message(f"{file_key}: Email draft created successfully in Outlook", 'success')
            
            # Delete screenshots if auto-delete is enabled
            if self.auto_delete_var.get():
                time.sleep(2)  # Wait for Outlook to process attachments
                
                # Delete each screenshot file
                for screenshot in self.screenshot_paths[file_key]:
                    try:
                        if os.path.exists(screenshot['path']):
                            os.remove(screenshot['path'])
                            self.log_message(f"{file_key}: Deleted screenshot - {screenshot['name']}", 'info')
                    except Exception as e:
                        self.log_message(f"{file_key}: Could not delete {screenshot['name']}: {str(e)}", 'warning')
                
                # Clear screenshot paths list
                self.screenshot_paths[file_key] = []
                self.log_message(f"{file_key}: Screenshots deleted from disk", 'info')
            
            # Uninitialize COM
            pythoncom.CoUninitialize()
            
            # Update status
            self.update_file_status(file_key, "Email draft created successfully", 'green')
            self.log_message(f"{file_key}: Email drafting completed", 'success')
            
            # Show success message
            messagebox.showinfo("Success", f"Email draft created successfully for {file_key}!")
            
        except Exception as e:
            self.log_message(f"{file_key}: Error drafting email - {str(e)}", 'error')
            self.update_file_status(file_key, "Error drafting email", 'red')
            messagebox.showerror("Error", f"Failed to create email draft:\n{str(e)}")
    
    def on_closing(self):
        """
        Handle application closing event
        Clean up resources before exit
        """
        try:
            # Uninitialize COM
            pythoncom.CoUninitialize()
        except:
            pass
        
        # Destroy the window
        self.root.destroy()


# ================================================================
# MAIN EXECUTION
# ================================================================

def main():
    """
    Main function to start the GUI application
    Creates the tkinter root window and initializes the GUI
    """
    # Create the main tkinter window
    root = tk.Tk()
    
    # Create the application instance
    app = ExcelOutlookGUI(root)
    
    # Set up window close handler
    root.protocol("WM_DELETE_WINDOW", app.on_closing)
    
    # Start the GUI event loop (keeps application running)
    root.mainloop()


# Entry point of the application
if __name__ == "__main__":
    main()


