def capturesinglescreenshot(self, workbook, sheetname, cellrange, name, folder, embed=True, attach=False):
    try:
        self.logmessage(f"Capturing {name} from {sheetname}!{cellrange}", "info")
        sheet = workbook.Sheets(sheetname)
        rangeobj = sheet.Range(cellrange)
        rangeobj.CopyPicture(Format=2)  # Copy as picture to clipboard

        # NEW robust sleep/wait for clipboard readiness
        img = None
        max_attempts = 5
        for attempt in range(max_attempts):
            time.sleep(1.25)  # Slightly longer wait
            img = ImageGrab.grabclipboard()
            if img is not None:
                break

        if img is None:
            self.logmessage(f"Failed to capture {name}", "error")
            return

        savepath = os.path.join(folder, f"{name}.png")
        img.save(savepath, "PNG")
        screenshotinfo = {
            "path": savepath,
            "name": name,
            "embed": embed,
            "attach": attach,
        }
        self.screenshotpaths.append(screenshotinfo)
        self.logmessage(f"Saved {name}", "success")
    except Exception as e:
        self.logmessage(f"Error capturing {name}: {str(e)}", "error")