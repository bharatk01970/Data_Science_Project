def reprocess_for_combination(self, result_rows, columns_to_combine):
    """Re-process rows: expand non-combined columns, keep combined columns as multi-values
    
    Args:
        result_rows: Rows from process_stage1_dataframe (may have Cartesian expansion)
        columns_to_combine: Columns that will be combined (keep these as multi-values)
    
    Returns:
        Rows with non-combined columns expanded, combined columns preserved
    """
    print(f"\n=== RE-PROCESSING FOR COMBINATION ===")
    print(f"Columns to combine (keep multi-values): {columns_to_combine}")
    
    new_result_rows = []
    
    for row in result_rows:
        # Separate fields
        combine_fields = {}  # Keep as-is
        expand_fields = {}   # Need Cartesian expansion
        
        for field, value in row.items():
            if field in columns_to_combine:
                # Keep multi-values for combination
                combine_fields[field] = value
            else:
                # Expand for non-combined fields
                if value and isinstance(value, str) and (',' in value or ';' in value):
                    split_vals = self.split_multi_values(value)
                    expand_fields[field] = [v for v in split_vals if v]
                else:
                    expand_fields[field] = [value] if value else ['']
        
        # If there are fields to expand, do Cartesian product on those only
        if expand_fields:
            expand_field_names = list(expand_fields.keys())
            expand_field_values = [expand_fields[f] for f in expand_field_names]
            
            for combination in itertools.product(*expand_field_values):
                new_row = combine_fields.copy()  # Keep combined fields as-is
                for field_name, value in zip(expand_field_names, combination):
                    new_row[field_name] = value
                
                if new_row not in new_result_rows:
                    new_result_rows.append(new_row)
        else:
            # No expansion needed
            new_result_rows.append(combine_fields.copy())
    
    print(f"Rows after re-processing: {len(new_result_rows)}")
    print(f"=== END RE-PROCESSING ===\n")
    
    return new_result_rows




