    def setup_logging(self):
        """
        Configure file-based logging with automatic rotation.
        
        Creates a logging system that:
        - Writes to dated log files (e.g., ReconMailDraft_20251117.log)
        - Rotates files when they reach 10MB
        - Keeps 5 backup log files
        - Logs all application activities with timestamps
        
        Returns:
            logging.Logger: Configured logger instance
        """
        try:
            # Create log folder if it doesn't exist
            if not os.path.exists(self.log_folder):
                os.makedirs(self.log_folder)
                print(f"Created log folder: {self.log_folder}")
            
            # Create log filename with current date
            log_filename = f"ReconMailDraft_{datetime.now().strftime('%Y%m%d')}.log"
            log_filepath = os.path.join(self.log_folder, log_filename)
            
            # Create logger instance
            logger = logging.getLogger('ReconMailDraft')
            logger.setLevel(logging.DEBUG)  # Log all levels
            
            # Remove existing handlers to avoid duplicates
            logger.handlers = []
            
            # Create rotating file handler
            # Max 10MB per file, keep 5 backups
            file_handler = RotatingFileHandler(
                log_filepath,
                maxBytes=10*1024*1024,  # 10MB maximum file size
                backupCount=5,  # Keep 5 backup files
                encoding='utf-8'  # UTF-8 encoding for international characters
            )
            file_handler.setLevel(logging.DEBUG)
            
            # Create formatter for log messages
            formatter = logging.Formatter(
                '%(asctime)s | %(levelname)-8s | %(message)s',  # Format: timestamp | level | message
                datefmt='%Y-%m-%d %I:%M:%S %p'  # Date format: 2025-11-17 02:30:45 PM
            )
            file_handler.setFormatter(formatter)
            
            # Add handler to logger
            logger.addHandler(file_handler)
            
            # Log the log file location
            logger.info(f"Log file initialized: {log_filepath}")
            
            return logger
            
        except Exception as e:
            # If logging setup fails, show error and create basic console logger
            print(f"Error setting up logging: {str(e)}")
            messagebox.showerror("Logging Error", f"Could not setup log file:\n{str(e)}")
            # Return a basic logger that only logs to console
            logger = logging.getLogger('ReconMailDraft')
            logger.setLevel(logging.INFO)
            console_handler = logging.StreamHandler()
            logger.addHandler(console_handler)
            return logger

