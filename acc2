    def log_message(self, message, tag='info'):
        """Add timestamped message to log"""
        self.log_text.config(state='normal')
        timestamp = datetime.now().strftime('%I:%M:%S %p')
        self.log_text.insert(tk.END, f"[{timestamp}] {message}\n", tag)
        self.log_text.see(tk.END)
        self.log_text.config(state='disabled')
        self.popup.update_idletasks()
        
        # Also log to main window
        if self.log_callback:
            self.log_callback(f"{self.file_key}: {message}", tag)
    
    def extract_cell_value(self, workbook, cell_ref):
        """
        Extract numeric value from a cell reference
        Handles references like "Sheet1!A1" or just "A1"
        """
        try:
            if '!' in cell_ref:
                sheet_name, cell_addr = cell_ref.split('!')
                sheet = workbook.Sheets(sheet_name)
            else:
                sheet = workbook.ActiveSheet
                cell_addr = cell_ref
            
            value = sheet.Range(cell_addr).Value
            
            # Try to convert to float
            if value is None:
                return 0.0
            
            try:
                return float(value)
            except (ValueError, TypeError):
                self.log_message(f"Non-numeric value in {cell_ref}: {value}", 'warning')
                return 0.0
                
        except Exception as e:
            self.log_message(f"Error reading cell {cell_ref}: {str(e)}", 'error')
            return 0.0
    
    def check_threshold_condition(self, value, threshold_type, threshold_value):
        """Check if value meets the threshold condition"""
        try:
            threshold_val = float(threshold_value)
        except (ValueError, TypeError):
            threshold_val = 0.0
        
        if threshold_type == 'equals_zero':
            return value == 0.0
        elif threshold_type == 'not_zero':
            return value != 0.0
        elif threshold_type == 'exceeds':
            return value > threshold_val
        elif threshold_type == 'below':
            return value < threshold_val
        else:
            return False
    
    def analyze_linked_sheets(self, workbook):
        """
        Analyze master sheet and determine which linked sheets meet threshold conditions
        Returns list of sheets to capture
        """
        smart_config = self.file_config.get('smart_linking', {})
        
        if not smart_config.get('enabled', False):
            return []
        
        master_sheet = smart_config.get('master_sheet', '')
        linked_sheets = smart_config.get('linked_sheets', [])
        threshold_type = self.threshold_type.get()
        threshold_value = self.threshold_value.get()
        
        self.log_message(f"Analyzing linked sheets from master: {master_sheet}", 'info')
        self.log_message(f"Threshold: {threshold_type} {threshold_value}", 'info')
        
        sheets_to_capture = []
        
        # Update conditional display
        if hasattr(self, 'conditional_text'):
            self.conditional_text.config(state='normal')
            self.conditional_text.delete('1.0', tk.END)
        
        for sheet_config in linked_sheets:
            sheet_name = sheet_config.get('sheet_name', '')
            value_cell = sheet_config.get('value_cell', '')  # Cell in master sheet with sum/value
            capture_range = sheet_config.get('capture_range', 'A1:Z50')
            
            # Read value from master sheet
            cell_value = self.extract_cell_value(workbook, value_cell)
            
            # Check if meets condition
            meets_condition = self.check_threshold_condition(
                cell_value,
                threshold_type,
                threshold_value
            )
            
            status = "✓ WILL CAPTURE" if meets_condition else "○ Skip"
            color = 'match' if meets_condition else 'nomatch'
            
            if hasattr(self, 'conditional_text'):
                self.conditional_text.insert(
                    tk.END,
                    f"{status} | {sheet_name} | Value: {cell_value} | Cell: {value_cell}\n",
                    color
                )
            
            self.log_message(
                f"  {sheet_name}: Value={cell_value}, Condition={meets_condition}",
                'success' if meets_condition else 'info'
            )
            
            if meets_condition:
                sheets_to_capture.append({
                    'sheet_name': sheet_name,
                    'cell_range': capture_range,
                    'embed': sheet_config.get('embed', True),
                    'attach': sheet_config.get('attach', False),
                    'name': sheet_config.get('name', sheet_name),
                    'value': cell_value
                })
        
        if hasattr(self, 'conditional_text'):
            self.conditional_text.config(state='disabled')
        
        return sheets_to_capture
    
    def take_screenshot(self):
        """Capture screenshots in separate thread"""
        thread = threading.Thread(target=self._take_screenshot_thread)
        thread.daemon = True
        thread.start()
    
    def _take_screenshot_thread(self):
        """Thread worker for screenshot capture with smart linking"""
        try:
            self.screenshot_status.config(text="Analyzing...", foreground='orange')
            self.log_message("Starting screenshot capture process", 'info')
            
            file_path = self.path_entry.get()
            
            if not file_path or not os.path.exists(file_path):
                self.log_message(f"Invalid file path: {file_path}", 'error')
                self.screenshot_status.config(text="Error: File not found", foreground='red')
                return
            
            pythoncom.CoInitialize()
            
            excel = win32com.client.gencache.EnsureDispatch("Excel.Application")
            excel.Visible = False
            excel.DisplayAlerts = False
            
            workbook = excel.Workbooks.Open(
                Filename=os.path.abspath(file_path),
                UpdateLinks=0,
                ReadOnly=True,
                IgnoreReadOnlyRecommended=True
            )
            
            file_folder = os.path.dirname(os.path.abspath(file_path))
            self.screenshot_paths = []
            
            # Determine which screenshots to capture
            if self.smart_enabled:
                # SMART MODE: Analyze and capture conditionally
                smart_config = self.file_config.get('smart_linking', {})
                master_sheet = smart_config.get('master_sheet', '')
                master_range = smart_config.get('master_range', 'A1:Z50')
                
                # First, always capture master sheet
                self.log_message(f"Capturing master sheet: {master_sheet}", 'info')
                self.screenshot_status.config(text=f"Capturing master: {master_sheet}...", foreground='orange')
                
                self._capture_single_screenshot(
                    workbook,
                    master_sheet,
                    master_range,
                    f"Master_{master_sheet}",
                    file_folder,
                    embed=True,
                    attach=False
                )
                
                # Analyze linked sheets
                self.screenshot_status.config(text="Analyzing linked sheets...", foreground='orange')
                conditional_sheets = self.analyze_linked_sheets(workbook)
                
                self.log_message(
                    f"Found {len(conditional_sheets)} linked sheets meeting threshold conditions",
                    'success'
                )
                
                # Capture conditional sheets
                for sheet_config in conditional_sheets:
                    self.screenshot_status.config(
                        text=f"Capturing: {sheet_config['sheet_name']}...",
                        foreground='orange'
                    )
                    
                    self._capture_single_screenshot(
                        workbook,
                        sheet_config['sheet_name'],
                        sheet_config['cell_range'],
                        sheet_config['name'],
                        file_folder,
                        embed=sheet_config.get('embed', True),
                        attach=sheet_config.get('attach', False)
                    )
            else:
                # STANDARD MODE: Capture predefined screenshots
                screenshots_config = self.file_config.get('screenshots', [])
                
                if not screenshots_config:
                    self.log_message("No screenshot configuration found", 'warning')
                    self.screenshot_status.config(text="No screenshots configured", foreground='orange')
                    workbook.Close(SaveChanges=False)
                    excel.Quit()
                    pythoncom.CoUninitialize()
                    return
                
                for idx, config in enumerate(screenshots_config, 1):
                    sheet_name = config['sheet_name']
                    cell_range = config['cell_range']
                    name = config.get('name', f'screenshot_{idx}')
                    
                    self.screenshot_status.config(
                        text=f"Capturing {idx}/{len(screenshots_config)}: {name}...",
                        foreground='orange'
                    )
                    
                    self._capture_single_screenshot(
                        workbook,
                        sheet_name,
                        cell_range,
                        name,
                        file_folder,
                        embed=config.get('embed', True),
                        attach=config.get('attach', False)
                    )
            
            workbook.Close(SaveChanges=False)
            excel.Quit()
            pythoncom.CoUninitialize()
            
            self.screenshot_status.config(
                text=f"✓ Captured {len(self.screenshot_paths)} screenshots",
                foreground='green'
            )
            self.log_message(
                f"Screenshot capture completed - {len(self.screenshot_paths)} images saved",
                'success'
            )
            
        except Exception as e:
            self.log_message(f"Error taking screenshots: {str(e)}", 'error')
            self.screenshot_status.config(text="Error", foreground='red')
    
    def _capture_single_screenshot(self, workbook, sheet_name, cell_range, name, folder, embed=True, attach=False):
        """Helper method to capture a single screenshot"""
        try:
            self.log_message(f"  Capturing {name} from {sheet_name}!{cell_range}", 'info')
            
            sheet = workbook.Sheets(sheet_name)
            range_obj = sheet.Range(cell_range)
            range_obj.CopyPicture(Format=2)
            time.sleep(0.5)
            
            img = ImageGrab.grabclipboard()
            
            if img is None:
                self.log_message(f"  Failed to capture {name}", 'error')
                return
            
            save_path = os.path.join(folder, f"{name}.png")
            img.save(save_path, 'PNG')
            
            screenshot_info = {
                'path': save_path,
                'name': name,
                'embed': embed,
                'attach': attach
            }
            self.screenshot_paths.append(screenshot_info)
            
            self.log_message(f"  ✓ Saved {name}", 'success')
            
        except Exception as e:
            self.log_message(f"  Error capturing {name}: {str(e)}", 'error')
    
    def get_timestamp_ampm(self):
        """Get formatted timestamp with AM/PM"""
        timezone = self.email_config.get('timezone', 'IST')
        tz_map = {
            'IST': pytz.timezone('Asia/Kolkata'),
            'UK': pytz.timezone('Europe/London'),
            'GMT': pytz.timezone('GMT')
        }
        tz = tz_map.get(timezone, pytz.timezone('Asia/Kolkata'))
        return datetime.now(tz).strftime('%Y-%m-%d %I:%M:%S %p %Z')
    
    def draft_email(self):
        """Draft email in separate thread"""
        thread = threading.Thread(target=self._draft_email_thread)
        thread.daemon = True
        thread.start()
    
    def _draft_email_thread(self):
        """Thread worker for email drafting"""
        try:
            self.log_message("Starting email draft creation", 'info')
            
            if not self.screenshot_paths:
                self.log_message("No screenshots available. Please capture screenshots first.", 'warning')
                messagebox.showwarning("No Screenshots", "Please capture screenshots first.")
                return
            
            # Verify screenshot files exist
            missing_files = [s['name'] for s in self.screenshot_paths if not os.path.exists(s['path'])]
            
            if missing_files:
                self.log_message(f"Missing screenshot files: {', '.join(missing_files)}", 'error')
                return
            
            pythoncom.CoInitialize()
            
            outlook = win32com.client.gencache.EnsureDispatch("Outlook.Application")
            mail = outlook.CreateItem(0)
            
            # Set sender
            sender_email = self.sender_entry.get().strip()
            if sender_email:
                try:
                    account_found = False
                    for account in outlook.Session.Accounts:
                        if hasattr(account, 'SmtpAddress') and \
                           account.SmtpAddress.lower() == sender_email.lower():
                            mail.SendUsingAccount = account
                            self.log_message(f"Using sender account: {sender_email}", 'info')
                            account_found = True
                            break
                    
                    if not account_found:
                        mail.SentOnBehalfOfName = sender_email
                        self.log_message(f"Using SentOnBehalfOfName: {sender_email}", 'info')
                        
                except Exception as e:
                    self.log_message(f"Could not set sender: {str(e)}", 'warning')
            
            # Set recipients
            to_recipients = self.to_entry.get().strip()
            if to_recipients:
                mail.To = to_recipients
            
            cc_recipients = self.cc_entry.get().strip()
            if cc_recipients:
                mail.CC = cc_recipients
            
            # Get timestamp in AM/PM format
            timestamp = self.get_timestamp_ampm()
            
            # Build subject with timestamp
            base_subject = self.subject_entry.get().strip()
            mail.Subject = f"{base_subject} - {timestamp}"
            
            # Build email body
            body_text = self.body_text.get('1.0', tk.END).strip()
            signature = self.email_config.get('signature', '')
            disclaimer = self.email_config.get('disclaimer', '')
            
            html_body = f"""
            <html>
            <body style="font-family: Arial, sans-serif;">
            <p>{body_text.replace(chr(10), '<br>')}</p>
            <p><strong>Generated:</strong> {timestamp}</p>
            """
            
            # Add smart linking info if enabled
            if self.smart_enabled:
                html_body += f"""
                <p style="color: #0066cc; font-size: 11px;">
                <strong>Note:</strong> Screenshots captured using smart threshold analysis 
                ({len(self.screenshot_paths)} sheets included based on conditions)
                </p>
                """
            
            html_body += "<br>"
            
            # Add embedded screenshots
            embed_count = 0
            for screenshot in self.screenshot_paths:
                if screenshot.get('embed', False):
                    cid = f"image_{embed_count}"
                    html_body += f'<p><strong>{screenshot["name"]}</strong></p>'
                    html_body += f'<img src="cid:{cid}" alt="{screenshot["name"]}" style="max-width: 100%;"><br><br>'
                    
                    attachment = mail.Attachments.Add(screenshot['path'])
                    attachment.PropertyAccessor.SetProperty(
                        "http://schemas.microsoft.com/mapi/proptag/0x3712001F",
                        cid
                    )
                    embed_count += 1
                    self.log_message(f"Embedded {screenshot['name']}", 'info')
                
                if screenshot.get('attach', False):
                    mail.Attachments.Add(screenshot['path'])
                    self.log_message(f"Attached {screenshot['name']}", 'info')
            
            if signature:
                html_body += f'<p>{signature.replace(chr(10), "<br>")}</p>'
            
            if disclaimer:
                html_body += f'<p style="font-size: 10px; color: #666;">{disclaimer.replace(chr(10), "<br>")}</p>'
            
            html_body += "</body></html>"
            
            mail.HTMLBody = html_body
            mail.Save()
            
            self.log_message("Email draft created successfully in Outlook", 'success')
            
            # Handle deletions
            if self.delete_screenshot_var.get():
                time.sleep(1)
                for screenshot in self.screenshot_paths:
                    try:
                        if os.path.exists(screenshot['path']):
                            os.remove(screenshot['path'])
                            self.log_message(f"Deleted screenshot: {screenshot['name']}", 'info')
                    except Exception as e:
                        self.log_message(f"Could not delete {screenshot['name']}: {str(e)}", 'warning')
                
                self.screenshot_paths = []
            
            excel_file_path = self.path_entry.get()
            file_deleted = False
            
            if self.delete_file_var.get():
                time.sleep(1)
                try:
                    if os.path.exists(excel_file_path):
                        os.remove(excel_file_path)
                        self.log_message(f"Excel file deleted: {os.path.basename(excel_file_path)}", 'success')
                        file_deleted = True
                    else:
                        self.log_message("Excel file not found for deletion", 'warning')
                        
                except Exception as e:
                    self.log_message(f"Could not delete Excel file: {str(e)}", 'error')
            
            pythoncom.CoUninitialize()
            
            self.log_message("Email drafting completed", 'success')
            
            # Show confirmation dialog
            self.show_confirmation_dialog(file_deleted)
            
        except Exception as e:
            self.log_message(f"Error drafting email: {str(e)}", 'error')
            messagebox.showerror("Error", f"Failed to create email draft:\n{str(e)}")
    
    def show_confirmation_dialog(self, file_was_deleted):
        """Show post-draft confirmation dialog"""
        dialog = tk.Toplevel(self.popup)
        dialog.title("Email Drafted Successfully")
        dialog.geometry("450x250")
        dialog.transient(self.popup)
        dialog.grab_set()
        
        # Center the dialog
        dialog.update_idletasks()
        x = self.popup.winfo_x() + (self.popup.winfo_width() - dialog.winfo_width()) // 2
        y = self.popup.winfo_y() + (self.popup.winfo_height() - dialog.winfo_height()) // 2
        dialog.geometry(f"+{x}+{y}")
        
        ttk.Label(
            dialog,
            text="✓ Email draft created successfully!",
            font=('Arial', 12, 'bold'),
            foreground='green'
        ).pack(pady=20)
        
        if self.smart_enabled:
            ttk.Label(
                dialog,
                text=f"📊 {len(self.screenshot_paths)} sheets captured using smart linking",
                font=('Arial', 9),
                foreground='blue'
            ).pack(pady=5)
        
        ttk.Label(
            dialog,
            text="What would you like to do next?",
            font=('Arial', 10)
        ).pack(pady=10)
        
        button_frame = ttk.Frame(dialog)
        button_frame.pack(pady=20)
        
        def on_continue():
            dialog.destroy()
            if not file_was_deleted:
                self.reset_popup()
            else:
                messagebox.showinfo("File Deleted", "The Excel file was deleted. Please select a new file or go back.")
        
        def on_back():
            dialog.destroy()
            self.popup.destroy()
        
        def on_exit():
            dialog.destroy()
            self.popup.destroy()
            self.parent.destroy()
        
        ttk.Button(
            button_frame,
            text="Continue (Refresh)",
            command=on_continue,
            width=20
        ).grid(row=0, column=0, padx=5, pady=5)
        
        ttk.Button(
            button_frame,
            text="Back (Main Menu)",
            command=on_back,
            width=20
        ).grid(row=0, column=1, padx=5, pady=5)
        
        ttk.Button(
            button_frame,
            text="Exit (Close All)",
            command=on_exit,
            width=20
        ).grid(row=0, column=2, padx=5, pady=5)
    
    def reset_popup(self):
