"""
Citrix Application Function Automation Tester - Core Logic Module
This module contains all core testing functionality independent of any GUI framework.
Can be used standalone via CLI or imported by GUI/automation tools.
"""

import pyautogui
import time
import csv
import os
from datetime import datetime
from pathlib import Path
import logging
from typing import Dict, List, Tuple, Optional, Callable
from dataclasses import dataclass, field
from enum import Enum


# ============================================================================
# DATA STRUCTURES
# ============================================================================

class TestStatus(Enum):
    """Enumeration for test result statuses."""
    SUCCESS = "SUCCESS"
    FAILURE = "FAILURE"
    SKIPPED = "SKIPPED"
    ERROR = "ERROR"


@dataclass
class FunctionConfig:
    """Configuration for a single function test."""
    name: str
    click_target: str
    success_indicator: str
    close_button: str
    enabled: bool = True


@dataclass
class TestResult:
    """Result of a single function test."""
    function_name: str
    status: TestStatus
    timestamp: str
    screenshots: List[str] = field(default_factory=list)
    error_message: str = ""
    duration_seconds: float = 0.0


@dataclass
class TestConfig:
    """Global test configuration."""
    screenshot_dir: str = "test_screenshots"
    report_dir: str = "test_reports"
    timeout: int = 30
    retry_interval: int = 2
    max_retries: int = 3
    image_confidence: float = 0.8
    click_delay: float = 1.0
    inter_test_delay: float = 3.0


# ============================================================================
# CORE ENGINE CLASS
# ============================================================================

class CitrixTestEngine:
    """
    Core testing engine that handles all automation logic.
    Completely independent of any GUI framework.
    """
    
    def __init__(self, config: TestConfig, progress_callback: Optional[Callable] = None):
        """
        Initialize the test engine.
        
        Args:
            config: Test configuration object
            progress_callback: Optional callback function for progress updates
                              Signature: callback(message: str, progress: int)
        """
        self.config = config
        self.progress_callback = progress_callback
        self.logger = self._setup_logging()
        self._setup_directories()
        
    def _setup_logging(self) -> logging.Logger:
        """Configure logging to both file and console."""
        logger = logging.getLogger('CitrixTestEngine')
        logger.setLevel(logging.INFO)
        
        # Remove existing handlers to avoid duplicates
        logger.handlers.clear()
        
        # Create formatters
        formatter = logging.Formatter('%(asctime)s - %(levelname)s - %(message)s')
        
        # Console handler
        console_handler = logging.StreamHandler()
        console_handler.setFormatter(formatter)
        logger.addHandler(console_handler)
        
        return logger
    
    def _add_file_logging(self):
        """Add file logging handler (called when test starts)."""
        log_filename = os.path.join(
            self.config.report_dir,
            f"test_log_{datetime.now().strftime('%Y%m%d_%H%M%S')}.log"
        )
        file_handler = logging.FileHandler(log_filename)
        file_handler.setFormatter(logging.Formatter('%(asctime)s - %(levelname)s - %(message)s'))
        self.logger.addHandler(file_handler)
        self.logger.info(f"Logging to file: {log_filename}")
    
    def _setup_directories(self):
        """Create necessary directories for screenshots and reports."""
        Path(self.config.screenshot_dir).mkdir(parents=True, exist_ok=True)
        Path(self.config.report_dir).mkdir(parents=True, exist_ok=True)
        self.logger.info(f"Directories verified: {self.config.screenshot_dir}, {self.config.report_dir}")
    
    def _notify_progress(self, message: str, progress: int = 0):
        """
        Send progress notification to callback if available.
        
        Args:
            message: Progress message
            progress: Progress percentage (0-100)
        """
        if self.progress_callback:
            self.progress_callback(message, progress)
    
    def capture_screenshot(self, step_name: str, function_name: str = "") -> str:
        """
        Capture a screenshot and save it with a descriptive filename.
        
        Args:
            step_name: Description of the current step
            function_name: Name of the function being tested
        
        Returns:
            Path to the saved screenshot
        """
        timestamp = datetime.now().strftime('%Y%m%d_%H%M%S_%f')
        filename = f"{function_name}_{step_name}_{timestamp}.png".replace(" ", "_")
        filepath = os.path.join(self.config.screenshot_dir, filename)
        
        screenshot = pyautogui.screenshot()
        screenshot.save(filepath)
        
        self.logger.info(f"Screenshot captured: {filepath}")
        return filepath
    
    def wait_for_image(self, image_path: str, timeout: Optional[int] = None,
                       confidence: Optional[float] = None) -> Tuple[bool, Optional[Tuple]]:
        """
        Wait for an image to appear on screen with retry mechanism.
        
        Args:
            image_path: Path to the target image file
            timeout: Maximum time to wait in seconds (uses config if None)
            confidence: Confidence level for image matching (uses config if None)
        
        Returns:
            Tuple of (success: bool, location: tuple or None)
        """
        timeout = timeout or self.config.timeout
        confidence = confidence or self.config.image_confidence
        
        start_time = time.time()
        attempts = 0
        
        self.logger.info(f"Waiting for image: {image_path}")
        
        while (time.time() - start_time) < timeout:
            try:
                location = pyautogui.locateOnScreen(image_path, confidence=confidence)
                if location:
                    self.logger.info(f"Image found at location: {location}")
                    return True, location
            except pyautogui.ImageNotFoundException:
                pass
            except Exception as e:
                self.logger.error(f"Error while searching for image: {e}")
            
            attempts += 1
            time.sleep(self.config.retry_interval)
        
        self.logger.warning(f"Image not found after {timeout} seconds and {attempts} attempts")
        return False, None
    
    def click_image(self, image_path: str, confidence: Optional[float] = None) -> bool:
        """
        Find and click on an image on the screen.
        
        Args:
            image_path: Path to the image to click
            confidence: Confidence level for image matching (uses config if None)
        
        Returns:
            True if click was successful, False otherwise
        """
        confidence = confidence or self.config.image_confidence
        
        try:
            location = pyautogui.locateOnScreen(image_path, confidence=confidence)
            if location:
                click_point = pyautogui.center(location)
                pyautogui.click(click_point)
                self.logger.info(f"Clicked on image: {image_path} at {click_point}")
                time.sleep(self.config.click_delay)
                return True
            else:
                self.logger.warning(f"Could not find image to click: {image_path}")
                return False
        except Exception as e:
            self.logger.error(f"Error clicking image {image_path}: {e}")
            return False
    
    def close_function(self, close_button_path: str, function_name: str) -> bool:
        """
        Close the current function window/tab.
        
        Args:
            close_button_path: Path to the close button image
            function_name: Name of the function being closed
        
        Returns:
            True if successfully closed, False otherwise
        """
        self.logger.info(f"Attempting to close function: {function_name}")
        
        # Capture screenshot before closing
        self.capture_screenshot("before_close", function_name)
        
        # Try clicking the close button
        if self.click_image(close_button_path):
            time.sleep(1)
            self.capture_screenshot("after_close", function_name)
            self.logger.info(f"Function closed: {function_name}")
            return True
        else:
            # Fallback: try ESC key
            self.logger.warning("Close button not found, trying ESC key")
            pyautogui.press('esc')
            time.sleep(1)
            self.capture_screenshot("after_close_keyboard", function_name)
            return False
    
    def test_function(self, function_config: FunctionConfig) -> TestResult:
        """
        Test a single function within the application.
        
        Args:
            function_config: Configuration for the function to test
        
        Returns:
            TestResult object with test outcome
        """
        function_name = function_config.name
        start_time = time.time()
        
        self.logger.info(f"\n{'='*60}")
        self.logger.info(f"Testing function: {function_name}")
        self.logger.info(f"{'='*60}")
        
        self._notify_progress(f"Testing: {function_name}", 0)
        
        result = TestResult(
            function_name=function_name,
            status=TestStatus.FAILURE,
            timestamp=datetime.now().strftime('%Y-%m-%d %H:%M:%S')
        )
        
        try:
            # Step 1: Capture initial state
            initial_screenshot = self.capture_screenshot("initial_state", function_name)
            result.screenshots.append(initial_screenshot)
            
            # Step 2: Click on the function button/menu
            self.logger.info(f"Step 1: Clicking function button for {function_name}")
            self._notify_progress(f"Clicking {function_name}...", 20)
            
            click_screenshot = self.capture_screenshot("before_click", function_name)
            result.screenshots.append(click_screenshot)
            
            if not self.click_image(function_config.click_target):
                result.error_message = "Failed to find or click function button"
                error_screenshot = self.capture_screenshot("click_failed", function_name)
                result.screenshots.append(error_screenshot)
                return result
            
            after_click_screenshot = self.capture_screenshot("after_click", function_name)
            result.screenshots.append(after_click_screenshot)
            
            # Step 3: Wait for function to load
            self.logger.info(f"Step 2: Waiting for {function_name} to load")
            self._notify_progress(f"Waiting for {function_name} to load...", 40)
            
            success = False
            for retry in range(self.config.max_retries):
                self.logger.info(f"Attempt {retry + 1} of {self.config.max_retries}")
                
                found, location = self.wait_for_image(
                    function_config.success_indicator,
                    timeout=self.config.timeout // self.config.max_retries
                )
                
                if found:
                    success = True
                    break
                else:
                    retry_screenshot = self.capture_screenshot(f"retry_{retry + 1}", function_name)
                    result.screenshots.append(retry_screenshot)
            
            # Step 4: Capture result
            self._notify_progress(f"Capturing result for {function_name}...", 70)
            
            if success:
                result.status = TestStatus.SUCCESS
                self.logger.info(f"✓ Function {function_name} loaded successfully")
                success_screenshot = self.capture_screenshot("success", function_name)
                result.screenshots.append(success_screenshot)
            else:
                result.status = TestStatus.FAILURE
                result.error_message = "Function did not load within timeout period"
                self.logger.error(f"✗ Function {function_name} failed to load")
                failure_screenshot = self.capture_screenshot("failure", function_name)
                result.screenshots.append(failure_screenshot)
            
            # Step 5: Close the function
            self.logger.info(f"Step 3: Closing {function_name}")
            self._notify_progress(f"Closing {function_name}...", 90)
            self.close_function(function_config.close_button, function_name)
            
        except Exception as e:
            result.status = TestStatus.ERROR
            result.error_message = f"Unexpected error: {str(e)}"
            self.logger.error(f"Error testing {function_name}: {e}")
            error_screenshot = self.capture_screenshot("error", function_name)
            result.screenshots.append(error_screenshot)
        
        finally:
            result.duration_seconds = time.time() - start_time
            self._notify_progress(f"Completed: {function_name}", 100)
        
        return result
    
    def run_all_tests(self, functions: List[FunctionConfig]) -> List[TestResult]:
        """
        Execute tests for all configured functions.
        
        Args:
            functions: List of function configurations to test
        
        Returns:
            List of test results for all functions
        """
        self.logger.info("\n" + "="*60)
        self.logger.info("STARTING AUTOMATED FUNCTION TESTS")
        self.logger.info("="*60 + "\n")
        
        # Add file logging now that test is starting
        self._add_file_logging()
        
        results = []
        enabled_functions = [f for f in functions if f.enabled]
        total = len(enabled_functions)
        
        for idx, function_config in enumerate(enabled_functions, 1):
            overall_progress = int((idx - 1) / total * 100)
            self._notify_progress(
                f"Testing {idx}/{total}: {function_config.name}",
                overall_progress
            )
            
            result = self.test_function(function_config)
            results.append(result)
            
            # Brief pause between tests
            if idx < total:
                time.sleep(self.config.inter_test_delay)
        
        self._notify_progress("All tests completed!", 100)
        return results


# ============================================================================
# REPORTING MODULE
# ============================================================================

class ReportGenerator:
    """Generates various report formats from test results."""
    
    def __init__(self, report_dir: str):
        """
        Initialize report generator.
        
        Args:
            report_dir: Directory to save reports
        """
        self.report_dir = report_dir
    
    def generate_console_report(self, results: List[TestResult]) -> str:
        """
        Generate a formatted summary report for console output.
        
        Args:
            results: List of test results
        
        Returns:
            Formatted report string
        """
        total = len(results)
        passed = sum(1 for r in results if r.status == TestStatus.SUCCESS)
        failed = total - passed
        
        report_lines = [
            "",
            "="*60,
            "TEST EXECUTION SUMMARY",
            "="*60,
            f"Total Functions Tested: {total}",
            f"Passed: {passed}",
            f"Failed: {failed}",
            f"Success Rate: {(passed/total)*100:.1f}%" if total > 0 else "Success Rate: 0.0%",
            "="*60,
            "",
            "DETAILED RESULTS:",
            "-"*60,
            ""
        ]
        
        for result in results:
            status_symbol = "✓" if result.status == TestStatus.SUCCESS else "✗"
            report_lines.extend([
                f"{status_symbol} {result.function_name}",
                f"  Status: {result.status.value}",
                f"  Timestamp: {result.timestamp}",
                f"  Duration: {result.duration_seconds:.2f}s",
                f"  Screenshots: {len(result.screenshots)} captured"
            ])
            if result.error_message:
                report_lines.append(f"  Error: {result.error_message}")
            report_lines.append("")
        
        report_lines.extend(["="*60, ""])
        
        return "\n".join(report_lines)
    
    def generate_csv_report(self, results: List[TestResult]) -> str:
        """
        Write test results to a CSV file.
        
        Args:
            results: List of test results
        
        Returns:
            Path to the generated CSV file
        """
        timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')
        csv_filename = os.path.join(self.report_dir, f"test_report_{timestamp}.csv")
        
        with open(csv_filename, 'w', newline='', encoding='utf-8') as csvfile:
            fieldnames = [
                'Function Name', 'Status', 'Timestamp', 'Duration (s)',
                'Error Message', 'Screenshot Count', 'Screenshot Paths'
            ]
            writer = csv.DictWriter(csvfile, fieldnames=fieldnames)
            
            writer.writeheader()
            for result in results:
                writer.writerow({
                    'Function Name': result.function_name,
                    'Status': result.status.value,
                    'Timestamp': result.timestamp,
                    'Duration (s)': f"{result.duration_seconds:.2f}",
                    'Error Message': result.error_message,
                    'Screenshot Count': len(result.screenshots),
                    'Screenshot Paths': '; '.join(result.screenshots)
                })
        
        return csv_filename
    
    def generate_text_report(self, results: List[TestResult]) -> str:
        """
        Write test results to a formatted text file.
        
        Args:
            results: List of test results
        
        Returns:
            Path to the generated text file
        """
        timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')
        txt_filename = os.path.join(self.report_dir, f"test_report_{timestamp}.txt")
        
        with open(txt_filename, 'w', encoding='utf-8') as txtfile:
            total = len(results)
            passed = sum(1 for r in results if r.status == TestStatus.SUCCESS)
            failed = total - passed
            
            txtfile.write("="*60 + "\n")
            txtfile.write("CITRIX APPLICATION FUNCTION TEST REPORT\n")
            txtfile.write("="*60 + "\n\n")
            txtfile.write(f"Test Date: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\n")
            txtfile.write(f"Total Functions Tested: {total}\n")
            txtfile.write(f"Passed: {passed}\n")
            txtfile.write(f"Failed: {failed}\n")
            txtfile.write(f"Success Rate: {(passed/total)*100:.1f}%\n" if total > 0 else "Success Rate: 0.0%\n")
            txtfile.write("\n" + "="*60 + "\n\n")
            
            txtfile.write("DETAILED RESULTS:\n")
            txtfile.write("-"*60 + "\n\n")
            
            for result in results:
                txtfile.write(f"Function: {result.function_name}\n")
                txtfile.write(f"Status: {result.status.value}\n")
                txtfile.write(f"Timestamp: {result.timestamp}\n")
                txtfile.write(f"Duration: {result.duration_seconds:.2f}s\n")
                if result.error_message:
                    txtfile.write(f"Error: {result.error_message}\n")
                txtfile.write(f"Screenshots Captured: {len(result.screenshots)}\n")
                txtfile.write("Screenshot Paths:\n")
                for screenshot in result.screenshots:
                    txtfile.write(f"  - {screenshot}\n")
                txtfile.write("\n" + "-"*60 + "\n\n")
        
        return txt_filename


