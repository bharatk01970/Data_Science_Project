Option Explicit

' ===================================================================
' TM1 Instance Health Check Validator - Excel Formula Method
' Purpose: Validate TM1 instances using native Excel TM1 functions
' Method: Uses DBRW/SUBNM functions to test connectivity
' ===================================================================

' Configuration Constants
Const LOG_SHEET_NAME As String = "TM1_ValidationLog"
Const CONFIG_SHEET_NAME As String = "TM1_Instances"
Const TEST_SHEET_NAME As String = "TM1_ConnectionTest"

Sub ValidateAllTM1Instances()
    ' Main procedure to validate all configured TM1 instances using Excel formulas
    
    Dim wsConfig As Worksheet
    Dim wsLog As Worksheet
    Dim wsTest As Worksheet
    Dim lastRow As Long
    Dim i As Long
    Dim instanceName As String
    Dim serverAddress As String
    Dim testCell As Range
    Dim formulaResult As Variant
    Dim isHealthy As Boolean
    Dim errorMessage As String
    Dim attempts As Integer
    
    On Error GoTo ErrorHandler
    
    ' Initialize worksheets
    Set wsConfig = GetOrCreateSheet(CONFIG_SHEET_NAME)
    Set wsLog = GetOrCreateSheet(LOG_SHEET_NAME)
    Set wsTest = GetOrCreateSheet(TEST_SHEET_NAME)
    
    ' Setup sheets
    Call InitializeLogSheet(wsLog)
    Call InitializeConfigSheet(wsConfig)
    
    ' Get last row of instance list
    lastRow = wsConfig.Cells(wsConfig.Rows.Count, 1).End(xlUp).Row
    
    If lastRow < 2 Then
        MsgBox "No TM1 instances configured. Please add instances to the " & CONFIG_SHEET_NAME & " sheet.", vbInformation
        Exit Sub
    End If
    
    ' Display progress
    Application.ScreenUpdating = False
    Application.DisplayAlerts = False
    Application.StatusBar = "Starting TM1 instance validation using Excel formulas..."
    Application.Calculation = xlCalculationManual
    
    ' Clear test sheet
    wsTest.Cells.Clear
    wsTest.Cells(1, 1).Value = "Test Area - Do Not Delete"
    
    ' Iterate through all instances
    For i = 2 To lastRow
        instanceName = Trim(wsConfig.Cells(i, 1).Value)
        serverAddress = Trim(wsConfig.Cells(i, 2).Value)
        
        If instanceName <> "" And serverAddress <> "" Then
            Application.StatusBar = "Validating instance " & (i - 1) & " of " & (lastRow - 1) & ": " & instanceName
            
            isHealthy = False
            errorMessage = ""
            
            ' Test connection using Excel TM1 formulas
            isHealthy = TestTM1ConnectionWithFormula(wsTest, serverAddress, instanceName, errorMessage)
            
            ' Log the result
            Call LogValidationResult(wsLog, instanceName, serverAddress, isHealthy, errorMessage)
            
            DoEvents
        End If
    Next i
    
    ' Cleanup
    Application.Calculation = xlCalculationAutomatic
    Application.Calculate
    Application.ScreenUpdating = True
    Application.DisplayAlerts = True
    Application.StatusBar = False
    
    MsgBox "TM1 instance validation completed. Check the " & LOG_SHEET_NAME & " sheet for results.", vbInformation
    
    Exit Sub
    
ErrorHandler:
    Application.Calculation = xlCalculationAutomatic
    Application.ScreenUpdating = True
    Application.DisplayAlerts = True
    Application.StatusBar = False
    MsgBox "Error in validation process: " & Err.Description, vbCritical
End Sub

Function TestTM1ConnectionWithFormula(wsTest As Worksheet, serverAddress As String, instanceName As String, ByRef errorMsg As String) As Boolean
    ' Tests TM1 connection using native Excel TM1 functions
    
    Dim testCell As Range
    Dim formulaString As String
    Dim cellValue As Variant
    Dim waitCounter As Integer
    Dim maxWait As Integer
    
    On Error GoTo TestError
    
    TestTM1ConnectionWithFormula = False
    errorMsg = ""
    maxWait = 15 ' seconds
    
    ' Set test cell
    Set testCell = wsTest.Range("A2")
    testCell.Clear
    
    ' Method 1: Try SUBNM function (gets server name - proves connection)
    ' Format: =SUBNM("ServerName:Port", "}")
    formulaString = "=SUBNM(""" & serverAddress & """, ""}"")"
    
    testCell.Formula = formulaString
    
    ' Force calculation and wait
    Application.Calculate
    DoEvents
    
    ' Wait for formula to resolve (up to maxWait seconds)
    For waitCounter = 1 To maxWait
        Application.Wait Now + TimeValue("00:00:01")
        DoEvents
        cellValue = testCell.Value
        
        ' Check if we got a valid result
        If Not IsError(cellValue) Then
            If cellValue <> "" And cellValue <> 0 Then
                ' Success - we got server name back
                TestTM1ConnectionWithFormula = True
                errorMsg = "Connected successfully - Server: " & cellValue
                Exit Function
            End If
        Else
            ' Got an error from the formula
            Exit For
        End If
    Next waitCounter
    
    ' Method 2: Try alternative connection test using TM1RPTROW
    testCell.Clear
    formulaString = "=TM1RPTROW(""" & serverAddress & """,""}"","""","""")"
    testCell.Formula = formulaString
    
    Application.Calculate
    DoEvents
    Application.Wait Now + TimeValue("00:00:02")
    
    cellValue = testCell.Value
    
    If Not IsError(cellValue) Then
        TestTM1ConnectionWithFormula = True
        errorMsg = "Connected successfully using TM1RPTROW"
        Exit Function
    End If
    
    ' If we reach here, connection failed
    If IsError(testCell.Value) Then
        errorMsg = "Connection failed - " & GetErrorDescription(testCell.Value)
    Else
        errorMsg = "Connection timeout - No response from server"
    End If
    
    TestTM1ConnectionWithFormula = False
    Exit Function
    
TestError:
    errorMsg = "Test error: " & Err.Description
    TestTM1ConnectionWithFormula = False
End Function

Function GetErrorDescription(errorValue As Variant) As String
    ' Translates Excel error values to readable descriptions
    Select Case errorValue
        Case CVErr(xlErrName)
            GetErrorDescription = "#NAME? - Server not found or TM1 functions not available"
        Case CVErr(xlErrNA)
            GetErrorDescription = "#N/A - Cannot connect to TM1 instance"
        Case CVErr(xlErrValue)
            GetErrorDescription = "#VALUE! - Invalid server address format"
        Case CVErr(xlErrRef)
            GetErrorDescription = "#REF! - Reference error"
        Case CVErr(xlErrNum)
            GetErrorDescription = "#NUM! - Numeric error"
        Case CVErr(xlErrNull)
            GetErrorDescription = "#NULL! - Null error"
        Case Else
            GetErrorDescription = "Unknown error"
    End Select
End Function

Sub InitializeConfigSheet(ws As Worksheet)
    ' Sets up the configuration sheet with headers and instructions
    
    If ws.Cells(1, 1).Value = "" Then
        ws.Cells(1, 1).Value = "Instance Name"
        ws.Cells(1, 2).Value = "Server Address"
        
        With ws.Range("A1:B1")
            .Font.Bold = True
            .Interior.Color = RGB(79, 129, 189)
            .Font.Color = RGB(255, 255, 255)
            .HorizontalAlignment = xlCenter
        End With
        
        ' Add instructions
        ws.Cells(2, 1).Value = "PROD_Finance"
        ws.Cells(2, 2).Value = "servername:port"
        
        ws.Cells(4, 1).Value = "INSTRUCTIONS:"
        ws.Cells(5, 1).Value = "1. Replace 'servername:port' with your actual TM1 server"
        ws.Cells(6, 1).Value = "2. Format: hostname:port or IP:port (e.g., tm1prod:12345)"
        ws.Cells(7, 1).Value = "3. Add more instances in rows below"
        ws.Cells(8, 1).Value = "4. Run ValidateAllTM1Instances macro"
        
        ws.Range("A4:A8").Font.Italic = True
        ws.Range("A4:A8").Font.Color = RGB(100, 100, 100)
        
        ws.Columns("A:B").AutoFit
    End If
End Sub

Sub InitializeLogSheet(ws As Worksheet)
    ' Sets up the log sheet with headers
    
    If ws.Cells(1, 1).Value = "" Then
        ws.Cells(1, 1).Value = "Timestamp"
        ws.Cells(1, 2).Value = "Instance Name"
        ws.Cells(1, 3).Value = "Server Address"
        ws.Cells(1, 4).Value = "Status"
        ws.Cells(1, 5).Value = "Message"
        
        ' Format headers
        With ws.Range("A1:E1")
            .Font.Bold = True
            .Interior.Color = RGB(79, 129, 189)
            .Font.Color = RGB(255, 255, 255)
            .HorizontalAlignment = xlCenter
        End With
        
        ws.Columns("A:E").AutoFit
    End If
End Sub

Sub LogValidationResult(ws As Worksheet, instanceName As String, serverAddress As String, isHealthy As Boolean, errorMsg As String)
    ' Logs validation result to the log sheet
    Dim nextRow As Long
    Dim statusText As String
    Dim statusColor As Long
    
    nextRow = ws.Cells(ws.Rows.Count, 1).End(xlUp).Row + 1
    
    ' Determine status
    If isHealthy Then
        statusText = "AVAILABLE"
        statusColor = RGB(0, 176, 80)
    Else
        statusText = "UNAVAILABLE"
        statusColor = RGB(255, 0, 0)
    End If
    
    ' Write log entry
    ws.Cells(nextRow, 1).Value = Now
    ws.Cells(nextRow, 2).Value = instanceName
    ws.Cells(nextRow, 3).Value = serverAddress
    ws.Cells(nextRow, 4).Value = statusText
    ws.Cells(nextRow, 5).Value = errorMsg
    
    ' Format status cell
    With ws.Cells(nextRow, 4)
        .Font.Bold = True
        .Font.Color = statusColor
    End With
    
    ' Format timestamp
    ws.Cells(nextRow, 1).NumberFormat = "yyyy-mm-dd hh:mm:ss"
    
    ws.Columns("A:E").AutoFit
End Sub

Function GetOrCreateSheet(sheetName As String) As Worksheet
    ' Gets existing sheet or creates new one
    Dim ws As Worksheet
    
    On Error Resume Next
    Set ws = ThisWorkbook.Worksheets(sheetName)
    On Error GoTo 0
    
    If ws Is Nothing Then
        Set ws = ThisWorkbook.Worksheets.Add(After:=ThisWorkbook.Worksheets(ThisWorkbook.Worksheets.Count))
        ws.Name = sheetName
    End If
    
    Set GetOrCreateSheet = ws
End Function

Sub ClearValidationLog()
    ' Utility to clear the validation log (keeps headers)
    Dim ws As Worksheet
    Dim lastRow As Long
    
    On Error Resume Next
    Set ws = ThisWorkbook.Worksheets(LOG_SHEET_NAME)
    On Error GoTo 0
    
    If Not ws Is Nothing Then
        lastRow = ws.Cells(ws.Rows.Count, 1).End(xlUp).Row
        If lastRow > 1 Then
            ws.Range("A2:E" & lastRow).ClearContents
            MsgBox "Validation log cleared.", vbInformation
        Else
            MsgBox "No log entries to clear.", vbInformation
        End If
    Else
        MsgBox "Log sheet not found.", vbExclamation
    End If
End Sub

' ====================================================================
' MANUAL TEST: Test Single TM1 Connection Using Formula
' Use this to manually test one server before running full validation
' ====================================================================
Sub TestSingleTM1Connection()
    Dim serverAddress As String
    Dim wsTest As Worksheet
    Dim testResult As Boolean
    Dim errorMsg As String
    
    ' Prompt for server address
    serverAddress = InputBox("Enter TM1 server address (format: servername:port)", "Test TM1 Connection", "localhost:12345")
    
    If serverAddress = "" Then Exit Sub
    
    Set wsTest = GetOrCreateSheet(TEST_SHEET_NAME)
    wsTest.Cells.Clear
    
    MsgBox "Testing connection to: " & serverAddress & vbCrLf & vbCrLf & "Please wait...", vbInformation
    
    testResult = TestTM1ConnectionWithFormula(wsTest, serverAddress, "Test", errorMsg)
    
    If testResult Then
        MsgBox "SUCCESS!" & vbCrLf & vbCrLf & errorMsg, vbInformation, "Connection Test Result"
    Else
        MsgBox "FAILED!" & vbCrLf & vbCrLf & errorMsg, vbCritical, "Connection Test Result"
    End If
End Sub

' ====================================================================
' Create a Manual Test Sheet with TM1 Formulas
' This creates a sheet where you can see the actual TM1 formulas working
' ====================================================================
Sub CreateManualTestSheet()
    Dim ws As Worksheet
    Dim serverAddress As String
    
    serverAddress = InputBox("Enter TM1 server address to test:", "Manual Test Sheet", "localhost:12345")
    If serverAddress = "" Then Exit Sub
    
    Set ws = GetOrCreateSheet("TM1_ManualTest")
    ws.Cells.Clear
    
    ' Header
    ws.Cells(1, 1).Value = "TM1 Manual Connection Test"
    ws.Cells(1, 1).Font.Bold = True
    ws.Cells(1, 1).Font.Size = 14
    
    ws.Cells(2, 1).Value = "Server:"
    ws.Cells(2, 2).Value = serverAddress
    ws.Cells(2, 2).Font.Bold = True
    
    ' Test formulas
    ws.Cells(4, 1).Value = "Test 1: SUBNM"
    ws.Cells(4, 2).Formula = "=SUBNM(""" & serverAddress & """, ""}"")"
    
    ws.Cells(5, 1).Value = "Test 2: TM1RPTROW"
    ws.Cells(5, 2).Formula = "=TM1RPTROW(""" & serverAddress & """,""}"","""","""")"
    
    ws.Cells(7, 1).Value = "Instructions:"
    ws.Cells(8, 1).Value = "- If formulas show server name or data = SUCCESS"
    ws.Cells(9, 1).Value = "- If formulas show #N/A or #NAME? = FAILED"
    ws.Cells(10, 1).Value = "- Wait 10-15 seconds for formulas to calculate"
    
    ws.Range("A7:A10").Font.Italic = True
    ws.Columns("A:B").AutoFit
    
    MsgBox "Manual test sheet created!" & vbCrLf & vbCrLf & "Check cells B4 and B5 for results.", vbInformation
End Sub