    def apply_reference_mapping(self, stage1_data, combined_column_name, combination_source_map, 
                                new_column_name, default_mappings, ref_mapping_df, 
                                direct_mappings, reference_values, repeat_values):
        """
        Enhanced three-step mapping logic:
        
        Step 1: Default Mapping - Apply default values for specific source columns
        Step 2: Reference Mapping - Apply reference-based repetition mapping
        Step 3: Direct Mapping - Apply direct value-to-value mappings from external files
        
        Priority: Direct Mapping > Reference Mapping > Default Mapping
        """
        print("\n" + "="*60)
        print("ENHANCED REFERENCE MAPPING - Three-Step Logic")
        print("="*60)
        
        rows = [copy.deepcopy(r) for r in stage1_data]
        
        # Build mapping dictionaries
        # Step 1: Default mappings (column → default_value)
        print(f"\nStep 1: Default Mappings")
        if default_mappings:
            for col, val in default_mappings.items():
                print(f"  - Column '{col}' → Default: '{val}'")
        else:
            print("  - None configured")
        
        # Step 2: Reference mapping (reference_value → mapped_value)
        ref_mapping_dict = {}
        if ref_mapping_df is not None and len(ref_mapping_df.columns) >= 2:
            key_col = ref_mapping_df.columns[0]
            value_col = ref_mapping_df.columns[1]
            ref_mapping_dict = {
                str(k).strip(): str(v).strip() 
                for k, v in zip(ref_mapping_df[key_col].astype(str), 
                              ref_mapping_df[value_col].astype(str))
            }
            print(f"\nStep 2: Reference Mapping")
            print(f"  - {len(ref_mapping_dict)} reference mappings loaded")
        else:
            print(f"\nStep 2: Reference Mapping")
            print("  - None configured")
        
        # Step 3: Direct mappings (value → mapped_value for specific columns)
        direct_mapping_dicts = {}
        if direct_mappings:
            print(f"\nStep 3: Direct Mappings")
            for col_name, mapping_df in direct_mappings.items():
                if len(mapping_df.columns) >= 2:
                    key_col = mapping_df.columns[0]
                    value_col = mapping_df.columns[1]
                    direct_mapping_dicts[col_name] = {
                        str(k).strip(): str(v).strip()
                        for k, v in zip(mapping_df[key_col].astype(str), 
                                      mapping_df[value_col].astype(str))
                    }
                    print(f"  - Column '{col_name}': {len(direct_mapping_dicts[col_name])} mappings")
        else:
            print(f"\nStep 3: Direct Mappings")
            print("  - None configured")
        
        # Convert reference and repeat values to sets
        ref_set = set(str(x).strip() for x in (reference_values or []))
        rep_set = set(str(x).strip() for x in (repeat_values or []))
        
        # Create reverse lookup: value → source_column
        value_to_source = {}
        if combination_source_map:
            for col_name, values in combination_source_map.items():
                for val in values:
                    value_to_source[str(val).strip()] = col_name
        
        print(f"\n" + "-"*60)
        print("Processing Rows...")
        print("-"*60)
        
        # Buffer for repeated values
        buffer_indices = []
        result_rows = []
        
        # Track statistics
        stats = {
            'default_applied': 0,
            'reference_applied': 0,
            'direct_applied': 0,
            'no_mapping': 0
        }
        
        for idx, row in enumerate(rows):
            combined_val = str(row.get(combined_column_name, '')).strip()
            source_column = value_to_source.get(combined_val, None)
            
            mapped_value = ''
            mapping_applied = None
            
            # PRIORITY 1: Check Direct Mapping
            if source_column and source_column in direct_mapping_dicts:
                if combined_val in direct_mapping_dicts[source_column]:
                    mapped_value = direct_mapping_dicts[source_column][combined_val]
                    mapping_applied = 'direct'
                    stats['direct_applied'] += 1
            
            # PRIORITY 2: Check if repeated value
            if not mapping_applied and combined_val in rep_set:
                row[new_column_name] = ''
                result_rows.append(row)
                buffer_indices.append(len(result_rows) - 1)
                continue
            
            # PRIORITY 3: Check if reference value
            if not mapping_applied and combined_val in ref_set:
                if ref_mapping_dict and combined_val in ref_mapping_dict:
                    mapped_value_for_buffer = ref_mapping_dict[combined_val]
                    if buffer_indices:
                        for bi in buffer_indices:
                            result_rows[bi][new_column_name] = mapped_value_for_buffer
                        stats['reference_applied'] += len(buffer_indices)
                buffer_indices = []
                row[new_column_name] = ''
                result_rows.append(row)
                continue
            
            # PRIORITY 4: Check Default Mapping
            if not mapping_applied and source_column and source_column in default_mappings:
                mapped_value = default_mappings[source_column]
                mapping_applied = 'default'
                stats['default_applied'] += 1
            
            if not mapping_applied:
                stats['no_mapping'] += 1
            
            row[new_column_name] = mapped_value
            result_rows.append(row)
        
        if buffer_indices:
            print(f"\n⚠ Warning: {len(buffer_indices)} buffered rows not followed by reference")
        
        print(f"\n" + "="*60)
        print("Mapping Statistics:")
        print("="*60)
        print(f"  Direct Mappings Applied (Step 3): {stats['direct_applied']}")
        print(f"  Reference Mappings Applied (Step 2): {stats['reference_applied']}")
        print(f"  Default Mappings Applied (Step 1): {stats['default_applied']}")
        print(f"  No Mapping (Blank): {stats['no_mapping']}")
        print(f"  Total Rows Processed: {len(result_rows)}")
        print("="*60 + "\n")
        
        return result_rows


