def apply_default_column_mapping(self, data_rows, source_column, mapping_df, target_column):
    """
    Enhanced Default Column Mapping:
    - Supports wildcard-based mapping rules.
    - Pattern rules:
        'APP='     → exact match
        '*App='    → starts with 'App'
        '*App*='   → contains 'App'
        'ZApp*='   → ends with 'ZApp'
        '='        → source value blank
        '*='       → all remaining unmatched values
    """
    if mapping_df is None or len(mapping_df.columns) < 2:
        return data_rows

    key_col = mapping_df.columns[0]
    value_col = mapping_df.columns[1]
    mapping_rules = [(str(k).strip(), str(v).strip()) for k, v in zip(mapping_df[key_col], mapping_df[value_col])]

    def match_pattern(src_val, pattern):
        src_val = str(src_val or '').strip()
        pattern = pattern.strip()

        # Handle blank
        if pattern == '=':
            return src_val == ''

        # Handle catch-all
        if pattern == '*=':
            return True  # only used when others fail

        # Split pattern before '='
        if '=' in pattern:
            left = pattern.split('=')[0]
        else:
            left = pattern

        # Exact match
        if not left.startswith('*') and not left.endswith('*'):
            return src_val == left

        # Starts with
        if left.startswith('*') and not left.endswith('*'):
            keyword = left[1:]
            return src_val.startswith(keyword)

        # Ends with
        if left.endswith('*') and not left.startswith('*'):
            keyword = left[:-1]
            return src_val.endswith(keyword)

        # Contains
        if left.startswith('*') and left.endswith('*'):
            keyword = left.strip('*')
            return keyword in src_val

        return False

    # Apply mapping
    for row in data_rows:
        src_val = str(row.get(source_column, '')).strip()
        mapped_val = ''
        applied = False

        for pattern, target in mapping_rules:
            if pattern == '*=':
                fallback_value = target  # store fallback for later
                continue
            if match_pattern(src_val, pattern):
                mapped_val = target
                applied = True
                break

        # If not matched, apply fallback if defined
        if not applied:
            for pattern, target in mapping_rules:
                if pattern == '*=':
                    mapped_val = target
                    break

        row[target_column] = mapped_val

    print(f"Applied default column mapping with wildcard rules on '{source_column}' → '{target_column}'")
    return data_rows