    def open_log_file(self):
        """Open the most recent log file in default text editor"""
        try:
            if not os.path.exists(self.log_folder):
                messagebox.showwarning("Folder Not Found", f"Log folder not found:\n{self.log_folder}")
                return
            
            # Get all log files
            log_files = [f for f in os.listdir(self.log_folder) if f.endswith('.log')]
            
            if not log_files:
                messagebox.showinfo("No Logs", "No log files found in log folder")
                return
            
            # Get most recent log file
            log_files_with_path = [os.path.join(self.log_folder, f) for f in log_files]
            most_recent_log = max(log_files_with_path, key=os.path.getmtime)
            
            os.startfile(most_recent_log)
            self.log_message(f"Opened log file: {os.path.basename(most_recent_log)}", 'info')
            
        except Exception as e:
            messagebox.showerror("Error", f"Could not open log file:\n{str(e)}")

