'=================================================================================
' ENHANCED SORT OUTPUT DATA - MIDDLE C HIERARCHY ONLY
' Sorts by: TopC → ALL/ATT (Col 2) → Middle C Hierarchy (Cols 3,4)
' Does NOT sort by Lowest C (NCR/SRAC/ARAC)
'=================================================================================
Sub SortOutputData()
    Dim wsOutput As Worksheet
    Dim lastRow As Long
    Dim dataRange As Range
    Dim i As Long
    Dim col2Value, col3Value, col4Value As String
    Dim sortKey1, sortKey2, sortKey3, sortKey4 As String
    
    Const OUTPUT_SHEET = "Output"
    Const OUTPUT_START_ROW = 2
    
    On Error GoTo ErrorHandler
    
    On Error Resume Next
    Set wsOutput = ThisWorkbook.Sheets(OUTPUT_SHEET)
    On Error GoTo ErrorHandler
    
    If wsOutput Is Nothing Then
        MsgBox "ERROR: 'Output' sheet not found!", vbCritical, "Sheet Not Found"
        Exit Sub
    End If
    
    lastRow = wsOutput.Cells(wsOutput.Rows.Count, "A").End(xlUp).Row
    
    If lastRow < OUTPUT_START_ROW Then
        MsgBox "No output data found to sort.", vbInformation, "No Data"
        Exit Sub
    End If
    
    ' Add helper columns for sorting (H, I, J, K)
    wsOutput.Cells(1, 9).Value = "Sort_TopC"
    wsOutput.Cells(1, 10).Value = "Sort_ALL_ATT"
    wsOutput.Cells(1, 11).Value = "Sort_Col3"
    wsOutput.Cells(1, 12).Value = "Sort_Col4"
    
    ' Assign sort keys based on Middle C columns only
    For i = OUTPUT_START_ROW To lastRow
        Dim topCValue As String
        topCValue = Trim(wsOutput.Cells(i, 1).Value)
        col2Value = UCase(Trim(wsOutput.Cells(i, 2).Value))
        col3Value = UCase(Trim(wsOutput.Cells(i, 3).Value))
        col4Value = UCase(Trim(wsOutput.Cells(i, 4).Value))
        
        ' Sort Key 1: TopC (alphabetical)
        wsOutput.Cells(i, 9).Value = topCValue
        
        ' Sort Key 2: ALL before ATT (based on Column 2)
        If InStr(col2Value, "_ALL") > 0 Or col2Value = "ALL*" Then
            sortKey2 = "1_ALL"
        Else
            sortKey2 = "2_ATT"
        End If
        wsOutput.Cells(i, 10).Value = sortKey2
        
        ' Sort Key 3: Column 3 hierarchy (NCR before RAC)
        If InStr(col3Value, "NCR") > 0 Then
            sortKey3 = "1_NCR"
        ElseIf InStr(col3Value, "RAC") > 0 Then
            sortKey3 = "2_RAC"
        ElseIf col3Value = "." Then
            sortKey3 = "0_DOT"
        Else
            sortKey3 = "9_" & col3Value
        End If
        wsOutput.Cells(i, 11).Value = sortKey3
        
        ' Sort Key 4: Column 4 hierarchy (. before ARAC before SRAC)
        If col4Value = "." Then
            sortKey4 = "1_DOT"
        ElseIf InStr(col4Value, "ARAC") > 0 Then
            sortKey4 = "2_ARAC"
        ElseIf InStr(col4Value, "SRAC") > 0 Then
            sortKey4 = "3_SRAC"
        Else
            sortKey4 = "9_" & col4Value
        End If
        wsOutput.Cells(i, 12).Value = sortKey4
        
    Next i
    
    ' Define data range including helper columns
    Set dataRange = wsOutput.Range("A" & OUTPUT_START_ROW & ":L" & lastRow)
    
    ' Perform multi-level sort based on Middle C hierarchy
    With wsOutput.Sort
        .SortFields.Clear
        
        ' 1st: Sort by TopC (alphabetical)
        .SortFields.Add Key:=wsOutput.Range("I" & OUTPUT_START_ROW & ":I" & lastRow), _
                       SortOn:=xlSortOnValues, Order:=xlAscending
        
        ' 2nd: Sort by ALL/ATT (ALL first)
        .SortFields.Add Key:=wsOutput.Range("J" & OUTPUT_START_ROW & ":J" & lastRow), _
                       SortOn:=xlSortOnValues, Order:=xlAscending
        
        ' 3rd: Sort by Column 3 (NCR before RAC)
        .SortFields.Add Key:=wsOutput.Range("K" & OUTPUT_START_ROW & ":K" & lastRow), _
                       SortOn:=xlSortOnValues, Order:=xlAscending
        
        ' 4th: Sort by Column 4 (. before ARAC before SRAC)
        .SortFields.Add Key:=wsOutput.Range("L" & OUTPUT_START_ROW & ":L" & lastRow), _
                       SortOn:=xlSortOnValues, Order:=xlAscending
        
        .SetRange dataRange
        .Header = xlNo
        .MatchCase = False
        .Orientation = xlTopToBottom
        .Apply
    End With
    
    ' Delete helper columns
    wsOutput.Columns("I:L").Delete
    
    wsOutput.Columns("A:H").AutoFit
    
    MsgBox "Sort complete!" & vbCrLf & vbCrLf & _
           "Sort hierarchy (Middle C only):" & vbCrLf & _
           "1. TopC (alphabetical)" & vbCrLf & _
           "2. ALL before ATT (Column 2)" & vbCrLf & _
           "3. NCR before RAC (Column 3)" & vbCrLf & _
           "4. . before ARAC before SRAC (Column 4)" & vbCrLf & vbCrLf & _
           "Result: A1-ALL, A1-ATT, A2-ALL, A2-ATT pattern", _
           vbInformation, "Sort Complete"
    
    Exit Sub
    
ErrorHandler:
    ' Clean up helper columns if they exist
    On Error Resume Next
    wsOutput.Columns("I:L").Delete
    On Error GoTo 0
    MsgBox "Error sorting: " & Err.Description, vbCritical, "Sort Error"
End Sub


'=================================================================================
' HIGHLIGHT CHANGES IN MIDDLE C COLUMNS
' Highlights cells in columns 2, 3, 4 where values change from previous row
' Applies light green color to changed cells
'=================================================================================
Sub HighlightMiddleCChanges()
    Dim wsOutput As Worksheet
    Dim lastRow As Long
    Dim currentRow As Long
    Dim col As Long
    Dim currentValue As String
    Dim previousValue As String
    Dim changesCount As Long
    
    ' Configuration
    Const OUTPUT_SHEET = "Output"
    Const OUTPUT_START_ROW = 2
    Const LIGHT_GREEN = 5296274  ' RGB(226, 239, 218) - Light green color
    
    On Error GoTo ErrorHandler
    
    ' Set worksheet reference
    On Error Resume Next
    Set wsOutput = ThisWorkbook.Sheets(OUTPUT_SHEET)
    On Error GoTo ErrorHandler
    
    If wsOutput Is Nothing Then
        MsgBox "ERROR: 'Output' sheet not found!", vbCritical, "Sheet Not Found"
        Exit Sub
    End If
    
    ' Find last row with data
    lastRow = wsOutput.Cells(wsOutput.Rows.Count, "A").End(xlUp).Row
    
    ' Check if there's data to highlight
    If lastRow < OUTPUT_START_ROW + 1 Then
        MsgBox "Not enough data to compare (need at least 2 rows).", vbInformation, "No Data"
        Exit Sub
    End If
    
    ' Clear any existing highlighting in columns 2, 3, 4
    wsOutput.Range("B" & OUTPUT_START_ROW & ":D" & lastRow).Interior.ColorIndex = xlNone
    
    changesCount = 0
    
    ' Loop through each row starting from the second data row
    For currentRow = OUTPUT_START_ROW + 1 To lastRow
        
        ' Check columns 2, 3, 4 (B, C, D) - the Middle C columns
        For col = 2 To 4
            currentValue = Trim(UCase(wsOutput.Cells(currentRow, col).Value))
            previousValue = Trim(UCase(wsOutput.Cells(currentRow - 1, col).Value))
            
            ' Compare current value with previous row
            If currentValue <> previousValue And currentValue <> "" Then
                ' Highlight the cell with light green
                wsOutput.Cells(currentRow, col).Interior.Color = LIGHT_GREEN
                changesCount = changesCount + 1
            End If
        Next col
        
    Next currentRow
    
    MsgBox "Highlighting complete!" & vbCrLf & vbCrLf & _
           "Total cells highlighted: " & changesCount & vbCrLf & _
           "Color: Light Green" & vbCrLf & vbCrLf & _
           "Changes highlighted in columns:" & vbCrLf & _
           "- Column 2 (Middle C - Status)" & vbCrLf & _
           "- Column 3 (Middle C - Code 1)" & vbCrLf & _
           "- Column 4 (Middle C - Code 2)", _
           vbInformation, "Highlighting Complete"
    
    Exit Sub
    
ErrorHandler:
    MsgBox "Error highlighting changes: " & Err.Description, vbCritical, "Error"
End Sub


'=================================================================================
' COMBINED MACRO - Transform, Sort, and Highlight
' Runs transformation, sorting, and highlighting automatically
'=================================================================================
Sub TransformAndSort()
    ' Run the transformation
    Call TransformInputToOutput
    
    ' Wait a moment for the transformation to complete
    DoEvents
    
    ' Run the sort
    Call SortOutputData
    
    ' Wait a moment for the sort to complete
    DoEvents
    
    ' Run the highlighting
    Call HighlightMiddleCChanges
End Sub


'=================================================================================
' CLEAR HIGHLIGHTING - Remove all highlighting from Middle C columns
'=================================================================================
Sub ClearHighlighting()
    Dim wsOutput As Worksheet
    Dim lastRow As Long
    
    On Error Resume Next
    Set wsOutput = ThisWorkbook.Sheets("Output")
    On Error GoTo 0
    
    If wsOutput Is Nothing Then
        MsgBox "ERROR: 'Output' sheet not found!", vbCritical, "Sheet Not Found"
        Exit Sub
    End If
    
    lastRow = wsOutput.Cells(wsOutput.Rows.Count, "A").End(xlUp).Row
    
    If lastRow >= 2 Then
        wsOutput.Range("B2:D" & lastRow).Interior.ColorIndex = xlNone
        MsgBox "All highlighting cleared from Middle C columns.", vbInformation, "Clear Complete"
    End If
End Sub


