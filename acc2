    def setup_file_specific_logging(self, file_key, actual_filename=None):
        """Setup individual log file for each recon file"""
        try:
            # Use actual filename if provided, otherwise use file_key
            if actual_filename:
                # Extract base name without extension
                base_name = os.path.splitext(actual_filename)[0]
                log_filename = f"ReconMailDraft_{base_name}_{datetime.now().strftime('%Y%m%d_%H%M%S')}.log"
            else:
                log_filename = f"ReconMailDraft_{file_key.replace(' ', '_')}_{datetime.now().strftime('%Y%m%d_%H%M%S')}.log"
            
            log_filepath = os.path.join(self.log_folder, log_filename)
            
            # Create unique logger for this file
            logger_name = f'ReconMailDraft_{file_key}_{datetime.now().strftime("%H%M%S%f")}'
            logger = logging.getLogger(logger_name)
            logger.setLevel(logging.DEBUG)
            logger.handlers = []
            
            file_handler = logging.FileHandler(
                log_filepath,
                encoding='utf-8'
            )
            file_handler.setLevel(logging.DEBUG)
            
            formatter = logging.Formatter(
                '%(asctime)s | %(levelname)-8s | %(message)s',
                datefmt='%Y-%m-%d %I:%M:%S %p'
            )
            file_handler.setFormatter(formatter)
            logger.addHandler(file_handler)
            
            logger.info("="*60)
            logger.info(f"FILE PROCESSING STARTED: {file_key}")
            logger.info("="*60)
            logger.info(f"File-specific log initialized for: {file_key}")
            if actual_filename:
                logger.info(f"Processing file: {actual_filename}")
            logger.info(f"Log file path: {log_filepath}")
            
            print(f"Created log file: {log_filename}")
            
            return logger
            
        except Exception as e:
            print(f"Error setting up file-specific logging: {str(e)}")
            return None

