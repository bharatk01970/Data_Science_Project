class ExcelOutlookEmailer:
    def __init__(self, excel_path=None, use_active_workbook=False):
        """
        Initialize with path to Excel workbook or use active workbook
        
        Args:
            excel_path: Path to Excel file (if not using active workbook)
            use_active_workbook: If True, use currently open Excel workbook
        """
        self.excel_path = excel_path
        self.use_active_workbook = use_active_workbook
        self.excel = None
        self.outlook = None
        self.workbook = None
        self.created_excel_instance = False
        
    def __enter__(self):
        """Context manager entry"""
        pythoncom.CoInitialize()
        try:
            self.outlook = win32com.client.gencache.EnsureDispatch("Outlook.Application")
            
            if self.use_active_workbook:
                # Connect to existing Excel instance
                try:
                    self.excel = win32com.client.GetActiveObject("Excel.Application")
                    self.workbook = self.excel.ActiveWorkbook
                    if self.workbook is None:
                        raise Exception("No active workbook found in Excel")
                    print(f"Connected to active workbook: {self.workbook.Name}")
                    self.created_excel_instance = False
                except:
                    raise Exception("No Excel instance running or no active workbook")
            else:
                # Create new Excel instance and open file
                self.excel = win32com.client.gencache.EnsureDispatch("Excel.Application")
                self.excel.Visible = False
                self.excel.DisplayAlerts = False
                self.created_excel_instance = True
                
                # Normalize path
                abs_path = os.path.abspath(self.excel_path)
                if not os.path.exists(abs_path):
                    raise FileNotFoundError(f"Excel file not found: {abs_path}")
                
                # Open workbook with parameters
                self.workbook = self.excel.Workbooks.Open(
                    Filename=abs_path,
                    UpdateLinks=0,
                    ReadOnly=True,
                    IgnoreReadOnlyRecommended=True
                )
            return self
        except Exception as e:
            # Cleanup on error
            if self.created_excel_instance and self.excel:
                try:
                    self.excel.Quit()
                except:
                    pass
            pythoncom.CoUninitialize()
            raise Exception(f"Failed to initialize: {str(e)}")
        
    def __exit__(self, exc_type, exc_val, exc_tb):
        """Context manager exit - cleanup"""
        try:
            # Only close workbook and quit Excel if we created the instance
            if self.created_excel_instance:
                if self.workbook:
                    self.workbook.Close(SaveChanges=False)
                if self.excel:
                    self.excel.Quit()
        except:
            pass
        try:
            pythoncom.CoUninitialize()
        except:
            pass
        
    def get_available_accounts(self, detailed=False):
        """
        Get list of Outlook accounts with detailed information
        
        Args:
            detailed: If True, return dict with account info; if False, return list of names
        
        Returns:
            List of account names or list of dicts with account details
        """
        accounts = []
        try:
            namespace = self.outlook.GetNamespace("MAPI")
            
            for idx, account in enumerate(namespace.Accounts):
                if detailed:
                    account_info = {
                        'index': idx,
                        'display_name': account.DisplayName,
                        'smtp_address': account.SmtpAddress if hasattr(account, 'SmtpAddress') else 'N/A',
                        'account_type': account.AccountType if hasattr(account, 'AccountType') else 'Unknown',
                        'user_name': account.UserName if hasattr(account, 'UserName') else 'N/A'
                    }
                    accounts.append(account_info)
                    print(f"{idx}: {account_info['display_name']} ({account_info['smtp_address']})")
                else:
                    accounts.append(account.DisplayName)
            
            if not accounts:
                print("Warning: No accounts found in Outlook Session.Accounts")
                # Try alternate method
                for folder in namespace.Folders:
                    store_name = folder.Name
                    if store_name not in accounts:
                        accounts.append(store_name)
                        if detailed:
                            print(f"Found via Folders: {store_name}")
                            
        except Exception as e:
            print(f"Error getting accounts: {str(e)}")
            
        return accounts
        
    def capture_range_screenshot(self, sheet_name, cell_range):
        """Capture screenshot of specified Excel range"""
        try:
            sheet = self.workbook.Sheets(sheet_name)
            range_obj = sheet.Range(cell_range)
            
            # Copy range as picture
            range_obj.CopyPicture(Format=2)  # xlBitmap
            time.sleep(0.5)  # Wait for clipboard
            
            # Grab from clipboard
            img = ImageGrab.grabclipboard()
            
            if img is None:
                raise Exception(f"Failed to capture {sheet_name}!{cell_range}")
                
            return img
            
        except Exception as e:
            raise Exception(f"Error capturing {sheet_name}!{cell_range}: {str(e)}")
    
    def get_timestamp(self, timezone='IST'):
        """Get formatted timestamp in specified timezone"""
        tz_map = {
            'IST': pytz.timezone('Asia/Kolkata'),
            'UK': pytz.timezone('Europe/London'),
            'GMT': pytz.timezone('GMT')
        }
        
        tz = tz_map.get(timezone, pytz.timezone('Asia/Kolkata'))
        now = datetime.now(tz)
        return now.strftime('%Y-%m-%d %H:%M:%S %Z')
    
    def create_email(self, 
                     screenshots_config,
                     subject=None,
                     body_text="",
                     to_recipients=None,
                     cc_recipients=None,
                     bcc_recipients=None,
                     sender_account=None,
                     sender_email=None,
                     timezone='IST',
                     send=False):
        """
        Create Outlook email with screenshots
        
        Args:
            screenshots_config: List of dicts with keys:
                - sheet_name: Excel sheet name
                - cell_range: Cell range (e.g., 'A1:D10')
                - embed: Boolean, embed in body
                - attach: Boolean, attach as file
                - name: Screenshot name/filename
            subject: Email subject (None for default)
            body_text: Additional body text
            to_recipients: List of email addresses
            cc_recipients: List of CC email addresses
            bcc_recipients: List of BCC email addresses
            sender_account: Sender account display name (e.g., "John Doe")
            sender_email: Sender email address (e.g., "john@example.com") - alternative to sender_account
            timezone: Timezone for timestamp ('IST', 'UK', 'GMT')
            send: If True, send email; if False, save as draft
        """
        
        # Create mail item
        mail = self.outlook.CreateItem(0)  # 0 = olMailItem
        
        # Set sender account - try multiple methods
        account_set = False
        
        # Method 1: By display name
        if sender_account and not account_set:
            try:
                for account in self.outlook.Session.Accounts:
                    if account.DisplayName == sender_account or \
                       (hasattr(account, 'SmtpAddress') and account.SmtpAddress == sender_account):
                        mail.SendUsingAccount = account
                        account_set = True
                        print(f"✓ Using account: {account.DisplayName}")
                        break
            except Exception as e:
                print(f"Method 1 failed: {str(e)}")
        
        # Method 2: By email address using SendUsingAccount
        if sender_email and not account_set:
            try:
                for account in self.outlook.Session.Accounts:
                    if hasattr(account, 'SmtpAddress') and account.SmtpAddress.lower() == sender_email.lower():
                        mail.SendUsingAccount = account
                        account_set = True
                        print(f"✓ Using account: {account.DisplayName} ({sender_email})")
                        break
            except Exception as e:
                print(f"Method 2 failed: {str(e)}")
        
        # Method 3: Set SentOnBehalfOfName (alternative approach)
        if sender_email and not account_set:
            try:
                mail.SentOnBehalfOfName = sender_email
                account_set = True
                print(f"✓ Using SentOnBehalfOfName: {sender_email}")
            except Exception as e:
                print(f"Method 3 failed: {str(e)}")
        
        # Method 4: Try using account by index
        if sender_account and not account_set:
            try:
                # If sender_account is a number, use it as index
                if isinstance(sender_account, int):
                    account = self.outlook.Session.Accounts.Item(sender_account + 1)  # 1-indexed
                    mail.SendUsingAccount = account
                    account_set = True
                    print(f"✓ Using account by index {sender_account}: {account.DisplayName}")
            except Exception as e:
                print(f"Method 4 failed: {str(e)}")
        
        if not account_set and (sender_account or sender_email):
            print(f"⚠ Warning: Could not set sender account. Using default account.")
        
        # Set recipients
        if to_recipients:
            mail.To = "; ".join(to_recipients)
        if cc_recipients:
            mail.CC = "; ".join(cc_recipients)
        if bcc_recipients:
            mail.BCC = "; ".join(bcc_recipients)
        
        # Generate timestamp
        timestamp = self.get_timestamp(timezone)
        
        # Set subject
        if subject is None:
            subject = f"Excel Report - {timestamp}"
        else:
            subject = f"{subject} - {timestamp}"
        mail.Subject = subject
        
        # Build email body
        html_body = f"""
        <html>
        <body>
        <p>{body_text}</p>
        <p><strong>Generated:</strong> {timestamp}</p>
        <br>
        """
        
        # Process screenshots
        temp_files = []
        embed_count = 0
        
        for idx, config in enumerate(screenshots_config):
            sheet_name = config['sheet_name']
            cell_range = config['cell_range']
            embed = config.get('embed', False)
            attach = config.get('attach', False)
            name = config.get('name', f'screenshot_{idx+1}')
            
            # Capture screenshot
            img = self.capture_range_screenshot(sheet_name, cell_range)
            
            # Save to temporary file
            temp_path = os.path.join(os.environ['TEMP'], f"{name}.png")
            img.save(temp_path, 'PNG')
            temp_files.append(temp_path)
            
            # Embed in body
            if embed:
                cid = f"image_{embed_count}"
                html_body += f'<p><strong>{name}</strong></p>'
                html_body += f'<img src="cid:{cid}" alt="{name}"><br><br>'
                
                # Add as inline attachment
                attachment = mail.Attachments.Add(temp_path)
                attachment.PropertyAccessor.SetProperty(
                    "http://schemas.microsoft.com/mapi/proptag/0x3712001F",
                    cid
                )
                embed_count += 1
            
            # Attach as file
            if attach:
                mail.Attachments.Add(temp_path)
        
        html_body += """
        </body>
        </html>
        """
        
        mail.HTMLBody = html_body
        
        # Send or save as draft
        if send:
            mail.Send()
            result = "Email sent successfully"
        else:
            mail.Save()
            result = "Email draft created successfully"
        
        # Cleanup temp files
        time.sleep(1)  # Wait for Outlook to process
        for temp_file in temp_files:
            try:
                os.remove(temp_file)
            except:
                pass
        
        return result


