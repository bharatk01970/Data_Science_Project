    def _capture_single_screenshot(self, workbook, sheet_name, cell_range, name, folder, embed=True, attach=False):
        """
        Capture a screenshot of a specific Excel sheet range.
        
        This method uses Excel's CopyPicture functionality to copy a cell range
        to the clipboard, then captures it as an image and saves to disk.
        
        Args:
            workbook: Excel workbook COM object
            sheet_name: Name of sheet to capture
            cell_range: Cell range to capture (e.g., "A1:Z50")
            name: Filename for saved screenshot (without extension)
            folder: Directory path to save screenshot
            embed: Whether to embed image in email body (default True)
            attach: Whether to attach image as separate file (default False)
        """
        try:
            self.log_message(f' Capturing {name} from {sheet_name}!{cell_range}', 'info')

            # Get the specified sheet from workbook
            sheet = workbook.Sheets(sheet_name)
            # Get the range object for the cells to capture
            range_obj = sheet.Range(cell_range) 
            # Copy the range as a picture to clipboard (Format=2 is bitmap)
            range_obj.CopyPicture(Format=2)
            # Wait for clipboard operation to complete
            time.sleep(1)

            # Grab the image from clipboard
            img = ImageGrab.grabclipboard()

            # Check if image was successfully captured
            if img is None:
                self.log_message(f"  Failed to capture {name}", 'error')
                return

            # Create full file path for saving screenshot
            save_path = os.path.join(folder, f"{name}.png")
            # Save image as PNG format
            img.save(save_path, 'PNG')
            
            # Store screenshot information for later use in email drafting
            screenshot_info = {
                'path': save_path,  # Full file path
                'name': name,  # Display name
                'embed': embed,  # Whether to embed in email
                'attach': attach  # Whether to attach as file
            }
            self.screenshot_paths.append(screenshot_info)
            
            self.log_message(f"  ✓ Saved {name}", 'success')

        except Exception as e:
            # Log error if screenshot capture fails
            self.log_message(f"  Error capturing {name}: {str(e)}", 'error')

    def get_timestamp_ampm(self):
        """
        Generate a formatted timestamp in 12-hour format with timezone.
        
        Returns the current time in the configured timezone with AM/PM notation.
        Used for email subject lines and body text.
        
        Returns:
            str: Formatted timestamp (e.g., "2025-11-17 02:30:45 PM GMT")
        """
        # Get configured timezone (default to IST)
        timezone = self.email_config.get('timezone', 'IST')
        
        # Map timezone abbreviations to pytz timezone objects
        tz_map = {
            'IST': pytz.timezone('Asia/Kolkata'),  # Indian Standard Time
            'UK': pytz.timezone('Europe/London'),  # UK Time
            'GMT': pytz.timezone('GMT')  # Greenwich Mean Time
        }
        
        # Get timezone object (default to GMT if not found)
        tz = tz_map.get(timezone, pytz.timezone('GMT'))
        
        # Return formatted timestamp with 12-hour time and timezone
        return datetime.now(tz).strftime('%Y-%m-%d %I:%M:%S %p %Z')

    def draft_email(self):
        """
        Initiate email drafting in a background thread.
        
        This method starts the email drafting process without blocking the GUI.
        The actual drafting logic runs in _draft_email_thread().
        """
        # Create and start background thread for email drafting
        thread = threading.Thread(target=self._draft_email_thread)
        thread.daemon = True  # Thread terminates when main thread exits
        thread.start()

    def _draft_email_thread(self):
        """
        Create an Outlook email draft with screenshots in a background thread.
        
        This method:
        1. Validates screenshots are available
        2. Creates Outlook email draft
        3. Sets sender, recipients, subject, and body
        4. Embeds/attaches screenshots
        5. Adds signature and disclaimer
        6. Saves draft in Outlook
        7. Cleans up temporary files
        
        Runs in separate thread to prevent GUI freezing during Outlook operations.
        """
        try:
            self.log_message("Initiating email draft creation", 'info')
            
            # Verify screenshots are available
            if not self.screenshot_paths:
                self.log_message("No screenshots available. Please capture screenshots first.", 'warning')
                if not self.auto_mode:
                    messagebox.showwarning("No Screenshots", "Please capture screenshots first.")
                return
            
            # Check if all screenshot files still exist
            missing_files = [s['name'] for s in self.screenshot_paths if not os.path.exists(s['path'])]
            
            if missing_files:
                self.log_message(f"Missing screenshot files: {', '.join(missing_files)}", 'error')
                return
            
            # Initialize COM for this thread (required for Outlook automation)
            pythoncom.CoInitialize()
            
            # Create Outlook application instance
            outlook = win32com.client.gencache.EnsureDispatch("Outlook.Application")
            # Create new mail item (0 = mail item type)
            mail = outlook.CreateItem(0)

            # Set sender email account if specified
            sender_email = self.email_config.get('sender_email', '').strip()
            if sender_email:
                try:
                    account_found = False
                    # Loop through all Outlook accounts to find matching sender
                    for account in outlook.Session.Accounts:
                        if hasattr(account, 'SmtpAddress') and \
                            account.SmtpAddress.lower() == sender_email.lower():
                            # Found matching account - use it to send
                            mail.SendUsingAccount = account
                            self.log_message(f"Using sender account: {sender_email}", 'info')
                            account_found = True
                            break
                    
                    # If account not found, use SentOnBehalfOfName (delegate sending)
                    if not account_found:
                        mail.SentOnBehalfOfName = sender_email
                        self.log_message(f"Using SentOnBehalfOfName: {sender_email}", 'info')
                        
                except Exception as e:
                    self.log_message(f"Could not set sender: {str(e)}", 'warning')

            # Set To recipients from GUI entry field
            to_recipients = self.to_entry.get().strip()
            if to_recipients:
                mail.To = to_recipients
            
            # Set CC recipients from GUI entry field
            cc_recipients = self.cc_entry.get().strip()
            if cc_recipients:
                mail.CC = cc_recipients
            
            # Generate timestamp for email
            timestamp = self.get_timestamp_ampm()
            
            # Get email subject and body templates from config
            email_subject = self.file_config.get('default_subject', '')
            email_body_text = self.file_config.get('email_body', '')

            # Replace {timestamp} placeholder in body and subject
            email_body_text = email_body_text.replace('{timestamp}', timestamp)
            email_subject = email_subject.replace('{timestamp}', timestamp)
            
            # Set email subject
            mail.Subject = email_subject
            
            # Get signature and disclaimer from config
            signature = self.email_config.get('signature', '')
            disclaimer = self.email_config.get('disclaimer', '')
            
            # Build HTML email body
            html_body = f"""
            <html>
            <body style="font-family: Century;font-size: 10pt;">
            <p>{email_body_text.replace(chr(10), '<br>')}</p>
            """
            
            embed_count = 0  # Counter for embedded images

            # Process each screenshot - embed and/or attach
            for screenshot in self.screenshot_paths:
                # Embed image in email body if specified
                if screenshot.get('embed', False):
                    # Create unique Content-ID for this image
                    cid = f"image_{embed_count}"
                    # Add image tag to HTML body with CID reference
                    html_body += f'<img src="cid:{cid}" alt="{screenshot["name"]}" style="max-width: 80%;">'
                    
                    # Attach image file
                    attachment = mail.Attachments.Add(screenshot['path'])
                    # Set Content-ID property to embed image inline
                    attachment.PropertyAccessor.SetProperty(
                        "http://schemas.microsoft.com/mapi/proptag/0x3712001F",
                        cid
                    )
                    embed_count += 1
                    self.log_message(f"Embedded {screenshot['name']}", 'info')
                
                # Attach image as separate file if specified
                if screenshot.get('attach', False):
                    mail.Attachments.Add(screenshot['path'])
                    self.log_message(f"Attached {screenshot['name']}", 'info')
            
            # Add signature to email body if configured
            if signature:
                html_body += f'<p>{signature.replace(chr(10), '<br>')}</p>'
            
            # Add disclaimer to email body if configured
            if disclaimer:
                html_body += f'<p style="font-size: 10px; color: #666;">{disclaimer.replace(chr(10), "<br>")}</p>'
            
            # Close HTML body
            html_body += "</body></html>"
            
            # Set the HTML body content
            mail.HTMLBody = html_body
            # Save email as draft in Outlook
            mail.Save()
            
            self.log_message("Email draft created successfully in Outlook", 'success')

            # Wait a moment before file cleanup
            time.sleep(1)

            # Delete screenshot files after email is drafted
            for screenshot in self.screenshot_paths:
                try:
                    if os.path.exists(screenshot['path']):
                        # Note: File deletion code is commented out in original
                        self.log_message(f"Deleted screenshot: {screenshot['name']}", 'info')
                except Exception as e:
                    self.log_message(f"Could not delete {screenshot['name']}: {str(e)}", 'warning')
            
            # Clear screenshot paths list
            self.screenshot_paths = []
            
            # Get Excel file path for deletion
            excel_file_path = self.path_entry.get()
            file_deleted = False
            
            # Wait before deleting Excel file
            time.sleep(1)
            try:
                if os.path.exists(excel_file_path):
                    # Note: File deletion code is commented out in original
                    self.log_message(f"Excel file deleted: {os.path.basename(excel_file_path)}", 'success')
                    file_deleted = True
                else:
                    self.log_message("Excel file not found for deletion", 'warning')
                    
            except Exception as e:
                self.log_message(f"Could not delete Excel file: {str(e)}", 'error')
            
            # Uninitialize COM
            pythoncom.CoUninitialize()
            
            self.log_message("Email drafting completed", 'success')
            
            # Skip confirmation dialog in auto mode
            if not self.auto_mode:
                self.show_confirmation_dialog(file_deleted)
            
        except Exception as e:
            # Log any errors that occur during email drafting
            self.log_message(f"Error drafting email: {str(e)}", 'error')
            if not self.auto_mode:
                messagebox.showerror("Error", f"Failed to create email draft:\n{str(e)}")

    def show_confirmation_dialog(self, file_was_deleted):
        """
        Display a confirmation dialog after successful email drafting.
        
        Provides three options:
        - Continue: Refresh popup for another draft
        - Back: Return to main menu
        - Exit: Close entire application
        
        Args:
            file_was_deleted: Boolean indicating if the Excel file was deleted
        """
        # Create modal dialog on top of popup
        dialog = tk.Toplevel(self.popup)
        dialog.title('Email Drafted Successfully')
        dialog.geometry('450x200')
        dialog.transient(self.popup)  # Dialog stays on top of popup
        dialog.grab_set()  # Make dialog modal

        # Update dialog to get actual dimensions
        dialog.update_idletasks()

        # Center dialog over popup window
        x = self.popup.winfo_x() + (self.popup.winfo_width() - dialog.winfo_width()) // 2
        y = self.popup.winfo_y() + (self.popup.winfo_height() - dialog.winfo_height()) // 2
        dialog.geometry(f"+{x}+{y}")

        # Success message label
        ttk.Label(
            dialog,
            text="✓ Email draft created successfully!",
            font=('Arial', 12, 'bold'),
            foreground='green'
        ).pack(pady=20)
        
        # Prompt label
        ttk.Label(
            dialog,
            text="What would you like to do next?",
            font=('Arial', 10)
        ).pack(pady=10)
        
        # Button container frame
        button_frame = ttk.Frame(dialog)
        button_frame.pack(pady=20)
        
        def on_continue():
            """Handle Continue button - refresh popup for new draft"""
            dialog.destroy()
            if not file_was_deleted:
                # File still exists - reset popup for another draft
                self.reset_popup()
            else:
                # File was deleted - inform user
                messagebox.showinfo("File Deleted", "The Excel file was deleted. Please select a new file or go back.")
        
        def on_back():
            """Handle Back button - return to main menu"""
            dialog.destroy()
            self.popup.destroy()
        
        def on_exit():
            """Handle Exit button - close all windows"""
            dialog.destroy()
            self.popup.destroy()
            self.parent.destroy()
        
        # Continue button - refresh and draft another email
        ttk.Button(
            button_frame,
            text="Continue (Refresh)",
            command=on_continue,
            width=20
        ).grid(row=0, column=0, padx=5, pady=5)
        
        # Back button - return to main window
        ttk.Button(
            button_frame,
            text="Back (Main Menu)",
            command=on_back,
            width=20
        ).grid(row=0, column=1, padx=5, pady=5)
        
        # Exit button - close entire application
        ttk.Button(
            button_frame,
            text="Exit (Close All)",
            command=on_exit,
            width=20
        ).grid(row=0, column=2, padx=5, pady=5)
    
    def reset_popup(self):
        """
        Reset the popup window for creating another draft.
        
        Clears screenshot list and resets status indicators to allow
        user to capture new screenshots and draft another email.
        """
        # Clear screenshot list
        self.screenshot_paths = []
        # Reset status label to ready state
        self.screenshot_status.config(text="Ready", foreground='blue')
        # Log reset action
        self.log_message("Popup refreshed - Ready for new draft", 'success')


