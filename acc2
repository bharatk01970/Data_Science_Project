    info_frame.grid(row=7, column=0, columnspan=2, sticky=(tk.W, tk.E), padx=10, pady=5)
    
    ttk.Label(info_frame, text="ℹ Pattern Matching is case-sensitive", 
              font=('TkDefaultFont', 8), foreground='red').pack(anchor=tk.W)
    ttk.Label(info_frame, text="ℹ Use * alone for catch-all wildcard (non-blank values only)", 
              font=('TkDefaultFont', 8), foreground='gray').pack(anchor=tk.W)

    def save_mapping():
        new_col=new_col_entry.get().strip()
        source_col=source_var.get().strip()
        if not new_col:
            messagebox.showwarning('Warning','Please enter a new column name')
            return
        if not source_col:
            messagebox.showwarning('Warning','Please select a source column')
            return

        #parse mapping with enhanced pattern support
        mapping_dict={}
        has_wildcard = False
        has_blank = False
        pattern_count = 0
        
        mapping_lines=mapping_text.get('1.0',tk.END).strip().split('\n')
        for line_num, line in enumerate(mapping_lines, 1):
            line = line.strip()
            if not line:
                continue
                
            if '=' not in line:
                messagebox.showwarning('Warning', 
                    f'Invalid format on line {line_num}: "{line}"\n'
                    'Expected format: key=value')
                return
                
            key, val = line.split('=', 1)
            key = key.strip()
            val = val.strip()
            
            if not key or not val:
                messagebox.showwarning('Warning', 
                    f'Empty key or value on line {line_num}: "{line}"')
                return
            
            # Check for special keys
            if key == '*':
                has_wildcard = True
            elif key.upper() == '<BLANK>':
                has_blank = True
                key = '<BLANK>'  # Normalize to uppercase
            elif '*' in key and key != '*':
                # Pattern detected
                pattern_count += 1
                # Validate pattern (should not have * in middle unless it's *text* pattern)
                star_count = key.count('*')
                if star_count > 2:
                    messagebox.showwarning('Warning', 
                        f'Invalid pattern on line {line_num}: "{key}"\n'
                        'Only prefix (*text), suffix (text*), or contains (*text*) patterns allowed')
                    return
                if star_count == 2 and not (key.startswith('*') and key.endswith('*')):
                    messagebox.showwarning('Warning', 
                        f'Invalid pattern on line {line_num}: "{key}"\n'
                        'For two wildcards, use *text* (contains pattern)')
                    return
            
            mapping_dict[key] = val

        if not mapping_dict:
            messagebox.showwarning('Warning','Please provide at least one value mapping')
            return
        
        # Show summary of mapping configuration
        summary_parts = [f"✓ {len(mapping_dict)} mapping rule(s) defined"]
        if has_wildcard:
            summary_parts.append("✓ Catch-all wildcard (*) included")
        if has_blank:
            summary_parts.append("✓ Blank value (<BLANK>) rule included")
        if pattern_count > 0:
            summary_parts.append(f"✓ {pattern_count} pattern matching rule(s) included")
        
        # Confirm with user
        confirm_msg = f"Add default column '{new_col}' based on '{source_col}'?\n\n" + "\n".join(summary_parts)
        if messagebox.askyesno("Confirm Mapping", confirm_msg):
            default_columns.append((new_col, source_col, mapping_dict))
            
            # Display in listbox with indicators
            display_text = f'{new_col} ← {source_col}'
            indicators = []
            if has_wildcard:
                indicators.append('*')
            if has_blank:
                indicators.append('B')
            if pattern_count > 0:
                indicators.append(f'P{pattern_count}')
            
            if indicators:
                display_text += f' [{", ".join(indicators)}]'
            
            add_listbox.insert(tk.END, display_text)
            detail_popup.destroy()

    button_frame = ttk.Frame(detail_popup)
    button_frame.grid(row=8, column=0, columnspan=2, pady=10)
    
    ttk.Button(button_frame, text='Save Mapping', 
               command=save_mapping, style='Accent.TButton').pack(side=tk.LEFT, padx=5)
    ttk.Button(button_frame, text='Cancel', 
               command=detail_popup.destroy).pack(side=tk.LEFT, padx=5)













