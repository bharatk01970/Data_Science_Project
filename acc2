                font=('Arial', 11, 'bold'),
                foreground='orange'
            ).pack(pady=5)
        
        inst_frame = ttk.LabelFrame(self.scrollable_frame, text="Workflow", padding="15")
        inst_frame.pack(fill=tk.X, padx=20, pady=15)
        
        instructions = """
        1. Select the Recon Template from below
        2. Capture screenshots from Excel sheets
        3. Configure email recipients
        4. Draft email in Outlook with embedded screenshots
        5. Files and screenshots are automatically deleted after drafting
        """
        
