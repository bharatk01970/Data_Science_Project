Sub TransformInputToOutput()
    '=================================================================================
    ' EXCEL TRANSFORMATION MACRO - ENHANCED VERSION
    ' Purpose: Transform one input row into three output rows with specific rules
    ' Enhanced: Added "New code" column, ALL/ATT sorting, hierarchical Middle C sorting
    '=================================================================================
    
    Dim wsInput As Worksheet
    Dim wsOutput As Worksheet
    Dim lastRow As Long
    Dim inputRow As Long
    Dim outputRow As Long
    Dim level5ID As String
    Dim level5Name As String
    Dim level4ID As String
    Dim level4Name As String
    Dim level3ID As String
    Dim level3Name As String
    Dim level2ID As String
    Dim level2Name As String
    Dim level1ID As String
    Dim level1Name As String
    Dim comments As String
    Dim topC As String
    Dim l2x As String
    Dim middleCStatus As String
    Dim isStandard As Boolean
    Dim allAltSuffix As String
    Dim shouldTransform As Boolean
    Dim skippedCount As Long
    Dim skipReason As String
    
    ' Configuration
    Const INPUT_SHEET = "Input"
    Const OUTPUT_SHEET = "Output"
    Const INPUT_START_ROW = 2
    Const OUTPUT_START_ROW = 2
    
    ' Turn off screen updating for faster processing
    Application.ScreenUpdating = False
    Application.Calculation = xlCalculationManual
    
    On Error GoTo ErrorHandler
    
    ' Set worksheet references
    On Error Resume Next
    Set wsInput = ThisWorkbook.Sheets(INPUT_SHEET)
    If wsInput Is Nothing Then
        MsgBox "ERROR: 'Input' sheet not found!", vbCritical, "Sheet Not Found"
        GoTo CleanExit
    End If
    
    Set wsOutput = ThisWorkbook.Sheets(OUTPUT_SHEET)
    If wsOutput Is Nothing Then
        MsgBox "ERROR: 'Output' sheet not found!", vbCritical, "Sheet Not Found"
        GoTo CleanExit
    End If
    On Error GoTo ErrorHandler
    
    ' Clear previous output data
    lastRow = wsOutput.Cells(wsOutput.Rows.Count, "A").End(xlUp).Row
    If lastRow >= OUTPUT_START_ROW Then
        wsOutput.Range("A" & OUTPUT_START_ROW & ":H" & lastRow).ClearContents
    End If
    
    ' Find last row with data in input sheet
    lastRow = wsInput.Cells(wsInput.Rows.Count, "A").End(xlUp).Row
    
    ' Check if there's data to process
    If lastRow < INPUT_START_ROW Then
        MsgBox "No input data found. Please add data starting from row " & INPUT_START_ROW, vbExclamation, "No Data"
        GoTo CleanExit
    End If
    
    ' Initialize counters
    outputRow = OUTPUT_START_ROW
    skippedCount = 0
    
    ' Create debug message
    Dim debugMsg As String
    debugMsg = "PROCESSING ROWS:" & vbCrLf & String(60, "=") & vbCrLf
    
    ' Loop through each input row
    For inputRow = INPUT_START_ROW To lastRow
        
        ' Read input data (Columns A to K)
        level5ID = Trim(CStr(wsInput.Cells(inputRow, 1).Value))
        level5Name = Trim(CStr(wsInput.Cells(inputRow, 2).Value))
        level4ID = Trim(CStr(wsInput.Cells(inputRow, 3).Value))
        level4Name = Trim(CStr(wsInput.Cells(inputRow, 4).Value))
        level3ID = Trim(CStr(wsInput.Cells(inputRow, 5).Value))
        level3Name = Trim(CStr(wsInput.Cells(inputRow, 6).Value))
        level2ID = Trim(CStr(wsInput.Cells(inputRow, 7).Value))
        level2Name = Trim(CStr(wsInput.Cells(inputRow, 8).Value))
        level1ID = Trim(CStr(wsInput.Cells(inputRow, 9).Value))
        level1Name = Trim(CStr(wsInput.Cells(inputRow, 10).Value))
        comments = Trim(CStr(wsInput.Cells(inputRow, 11).Value))
        
        ' Skip empty rows
        If level5ID = "" Then
            debugMsg = debugMsg & "Row " & inputRow & ": EMPTY - Skipped" & vbCrLf
            GoTo NextInputRow
        End If
        
        ' Initialize transformation flag
        shouldTransform = True
        skipReason = ""
        
        '=========================================================================
        ' FILTER 1: Comments must contain "new"
        '=========================================================================
        If InStr(1, UCase(comments), "NEW") = 0 Then
            shouldTransform = False
            skipReason = "Comments doesn't contain 'new' (value: '" & comments & "')"
        End If
        
        '=========================================================================
        ' FILTER 2: Level2 Name must be from the allowed list
        '=========================================================================
        If shouldTransform Then
            Dim isValidLevel2 As Boolean
            Dim level2Upper As String
            level2Upper = UCase(level2Name)
            
            ' Check if Level2 Name matches any allowed value
            isValidLevel2 = False
            If level2Upper = "CENTRAL MANAGED OFFICES" Then isValidLevel2 = True
            If level2Upper = "CENTRAL MANAGED SERVICES" Then isValidLevel2 = True
            If level2Upper = "COMM BUSINESSES & MKTS" Then isValidLevel2 = True
            If level2Upper = "ENTERPRISE TALENT BC" Then isValidLevel2 = True
            If level2Upper = "FINANCE FUNCTION" Then isValidLevel2 = True
            If level2Upper = "GLOBAL SUSTAINABILITY" Then isValidLevel2 = True
            If level2Upper = "GOVERNANCE" Then isValidLevel2 = True
            If level2Upper = "GROUP BRAND L2" Then isValidLevel2 = True
            If level2Upper = "GROUP EXTERNAL COMMUNICATION" Then isValidLevel2 = True
            If level2Upper = "GRP CHIEF CNTRL OVERSIGHT OFF" Then isValidLevel2 = True
            If level2Upper = "INTERNAL AUDIT" Then isValidLevel2 = True
            If level2Upper = "LEGAL" Then isValidLevel2 = True
            If level2Upper = "PEOPLE" Then isValidLevel2 = True
            If level2Upper = "RISK & COMPLIANCE" Then isValidLevel2 = True
            
            If Not isValidLevel2 Then
                shouldTransform = False
                skipReason = "Level2 Name not from list (value: '" & level2Name & "')"
            End If
        End If
        
        '=========================================================================
        ' FILTER 3: Level1 Name must be "Alpha", "Kenamma", or "Naago"
        '=========================================================================
        If shouldTransform Then
            If UCase(level1Name) <> "ALPHA" And _
               UCase(level1Name) <> "KENAMMA" And _
               UCase(level1Name) <> "NAAGO" Then
                shouldTransform = False
                skipReason = "Level1 Name not Alpha/Kenamma/Naago (value: '" & level1Name & "')"
            End If
        End If
        
        '=========================================================================
        ' FILTER 4: Exclude if Level5 Name contains "Retained", "Retd", or "Rtd"
        '=========================================================================
        If shouldTransform Then
            If InStr(1, UCase(level5Name), "RETAINED") > 0 Or _
               InStr(1, UCase(level5Name), "RETD") > 0 Or _
               InStr(1, UCase(level5Name), "RTD") > 0 Then
                shouldTransform = False
                skipReason = "Level5 Name contains Retained/Retd/Rtd (value: '" & level5Name & "')"
            End If
        End If
        
        ' Add to debug message
        If shouldTransform Then
            debugMsg = debugMsg & "Row " & inputRow & ": PROCESSING ✓ (ID: " & level5ID & ")" & vbCrLf
        Else
            debugMsg = debugMsg & "Row " & inputRow & ": SKIPPED - " & skipReason & vbCrLf
            skippedCount = skippedCount + 1
            GoTo NextInputRow
        End If
        
        '=========================================================================
        ' ROW PASSED ALL FILTERS - PROCEED WITH TRANSFORMATION
        '=========================================================================
        
        ' Get Top C and L2X values using mapping functions
        topC = GetTopCValue(level2Name)
        l2x = GetL2XValue(level2Name)
        
        ' Calculate STD/STEWARDSHIP and ALL/ATT suffix
        isStandard = False
        If InStr(1, UCase(level5Name), "(STD)") > 0 Or _
           InStr(1, UCase(level5Name), "(STEWARDSHIP)") > 0 Then
            isStandard = True
        End If
        
        If isStandard Then
            allAltSuffix = "ALL"
        Else
            allAltSuffix = "ATT"
        End If
        
        ' Build Middle C Status dynamically using L2X
        middleCStatus = "RBMI - " & l2x & "_" & allAltSuffix
        
        '=========================================================================
        ' OUTPUT ROW 1
        '=========================================================================
        wsOutput.Cells(outputRow, 1).Value = topC                                    ' Column 1: Top C
        wsOutput.Cells(outputRow, 2).Value = middleCStatus                           ' Column 2: Middle C (RBMI - L2X_ALL/ATT)
        wsOutput.Cells(outputRow, 3).Value = l2x & "_NCR" & allAltSuffix            ' Column 3: Middle C (L2X_NCR + ALL/ATT)
        wsOutput.Cells(outputRow, 4).Value = "."                                     ' Column 4: Middle C (.)
        wsOutput.Cells(outputRow, 5).Value = "RBMI - " & level5ID & "_NCR"          ' Column 5: Lowest C
        wsOutput.Cells(outputRow, 6).Value = "R-" & level5ID                         ' Column 6: N element (R-)
        wsOutput.Cells(outputRow, 7).Value = "New code"                              ' Column 7: NEW - Status column
        outputRow = outputRow + 1
        
        '=========================================================================
        ' OUTPUT ROW 2
        '=========================================================================
        wsOutput.Cells(outputRow, 1).Value = topC                                    ' Column 1: Top C
        wsOutput.Cells(outputRow, 2).Value = middleCStatus                           ' Column 2: Middle C (RBMI - L2X_ALL/ATT)
        wsOutput.Cells(outputRow, 3).Value = l2x & "_RAC" & allAltSuffix            ' Column 3: Middle C (L2X_RAC + ALL/ATT)
        wsOutput.Cells(outputRow, 4).Value = l2x & "_ARAC" & allAltSuffix           ' Column 4: Middle C (L2X_ARAC + ALL/ATT)
        wsOutput.Cells(outputRow, 5).Value = "RBMI - " & level5ID & "_ARAC"         ' Column 5: Lowest C
        wsOutput.Cells(outputRow, 6).Value = "I-Dummy"                               ' Column 6: N element (I-Dummy)
        wsOutput.Cells(outputRow, 7).Value = "New code"                              ' Column 7: NEW - Status column
        outputRow = outputRow + 1
        
        '=========================================================================
        ' OUTPUT ROW 3
        '=========================================================================
        wsOutput.Cells(outputRow, 1).Value = topC                                    ' Column 1: Top C
        wsOutput.Cells(outputRow, 2).Value = middleCStatus                           ' Column 2: Middle C (RBMI - L2X_ALL/ATT)
        wsOutput.Cells(outputRow, 3).Value = l2x & "_RAC" & allAltSuffix            ' Column 3: Middle C (L2X_RAC + ALL/ATT)
        wsOutput.Cells(outputRow, 4).Value = l2x & "_SRAC" & allAltSuffix           ' Column 4: Middle C (L2X_SRAC + ALL/ATT)
        wsOutput.Cells(outputRow, 5).Value = "RBMI - " & level5ID & "_SRAC"         ' Column 5: Lowest C
        wsOutput.Cells(outputRow, 6).Value = "I-Dummy"                               ' Column 6: N element (I-Dummy)
        wsOutput.Cells(outputRow, 7).Value = "New code"                              ' Column 7: NEW - Status column
        outputRow = outputRow + 1
        
NextInputRow:
    Next inputRow
    
    ' Format output
    If outputRow > OUTPUT_START_ROW Then
        wsOutput.Range("A" & OUTPUT_START_ROW & ":H" & (outputRow - 1)).Font.Name = "Calibri"
        wsOutput.Range("A" & OUTPUT_START_ROW & ":H" & (outputRow - 1)).Font.Size = 11
        wsOutput.Columns("A:H").AutoFit
    End If
    
    ' Show detailed results
    Dim totalRows As Long
    Dim processedCount As Long
    totalRows = lastRow - INPUT_START_ROW + 1
    processedCount = totalRows - skippedCount
    
    debugMsg = debugMsg & vbCrLf & String(60, "=") & vbCrLf
    debugMsg = debugMsg & "SUMMARY:" & vbCrLf
    debugMsg = debugMsg & "Total Input Rows: " & totalRows & vbCrLf
    debugMsg = debugMsg & "Rows Processed: " & processedCount & vbCrLf
    debugMsg = debugMsg & "Rows Skipped: " & skippedCount & vbCrLf
    debugMsg = debugMsg & "Output Rows Generated: " & (outputRow - OUTPUT_START_ROW)
    
    MsgBox debugMsg, vbInformation, "Transformation Complete"
    
CleanExit:
    Application.ScreenUpdating = True
    Application.Calculation = xlCalculationAutomatic
    Exit Sub
    
ErrorHandler:
    Application.ScreenUpdating = True
    Application.Calculation = xlCalculationAutomatic
    MsgBox "Error on row " & inputRow & ": " & Err.Description, vbCritical, "Error"
End Sub


'=================================================================================
' CONFIGURABLE TOP C MAPPING FUNCTION
'=================================================================================
Function GetTopCValue(level2Name As String) As String
    Dim cleanName As String
    cleanName = UCase(Trim(level2Name))
    
    Select Case cleanName
        Case "CENTRAL MANAGED OFFICES"
            GetTopCValue = "RBMI - MISC"
        Case "CENTRAL MANAGED SERVICES"
            GetTopCValue = "RBMI - MISC"
        Case "COMM BUSINESSES & MKTS"
            GetTopCValue = "RBMI - Group Communications & Brand (L3)"
        Case "GROUP BRAND L2"
            GetTopCValue = "RBMI - Group Brand L2"
        Case "GROUP EXTERNAL COMMUNICATION"
            GetTopCValue = "RBMI - Group External Communication"
        Case "ENTERPRISE TALENT BC"
            GetTopCValue = "RBMI - Enterprise Talent BC"
        Case "GOVERNANCE"
            GetTopCValue = "RBMI - Governance"
        Case "GRP CHIEF CNTRL OVERSIGHT OFF"
            GetTopCValue = "RBMI - Grp Chief Cntrl Oversight Off"
        Case "INTERNAL AUDIT"
            GetTopCValue = "RBMI - Internal Audit (L2)"
        Case "LEGAL"
            GetTopCValue = "RBMI - Legal (L2)"
        Case "RISK & COMPLIANCE"
            GetTopCValue = "RBMI - Risk & Compliance (L2)"
        Case "FINANCE FUNCTION"
            GetTopCValue = "RBMI - Finance Function"
        Case "GLOBAL SUSTAINABILITY"
            GetTopCValue = "RBMI - Global Sustainability"
        Case "PEOPLE"
            GetTopCValue = "RBMI - HR"
        Case Else
            GetTopCValue = "RBMI - " & level2Name & " (L2)"
    End Select
End Function


'=================================================================================
' CONFIGURABLE L2X MAPPING FUNCTION
' This function maps Level 2 Name to L2X code for Middle C columns
' To add/modify mappings, simply edit the entries in this function
'=================================================================================
Function GetL2XValue(level2Name As String) As String
    '-------------------------------------------------------------------------
    ' CONFIGURATION: Add or modify L2X mappings below
    ' Format: Case "[Level 2 Name]": GetL2XValue = "[L2X Code]"
    '-------------------------------------------------------------------------
    
    Dim cleanName As String
    cleanName = UCase(Trim(level2Name))
    
    Select Case cleanName
        ' Central & Core Services
        Case "CENTRAL MANAGED OFFICES"
            GetL2XValue = "CMO"
        
        Case "CENTRAL MANAGED SERVICES"
            GetL2XValue = "CMO"
        
        ' Communications & Brand
        Case "COMM BUSINESSES & MKTS"
            GetL2XValue = "CPA"
        
        Case "GROUP BRAND L2"
            GetL2XValue = "GBD"
        
        Case "GROUP EXTERNAL COMMUNICATION"
            GetL2XValue = "GEC"
        
        ' Governance & Compliance
        Case "ENTERPRISE TALENT BC"
            GetL2XValue = "EPT"
        
        Case "GOVERNANCE"
            GetL2XValue = "SCY"
        
        Case "GRP CHIEF CNTRL OVERSIGHT OFF"
            GetL2XValue = "GCC"
        
        Case "INTERNAL AUDIT"
            GetL2XValue = "GIA"
        
        Case "LEGAL"
            GetL2XValue = "LEG"
        
        Case "RISK & COMPLIANCE"
            GetL2XValue = "RIS"
        
        ' Finance & Support Functions
        Case "FINANCE FUNCTION"
            GetL2XValue = "FIN"
        
        Case "GLOBAL SUSTAINABILITY"
            GetL2XValue = "CSR"
        
        Case "PEOPLE"
            GetL2XValue = "HR_"
        
        '---------------------------------------------------------------------
        ' ADD MORE L2X MAPPINGS HERE AS NEEDED
        ' Simply copy the pattern above and add new cases
        '---------------------------------------------------------------------
        ' Example:
        ' Case "NEW DEPARTMENT NAME"
        '     GetL2XValue = "XXX"
        '---------------------------------------------------------------------
        
        ' Default case: If no match found, use first 3 characters
        Case Else
            If Len(level2Name) >= 3 Then
                GetL2XValue = UCase(Left(level2Name, 3))
            Else
                GetL2XValue = UCase(level2Name)
            End If
    
    End Select
End Function


'=================================================================================
' DIAGNOSTIC MACRO
'=================================================================================
Sub DiagnoseData()
    Dim wsInput As Worksheet
    Dim lastRow As Long
    Dim i As Long
    Dim msg As String
    
    On Error Resume Next
    Set wsInput = ThisWorkbook.Sheets("Input")
    On Error GoTo 0
    
    If wsInput Is Nothing Then
        MsgBox "ERROR: 'Input' sheet not found!", vbCritical, "Error"
        Exit Sub
    End If
    
    lastRow = wsInput.Cells(wsInput.Rows.Count, "A").End(xlUp).Row
    
    msg = "DATA DIAGNOSIS" & vbCrLf & String(60, "=") & vbCrLf & vbCrLf
    msg = msg & "Last row: " & lastRow & vbCrLf
    msg = msg & "Total data rows: " & (lastRow - 1) & vbCrLf & vbCrLf
    
    If lastRow < 2 Then
        msg = msg & "ERROR: No data rows found!"
        MsgBox msg, vbCritical, "No Data"
        Exit Sub
    End If
    
    msg = msg & "CHECKING FIRST 5 ROWS:" & vbCrLf & String(60, "-") & vbCrLf
    
    For i = 2 To Application.Min(lastRow, 6)
        Dim level2Name As String
        level2Name = Trim(CStr(wsInput.Cells(i, 8).Value))
        
        msg = msg & vbCrLf & "Row " & i & ":" & vbCrLf
        msg = msg & "  Level5 ID: " & wsInput.Cells(i, 1).Value & vbCrLf
        msg = msg & "  Level5 Name: " & wsInput.Cells(i, 2).Value & vbCrLf
        msg = msg & "  Level2 Name: " & level2Name & vbCrLf
        msg = msg & "  L2X Mapping: " & GetL2XValue(level2Name) & vbCrLf
        msg = msg & "  Level1 Name: " & wsInput.Cells(i, 10).Value & vbCrLf
        msg = msg & "  Comments: " & wsInput.Cells(i, 11).Value & vbCrLf
        
        Dim hasNew, validLevel2, validLevel1, notRetained As Boolean
        Dim level5Name, level1Name, comments As String
        Dim level2Upper As String
        
        level5Name = UCase(Trim(CStr(wsInput.Cells(i, 2).Value)))
        level2Upper = UCase(level2Name)
        level1Name = UCase(Trim(CStr(wsInput.Cells(i, 10).Value)))
        comments = UCase(Trim(CStr(wsInput.Cells(i, 11).Value)))
        
        hasNew = InStr(1, comments, "NEW") > 0
        
        validLevel2 = False
        If level2Upper = "CENTRAL MANAGED OFFICES" Then validLevel2 = True
        If level2Upper = "CENTRAL MANAGED SERVICES" Then validLevel2 = True
        If level2Upper = "COMM BUSINESSES & MKTS" Then validLevel2 = True
        If level2Upper = "ENTERPRISE TALENT BC" Then validLevel2 = True
        If level2Upper = "FINANCE FUNCTION" Then validLevel2 = True
        If level2Upper = "GLOBAL SUSTAINABILITY" Then validLevel2 = True
        If level2Upper = "GOVERNANCE" Then validLevel2 = True
        If level2Upper = "GROUP BRAND L2" Then validLevel2 = True
        If level2Upper = "GROUP EXTERNAL COMMUNICATION" Then validLevel2 = True
        If level2Upper = "GRP CHIEF CNTRL OVERSIGHT OFF" Then validLevel2 = True
        If level2Upper = "INTERNAL AUDIT" Then validLevel2 = True
        If level2Upper = "LEGAL" Then validLevel2 = True
        If level2Upper = "PEOPLE" Then validLevel2 = True
        If level2Upper = "RISK & COMPLIANCE" Then validLevel2 = True
        
        validLevel1 = (level1Name = "ALPHA" Or level1Name = "KENAMMA" Or level1Name = "NAAGO")
        notRetained = InStr(1, level5Name, "RETAINED") = 0 And _
                      InStr(1, level5Name, "RETD") = 0 And _
                      InStr(1, level5Name, "RTD") = 0
        
        msg = msg & "  ✓ Has 'new': " & hasNew & vbCrLf
        msg = msg & "  ✓ Valid Level2: " & validLevel2 & vbCrLf
        msg = msg & "  ✓ Valid Level1: " & validLevel1 & vbCrLf
        msg = msg & "  ✓ Not Retained: " & notRetained & vbCrLf
        
        If hasNew And validLevel2 And validLevel1 And notRetained Then
            msg = msg & "  → WILL BE PROCESSED ✓" & vbCrLf
        Else
            msg = msg & "  → WILL BE SKIPPED ✗" & vbCrLf
        End If
    Next i
    
    MsgBox msg, vbInformation, "Data Diagnosis"
End Sub


