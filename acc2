        files_frame.pack(fill=tk.BOTH, expand=True, padx=20, pady=10)
        
        for file_key, config in self.file_configs.items():
            file_button_frame = ttk.Frame(files_frame)
            file_button_frame.pack(fill=tk.X, pady=8)
            
            smart_enabled = config.get('smart_linking', {}).get('enabled', False)
            icon = "🔗" if smart_enabled else "📄"
            
            btn = ttk.Button(
                file_button_frame,
                text=f"{icon} {file_key}: {config['name']}",
                command=lambda fk=file_key: self.open_file_popup(fk),
                width=55
            )
            btn.pack(side=tk.LEFT, padx=5)
            
            if smart_enabled:
                num_sheets = len(config.get('smart_linking', {}).get('linked_sheets', []))
                info_label = ttk.Label(
                    file_button_frame,
                    text=f"({num_sheets} linked sheets)",
                    font=('Arial', 8),
                    foreground='gray'
                )
                info_label.pack(side=tk.LEFT, padx=5)
        
