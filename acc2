Sub SetupSheets()
    Dim wsInput As Worksheet
    Dim wsOutput As Worksheet
    Dim wb As Workbook
    
    Set wb = ThisWorkbook
    
    ' Create or clear Input sheet
    On Error Resume Next
    Set wsInput = wb.Sheets("Input")
    On Error GoTo 0
    
    If wsInput Is Nothing Then
        Set wsInput = wb.Sheets.Add
        wsInput.Name = "Input"
    Else
        wsInput.Cells.Clear
    End If
    
    ' Create or clear Output sheet
    On Error Resume Next
    Set wsOutput = wb.Sheets("Output")
    On Error GoTo 0
    
    If wsOutput Is Nothing Then
        Set wsOutput = wb.Sheets.Add
        wsOutput.Name = "Output"
    Else
        wsOutput.Cells.Clear
