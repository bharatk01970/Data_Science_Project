def _capture_single_screenshot(self, workbook, sheet_name, cell_range, name, folder, embed=True, attach=False):
    """Helper method to capture a single screenshot using Excel export (more reliable)"""
    try:
        self.log_message(f"  Capturing {name} from {sheet_name}!{cell_range}", 'info')

        # Get the sheet and range
        sheet = workbook.Sheets(sheet_name)
        range_obj = sheet.Range(cell_range)
        
        # Generate unique temporary filename
        timestamp = datetime.now().strftime('%Y%m%d_%H%M%S_%f')
        temp_filename = f"temp_{name}_{timestamp}.png"
        temp_path = os.path.join(folder, temp_filename)
        
        # Final filename
        final_filename = f"{name}_{timestamp}.png"
        final_path = os.path.join(folder, final_filename)
        
        try:
            # Method 1: Try CopyPicture + Export (hybrid approach)
            range_obj.CopyPicture(Appearance=1, Format=2)
            time.sleep(1.5)
            
            # Create a new chart to paste the picture
            chart_obj = sheet.ChartObjects().Add(0, 0, range_obj.Width, range_obj.Height)
            chart_obj.Chart.Paste()
            
            # Export the chart as image
            chart_obj.Chart.Export(temp_path, "PNG")
            
            # Delete the chart
            chart_obj.Delete()
            
            # Rename to final name
            if os.path.exists(temp_path):
                os.rename(temp_path, final_path)
            
        except Exception as export_error:
            self.log_message(f"    Export method failed, trying clipboard method: {str(export_error)}", 'warning')
            
            # Fallback to clipboard method
            range_obj.CopyPicture(Format=2)
            time.sleep(2.0)
            
            img = ImageGrab.grabclipboard()
            if img is None:
                self.log_message(f"  Failed to capture {name}", 'error')
                return
            
            img.save(final_path, 'PNG')
        
        # Verify file was saved
        if os.path.exists(final_path):
            file_size = os.path.getsize(final_path)
            if file_size > 0:
                screenshot_info = {
                    'path': final_path,
                    'name': name,
                    'embed': embed,
                    'attach': attach
                }
                self.screenshot_paths.append(screenshot_info)
                self.log_message(f"  ✓ Saved {name} ({file_size} bytes)", 'success')
            else:
                self.log_message(f"  ✗ File saved but empty: {name}", 'error')
                if os.path.exists(final_path):
                    os.remove(final_path)
        else:
            self.log_message(f"  ✗ File not saved: {name}", 'error')

    except Exception as e:
        self.log_message(f"  Error capturing {name}: {str(e)}", 'error')
    
    finally:
        # Clean up any temporary files
        try:
            if os.path.exists(temp_path):
                os.remove(temp_path)
        except:
            pass
        
        # Delay between captures
        time.sleep(0.5)