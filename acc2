import requests
from bs4 import BeautifulSoup
import csv
from urllib.parse import urljoin
import time
import tkinter as tk
from tkinter import ttk, messagebox, filedialog

def scrape_page(url, output_csv, delay=1.5, progress_var=None):
    all_data = []
    headers = []
    session = requests.Session()
    next_page = url
    page_num = 1

    try:
        while next_page:
            if progress_var:
                progress_var.set(f"Scraping page {page_num}...")

            response = session.get(next_page)
            response.raise_for_status()
            soup = BeautifulSoup(response.text, "html.parser")

            # --- Detect structure ---
            table = soup.find("table")
            list_items = soup.find_all("li")
            cards = soup.select("div[class*='card'], div[class*='item'], div[class*='listing']")

            page_data = []

            if table:
                rows = table.find_all("tr")
                for row in rows:
                    cols = row.find_all(["td", "th"])
                    if not cols:
                        continue
                    row_data = []
                    for col in cols:
                        text = col.get_text(strip=True)
                        link = col.find("a")
                        href = link["href"] if link and link.has_attr("href") else None
                        href = urljoin(next_page, href) if href else None
                        value = f'<a href="{href}">{text}</a>' if href else text
                        row_data.append(value)
                    page_data.append(row_data)
                if not headers and page_data:
                    headers = [f"Column_{i+1}" for i in range(len(page_data[0]))]

            elif list_items and len(list_items) > 3:
                for li in list_items:
                    text = li.get_text(strip=True)
                    link = li.find("a")
                    href = link["href"] if link and link.has_attr("href") else None
                    href = urljoin(next_page, href) if href else None
                    value = f'<a href="{href}">{text}</a>' if href else text
                    page_data.append([value])
                if not headers:
                    headers = ["List_Item"]

            elif cards and len(cards) > 2:
                for card in cards:
                    text = card.get_text(" ", strip=True)
                    link = card.find("a")
                    href = link["href"] if link and link.has_attr("href") else None
                    href = urljoin(next_page, href) if href else None
                    value = f'<a href="{href}">{text}</a>' if href else text
                    page_data.append([value])
                if not headers:
                    headers = ["Card_Detail"]

            else:
                messagebox.showwarning("Warning", f"Could not auto-detect structure on page {page_num}.")
                break

            all_data.extend(page_data)

            # --- Find next page link ---
            next_link = (
                soup.select_one("a[rel='next']")
                or soup.find("a", string=lambda s: s and "next" in s.lower())
                or soup.find("a", string=lambda s: s and "›" in s)
            )

            if next_link and next_link.has_attr("href"):
                next_page = urljoin(next_page, next_link["href"])
                page_num += 1
                time.sleep(delay)
            else:
                next_page = None

        # --- Save everything to CSV ---
        with open(output_csv, "w", newline="", encoding="utf-8") as f:
            writer = csv.writer(f)
            writer.writerow(headers)
            writer.writerows(all_data)

        messagebox.showinfo("Success", f"✅ All pages scraped and saved to '{output_csv}'!")

    except Exception as e:
        messagebox.showerror("Error", f"An error occurred:\n{e}")
        return

    if progress_var:
        progress_var.set("Scraping completed ✅")


def start_scraping():
    url = url_entry.get().strip()
    if not url:
        messagebox.showwarning("Input required", "Please enter a URL.")
        return

    output_csv = filedialog.asksaveasfilename(
        defaultextension=".csv",
        filetypes=[("CSV Files", "*.csv")],
        title="Save scraped data as..."
    )

    if not output_csv:
        return

    progress_var.set("Starting...")
    root.update_idletasks()
    scrape_page(url, output_csv, progress_var=progress_var)


# --- Tkinter GUI ---
root = tk.Tk()
root.title("🌐 Universal Web Scraper")
root.geometry("500x250")
root.resizable(False, False)

frame = ttk.Frame(root, padding=20)
frame.pack(fill="both", expand=True)

ttk.Label(frame, text="Enter webpage URL to scrape:", font=("Segoe UI", 10)).pack(anchor="w", pady=(0, 5))
url_entry = ttk.Entry(frame, width=70)
url_entry.pack(fill="x", pady=(0, 10))

scrape_btn = ttk.Button(frame, text="Start Scraping", command=start_scraping)
scrape_btn.pack(pady=10)

progress_var = tk.StringVar()
progress_label = ttk.Label(frame, textvariable=progress_var, font=("Segoe UI", 9, "italic"), foreground="#555")
progress_label.pack(anchor="center", pady=10)

ttk.Label(frame, text="Output will be saved as CSV with clickable links.", font=("Segoe UI", 8)).pack(pady=(10, 0))

root.mainloop()