def apply_column_combination(self, result_rows, columns_to_combine, new_column_name, 
                             reference_column='', repeat_columns=None):
    """Combine multiple columns into separate rows with optional reference-based repetition
    
    The key insight: We need to track which SOURCE ROW each value came from to maintain
    the relationship between reference values and the values that should repeat with them.
    """
    if not columns_to_combine or not new_column_name:
        return result_rows
    
    if repeat_columns is None:
        repeat_columns = []
    
    combined_rows = []
    
    for row_idx, row in enumerate(result_rows):
        print(f"\n{'='*60}")
        print(f"Processing source row {row_idx + 1}")
        print(f"{'='*60}")
        
        # Collect all values from all columns to combine
        column_values = {}
        
        for col in columns_to_combine:
            if col in row and row[col]:
                value = row[col]
                if isinstance(value, str) and (',' in value or ';' in value):
                    split_vals = self.split_multi_values(value)
                    column_values[col] = [v for v in split_vals if v]
                else:
                    column_values[col] = [str(value)] if value else []
            else:
                column_values[col] = []
        
        print(f"Values collected from this row:")
        for col in columns_to_combine:
            print(f"  {col}: {column_values.get(col, [])}")
        
        # Check if we have reference-based repetition
        ref_values = []
        if reference_column and reference_column in column_values:
            ref_values = column_values[reference_column]
        
        # CASE 1: Simple combination (no reference-based repetition)
        if not reference_column or not repeat_columns or not ref_values:
            print(f"\nMode: Simple combination (no repetition)")
            print(f"Adding values in column order: {columns_to_combine}")
            
            for col in columns_to_combine:
                for value in column_values.get(col, []):
                    new_row = {key: val for key, val in row.items() if key not in columns_to_combine}
                    new_row[new_column_name] = value
                    combined_rows.append(new_row)
                    print(f"  Added: {value} (from {col})")
        
        # CASE 2: Reference-based repetition
        else:
            print(f"\nMode: Reference-based repetition")
            print(f"Reference column: {reference_column} with values: {ref_values}")
            print(f"Repeat columns: {repeat_columns}")
            
            # Get other columns (not reference, not repeat)
            other_columns = [col for col in columns_to_combine 
                           if col != reference_column and col not in repeat_columns]
            print(f"Other columns: {other_columns}")
            
            # Process each reference value
            for ref_idx, ref_value in enumerate(ref_values):
                print(f"\n  --- Block {ref_idx + 1}: Reference = '{ref_value}' ---")
                
                # For this reference value, add all repeat column values
                for repeat_col in repeat_columns:
                    repeat_vals = column_values.get(repeat_col, [])
                    print(f"    Repeating {len(repeat_vals)} values from '{repeat_col}':")
                    
                    for val in repeat_vals:
                        new_row = {key: val for key, val in row.items() if key not in columns_to_combine}
                        new_row[new_column_name] = val
                        combined_rows.append(new_row)
                        print(f"      -> {val}")
                
                # Add the reference value itself
                new_row = {key: val for key, val in row.items() if key not in columns_to_combine}
                new_row[new_column_name] = ref_value
                combined_rows.append(new_row)
                print(f"    -> {ref_value} (reference)")
            
            # Add other column values at the end (once)
            if other_columns:
                print(f"\n  --- Other columns (added once) ---")
                for other_col in other_columns:
                    other_vals = column_values.get(other_col, [])
                    print(f"    From '{other_col}':")
                    
                    for val in other_vals:
                        new_row = {key: val for key, val in row.items() if key not in columns_to_combine}
                        new_row[new_column_name] = val
                        combined_rows.append(new_row)
                        print(f"      -> {val}")
        
        print(f"\nRows generated from this source row: {len(combined_rows) - len([r for r in combined_rows if r in combined_rows[:combined_rows.index(combined_rows[-1])]])}")
    
    print(f"\n{'='*60}")
    print(f"TOTAL COMBINED ROWS: {len(combined_rows)}")
    print(f"{'='*60}\n")
    
    return combined_rows