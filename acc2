Option Explicit

' ===================================================================
' TM1 Instance Health Check Validator - Improved Formula Method
' Purpose: Validate TM1 instances with proper error detection
' Method: Uses multiple validation checks with fresh connections
' ===================================================================

' Configuration Constants
Const LOG_SHEET_NAME As String = "TM1_ValidationLog"
Const CONFIG_SHEET_NAME As String = "TM1_Instances"
Const TEST_SHEET_NAME As String = "TM1_ConnectionTest"

Sub ValidateAllTM1Instances()
    ' Main procedure to validate all configured TM1 instances
    
    Dim wsConfig As Worksheet
    Dim wsLog As Worksheet
    Dim wsTest As Worksheet
    Dim lastRow As Long
    Dim i As Long
    Dim instanceName As String
    Dim serverAddress As String
    Dim isHealthy As Boolean
    Dim errorMessage As String
    
    On Error GoTo ErrorHandler
    
    ' Initialize worksheets
    Set wsConfig = GetOrCreateSheet(CONFIG_SHEET_NAME)
    Set wsLog = GetOrCreateSheet(LOG_SHEET_NAME)
    Set wsTest = GetOrCreateSheet(TEST_SHEET_NAME)
    
    ' Setup sheets
    Call InitializeLogSheet(wsLog)
    Call InitializeConfigSheet(wsConfig)
    
    ' Get last row of instance list
    lastRow = wsConfig.Cells(wsConfig.Rows.Count, 1).End(xlUp).Row
    
    If lastRow < 2 Then
        MsgBox "No TM1 instances configured. Please add instances to the " & CONFIG_SHEET_NAME & " sheet.", vbInformation
        Exit Sub
    End If
    
    ' Display progress
    Application.ScreenUpdating = False
    Application.DisplayAlerts = False
    Application.StatusBar = "Starting TM1 instance validation..."
    
    ' Clear test sheet and disable calculation temporarily
    wsTest.Cells.Clear
    wsTest.Cells(1, 1).Value = "Test Area"
    
    ' Iterate through all instances
    For i = 2 To lastRow
        instanceName = Trim(wsConfig.Cells(i, 1).Value)
        serverAddress = Trim(wsConfig.Cells(i, 2).Value)
        
        If instanceName <> "" And serverAddress <> "" Then
            Application.StatusBar = "Validating instance " & (i - 1) & " of " & (lastRow - 1) & ": " & instanceName
            
            isHealthy = False
            errorMessage = ""
            
            ' Clear previous test results
            wsTest.Range("A2:Z100").Clear
            
            ' Test connection with proper error detection
            isHealthy = TestTM1ConnectionRobust(wsTest, serverAddress, instanceName, errorMessage)
            
            ' Log the result
            Call LogValidationResult(wsLog, instanceName, serverAddress, isHealthy, errorMessage)
            
            DoEvents
        End If
    Next i
    
    ' Cleanup
    Application.ScreenUpdating = True
    Application.DisplayAlerts = True
    Application.StatusBar = False
    
    MsgBox "TM1 instance validation completed. Check the " & LOG_SHEET_NAME & " sheet for results.", vbInformation
    
    Exit Sub
    
ErrorHandler:
    Application.ScreenUpdating = True
    Application.DisplayAlerts = True
    Application.StatusBar = False
    MsgBox "Error in validation process: " & Err.Description, vbCritical
End Sub

Function TestTM1ConnectionRobust(wsTest As Worksheet, serverAddress As String, instanceName As String, ByRef errorMsg As String) As Boolean
    ' Tests TM1 connection with multiple validation methods and proper error detection
    
    Dim testCell As Range
    Dim formulaString As String
    Dim cellValue As Variant
    Dim waitCounter As Integer
    Dim maxWait As Integer
    Dim testsPassed As Integer
    Dim originalCalc As XlCalculation
    
    On Error GoTo TestError
    
    TestTM1ConnectionRobust = False
    errorMsg = ""
    maxWait = 20 ' seconds
    testsPassed = 0
    
    ' Save calculation mode and set to automatic
    originalCalc = Application.Calculation
    Application.Calculation = xlCalculationAutomatic
    
    ' ===================================================================
    ' TEST 1: SUBNM - Get Server Name
    ' ===================================================================
    Set testCell = wsTest.Range("B2")
    testCell.Clear
    wsTest.Range("A2").Value = "Test 1: SUBNM"
    
    formulaString = "=SUBNM(""" & serverAddress & """, ""}"")"
    testCell.Formula = formulaString
    
    ' Wait for formula to calculate
    Application.Calculate
    For waitCounter = 1 To 8
        DoEvents
        Application.Wait Now + TimeValue("00:00:01")
        cellValue = testCell.Value
        
        ' Check for valid result
        If Not IsEmpty(cellValue) Then
            Exit For
        End If
    Next waitCounter
    
    cellValue = testCell.Value
    
    ' Validate result
    If IsError(cellValue) Then
        errorMsg = "SUBNM failed: " & GetErrorDescription(cellValue)
    ElseIf IsEmpty(cellValue) Or cellValue = "" Or cellValue = 0 Then
        errorMsg = "SUBNM returned empty - Server not responding"
    ElseIf VarType(cellValue) = vbString And Len(cellValue) > 0 Then
        testsPassed = testsPassed + 1
        errorMsg = "SUBNM passed (Server: " & cellValue & ")"
    Else
        errorMsg = "SUBNM returned unexpected value: " & cellValue
    End If
    
    wsTest.Range("C2").Value = errorMsg
    
    ' ===================================================================
    ' TEST 2: TM1SERVERHANDLE - Get Server Handle (proves active connection)
    ' ===================================================================
    Set testCell = wsTest.Range("B3")
    testCell.Clear
    wsTest.Range("A3").Value = "Test 2: TM1SERVERHANDLE"
    
    formulaString = "=TM1SERVERHANDLE(""" & serverAddress & """)"
    testCell.Formula = formulaString
    
    Application.Calculate
    For waitCounter = 1 To 8
        DoEvents
        Application.Wait Now + TimeValue("00:00:01")
        cellValue = testCell.Value
        
        If Not IsEmpty(cellValue) Then
            Exit For
        End If
    Next waitCounter
    
    cellValue = testCell.Value
    
    If IsError(cellValue) Then
        wsTest.Range("C3").Value = "FAILED: " & GetErrorDescription(cellValue)
    ElseIf IsEmpty(cellValue) Or cellValue = "" Or cellValue = 0 Then
        wsTest.Range("C3").Value = "FAILED: No handle returned"
    ElseIf IsNumeric(cellValue) And cellValue > 0 Then
        testsPassed = testsPassed + 1
        wsTest.Range("C3").Value = "PASSED (Handle: " & cellValue & ")"
    Else
        wsTest.Range("C3").Value = "FAILED: Invalid handle"
    End If
    
    ' ===================================================================
    ' TEST 3: Try to get dimension count using DBSW
    ' ===================================================================
    Set testCell = wsTest.Range("B4")
    testCell.Clear
    wsTest.Range("A4").Value = "Test 3: DBSW"
    
    ' Try to get system info - this will fail if server isn't accessible
    formulaString = "=DBSW(""" & serverAddress & """,""}"","""")"
    testCell.Formula = formulaString
    
    Application.Calculate
    For waitCounter = 1 To 8
        DoEvents
        Application.Wait Now + TimeValue("00:00:01")
        cellValue = testCell.Value
        
        If Not IsEmpty(cellValue) Then
            Exit For
        End If
    Next waitCounter
    
    cellValue = testCell.Value
    
    If IsError(cellValue) Then
        wsTest.Range("C4").Value = "FAILED: " & GetErrorDescription(cellValue)
    ElseIf IsEmpty(cellValue) Then
        wsTest.Range("C4").Value = "FAILED: No response"
    Else
        testsPassed = testsPassed + 1
        wsTest.Range("C4").Value = "PASSED"
    End If
    
    ' ===================================================================
    ' FINAL EVALUATION
    ' ===================================================================
    Application.Calculation = originalCalc
    
    ' Need at least 2 out of 3 tests to pass
    If testsPassed >= 2 Then
        TestTM1ConnectionRobust = True
        errorMsg = "Instance AVAILABLE - " & testsPassed & " of 3 tests passed"
    Else
        TestTM1ConnectionRobust = False
        If errorMsg = "" Then
            errorMsg = "Instance UNAVAILABLE - Only " & testsPassed & " of 3 tests passed. Check TM1_ConnectionTest sheet for details."
        End If
    End If
    
    Exit Function
    
TestError:
    Application.Calculation = originalCalc
    errorMsg = "Test error: " & Err.Description
    TestTM1ConnectionRobust = False
End Function

Function GetErrorDescription(errorValue As Variant) As String
    ' Translates Excel error values to readable descriptions
    Select Case errorValue
        Case CVErr(xlErrName)
            GetErrorDescription = "#NAME? (TM1 function not available or server not found)"
        Case CVErr(xlErrNA)
            GetErrorDescription = "#N/A (Cannot connect to server)"
        Case CVErr(xlErrValue)
            GetErrorDescription = "#VALUE! (Invalid server format)"
        Case CVErr(xlErrRef)
            GetErrorDescription = "#REF! (Reference error)"
        Case CVErr(xlErrNum)
            GetErrorDescription = "#NUM! (Numeric error)"
        Case CVErr(xlErrNull)
            GetErrorDescription = "#NULL! (Null error)"
        Case CVErr(xlErrDiv0)
            GetErrorDescription = "#DIV/0! (Division by zero)"
        Case Else
            GetErrorDescription = "Unknown error (" & TypeName(errorValue) & ")"
    End Select
End Function

Sub InitializeConfigSheet(ws As Worksheet)
    ' Sets up the configuration sheet with headers and instructions
    
    If ws.Cells(1, 1).Value = "" Then
        ws.Cells(1, 1).Value = "Instance Name"
        ws.Cells(1, 2).Value = "Server Address"
        
        With ws.Range("A1:B1")
            .Font.Bold = True
            .Interior.Color = RGB(79, 129, 189)
            .Font.Color = RGB(255, 255, 255)
            .HorizontalAlignment = xlCenter
        End With
        
        ' Add sample
        ws.Cells(2, 1).Value = "Example_Instance"
        ws.Cells(2, 2).Value = "servername:port"
        
        ws.Cells(4, 1).Value = "INSTRUCTIONS:"
        ws.Cells(5, 1).Value = "1. Replace sample with your TM1 server address"
        ws.Cells(6, 1).Value = "2. Format: hostname:port (e.g., tm1prod:12345)"
        ws.Cells(7, 1).Value = "3. Make sure TM1 Perspectives is installed"
        ws.Cells(8, 1).Value = "4. Test one server using TestSingleTM1Connection first"
        
        ws.Range("A4:A8").Font.Italic = True
        ws.Range("A4:A8").Font.Color = RGB(100, 100, 100)
        
        ws.Columns("A:B").AutoFit
    End If
End Sub

Sub InitializeLogSheet(ws As Worksheet)
    ' Sets up the log sheet with headers
    
    If ws.Cells(1, 1).Value = "" Then
        ws.Cells(1, 1).Value = "Timestamp"
        ws.Cells(1, 2).Value = "Instance Name"
        ws.Cells(1, 3).Value = "Server Address"
        ws.Cells(1, 4).Value = "Status"
        ws.Cells(1, 5).Value = "Message"
        
        ' Format headers
        With ws.Range("A1:E1")
            .Font.Bold = True
            .Interior.Color = RGB(79, 129, 189)
            .Font.Color = RGB(255, 255, 255)
            .HorizontalAlignment = xlCenter
        End With
        
        ws.Columns("A:E").AutoFit
    End If
End Sub

Sub LogValidationResult(ws As Worksheet, instanceName As String, serverAddress As String, isHealthy As Boolean, errorMsg As String)
    ' Logs validation result to the log sheet
    Dim nextRow As Long
    Dim statusText As String
    Dim statusColor As Long
    
    nextRow = ws.Cells(ws.Rows.Count, 1).End(xlUp).Row + 1
    
    ' Determine status
    If isHealthy Then
        statusText = "AVAILABLE"
        statusColor = RGB(0, 176, 80)
    Else
        statusText = "UNAVAILABLE"
        statusColor = RGB(255, 0, 0)
    End If
    
    ' Write log entry
    ws.Cells(nextRow, 1).Value = Now
    ws.Cells(nextRow, 2).Value = instanceName
    ws.Cells(nextRow, 3).Value = serverAddress
    ws.Cells(nextRow, 4).Value = statusText
    ws.Cells(nextRow, 5).Value = errorMsg
    
    ' Format status cell
    With ws.Cells(nextRow, 4)
        .Font.Bold = True
        .Font.Color = statusColor
    End With
    
    ' Format timestamp
    ws.Cells(nextRow, 1).NumberFormat = "yyyy-mm-dd hh:mm:ss"
    
    ws.Columns("A:E").AutoFit
End Sub

Function GetOrCreateSheet(sheetName As String) As Worksheet
    ' Gets existing sheet or creates new one
    Dim ws As Worksheet
    
    On Error Resume Next
    Set ws = ThisWorkbook.Worksheets(sheetName)
    On Error GoTo 0
    
    If ws Is Nothing Then
        Set ws = ThisWorkbook.Worksheets.Add(After:=ThisWorkbook.Worksheets(ThisWorkbook.Worksheets.Count))
        ws.Name = sheetName
    End If
    
    Set GetOrCreateSheet = ws
End Function

Sub ClearValidationLog()
    ' Utility to clear the validation log (keeps headers)
    Dim ws As Worksheet
    Dim lastRow As Long
    
    On Error Resume Next
    Set ws = ThisWorkbook.Worksheets(LOG_SHEET_NAME)
    On Error GoTo 0
    
    If Not ws Is Nothing Then
        lastRow = ws.Cells(ws.Rows.Count, 1).End(xlUp).Row
        If lastRow > 1 Then
            ws.Range("A2:E" & lastRow).ClearContents
            MsgBox "Validation log cleared.", vbInformation
        Else
            MsgBox "No log entries to clear.", vbInformation
        End If
    Else
        MsgBox "Log sheet not found.", vbExclamation
    End If
End Sub

' ====================================================================
' MANUAL TEST: Test Single TM1 Connection
' ====================================================================
Sub TestSingleTM1Connection()
    Dim serverAddress As String
    Dim wsTest As Worksheet
    Dim testResult As Boolean
    Dim errorMsg As String
    
    ' Prompt for server address
    serverAddress = InputBox("Enter TM1 server address (format: servername:port)" & vbCrLf & vbCrLf & _
                            "Example: tm1prod:12345 or localhost:5555", _
                            "Test TM1 Connection", "localhost:12345")
    
    If serverAddress = "" Then Exit Sub
    
    Set wsTest = GetOrCreateSheet(TEST_SHEET_NAME)
    wsTest.Cells.Clear
    
    Application.ScreenUpdating = False
    
    MsgBox "Testing connection to: " & serverAddress & vbCrLf & vbCrLf & _
           "This will take 15-20 seconds. Please wait...", vbInformation
    
    testResult = TestTM1ConnectionRobust(wsTest, serverAddress, "Manual Test", errorMsg)
    
    Application.ScreenUpdating = True
    
    ' Format the test sheet for readability
    wsTest.Columns("A:C").AutoFit
    wsTest.Range("A1").Value = "Connection Test Results for: " & serverAddress
    wsTest.Range("A1").Font.Bold = True
    wsTest.Range("A1").Font.Size = 12
    
    If testResult Then
        MsgBox "✓ CONNECTION SUCCESS!" & vbCrLf & vbCrLf & _
               errorMsg & vbCrLf & vbCrLf & _
               "Check the TM1_ConnectionTest sheet for detailed results.", _
               vbInformation, "Connection Test Result"
    Else
        MsgBox "✗ CONNECTION FAILED!" & vbCrLf & vbCrLf & _
               errorMsg & vbCrLf & vbCrLf & _
               "Check the TM1_ConnectionTest sheet for detailed error information.", _
               vbCritical, "Connection Test Result"
    End If
End Sub

' ====================================================================
' Check if TM1 Functions are Available
' ====================================================================
Sub CheckTM1FunctionsAvailable()
    Dim ws As Worksheet
    Dim testCell As Range
    Dim result As String
    
    Set ws = GetOrCreateSheet(TEST_SHEET_NAME)
    ws.Cells.Clear
    
    ws.Cells(1, 1).Value = "TM1 Excel Functions Availability Check"
    ws.Cells(1, 1).Font.Bold = True
    
    ' Test if SUBNM function exists
    Set testCell = ws.Range("B3")
    On Error Resume Next
    testCell.Formula = "=SUBNM(""test"", ""}"")"
    
    If IsError(testCell.Value) Then
        If testCell.Value = CVErr(xlErrName) Then
            result = "TM1 functions are NOT available in this Excel session." & vbCrLf & vbCrLf & _
                    "Please ensure:" & vbCrLf & _
                    "1. TM1 Perspectives is installed" & vbCrLf & _
                    "2. TM1 Excel Add-in is loaded" & vbCrLf & _
                    "3. You have opened TM1 Perspectives at least once"
            MsgBox result, vbCritical, "TM1 Functions Not Found"
        Else
            result = "TM1 functions appear to be available (got error but not #NAME?)"
            MsgBox result, vbInformation, "TM1 Functions Check"
        End If
    Else
        result = "TM1 functions are available and working!"
        MsgBox result, vbInformation, "TM1 Functions Check"
    End If
    
    ws.Cells(3, 1).Value = result
    testCell.Clear
    On Error GoTo 0
End Sub