        ttk.Label(popup, text="File Path:").grid(row=0, column=0, sticky="w", padx=5, pady=5)
        path_entry = ttk.Entry(popup, width=70)
        path_entry.insert(0, fileinfo["path"])
        path_entry.grid(row=0, column=1, sticky="ew", padx=5, pady=5)

        # Default subject and body per file, timestamp AM/PM format
        now = datetime.now()
