    def open_log_folder(self):
        """
        Open the log folder in Windows Explorer.
        
        Allows user to browse all log files and backups.
        Uses Windows startfile to open Explorer at log folder location.
        """
        try:
            # Check if log folder exists
            if os.path.exists(self.log_folder):
                # Open folder in Windows Explorer
                os.startfile(self.log_folder)
                self.log_message("Opened log folder", 'info')
                self.logger.info("User opened log folder")
            else:
                # Show warning if folder doesn't exist
                messagebox.showwarning("Folder Not Found", f"Log folder not found:\n{self.log_folder}")
        except Exception as e:
            # Show error if folder cannot be opened
            messagebox.showerror("Error", f"Could not open log folder:\n{str(e)}")
            self.logger.error(f"Error opening log folder: {str(e)}")

    def open_log_file(self):
        """
        Open the current day's log file in the default text editor.
        
        Opens today's log file for viewing application activity.
        Uses Windows startfile to open with default .log file handler.
        """
        try:
            # Construct current log filename with today's date
            log_filename = f"ReconMailDraft_{datetime.now().strftime('%Y%m%d')}.log"
            log_filepath = os.path.join(self.log_folder, log_filename)
            
            # Check if log file exists
            if os.path.exists(log_filepath):
                # Open file in default text editor
                os.startfile(log_filepath)
                self.log_message("Opened current log file", 'info')
                self.logger.info("User opened current log file")
            else:
                # Show warning if file doesn't exist
                messagebox.showwarning("File Not Found", f"Log file not found:\n{log_filepath}")
        except Exception as e:
            # Show error if file cannot be opened
            messagebox.showerror("Error", f"Could not open log file:\n{str(e)}")
            self.logger.error(f"Error opening log file: {str(e)}")

    def log_message(self, message, tag='info'):
        """
        Log a message to the main window's activity log.
        
        Displays timestamped messages in the GUI log with color coding.
        
        Args:
            message: The message text to log
            tag: The message type ('info', 'success', 'warning', 'error')
                 Determines text color
        """
        # Enable text widget for editing
        self.log_text.config(state='normal')
        # Get current timestamp in 12-hour format
        timestamp = datetime.now().strftime('%I:%M:%S %p')
        # Insert message with timestamp and color tag
        self.log_text.insert(tk.END, f"[{timestamp}] {message}\n", tag)
        # Auto-scroll to show latest message
        self.log_text.see(tk.END)
        # Make text widget read-only again
        self.log_text.config(state='disabled')
        # Force GUI to update
        self.root.update_idletasks()
    
    def open_file_popup(self, file_key):
        """
        Open the popup window for a specific reconciliation file.
        
        Creates a ReconFile instance for the selected file, which opens
        a new popup window for screenshot capture and email drafting.
        
        Args:
            file_key: Unique identifier for the file (e.g., "Recon 1")
        """
        self.log_message(f"Opening draft window for {file_key}", 'info')
        self.logger.info(f"Opening draft window for {file_key}")
        
        # Get configuration for the selected file
        file_config = self.file_configs.get(file_key, {})
        
        # Validate configuration exists
        if not file_config:
            self.log_message(f"Configuration not found for {file_key}", 'error')
            self.logger.error(f"Configuration not found for {file_key}")
            messagebox.showerror("Error", f"No configuration found for {file_key}")
            return
        
        # Check if smart linking is enabled (for logging purposes)
        smart_enabled = file_config.get('smart_linking', {}).get('enabled', False)
        
        # Create ReconFile popup in manual mode (auto_mode=False)
        ReconFile(self.root, file_key, file_config, self.email_config, self.log_message, self.logger, auto_mode=False)
    
    def on_closing(self):
        """
        Handle application closure.
        
        Called when the application window is closed by user or automatically.
        Performs cleanup operations and logs shutdown.
        """
        try:
            # Log application shutdown
            self.logger.info("="*60)
            self.logger.info("APPLICATION CLOSED")
            self.logger.info("="*60)
            # Uninitialize COM
            pythoncom.CoUninitialize()
        except:
            # Ignore errors during cleanup
            pass
        
        # Destroy the root window (closes application)
        self.root.destroy()


def main():
    """
    Main entry point for the application.
    
    Creates the Tkinter root window and initializes the GUI.
    Sets up window close handler and starts the main event loop.
    
    To enable auto-execute mode, set auto_execute=True when creating
    the ExcelOutlookGUI instance.
    """
    # Create Tkinter root window
    root = tk.Tk()
    
    # ============================================================
    # ENABLE AUTO-EXECUTE MODE
    # ============================================================
    # Change auto_execute=False to auto_execute=True to enable
    # automatic execution on launch
    # ============================================================
    
    # Create main application GUI
    # Set auto_execute=True to automatically process first file on launch
    # Set auto_execute=False for manual operation
    app = ExcelOutlookGUI(root, auto_execute=True)  # <-- SET TO True FOR AUTO MODE
    
    # Set window close handler
    root.protocol("WM_DELETE_WINDOW", app.on_closing)
    # Start the GUI event loop
    root.mainloop()


# Application entry point
if __name__ == "__main__":
    main()


