def show_reference_mapping_popup(self, stage1_data, combined_column_name):
    """Show popup to upload mapping file for reference-based values"""
    # First, identify which columns were used in combination
    if not stage1_data:
        return None
    
    popup = tk.Toplevel(self.root)
    popup.title("Reference-Based Mapping (Optional)")
    popup.geometry("500x400")
    popup.transient(self.root)
    popup.grab_set()
    
    ttk.Label(popup, text="Reference-Based Mapping (Optional)", 
              font=('TkDefaultFont', 11, 'bold')).pack(pady=10)
    ttk.Label(popup, text=f"Map reference values in '{combined_column_name}' to new column", 
              font=('TkDefaultFont', 9)).pack(pady=5, padx=10, anchor=tk.W)
    
    ttk.Label(popup, text="Example: Map B1→Z1, B2→Z2\nZ1/Z2 will appear for repeated A values, not for B rows", 
              font=('TkDefaultFont', 8), foreground='blue').pack(pady=5, padx=10, anchor=tk.W)
    
    # Frame for mapping file
    file_frame = ttk.Frame(popup)
    file_frame.pack(fill=tk.X, padx=10, pady=10)
    
    ttk.Label(file_frame, text="Mapping File:").pack(side=tk.LEFT, padx=5)
    file_label = ttk.Label(file_frame, text="No file selected", foreground='gray')
    file_label.pack(side=tk.LEFT, padx=5)
    
    mapping_data = {'file': None, 'df': None}
    
    def select_mapping_file():
        file_path = filedialog.askopenfilename(
            title="Select Reference Mapping File",
            filetypes=[("CSV files", "*.csv"), ("Text files", "*.txt"), ("All files", "*.*")]
        )
        
        if file_path:
            try:
                if file_path.endswith('.csv'):
                    mapping_df = pd.read_csv(file_path)
                else:
                    mapping_df = pd.read_csv(file_path, delimiter='\t')
                
                if len(mapping_df.columns) < 2:
                    messagebox.showerror("Error", "Mapping file must have at least 2 columns")
                    return
                
                mapping_data['file'] = file_path
                mapping_data['df'] = mapping_df
                file_label.config(text=os.path.basename(file_path), foreground='black')
                
            except Exception as e:
                messagebox.showerror("Error", f"Failed to load mapping file: {str(e)}")
    
    ttk.Button(file_frame, text="Browse...", command=select_mapping_file).pack(side=tk.LEFT, padx=5)
    
    # New column name entry
    name_frame = ttk.Frame(popup)
    name_frame.pack(fill=tk.X, padx=10, pady=10)
    
    ttk.Label(name_frame, text="New Mapped Column Name:").pack(side=tk.LEFT, padx=5)
    new_col_entry = ttk.Entry(name_frame, width=30)
    new_col_entry.pack(side=tk.LEFT, padx=5)
    new_col_entry.insert(0, "Mapped_Value")
    
    result = {'apply': False, 'mapping_df': None, 'new_column': ''}
    
    def confirm():
        # FIXED: Correct way to check if DataFrame is None
        if mapping_data['df'] is None:
            response = messagebox.askyesno("No Mapping File", 
                                          "No mapping file selected. Skip this step?")
            if response:
                popup.destroy()
            return
        
        new_col_name = new_col_entry.get().strip()
        if not new_col_name:
            messagebox.showwarning("Warning", "Please enter a name for the new column")
            return
        
        result['apply'] = True
        result['mapping_df'] = mapping_data['df']
        result['new_column'] = new_col_name
        popup.destroy()
    
    def skip():
        popup.destroy()
    
    button_frame = ttk.Frame(popup)
    button_frame.pack(pady=20)
    
    ttk.Button(button_frame, text="Apply Mapping", command=confirm).pack(side=tk.LEFT, padx=5)
    ttk.Button(button_frame, text="Skip (No Mapping)", command=skip).pack(side=tk.LEFT, padx=5)
    
    popup.wait_window()
    return result





