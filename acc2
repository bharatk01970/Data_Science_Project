import requests
from bs4 import BeautifulSoup
import csv
from urllib.parse import urljoin
import time
from requests.exceptions import RequestException, ConnectionError

def scrape_page(url, output_csv, delay=1.5, progress_var=None, max_retries=3):
    all_data = []
    headers = []
    session = requests.Session()

    # Add browser-like headers to avoid being blocked
    session.headers.update({
        "User-Agent": (
            "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
            "AppleWebKit/537.36 (KHTML, like Gecko) "
            "Chrome/129.0 Safari/537.36"
        ),
        "Accept-Language": "en-US,en;q=0.9",
    })

    next_page = url
    page_num = 1

    try:
        while next_page:
            if progress_var:
                progress_var.set(f"Scraping page {page_num}...")

            # Retry block for unstable connections
            for attempt in range(max_retries):
                try:
                    response = session.get(next_page, timeout=15)
                    response.raise_for_status()
                    break
                except (ConnectionError, RequestException) as e:
                    print(f"⚠️ Network error: {e} (attempt {attempt+1}/{max_retries})")
                    if attempt < max_retries - 1:
                        time.sleep(2 ** attempt)  # exponential backoff
                        continue
                    else:
                        raise

            soup = BeautifulSoup(response.text, "html.parser")

            # --- Detect structure ---
            table = soup.find("table")
            list_items = soup.find_all("li")
            cards = soup.select("div[class*='card'], div[class*='item'], div[class*='listing']")

            page_data = []

            if table:
                rows = table.find_all("tr")
                for row in rows:
                    cols = row.find_all(["td", "th"])
                    if not cols:
                        continue
                    row_data = []
                    for col in cols:
                        text = col.get_text(strip=True)
                        link = col.find("a")
                        href = link["href"] if link and link.has_attr("href") else None
                        href = urljoin(next_page, href) if href else None
                        value = f'<a href="{href}">{text}</a>' if href else text
                        row_data.append(value)
                    page_data.append(row_data)
                if not headers and page_data:
                    headers = [f"Column_{i+1}" for i in range(len(page_data[0]))]

            elif list_items and len(list_items) > 3:
                for li in list_items:
                    text = li.get_text(strip=True)
                    link = li.find("a")
                    href = link["href"] if link and link.has_attr("href") else None
                    href = urljoin(next_page, href) if href else None
                    value = f'<a href="{href}">{text}</a>' if href else text
                    page_data.append([value])
                if not headers:
                    headers = ["List_Item"]

            elif cards and len(cards) > 2:
                for card in cards:
                    text = card.get_text(" ", strip=True)
                    link = card.find("a")
                    href = link["href"] if link and link.has_attr("href") else None
                    href = urljoin(next_page, href) if href else None
                    value = f'<a href="{href}">{text}</a>' if href else text
                    page_data.append([value])
                if not headers:
                    headers = ["Card_Detail"]

            else:
                print(f"⚠️ No recognizable data structure on page {page_num}.")
                break

            all_data.extend(page_data)

            # --- Find the next page link ---
            next_link = (
                soup.select_one("a[rel='next']")
                or soup.find("a", string=lambda s: s and "next" in s.lower())
                or soup.find("a", string=lambda s: s and "›" in s)
            )

            if next_link and next_link.has_attr("href"):
                next_page = urljoin(next_page, next_link["href"])
                page_num += 1
                time.sleep(delay)
            else:
                next_page = None

        # --- Save everything to CSV ---
        with open(output_csv, "w", newline="", encoding="utf-8") as f:
            writer = csv.writer(f)
            writer.writerow(headers)
            writer.writerows(all_data)

        print(f"✅ All pages scraped and saved to '{output_csv}'")
        if progress_var:
            progress_var.set("Scraping completed ✅")

    except Exception as e:
        import tkinter.messagebox as messagebox
        messagebox.showerror("Error", f"An error occurred:\n{e}")
        if progress_var:
            progress_var.set("❌ Scraping failed due to connection issues.")