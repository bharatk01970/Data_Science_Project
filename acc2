Option Explicit

' ===================================================================
' TM1 Instance Health Check Validator - Windows Automation Method
' Purpose: Automate validation of TM1 instances in Citrix environment
' Method: Uses Windows Shell and UI automation instead of TM1 API
' ===================================================================

' Configuration Constants
Const TIMEOUT_SECONDS As Long = 45
Const LOG_SHEET_NAME As String = "TM1_ValidationLog"
Const CONFIG_SHEET_NAME As String = "TM1_Instances"
Const LAUNCH_WAIT_SECONDS As Long = 10

' Windows Shell Object
Dim wshShell As Object

Sub ValidateAllTM1Instances()
    ' Main procedure to validate all configured TM1 instances
    
    Dim wsConfig As Worksheet
    Dim wsLog As Worksheet
    Dim lastRow As Long
    Dim i As Long
    Dim instanceName As String
    Dim serverAddress As String
    Dim instancePath As String
    Dim startTime As Double
    Dim validationResult As String
    Dim errorMessage As String
    Dim isHealthy As Boolean
    Dim useHardcodedList As Boolean
    
    On Error GoTo ErrorHandler
    
    ' *** CONFIGURATION: Set to True to use hardcoded list below ***
    useHardcodedList = False
    
    ' Initialize worksheets
    Set wsConfig = GetOrCreateSheet(CONFIG_SHEET_NAME)
    Set wsLog = GetOrCreateSheet(LOG_SHEET_NAME)
    
    ' Setup log sheet headers if needed
    Call InitializeLogSheet(wsLog)
    
    ' If using hardcoded list, populate the config sheet
    If useHardcodedList Then
        Call PopulateHardcodedInstances(wsConfig)
    End If
    
    ' Validate configuration sheet structure
    If Not ValidateConfigSheet(wsConfig) Then
        MsgBox "Configuration sheet is invalid. Please ensure columns: Instance Name, Server Address, Instance Path", vbCritical
        Exit Sub
    End If
    
    ' Get last row of instance list
    lastRow = wsConfig.Cells(wsConfig.Rows.Count, 1).End(xlUp).Row
    
    If lastRow < 2 Then
        MsgBox "No TM1 instances configured. Please add instances to the " & CONFIG_SHEET_NAME & " sheet.", vbInformation
        Exit Sub
    End If
    
    ' Display progress
    Application.ScreenUpdating = False
    Application.StatusBar = "Starting TM1 instance validation..."
    
    ' Initialize Windows Shell
    Set wshShell = CreateObject("WScript.Shell")
    
    ' Iterate through all instances
    For i = 2 To lastRow
        instanceName = Trim(wsConfig.Cells(i, 1).Value)
        serverAddress = Trim(wsConfig.Cells(i, 2).Value)
        instancePath = Trim(wsConfig.Cells(i, 3).Value)
        
        If instanceName <> "" And serverAddress <> "" Then
            Application.StatusBar = "Validating instance " & i - 1 & " of " & lastRow - 1 & ": " & instanceName
            
            startTime = Timer
            isHealthy = False
            errorMessage = ""
            
            ' Validate the instance
            isHealthy = ValidateTM1InstanceByLaunch(instanceName, serverAddress, instancePath, errorMessage)
            
            ' Log the result
            Call LogValidationResult(wsLog, instanceName, serverAddress, isHealthy, errorMessage)
            
            ' Brief pause between checks
            Application.Wait Now + TimeValue("00:00:02")
        End If
    Next i
    
    ' Cleanup
    Set wshShell = Nothing
    
    Application.ScreenUpdating = True
    Application.StatusBar = False
    
    MsgBox "TM1 instance validation completed. Check the " & LOG_SHEET_NAME & " sheet for results.", vbInformation
    
    Exit Sub
    
ErrorHandler:
    Application.ScreenUpdating = True
    Application.StatusBar = False
    Set wshShell = Nothing
    MsgBox "Error in validation process: " & Err.Description, vbCritical
End Sub

Function ValidateTM1InstanceByLaunch(instanceName As String, serverAddress As String, instancePath As String, ByRef errorMsg As String) As Boolean
    ' Validates a TM1 instance by launching it and checking for errors
    
    Dim startTime As Double
    Dim tm1WindowTitle As String
    Dim launchCommand As String
    Dim processID As Long
    Dim waitCounter As Integer
    Dim windowFound As Boolean
    Dim errorWindowFound As Boolean
    
    On Error GoTo LaunchError
    
    ValidateTM1InstanceByLaunch = False
    errorMsg = ""
    startTime = Timer
    
    ' Determine launch method
    If instancePath <> "" Then
        ' Method 1: Direct instance file path (e.g., .opt file)
        If Dir(instancePath) <> "" Then
            launchCommand = instancePath
        Else
            errorMsg = "Instance path not found: " & instancePath
            Exit Function
        End If
    Else
        ' Method 2: Try to launch TM1 Perspectives with server parameter
        launchCommand = "tm1p.exe"
    End If
    
    ' Launch the instance
    On Error Resume Next
    wshShell.Run launchCommand, 1, False
    
    If Err.Number <> 0 Then
        errorMsg = "Failed to launch instance: " & Err.Description
        Err.Clear
        Exit Function
    End If
    On Error GoTo LaunchError
    
    ' Wait for instance window to appear
    waitCounter = 0
    windowFound = False
    errorWindowFound = False
    
    Do While waitCounter < LAUNCH_WAIT_SECONDS
        DoEvents
        Application.Wait Now + TimeValue("00:00:01")
        waitCounter = waitCounter + 1
        
        ' Check for TM1 window (various possible titles)
        If IsWindowOpen("TM1") Or IsWindowOpen(instanceName) Or IsWindowOpen("Perspectives") Then
            windowFound = True
            Exit Do
        End If
        
        ' Check for error dialogs
        If IsWindowOpen("Error") Or IsWindowOpen("TM1 Server Login") Or IsWindowOpen("Connection Failed") Then
            errorWindowFound = True
            Exit Do
        End If
        
        ' Check timeout
        If (Timer - startTime) > TIMEOUT_SECONDS Then
            errorMsg = "Launch timeout exceeded"
            Call CloseAnyTM1Windows
            Exit Function
        End If
    Loop
    
    ' Evaluate results
    If errorWindowFound Then
        errorMsg = "Instance launch failed - Error dialog detected"
        Call CloseAnyTM1Windows
        Exit Function
    End If
    
    If Not windowFound Then
        errorMsg = "Instance window not detected within timeout period"
        Call CloseAnyTM1Windows
        Exit Function
    End If
    
    ' Additional wait to ensure components load
    Application.Wait Now + TimeValue("00:00:03")
    
    ' Check if window still exists (didn't crash)
    If IsWindowOpen("TM1") Or IsWindowOpen(instanceName) Or IsWindowOpen("Perspectives") Then
        ValidateTM1InstanceByLaunch = True
        errorMsg = "Instance launched successfully - Window active"
    Else
        errorMsg = "Instance window closed unexpectedly after launch"
    End If
    
    ' Close the instance window
    Call CloseAnyTM1Windows
    
    Exit Function
    
LaunchError:
    errorMsg = "Launch error: " & Err.Description & " (Code: " & Err.Number & ")"
    ValidateTM1InstanceByLaunch = False
    Call CloseAnyTM1Windows
End Function

Function IsWindowOpen(windowTitle As String) As Boolean
    ' Checks if a window with the given title exists
    On Error Resume Next
    IsWindowOpen = (wshShell.AppActivate(windowTitle) = True)
    On Error GoTo 0
End Function

Sub CloseAnyTM1Windows()
    ' Attempts to close any open TM1 windows
    On Error Resume Next
    
    ' Try common TM1 window titles
    Dim titles As Variant
    Dim i As Integer
    
    titles = Array("TM1", "Perspectives", "IBM TM1", "TM1 Perspectives")
    
    For i = 0 To UBound(titles)
        If wshShell.AppActivate(titles(i)) Then
            wshShell.SendKeys "%{F4}", True  ' Alt+F4
            Application.Wait Now + TimeValue("00:00:01")
        End If
    Next i
    
    On Error GoTo 0
End Sub

Function GetOrCreateSheet(sheetName As String) As Worksheet
    ' Gets existing sheet or creates new one
    Dim ws As Worksheet
    
    On Error Resume Next
    Set ws = ThisWorkbook.Worksheets(sheetName)
    On Error GoTo 0
    
    If ws Is Nothing Then
        Set ws = ThisWorkbook.Worksheets.Add(After:=ThisWorkbook.Worksheets(ThisWorkbook.Worksheets.Count))
        ws.Name = sheetName
    End If
    
    Set GetOrCreateSheet = ws
End Function

Sub InitializeLogSheet(ws As Worksheet)
    ' Sets up the log sheet with headers
    
    If ws.Cells(1, 1).Value = "" Then
        ws.Cells(1, 1).Value = "Timestamp"
        ws.Cells(1, 2).Value = "Instance Name"
        ws.Cells(1, 3).Value = "Server Address"
        ws.Cells(1, 4).Value = "Status"
        ws.Cells(1, 5).Value = "Message"
        
        ' Format headers
        With ws.Range("A1:E1")
            .Font.Bold = True
            .Interior.Color = RGB(79, 129, 189)
            .Font.Color = RGB(255, 255, 255)
            .HorizontalAlignment = xlCenter
        End With
        
        ws.Columns("A:E").AutoFit
    End If
End Sub

Function ValidateConfigSheet(ws As Worksheet) As Boolean
    ' Validates the configuration sheet has required columns
    ValidateConfigSheet = False
    
    If ws.Cells(1, 1).Value = "" Then
        ' Setup config sheet if empty
        ws.Cells(1, 1).Value = "Instance Name"
        ws.Cells(1, 2).Value = "Server Address"
        ws.Cells(1, 3).Value = "Instance Path (Optional)"
        
        With ws.Range("A1:C1")
            .Font.Bold = True
            .Interior.Color = RGB(79, 129, 189)
            .Font.Color = RGB(255, 255, 255)
        End With
        
        ' Add sample data with instructions
        ws.Cells(2, 1).Value = "PROD_Instance"
        ws.Cells(2, 2).Value = "localhost:12345"
        ws.Cells(2, 3).Value = "C:\ProgramData\IBM\TM1\Instance1.opt"
        
        ws.Cells(3, 1).Value = "INSTRUCTIONS:"
        ws.Cells(3, 2).Value = "Find .opt files in your TM1 configuration folder"
        
        ws.Columns("A:C").AutoFit
    End If
    
    ValidateConfigSheet = True
End Function

Sub LogValidationResult(ws As Worksheet, instanceName As String, serverAddress As String, isHealthy As Boolean, errorMsg As String)
    ' Logs validation result to the log sheet
    Dim nextRow As Long
    Dim statusText As String
    Dim statusColor As Long
    
    nextRow = ws.Cells(ws.Rows.Count, 1).End(xlUp).Row + 1
    
    ' Determine status
    If isHealthy Then
        statusText = "AVAILABLE"
        statusColor = RGB(0, 176, 80)
    Else
        statusText = "UNAVAILABLE"
        statusColor = RGB(255, 0, 0)
    End If
    
    ' Write log entry
    ws.Cells(nextRow, 1).Value = Now
    ws.Cells(nextRow, 2).Value = instanceName
    ws.Cells(nextRow, 3).Value = serverAddress
    ws.Cells(nextRow, 4).Value = statusText
    ws.Cells(nextRow, 5).Value = errorMsg
    
    ' Format status cell
    With ws.Cells(nextRow, 4)
        .Font.Bold = True
        .Font.Color = statusColor
    End With
    
    ' Format timestamp
    ws.Cells(nextRow, 1).NumberFormat = "yyyy-mm-dd hh:mm:ss"
    
    ws.Columns("A:E").AutoFit
End Sub

Sub ClearValidationLog()
    ' Utility to clear the validation log (keeps headers)
    Dim ws As Worksheet
    Dim lastRow As Long
    
    On Error Resume Next
    Set ws = ThisWorkbook.Worksheets(LOG_SHEET_NAME)
    On Error GoTo 0
    
    If Not ws Is Nothing Then
        lastRow = ws.Cells(ws.Rows.Count, 1).End(xlUp).Row
        If lastRow > 1 Then
            ws.Range("A2:E" & lastRow).ClearContents
            MsgBox "Validation log cleared.", vbInformation
        Else
            MsgBox "No log entries to clear.", vbInformation
        End If
    Else
        MsgBox "Log sheet not found.", vbExclamation
    End If
End Sub

