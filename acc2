def show_conditional_impact_popup(self, stage1_data, combined_column_name):
    """Show popup to configure conditional impacts on target columns based on combined column values"""
    if not stage1_data:
        return None
    
    # Extract unique values from combined column
    combined_values = set()
    for row in stage1_data:
        if combined_column_name in row and row[combined_column_name]:
            combined_values.add(str(row[combined_column_name]).strip())
    
    # Get all available columns (excluding combined column)
    available_columns = set()
    for row in stage1_data:
        available_columns.update(row.keys())
    available_columns.discard(combined_column_name)
    
    if not combined_values or not available_columns:
        return None
    
    popup = tk.Toplevel(self.root)
    popup.title("Conditional Column Impact (Optional)")
    popup.geometry("700x650")
    popup.transient(self.root)
    popup.grab_set()
    
    ttk.Label(popup, text="Conditional Column Impact (Optional)", 
              font=('TkDefaultFont', 12, 'bold')).pack(pady=10)
    ttk.Label(popup, text="Define actions on target columns based on combined column values", 
              font=('TkDefaultFont', 9)).pack(pady=5, padx=10, anchor=tk.W)
    
    # Create notebook for organized input
    notebook = ttk.Notebook(popup)
    notebook.pack(fill=tk.BOTH, expand=True, padx=10, pady=10)
    
    # --- TAB 1: Select Target Columns ---
    tab1 = ttk.Frame(notebook)
    notebook.add(tab1, text="Step 1: Target Columns")
    
    ttk.Label(tab1, text="Select target column(s) to impact:", 
              font=('TkDefaultFont', 9, 'bold')).pack(pady=5, padx=10, anchor=tk.W)
    
    # Scrollable frame for target column checkboxes
    target_canvas_frame = ttk.Frame(tab1)
    target_canvas_frame.pack(fill=tk.BOTH, expand=True, padx=10, pady=5)
    
    target_canvas = tk.Canvas(target_canvas_frame, highlightthickness=0, height=300)
    target_scrollbar = ttk.Scrollbar(target_canvas_frame, orient="vertical", command=target_canvas.yview)
    target_scrollable = ttk.Frame(target_canvas)
    
    target_scrollable.bind("<Configure>", 
                          lambda e: target_canvas.configure(scrollregion=target_canvas.bbox("all")))
    
    target_canvas.create_window((0, 0), window=target_scrollable, anchor="nw")
    target_canvas.configure(yscrollcommand=target_scrollbar.set)
    
    target_canvas.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
    target_scrollbar.pack(side=tk.RIGHT, fill=tk.Y)
    
    target_vars = {}
    for col in sorted(available_columns):
        var = tk.BooleanVar(value=False)
        target_vars[col] = var
        cb = ttk.Checkbutton(target_scrollable, text=col, variable=var)
        cb.pack(anchor=tk.W, padx=5, pady=2)
    
    # --- TAB 2: Select Trigger Values (with mode selection) ---
    tab2 = ttk.Frame(notebook)
    notebook.add(tab2, text="Step 2: Trigger Values")
    
    ttk.Label(tab2, text=f"Select value(s) from '{combined_column_name}' that trigger the action:", 
              font=('TkDefaultFont', 9, 'bold')).pack(pady=5, padx=10, anchor=tk.W)
    ttk.Label(tab2, text="Only rows with these values will be affected", 
              font=('TkDefaultFont', 8), foreground='gray').pack(pady=2, padx=10, anchor=tk.W)
    
    # Mode selection frame
    mode_frame = ttk.LabelFrame(tab2, text="Selection Mode", padding=10)
    mode_frame.pack(fill=tk.X, padx=10, pady=5)
    
    selection_mode = tk.StringVar(value="individual")
    
    ttk.Radiobutton(mode_frame, text="Select Individual Values", 
                    variable=selection_mode, value="individual",
                    command=lambda: update_trigger_display()).pack(anchor=tk.W, pady=2)
    ttk.Radiobutton(mode_frame, text="Select by Column Headers (bulk selection)", 
                    variable=selection_mode, value="column_headers",
                    command=lambda: update_trigger_display()).pack(anchor=tk.W, pady=2)
    
    # Scrollable frame for trigger selection (will be dynamically updated)
    trigger_canvas_frame = ttk.Frame(tab2)
    trigger_canvas_frame.pack(fill=tk.BOTH, expand=True, padx=10, pady=5)
    
    trigger_canvas = tk.Canvas(trigger_canvas_frame, highlightthickness=0, height=250)
    trigger_scrollbar = ttk.Scrollbar(trigger_canvas_frame, orient="vertical", command=trigger_canvas.yview)
    trigger_scrollable = ttk.Frame(trigger_canvas)
    
    trigger_scrollable.bind("<Configure>", 
                           lambda e: trigger_canvas.configure(scrollregion=trigger_canvas.bbox("all")))
    
    trigger_canvas.create_window((0, 0), window=trigger_scrollable, anchor="nw")
    trigger_canvas.configure(yscrollcommand=trigger_scrollbar.set)
    
    trigger_canvas.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
    trigger_scrollbar.pack(side=tk.RIGHT, fill=tk.Y)
    
    # Storage for trigger selection
    trigger_vars = {}
    column_header_vars = {}
    column_to_values_map = {}  # Maps column name to list of its values
    
    def update_trigger_display():
        """Update the trigger selection display based on selected mode"""
        # Clear existing widgets
        for widget in trigger_scrollable.winfo_children():
            widget.destroy()
        trigger_vars.clear()
        column_header_vars.clear()
        
        mode = selection_mode.get()
        
        if mode == "individual":
            # Show individual values (original functionality)
            for val in sorted(combined_values):
                var = tk.BooleanVar(value=False)
                trigger_vars[val] = var
                cb = ttk.Checkbutton(trigger_scrollable, text=val, variable=var)
                cb.pack(anchor=tk.W, padx=5, pady=2)
        
        elif mode == "column_headers":
            # Show column headers with sample values
            # First, we need to map which values belong to which source columns
            # This requires tracking from the combination process
            
            # Try to infer column grouping from the data
            # Look for patterns or use stored metadata if available
            if hasattr(self, 'combination_source_columns') and self.combination_source_columns:
                # Use stored mapping if available
                for col_name in sorted(self.combination_source_columns.keys()):
                    values = self.combination_source_columns[col_name]
                    column_to_values_map[col_name] = values
                    
                    var = tk.BooleanVar(value=False)
                    column_header_vars[col_name] = var
                    
                    # Show sample value in parentheses
                    sample_val = values[0] if values else ""
                    display_text = f"{col_name} ({sample_val}... [{len(values)} values])"
                    
                    cb = ttk.Checkbutton(trigger_scrollable, text=display_text, variable=var)
                    cb.pack(anchor=tk.W, padx=5, pady=2)
            else:
                # Fallback: Show warning that column mapping is not available
                ttk.Label(trigger_scrollable, 
                         text="⚠ Column header mapping not available",
                         font=('TkDefaultFont', 9, 'bold'),
                         foreground='red').pack(anchor=tk.W, padx=5, pady=5)
                ttk.Label(trigger_scrollable, 
                         text="Please use 'Individual Values' mode instead.\n\n"
                              "Column header mode requires tracking from the\n"
                              "combination process. This will be available in\n"
                              "future processing runs.",
                         font=('TkDefaultFont', 8),
                         foreground='gray').pack(anchor=tk.W, padx=5, pady=2)
    
    # Initial display
    update_trigger_display()
    
    # --- TAB 3: Define Impact ---
    tab3 = ttk.Frame(notebook)
    notebook.add(tab3, text="Step 3: Define Impact")
    
    ttk.Label(tab3, text="Choose the action to perform:", 
              font=('TkDefaultFont', 9, 'bold')).pack(pady=10, padx=10, anchor=tk.W)
    
    impact_var = tk.StringVar(value="blank_non_matching")
    
    # Radio buttons for impact options
    rb_frame = ttk.Frame(tab3)
    rb_frame.pack(fill=tk.X, padx=20, pady=5)
    
    ttk.Radiobutton(rb_frame, text="Option 1: Blank out NON-MATCHING rows (keep matching rows unchanged)", 
                    variable=impact_var, value="blank_non_matching").pack(anchor=tk.W, pady=3)
    ttk.Label(rb_frame, text="   → Target columns become empty for rows NOT in trigger values", 
              font=('TkDefaultFont', 8), foreground='blue').pack(anchor=tk.W, padx=20)
    
    ttk.Radiobutton(rb_frame, text="Option 2: Replace MATCHING rows with custom value", 
                    variable=impact_var, value="replace_matching").pack(anchor=tk.W, pady=3)
    ttk.Label(rb_frame, text="   → Target columns get new value for rows IN trigger values", 
              font=('TkDefaultFont', 8), foreground='blue').pack(anchor=tk.W, padx=20)
    
    ttk.Radiobutton(rb_frame, text="Option 3: Blank out MATCHING rows (keep non-matching unchanged)", 
                    variable=impact_var, value="blank_matching").pack(anchor=tk.W, pady=3)
    ttk.Label(rb_frame, text="   → Target columns become empty for rows IN trigger values", 
              font=('TkDefaultFont', 8), foreground='blue').pack(anchor=tk.W, padx=20)
    
    # Custom value entry (for Option 2)
    value_frame = ttk.Frame(tab3)
    value_frame.pack(fill=tk.X, padx=20, pady=15)
    
    ttk.Label(value_frame, text="Custom replacement value (for Option 2):").pack(side=tk.LEFT, padx=5)
    custom_value_entry = ttk.Entry(value_frame, width=30)
    custom_value_entry.pack(side=tk.LEFT, padx=5)
    custom_value_entry.insert(0, "")
    
    # Example section
    example_frame = ttk.LabelFrame(tab3, text="Example", padding=10)
    example_frame.pack(fill=tk.BOTH, expand=True, padx=10, pady=10)
    
    example_text = tk.Text(example_frame, height=8, width=70, wrap=tk.WORD, 
                          font=('Courier', 8), state='normal')
    example_text.pack(fill=tk.BOTH, expand=True)
    
    example_content = """
Example Setup:
• Combined Column: [A1, A2, B1, C1]
• Target Column: X
• Trigger Selection: Column A (contains A1, A2)

Option 1 Result (Blank Non-Matching):
  Row with A1 → X keeps original value
  Row with A2 → X keeps original value
  Row with B1 → X becomes blank
  Row with C1 → X becomes blank

Option 2 Result (Replace Matching with "drama"):
  Row with A1 → X = "drama"
  Row with A2 → X = "drama"
  Row with B1 → X keeps original value
  Row with C1 → X keeps original value

Option 3 Result (Blank Matching):
  Row with A1 → X becomes blank
  Row with A2 → X becomes blank
  Row with B1 → X keeps original value
  Row with C1 → X keeps original value
    """
    example_text.insert('1.0', example_content)
    example_text.config(state='disabled')
    
    result = {'apply': False, 'target_columns': [], 'trigger_values': [], 
              'impact_type': '', 'custom_value': ''}
    
    def validate_and_confirm():
        target_cols = [col for col, var in target_vars.items() if var.get()]
        
        # Collect trigger values based on selection mode
        mode = selection_mode.get()
        trigger_vals = []
        
        if mode == "individual":
            trigger_vals = [val for val, var in trigger_vars.items() if var.get()]
        elif mode == "column_headers":
            # Collect all values from selected column headers
            selected_columns = [col for col, var in column_header_vars.items() if var.get()]
            for col in selected_columns:
                if col in column_to_values_map:
                    trigger_vals.extend(column_to_values_map[col])
        
        impact_type = impact_var.get()
        custom_val = custom_value_entry.get().strip()
        
        # Validation
        if not target_cols:
            messagebox.showwarning("Warning", "Please select at least one target column in Step 1")
            return
        
        if not trigger_vals:
            if mode == "column_headers" and not hasattr(self, 'combination_source_columns'):
                messagebox.showwarning("Warning", 
                    "Column header mode is not available.\n"
                    "Please switch to 'Individual Values' mode in Step 2.")
            else:
                messagebox.showwarning("Warning", "Please select at least one trigger value/column in Step 2")
            return
        
        if impact_type == "replace_matching" and not custom_val:
            messagebox.showwarning("Warning", 
                "Option 2 requires a custom replacement value.\nPlease enter a value in Step 3.")
            return
        
        result['apply'] = True
        result['target_columns'] = target_cols
        result['trigger_values'] = trigger_vals
        result['impact_type'] = impact_type
        result['custom_value'] = custom_val
        popup.destroy()
    
    def skip():
        popup.destroy()
    
    # Bottom buttons
    button_frame = ttk.Frame(popup)
    button_frame.pack(pady=10)
    
    ttk.Button(button_frame, text="Apply Configuration", 
               command=validate_and_confirm, style='Accent.TButton').pack(side=tk.LEFT, padx=5)
    ttk.Button(button_frame, text="Skip (No Conditional Impact)", 
               command=skip).pack(side=tk.LEFT, padx=5)
    
    popup.wait_window()
    return result





