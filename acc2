    def log_message(self, message, tag='info'):
        """
        Log a message to both the popup GUI log and the file-based logger.
        
        Args:
            message: The message text to log
            tag: The message type ('info', 'success', 'warning', 'error')
                 Determines text color and log level
        """
        # Update GUI log (enable, insert, disable to prevent user editing)
        self.log_text.config(state='normal')
        timestamp = datetime.now().strftime('%I:%M:%S %p')  # Format: 02:30:45 PM
        full_message = f"[{timestamp}] {message}"
        self.log_text.insert(tk.END, f"{full_message}\n", tag)  # Append with color tag
        self.log_text.see(tk.END)  # Auto-scroll to latest message
        self.log_text.config(state='disabled')  # Make read-only again
        self.popup.update_idletasks()  # Force GUI update

        # Write to file logger with appropriate log level
        if self.logger:
            # Map GUI tag to logging level
            log_level = {
                'info': logging.INFO,
                'success': logging.INFO,
                'warning': logging.WARNING,
                'error': logging.ERROR
            }.get(tag, logging.INFO)
            
            # Log to file with file key prefix
            self.logger.log(log_level, f"{self.file_key}: {message}")

        # Also log to main window if callback provided
        if self.log_callback:
            self.log_callback(f"{self.file_key}: {message}", tag)

    def extract_cell_value(self, workbook, cell_ref):
        """
        Extract numeric value from an Excel cell reference.
        
        This method handles both simple cell references (e.g., "A1") and
        qualified references with sheet names (e.g., "Sheet1!A1").
        
        Args:
            workbook: Excel workbook COM object
            cell_ref: Cell reference string (e.g., "A1" or "Sheet1!A1")
            
        Returns:
            float: The numeric value from the cell (0.0 if empty/error)
        """
        cell_addr = None
        sheet = None
        
        try:
            # Remove leading/trailing whitespace
            cell_ref = cell_ref.strip()
            
            # Check if reference includes sheet name (contains '!')
            if '!' in cell_ref:
                parts = cell_ref.split('!')
                if len(parts) != 2:
                    # Invalid format - must be exactly "Sheet!Cell"
                    self.log_message(f"Invalid cell reference format: {cell_ref}", 'error')
                    return 0.0
                
                # Parse sheet name and cell address
                sheet_name, cell_addr = parts
                sheet_name = sheet_name.strip()
                cell_addr = cell_addr.strip()
                
                try:
                    # Get the specified sheet from workbook
                    sheet = workbook.Sheets(sheet_name)
                except Exception as e:
                    # Sheet not found in workbook
                    self.log_message(f"Sheet '{sheet_name}' not found in workbook", 'error')
                    return 0.0
            else:
                # No sheet specified - use active sheet
                sheet = workbook.ActiveSheet
                cell_addr = cell_ref.strip()
    
            # Verify cell address is not empty
            if not cell_addr:
                self.log_message(f"Empty cell address in reference: {cell_ref}", 'error')
                return 0.0
    
            # Get the cell value
            value = sheet.Range(cell_addr).Value
    
            # Handle empty cells
            if value is None:
                self.log_message(f"Cell {cell_ref} is empty, using 0.0", 'info')
                return 0.0
    
            # Convert to float (handles numeric strings)
            try:
                return float(value)
            except (ValueError, TypeError):
                # Cell contains non-numeric data
                self.log_message(f"Non-numeric value in {cell_ref}: {value}", 'warning')
                return 0.0
    
        except Exception as e:
            # Catch-all for any other errors
            self.log_message(f"Error reading cell {cell_ref}: {str(e)}", 'error')
            return 0.0

    def check_threshold_condition(self, value, threshold_type, threshold_value, threshold_max=None):
        """
        Evaluate whether a value meets a specified threshold condition.
        
        This method supports multiple comparison types for conditional logic.
        Used to determine if linked sheets should be captured based on cell values.
        
        Args:
            value: The numeric value to test
            threshold_type: Type of comparison ('equals_zero', 'not_zero', 'exceeds', 
                           'below', 'between', 'less_minus_x_greater_x')
            threshold_value: The threshold value to compare against
            threshold_max: Maximum value for 'between' comparisons (optional)
            
        Returns:
            bool: True if condition is met, False otherwise
        """
        try:
            # Convert threshold values to float
            threshold_val = float(threshold_value)
            if threshold_max is not None:
                threshold_max_val = float(threshold_max)
        except (ValueError, TypeError):
            # Invalid threshold values - default to 0
            threshold_val = 0.0
            threshold_max_val = None
        
        # Evaluate condition based on type
        if threshold_type == 'equals_zero':
            # Value must be exactly zero
            return value == 0.0
        elif threshold_type == 'not_zero':
            # Value must be non-zero
            return value != 0.0
        elif threshold_type == 'exceeds':
            # Value must be greater than threshold
            return value > threshold_val
        elif threshold_type == 'below':
            # Value must be less than threshold
            return value < threshold_val
        elif threshold_type == 'between':
            # Value must be within range [threshold_val, threshold_max_val]
            if threshold_max_val is not None:
                return threshold_val <= value <= threshold_max_val
            else:
                return False
        elif threshold_type == 'less_minus_x_greater_x':
            # Value must be outside range (-threshold_val, threshold_val)
            # Triggers if value < -threshold or value > threshold
            return (-threshold_val > value) or (threshold_val < value)
        else:
            # Unknown threshold type
            return False

    def analyze_linked_sheets(self, workbook):
        """
        Analyze Excel workbook and determine which linked sheets to capture.
        
        This method implements "smart linking" - conditional screenshot capture
        based on cell values meeting threshold conditions. Each linked sheet
        has an associated "value cell" that is checked against thresholds.
        
        Args:
            workbook: Excel workbook COM object to analyze
            
        Returns:
            list: List of sheet configuration dicts for sheets that meet conditions
                  Each dict contains: sheet_name, cell_range, embed, attach, name, value
        """
        # Get smart linking configuration
        smart_config = self.file_config.get('smart_linking', {})
        
        # Return empty list if smart linking is disabled
        if not smart_config.get('enabled', False):
            return []

        # Extract configuration parameters
        master_sheet = smart_config.get('master_sheet', '')  # Master sheet name
        linked_sheets = smart_config.get('linked_sheets', [])  # List of linked sheet groups
        threshold_type = smart_config.get('threshold_type', 'equals_zero')  # Comparison type
        threshold_value = smart_config.get('threshold_value', 0)  # Threshold value
        threshold_max = smart_config.get('threshold_max', None)  # Max value for 'between'
        
        self.log_message("Analyzing linked sheets with threshold conditions", 'info')
        
        sheets_to_capture = []  # List to store sheets that meet conditions
        
        # Iterate through each linked sheet group
        for linked_group in linked_sheets:
            value_cell = linked_group.get('value_cell', '')  # Cell to check condition
            sheets_list = linked_group.get('sheets', [])  # List of sheets in this group
            
            # Handle legacy format where sheet config is in the group itself
            if not sheets_list and linked_group.get('sheet_name'):
                sheets_list = [linked_group]
                value_cell = linked_group.get('value_cell', '')
            
            # Extract the value from the specified cell
            cell_value = self.extract_cell_value(workbook, value_cell)
            
            # Check if value meets the threshold condition
            meets_condition = self.check_threshold_condition(
               cell_value,
               threshold_type,
               threshold_value,
               threshold_max
            )
            
            # Log the condition check result
            self.log_message(
                f"  Value Cell {value_cell}: Value={cell_value}, Condition={meets_condition}",
                'success' if meets_condition else 'info'
            )
            
            # If condition is met, add all sheets in this group to capture list
            if meets_condition:
                for sheet_config in sheets_list:
                    sheet_name = sheet_config.get('sheet_name', '')
                    capture_range = sheet_config.get('capture_range', 'A1:Z50')
                    
                    self.log_message(
                        f"    → Will capture: {sheet_name}",
                        'success'
                    )
                    
                    # Add sheet configuration to capture list
                    sheets_to_capture.append({
                        'sheet_name': sheet_name,  # Name of sheet to capture
                        'cell_range': capture_range,  # Range to screenshot
                        'embed': sheet_config.get('embed', True),  # Embed in email body
                        'attach': sheet_config.get('attach', False),  # Attach as file
                        'name': sheet_config.get('name', sheet_name),  # Display name
                        'value': cell_value,  # The value that triggered capture
                        'value_cell': value_cell  # Cell reference that was checked
                    })
        
        return sheets_to_capture

    def take_screenshot(self):
        """
        Initiate screenshot capture in a background thread.
        
        This method starts the screenshot capture process without blocking the GUI.
        The actual capture logic runs in _take_screenshot_thread().
        """
        # Create and start background thread
        thread = threading.Thread(target=self._take_screenshot_thread)
        thread.daemon = True  # Thread terminates when main thread exits
        thread.start()

    def _take_screenshot_thread(self):
        """
        Execute the screenshot capture workflow in a background thread.
        
        This method:
        1. Opens the Excel workbook
        2. Analyzes smart linking conditions (if enabled)
        3. Captures screenshots from specified sheet ranges
        4. Saves screenshots as PNG files
        5. Cleans up Excel resources
        
        Runs in separate thread to prevent GUI freezing during Excel operations.
        """
        try:
            # Update status to show processing
            self.screenshot_status.config(text='Analyzing...', foreground='orange')
            self.log_message('Initiating Screenshot Capture Process', 'info')

            # Get file path from GUI entry field
            file_path = self.path_entry.get()

            # Validate file path exists
            if not file_path or not os.path.exists(file_path):
                self.log_message(f'Invalid file path: {file_path}', 'error')
                self.screenshot_status.config(text='Error: File not found', foreground='red')
                return

            # Initialize COM for this thread (required for Excel automation)
            pythoncom.CoInitialize()

            # Create Excel application instance (hidden, no alerts)
            excel = win32com.client.gencache.EnsureDispatch("Excel.Application")
            excel.Visible = False  # Don't show Excel window
            excel.DisplayAlerts = False  # Suppress Excel alerts/prompts

            # Open the workbook in read-only mode without updating links
            workbook = excel.Workbooks.Open(
                Filename=os.path.abspath(file_path),
                UpdateLinks=0,  # Don't update external links
                ReadOnly=True,  # Open in read-only mode
                IgnoreReadOnlyRecommended=True  # Don't show read-only prompt
            )
            
            # Get folder containing the Excel file (for saving screenshots)
            file_folder = os.path.dirname(os.path.abspath(file_path))
            self.screenshot_paths = []  # Reset screenshot list

            # Check if smart linking is enabled
            if self.smart_enabled:
                # Smart linking mode - capture master sheet plus conditional sheets
                smart_config = self.file_config.get('smart_linking', {})
                master_sheet = smart_config.get('master_sheet', '')
                master_range = smart_config.get('master_range', 'A1:Z50')
                
                # Capture the master sheet first
                self.log_message(f"Capturing Master sheet: {master_sheet}", 'info')
                self.screenshot_status.config(text=f"Capturing Master Sheet: {master_sheet}...", foreground='orange')
                
                self._capture_single_screenshot(
                    workbook,
                    master_sheet,
                    master_range,
                    f"{master_sheet}",  # Use sheet name as filename
                    file_folder,
                    embed=True,  # Embed master sheet in email
                    attach=False  # Don't attach as separate file
                )

                # Analyze and capture linked sheets that meet conditions
                self.screenshot_status.config(text="Analyzing linked sheets...", foreground='orange')
                conditional_sheets = self.analyze_linked_sheets(workbook)
            
                # Capture each conditional sheet
                for sheet_config in conditional_sheets:
                    self.screenshot_status.config(
                        text=f"Capturing: {sheet_config['sheet_name']}...",
                        foreground='orange'
                    )
                    
                    self._capture_single_screenshot(
                        workbook,
                        sheet_config['sheet_name'],
                        sheet_config['cell_range'],
                        sheet_config['name'],
                        file_folder,
                        embed=sheet_config.get('embed', True),
                        attach=sheet_config.get('attach', False)
                    )

            else:
                # Standard mode - capture all configured screenshots
                screenshots_config = self.file_config.get('screenshots', [])
                
                # Check if any screenshots are configured
                if not screenshots_config:
                    self.log_message("No screenshot configuration found", 'warning')
                    self.screenshot_status.config(text="No screenshots configured", foreground='orange')
                    # Clean up and exit
                    workbook.Close(SaveChanges=False)
                    excel.Quit()
                    pythoncom.CoUninitialize()
                    return

                # Capture each configured screenshot
                for idx, config in enumerate(screenshots_config, 1):
                    sheet_name = config['sheet_name']
                    cell_range = config['cell_range']
                    name = config.get('name', f'screenshot_{idx}')
                    
                    # Update status with progress
                    self.screenshot_status.config(
                        text=f"Capturing {idx}/{len(screenshots_config)}: {name}...",
                        foreground='orange'
                    )

                    self._capture_single_screenshot(
                        workbook,
                        sheet_name,
                        cell_range,
                        name,
                        file_folder,
