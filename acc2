#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""
Auto-Execute Mail Draft Utility
Automatically processes Excel files and drafts emails with screenshots on launch.
Supports manual and automatic execution modes with smart conditional screenshot capture.
"""

# Standard library imports
import tkinter as tk  # GUI framework
from tkinter import ttk, filedialog, messagebox, scrolledtext  # GUI components
import os  # File system operations
import time  # Time delays and timing operations
import threading  # Multi-threading for background tasks
import logging  # Logging framework
from logging.handlers import RotatingFileHandler  # Log file rotation
from datetime import datetime  # Date and time handling
import pytz  # Timezone conversions

# Third-party imports
import win32com.client  # COM interface for Excel and Outlook automation
from PIL import ImageGrab  # Clipboard image capture
import pythoncom  # COM initialization for threading


class ReconFile:
    """
    Handles individual reconciliation file processing.
    
    This class creates a popup window for each file, manages screenshot capture
    from Excel workbooks, analyzes conditional logic for smart linking, and
    drafts emails in Outlook with embedded/attached screenshots.
    
    Key Features:
    - Manual or automatic workflow execution
    - Smart conditional screenshot capture based on cell values
    - Excel sheet range screenshot with clipboard copying
    - Outlook email drafting with embedded images
    - Automatic cleanup of temporary files
    - Activity logging to GUI and file
    """
    
    def __init__(self, parent, file_key, file_config, email_config, log_callback, logger, auto_mode=False):
        """
        Initialize the ReconFile popup window.
        
        Args:
            parent: Parent tkinter window (main application window)
            file_key: Unique identifier for the file (e.g., "Recon 1")
            file_config: Dictionary containing file-specific configuration
            email_config: Dictionary containing email settings (recipients, signature, etc.)
            log_callback: Function to call for logging to main window
            logger: Logger instance for file-based logging
            auto_mode: Boolean flag to enable automatic workflow execution
        """
        # Store initialization parameters
        self.parent = parent  # Reference to main window
        self.file_key = file_key  # File identifier for logging
        self.file_config = file_config  # Configuration dict for this file
        self.email_config = email_config  # Email settings dict
        self.log_callback = log_callback  # Function to log to main window
        self.logger = logger  # Logger instance for file logging
        self.screenshot_paths = []  # List to store captured screenshot file paths
        self.conditional_screenshots = []  # List for conditionally captured sheets
        self.auto_mode = auto_mode  # Flag indicating automatic vs manual mode

        # Create popup window
        self.popup = tk.Toplevel(parent)  # Create new window on top of parent
        self.popup.title(f"Draft Email - {file_key}")  # Set window title
        self.popup.geometry("550x560")  # Set window dimensions
        self.popup.grab_set()  # Make window modal (blocks parent interaction)
        
        # Initialize COM for this thread (required for Excel/Outlook automation)
        pythoncom.CoInitialize()
        
        # Build the GUI components
        self.create_popup_gui()
        
        # Auto-execute workflow if in automatic mode
        if self.auto_mode:
            # Schedule auto-execution after 500ms to allow GUI to render
            self.popup.after(500, self.auto_execute_workflow)

    def auto_execute_workflow(self):
        """
        Automatically execute the complete workflow without user interaction.
        
        This method orchestrates the automatic execution sequence:
        1. Capture screenshots from Excel
        2. Draft email in Outlook
        3. Close popup and main windows
        
        Used when auto_mode=True for hands-free operation.
        """
        self.log_message("AUTO MODE: Starting automated workflow", 'info')
        
        # Step 1: Initiate screenshot capture in background thread
        self.log_message("AUTO MODE: Step 1/2 - Capturing screenshots...", 'info')
        thread = threading.Thread(target=self._auto_screenshot_and_draft)
        thread.daemon = True  # Thread dies when main thread exits
        thread.start()

    def _auto_screenshot_and_draft(self):
        """
        Combined background thread for automatic screenshot capture and email drafting.
        
        This method runs in a separate thread to prevent GUI blocking.
        Executes the full workflow and handles automatic window closure.
        """
        try:
            # Step 1: Execute screenshot capture logic
            self._take_screenshot_thread()
            
            # Wait for screenshot files to be written to disk
            time.sleep(2)
            
            # Step 2: Draft email if screenshots were captured successfully
            if self.screenshot_paths:
                self.log_message("AUTO MODE: Step 2/2 - Drafting email...", 'info')
                self._draft_email_thread()
                
                # Step 3: Schedule automatic window closure
                time.sleep(2)
                self.popup.after(100, self.auto_close)
            else:
                # No screenshots captured - abort workflow
                self.log_message("AUTO MODE: No screenshots captured, aborting", 'error')
                
        except Exception as e:
            # Log any errors that occur during auto-execution
            self.log_message(f"AUTO MODE ERROR: {str(e)}", 'error')

    def auto_close(self):
        """
        Automatically close the popup window and then the main application window.
        
        This method is called after successful auto-execution to clean up
        and close all windows without user interaction.
        """
        self.log_message("AUTO MODE: Workflow completed, closing popup window", 'success')
        
        # Check if in auto mode and parent window exists
        if self.auto_mode and hasattr(self.parent, 'winfo_exists'):
            main_window = self.parent
            
            # Close popup window first
            self.popup.destroy()
            
            # Schedule main window closure after 2 second delay
            if main_window.winfo_exists():
                main_window.after(2000, self.close_main_window, main_window)
        else:
            # Manual mode - just close popup
            self.popup.destroy()
    
    def close_main_window(self, main_window):
        """
        Helper method to close the main application window.
        
        Args:
            main_window: Reference to the main tkinter window to close
        """
        try:
            # Verify window still exists before attempting to close
            if main_window.winfo_exists():
                # Log closure action
                self.logger.info("AUTO MODE: Closing main application window")
                # Destroy the main window
                main_window.destroy()
        except Exception as e:
            # Print error to console if window closure fails
            print(f"Error closing main window: {e}")

