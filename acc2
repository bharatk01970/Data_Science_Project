        self.log_text.pack(fill=tk.BOTH, expand=True)
        
        self.log_text.tag_config('info', foreground='blue')
        self.log_text.tag_config('success', foreground='green')
        self.log_text.tag_config('error', foreground='red')
        self.log_text.tag_config('warning', foreground='orange')
        
        self.log_message("Application initialized", 'success')
        
        if self.auto_execute:
            self.log_message("AUTO-EXECUTE MODE: Will process first file automatically", 'warning')
        else:
            self.log_message("Select a file above to begin", 'info')

    def log_message(self, message, tag='info'):
        self.log_text.config(state='normal')
        timestamp = datetime.now().strftime('%I:%M:%S %p')
        self.log_text.insert(tk.END, f"[{timestamp}] {message}\n", tag)
        self.log_text.see(tk.END)
        self.log_text.config(state='disabled')
        self.root.update_idletasks()
    
    def open_file_popup(self, file_key):
        self.log_message(f"Opening draft window for {file_key}", 'info')
        
        file_config = self.file_configs.get(file_key, {})
        
        if not file_config:
            self.log_message(f"Configuration not found for {file_key}", 'error')
            messagebox.showerror("Error", f"No configuration found for {file_key}")
            return
        
        smart_enabled = file_config.get('smart_linking', {}).get('enabled', False)
        
        # NEW: Pass auto_mode=False for manual opening
        ReconFile(self.root, file_key, file_config, self.email_config, self.log_message, auto_mode=False)
    
    def on_closing(self):
        try:
            pythoncom.CoUninitialize()
        except:
            pass
        
        self.root.destroy()


def main():
    """Main function to start the GUI application"""
    root = tk.Tk()
    
    # ============================================================
    # ENABLE AUTO-EXECUTE MODE
    # ============================================================
    # Change auto_execute=False to auto_execute=True to enable
    # automatic execution on launch
    # ============================================================
    
    app = ExcelOutlookGUI(root, auto_execute=True)  # <-- SET TO True FOR AUTO MODE
    
    root.protocol("WM_DELETE_WINDOW", app.on_closing)
    root.mainloop()


if __name__ == "__main__":
    main()


