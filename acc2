        default_body = f"{fileinfo['body']}

Timestamp: {ts_str}"

        ttk.Label(popup, text="Email Subject:").grid(row=1, column=0, sticky="w", padx=5, pady=5)
        subject_entry = ttk.Entry(popup, width=70)
        subject_entry.insert(0, default_subject)
        subject_entry.grid(row=1, column=1, sticky="ew", padx=5, pady=5)

        ttk.Label(popup, text="Email Body:").grid(row=2, column=0, sticky="w", padx=5, pady=5)
        body_text = scrolledtext.ScrolledText(popup, width=60, height=7)
        body_text.insert("1.0", default_body)
        body_text.grid(row=2, column=1, sticky="ew", padx=5, pady=5)

        # Buttons for draft, screenshot, file deletion
        btn_frame = ttk.Frame(popup)
        btn_frame.grid(row=3, column=0, columnspan=2, pady=15)
        
        draft_btn = ttk.Button(btn_frame, text="Draft Mail", command=lambda: self.draftmailpopup(filekey, path_entry, subject_entry, body_text, popup))
        draft_btn.grid(row=0, column=0, padx=6)
        
        screenshot_btn = ttk.Button(btn_frame, text="Take Screenshot", command=lambda: self.takescreenshotpopup(filekey, path_entry))
        screenshot_btn.grid(row=0, column=1, padx=6)

        # Initially hidden; shown only after drafting email
        del_btn = ttk.Button(btn_frame, text="Delete Screenshot & File", state="disabled", command=lambda: self.delete_file_and_screenshot(filekey, path_entry))
        del_btn.grid(row=0, column=2, padx=6)

        # Save reference for later enabling
        popup.del_btn = del_btn
        popup.path_entry = path_entry

