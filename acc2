def extract_cell_value(self, workbook, cell_ref):
    """
    Extract numeric value from a cell reference
    Handles references like "Sheet1!A1" or just "A1"
    """
    # Initialize cell_addr to avoid UnboundLocalError
    cell_addr = None
    sheet = None
    
    try:
        # Strip any whitespace from the cell reference
        cell_ref = cell_ref.strip()
        
        if '!' in cell_ref:
            # Split into sheet name and cell address
            parts = cell_ref.split('!')
            if len(parts) != 2:
                self.log_message(f"Invalid cell reference format: {cell_ref}", 'error')
                return 0.0
            
            sheet_name, cell_addr = parts
            sheet_name = sheet_name.strip()
            cell_addr = cell_addr.strip()
            
            # Try to get the sheet
            try:
                sheet = workbook.Sheets(sheet_name)
            except Exception as e:
                self.log_message(f"Sheet '{sheet_name}' not found in workbook", 'error')
                return 0.0
        else:
            # Use active sheet
            sheet = workbook.ActiveSheet
            cell_addr = cell_ref.strip()

        # Validate cell_addr is not empty
        if not cell_addr:
            self.log_message(f"Empty cell address in reference: {cell_ref}", 'error')
            return 0.0

        # Get the value from the cell
        value = sheet.Range(cell_addr).Value

        # Try to convert to float
        if value is None:
            self.log_message(f"Cell {cell_ref} is empty, using 0.0", 'info')
            return 0.0

        try:
            return float(value)
        except (ValueError, TypeError):
            self.log_message(f"Non-numeric value in {cell_ref}: {value}", 'warning')
            return 0.0

    except Exception as e:
        self.log_message(f"Error reading cell {cell_ref}: {str(e)}", 'error')
        return 0.0