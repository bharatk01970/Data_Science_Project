    def browse_file(self, entry_widget):
        """
        Open file dialog to browse and select an Excel file
        Updates the entry widget with selected file path
        
        Args:
            entry_widget: The tkinter Entry widget to update with file path
        """
        # Open file dialog with Excel file filters
        filename = filedialog.askopenfilename(
            title="Select Excel File",
            filetypes=[
                ("Excel Files", "*.xlsx *.xlsm *.xls"),
                ("CSV Files", "*.csv"),
                ("All Files", "*.*")
            ]
        )
        
        # If user selected a file, update the entry widget
        if filename:
            entry_widget.delete(0, tk.END)  # Clear current content
            entry_widget.insert(0, filename)  # Insert new file path
            self.log_message(f"File selected: {filename}", 'info')
    
    def use_active_workbook(self, entry_widget, file_key):
        """
        Use currently open Excel workbook instead of file path
        Connects to active Excel instance and gets the workbook name
        
        Args:
            entry_widget: The tkinter Entry widget to update
            file_key: The file identifier (e.g., 'File 1')
        """
        try:
            # Connect to running Excel instance
            excel = win32com.client.GetActiveObject("Excel.Application")
            
            # Get active workbook
            workbook = excel.ActiveWorkbook
            
            if workbook is None:
                self.log_message("No active workbook found in Excel", 'error')
                messagebox.showerror("Error", "No active workbook found. Please open an Excel file.")
                return
            
            # Get full path of active workbook
            workbook_path = workbook.FullName
            
            # Update entry widget with active workbook path
            entry_widget.delete(0, tk.END)
            entry_widget.insert(0, workbook_path)
            
            self.log_message(f"{file_key}: Using active workbook - {workbook.Name}", 'success')
            
        except Exception as e:
            self.log_message(f"Error accessing active workbook: {str(e)}", 'error')
            messagebox.showerror("Error", f"Could not access active Excel workbook:\n{str(e)}")
    
    def log_message(self, message, tag='info'):
        """
        Add a timestamped message to the log area
        
        Args:
            message: The message text to log
            tag: The tag for text formatting ('info', 'success', 'error', 'warning')
        """
        # Enable text widget for editing
        self.log_text.config(state='normal')
        
        # Get current timestamp
        timestamp = datetime.now().strftime('%H:%M:%S')
        
        # Insert timestamped message with appropriate tag
        self.log_text.insert(tk.END, f"[{timestamp}] {message}\n", tag)
        
        # Auto-scroll to bottom
        self.log_text.see(tk.END)
        
        # Disable text widget to prevent user editing
        self.log_text.config(state='disabled')
        
        # Update GUI to show message immediately
        self.root.update_idletasks()
    
