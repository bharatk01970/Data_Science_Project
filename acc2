Sub TransformInputToOutput()
    '=================================================================================
    ' EXCEL TRANSFORMATION MACRO - FINAL VERSION
    ' Purpose: Transform one input row into three output rows with specific rules
    ' Updated: Added N element column, Comments filter, Level1 Name filter, and
    '          Level5 Name exclusion logic
    '=================================================================================
    
    Dim wsInput As Worksheet
    Dim wsOutput As Worksheet
    Dim lastRow As Long
    Dim inputRow As Long
    Dim outputRow As Long
    Dim level5ID As String
    Dim level5Name As String
    Dim level4ID As String
    Dim level4Name As String
    Dim level3ID As String
    Dim level3Name As String
    Dim level2ID As String
    Dim level2Name As String
    Dim level1ID As String
    Dim level1Name As String
    Dim comments As String
    Dim topC As String
    Dim middleCStatus As String
    Dim isStandard As Boolean
    Dim allAltSuffix As String
    Dim shouldTransform As Boolean
    Dim skippedCount As Long
    
    ' Configuration - Change these if your sheet names are different
    Const INPUT_SHEET = "Input"
    Const OUTPUT_SHEET = "Output"
    Const INPUT_START_ROW = 2  ' First data row (after headers)
    Const OUTPUT_START_ROW = 2 ' First output data row
    
    ' Turn off screen updating for faster processing
    Application.ScreenUpdating = False
    Application.Calculation = xlCalculationManual
    
    On Error GoTo ErrorHandler
    
    ' Set worksheet references
    Set wsInput = ThisWorkbook.Sheets(INPUT_SHEET)
    Set wsOutput = ThisWorkbook.Sheets(OUTPUT_SHEET)
    
    ' Clear previous output data (keep headers)
    lastRow = wsOutput.Cells(wsOutput.Rows.Count, "A").End(xlUp).Row
    If lastRow >= OUTPUT_START_ROW Then
        wsOutput.Range("A" & OUTPUT_START_ROW & ":F" & lastRow).ClearContents
    End If
    
    ' Find last row with data in input sheet
    lastRow = wsInput.Cells(wsInput.Rows.Count, "A").End(xlUp).Row
    
    ' Check if there's data to process
    If lastRow < INPUT_START_ROW Then
        MsgBox "No input data found. Please add data starting from row " & INPUT_START_ROW, vbExclamation, "No Data"
        GoTo CleanExit
    End If
    
    ' Initialize counters
    outputRow = OUTPUT_START_ROW
    skippedCount = 0
    
    ' Loop through each input row
    For inputRow = INPUT_START_ROW To lastRow
        
        ' Read input data (Columns A to K)
        level5ID = Trim(wsInput.Cells(inputRow, 1).Value)    ' Column A
        level5Name = Trim(wsInput.Cells(inputRow, 2).Value)  ' Column B
        level4ID = Trim(wsInput.Cells(inputRow, 3).Value)    ' Column C
        level4Name = Trim(wsInput.Cells(inputRow, 4).Value)  ' Column D
        level3ID = Trim(wsInput.Cells(inputRow, 5).Value)    ' Column E
        level3Name = Trim(wsInput.Cells(inputRow, 6).Value)  ' Column F
        level2ID = Trim(wsInput.Cells(inputRow, 7).Value)    ' Column G
        level2Name = Trim(wsInput.Cells(inputRow, 8).Value)  ' Column H
        level1ID = Trim(wsInput.Cells(inputRow, 9).Value)    ' Column I
        level1Name = Trim(wsInput.Cells(inputRow, 10).Value) ' Column J
        comments = Trim(wsInput.Cells(inputRow, 11).Value)   ' Column K - Comments
        
        ' Skip empty rows
        If level5ID = "" Then
            GoTo NextInputRow
        End If
        
        ' Initialize transformation flag
        shouldTransform = True
        
        '=========================================================================
        ' FILTER 1: Comments must contain "new" (case-insensitive, wildcard match)
        '=========================================================================
        If InStr(1, UCase(comments), "NEW") = 0 Then
            shouldTransform = False
        End If
        
        '=========================================================================
        ' FILTER 2: Level1 Name must be "Alpha", "Kenamma", or "Naago"
        '=========================================================================
        If shouldTransform Then
            If UCase(level1Name) <> "ALPHA" And _
               UCase(level1Name) <> "KENAMMA" And _
               UCase(level1Name) <> "NAAGO" Then
                shouldTransform = False
            End If
        End If
        
        '=========================================================================
        ' FILTER 3: Exclude if Level5 Name contains "Retained", "Retd", or "Rtd"
        '=========================================================================
        If shouldTransform Then
            If InStr(1, UCase(level5Name), "RETAINED") > 0 Or _
               InStr(1, UCase(level5Name), "RETD") > 0 Or _
               InStr(1, UCase(level5Name), "RTD") > 0 Then
                shouldTransform = False
            End If
        End If
        
        ' Skip this row if it doesn't meet all criteria
        If Not shouldTransform Then
            skippedCount = skippedCount + 1
            GoTo NextInputRow
        End If
        
        '=========================================================================
        ' ROW PASSED ALL FILTERS - PROCEED WITH TRANSFORMATION
        '=========================================================================
        
        ' Calculate Top C (Column 1)
        topC = "RBMI - " & level2Name & " (L2)"
        
        ' Calculate Middle C Status (Column 2)
        ' Check if Level 5 Name contains (STD) or (STEWARDSHIP)
        isStandard = False
        If InStr(1, UCase(level5Name), "(STD)") > 0 Or _
           InStr(1, UCase(level5Name), "(STEWARDSHIP)") > 0 Then
            isStandard = True
        End If
        
        If isStandard Then
            middleCStatus = "RBMI - GIA_ALL"
            allAltSuffix = "ALL"
        Else
            middleCStatus = "RBMI - GIA_ATT"
            allAltSuffix = "ATT"
        End If
        
        '=========================================================================
        ' OUTPUT ROW 1
        '=========================================================================
        wsOutput.Cells(outputRow, 1).Value = topC                                ' Column 1: Top C
        wsOutput.Cells(outputRow, 2).Value = middleCStatus                       ' Column 2: Middle C (Status)
        wsOutput.Cells(outputRow, 3).Value = "GIA_NCR" & allAltSuffix           ' Column 3: Middle C (NCR + ALL/ATT)
        wsOutput.Cells(outputRow, 4).Value = "."                                 ' Column 4: Middle C (.)
        wsOutput.Cells(outputRow, 5).Value = "RBMI - " & level5ID & "_NCR"      ' Column 5: Lowest C
        wsOutput.Cells(outputRow, 6).Value = "R-" & level5ID                     ' Column 6: N element (R-)
        outputRow = outputRow + 1
        
        '=========================================================================
        ' OUTPUT ROW 2
        '=========================================================================
        wsOutput.Cells(outputRow, 1).Value = topC                                ' Column 1: Top C
        wsOutput.Cells(outputRow, 2).Value = middleCStatus                       ' Column 2: Middle C (Status)
        wsOutput.Cells(outputRow, 3).Value = "GIA_RAC" & allAltSuffix           ' Column 3: Middle C (RAC + ALL/ATT)
        wsOutput.Cells(outputRow, 4).Value = "GIA_ARAC" & allAltSuffix          ' Column 4: Middle C (ARAC + ALL/ATT)
        wsOutput.Cells(outputRow, 5).Value = "RBMI - " & level5ID & "_ARAC"     ' Column 5: Lowest C
        wsOutput.Cells(outputRow, 6).Value = "I-Dummy"                           ' Column 6: N element (I-Dummy)
        outputRow = outputRow + 1
        
        '=========================================================================
        ' OUTPUT ROW 3
        '=========================================================================
        wsOutput.Cells(outputRow, 1).Value = topC                                ' Column 1: Top C
        wsOutput.Cells(outputRow, 2).Value = middleCStatus                       ' Column 2: Middle C (Status)
        wsOutput.Cells(outputRow, 3).Value = "GIA_RAC" & allAltSuffix           ' Column 3: Middle C (RAC + ALL/ATT)
        wsOutput.Cells(outputRow, 4).Value = "GIA_SRAC" & allAltSuffix          ' Column 4: Middle C (SRAC + ALL/ATT)
        wsOutput.Cells(outputRow, 5).Value = "RBMI - " & level5ID & "_SRAC"     ' Column 5: Lowest C
        wsOutput.Cells(outputRow, 6).Value = "I-Dummy"                           ' Column 6: N element (I-Dummy)
        outputRow = outputRow + 1
        
NextInputRow:
    Next inputRow
    
    ' Format output (optional)
    If outputRow > OUTPUT_START_ROW Then
        wsOutput.Range("A" & OUTPUT_START_ROW & ":F" & (outputRow - 1)).Font.Name = "Calibri"
        wsOutput.Range("A" & OUTPUT_START_ROW & ":F" & (outputRow - 1)).Font.Size = 11
        wsOutput.Columns("A:F").AutoFit
    End If
    
    ' Success message with detailed statistics
    Dim processedCount As Long
    Dim totalRows As Long
    totalRows = lastRow - INPUT_START_ROW + 1
    processedCount = totalRows - skippedCount
    
    MsgBox "Transformation Complete!" & vbCrLf & vbCrLf & _
           "Total Input Rows: " & totalRows & vbCrLf & _
           "Rows Processed: " & processedCount & vbCrLf & _
           "Rows Skipped: " & skippedCount & vbCrLf & _
           "Output Rows Generated: " & (outputRow - OUTPUT_START_ROW) & vbCrLf & vbCrLf & _
           "Rows were skipped if they didn't meet ALL criteria:" & vbCrLf & _
           "  - Comments contains 'new'" & vbCrLf & _
           "  - Level1 Name is Alpha/Kenamma/Naago" & vbCrLf & _
           "  - Level5 Name doesn't contain Retained/Retd/Rtd", _
           vbInformation, "Success"
    
CleanExit:
    ' Restore settings
    Application.ScreenUpdating = True
    Application.Calculation = xlCalculationAutomatic
    Exit Sub
    
ErrorHandler:
    Application.ScreenUpdating = True
    Application.Calculation = xlCalculationAutomatic
    MsgBox "Error: " & Err.Description & vbCrLf & vbCrLf & _
           "Please check:" & vbCrLf & _
           "1. Sheet names are correct (Input/Output)" & vbCrLf & _
           "2. Data format is correct" & vbCrLf & _
           "3. All required columns exist (A-K)" & vbCrLf & _
           "4. No special characters in data", _
           vbCritical, "Error"
End Sub


