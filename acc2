    def creategui(self):
        # Scrollable main frame implementation
        container = ttk.Frame(self.root)
        canvas = tk.Canvas(container)
        scrollbar = ttk.Scrollbar(container, orient="vertical", command=canvas.yview)
        scrollable_frame = ttk.Frame(canvas)

        scrollable_frame.bind(
            "<Configure>",
            lambda e: canvas.configure(
                scrollregion=canvas.bbox("all")
            )
        )
        canvas.create_window((0, 0), window=scrollable_frame, anchor="nw")
        canvas.configure(yscrollcommand=scrollbar.set)

        container.pack(fill="both", expand=True)
        canvas.pack(side="left", fill="both", expand=True)
        scrollbar.pack(side="right", fill="y")

        self.mainframe = scrollable_frame # for consistency in rest of code

        ttk.Label(self.mainframe, text="Excel to Outlook Email Utility - v2.0", font=("Arial", 16, "bold")).grid(row=0, column=0, columnspan=2, pady=10)
        ttk.Label(self.mainframe, text="Select a file below:", font=("Arial", 10)).grid(row=1, column=0, columnspan=2, pady=5)

        self.filelist_frame = ttk.Frame(self.mainframe)
        self.filelist_frame.grid(row=2, column=0, columnspan=2, pady=10, sticky="ew")
        self.filelist_frame.columnconfigure(0, weight=1)

        # Show file names only; selecting one opens popup
        for idx, filekey in enumerate(self.fileconfigs.keys()):
            fileinfo = self.fileconfigs[filekey]
            file_btn = ttk.Button(self.filelist_frame, 
                text=fileinfo["name"], 
                command=lambda fk=filekey: self.open_file_popup(fk)
            )
            file_btn.grid(row=idx, column=0, sticky="ew", padx=20, pady=6)
            
