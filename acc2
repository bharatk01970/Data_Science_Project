def apply_reference_mapping(self, stage1_data, combined_column_name, mapping_df, new_column_name, reference_values, repeat_values):
    """Enhanced mapping logic:
       - Handles repeated A values mapped via reference B (existing behavior).
       - Additionally applies direct mapping for non-repeated values (like Column C)
         if they are present in the mapping file.
    """
    if mapping_df is None or len(mapping_df.columns) < 2:
        return stage1_data

    # Build mapping dict (stringified keys)
    key_col = mapping_df.columns[0]
    value_col = mapping_df.columns[1]
    mapping_dict = {str(k).strip(): str(v).strip() for k, v in zip(mapping_df[key_col].astype(str), mapping_df[value_col].astype(str))}

    print("\n=== Reference Mapping (Extended) ===")
    print(f"Mapping dictionary keys sample: {list(mapping_dict.keys())[:10]} ... total {len(mapping_dict)}")

    import copy
    rows = [copy.deepcopy(r) for r in stage1_data]

    ref_set = set(str(x).strip() for x in (reference_values or []))
    rep_set = set(str(x).strip() for x in (repeat_values or []))

    buffer_indices = []
    result_rows = []

    for idx, row in enumerate(rows):
        combined_val = str(row.get(combined_column_name, '')).strip()

        # Repeat rows → buffer them
        if combined_val in rep_set:
            row[new_column_name] = ''
            result_rows.append(row)
            buffer_indices.append(len(result_rows) - 1)
            print(f"Buffered repeat row: {combined_val}")

        # Reference rows → flush buffer
        elif combined_val in ref_set:
            mapped_value = mapping_dict.get(combined_val, '')
            if buffer_indices:
                for bi in buffer_indices:
                    result_rows[bi][new_column_name] = mapped_value
                print(f"Flushed {len(buffer_indices)} repeats with mapping '{mapped_value}' for reference '{combined_val}'")
            buffer_indices = []
            row[new_column_name] = ''
            result_rows.append(row)

        else:
            # Non-repeated rows (like C)
            # Check if mapping exists for them directly
            direct_map = mapping_dict.get(combined_val, '')
            if direct_map:
                row[new_column_name] = direct_map
                print(f"Direct-mapped non-repeated row: {combined_val} -> {direct_map}")
            else:
                row[new_column_name] = ''
                print(f"Other row: {combined_val} -> left blank (no direct mapping)")
            result_rows.append(row)

    if buffer_indices:
        print(f"Warning: {len(buffer_indices)} buffered repeat rows were not followed by any reference.")

    print("=== End Reference Mapping (Extended) ===\n")
    return result_rows