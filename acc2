"""
Excel to Outlook Email Utility
Captures screenshots from Excel workbook cells and creates Outlook email drafts
"""

import win32com.client
import openpyxl
from openpyxl.utils import get_column_letter
from PIL import ImageGrab, Image
import pythoncom
from datetime import datetime
import pytz
import os
import base64
from io import BytesIO
import time

class ExcelOutlookEmailer:
    def __init__(self, excel_path):
        """Initialize with path to Excel workbook"""
        self.excel_path = excel_path
        self.excel = None
        self.outlook = None
        self.workbook = None
        
    def __enter__(self):
        """Context manager entry"""
        pythoncom.CoInitialize()
        self.excel = win32com.client.Dispatch("Excel.Application")
        self.outlook = win32com.client.Dispatch("Outlook.Application")
        self.workbook = self.excel.Workbooks.Open(os.path.abspath(self.excel_path))
        self.excel.Visible = False
        return self
        
    def __exit__(self, exc_type, exc_val, exc_tb):
        """Context manager exit - cleanup"""
        if self.workbook:
            self.workbook.Close(SaveChanges=False)
        if self.excel:
            self.excel.Quit()
        pythoncom.CoUninitialize()
        
    def get_available_accounts(self):
        """Get list of Outlook accounts"""
        accounts = []
        for account in self.outlook.Session.Accounts:
            accounts.append(account.DisplayName)
        return accounts
        
    def capture_range_screenshot(self, sheet_name, cell_range):
        """Capture screenshot of specified Excel range"""
        try:
            sheet = self.workbook.Sheets(sheet_name)
            range_obj = sheet.Range(cell_range)
            
            # Copy range as picture
            range_obj.CopyPicture(Format=2)  # xlBitmap
            time.sleep(0.5)  # Wait for clipboard
            
            # Grab from clipboard
            img = ImageGrab.grabclipboard()
            
            if img is None:
                raise Exception(f"Failed to capture {sheet_name}!{cell_range}")
                
            return img
            
        except Exception as e:
            raise Exception(f"Error capturing {sheet_name}!{cell_range}: {str(e)}")
    
    def get_timestamp(self, timezone='IST'):
        """Get formatted timestamp in specified timezone"""
        tz_map = {
            'IST': pytz.timezone('Asia/Kolkata'),
            'UK': pytz.timezone('Europe/London'),
            'GMT': pytz.timezone('GMT')
        }
        
        tz = tz_map.get(timezone, pytz.timezone('Asia/Kolkata'))
        now = datetime.now(tz)
        return now.strftime('%Y-%m-%d %H:%M:%S %Z')
    
    def create_email(self, 
                     screenshots_config,
                     subject=None,
                     body_text="",
                     to_recipients=None,
                     cc_recipients=None,
                     bcc_recipients=None,
                     sender_account=None,
                     timezone='IST',
                     send=False):
        """
        Create Outlook email with screenshots
        
        Args:
            screenshots_config: List of dicts with keys:
                - sheet_name: Excel sheet name
                - cell_range: Cell range (e.g., 'A1:D10')
                - embed: Boolean, embed in body
                - attach: Boolean, attach as file
                - name: Screenshot name/filename
            subject: Email subject (None for default)
            body_text: Additional body text
            to_recipients: List of email addresses
            cc_recipients: List of CC email addresses
            bcc_recipients: List of BCC email addresses
            sender_account: Sender account name
            timezone: Timezone for timestamp ('IST', 'UK', 'GMT')
            send: If True, send email; if False, save as draft
        """
        
        # Create mail item
        mail = self.outlook.CreateItem(0)  # 0 = olMailItem
        
        # Set sender account if specified
        if sender_account:
            for account in self.outlook.Session.Accounts:
                if account.DisplayName == sender_account:
                    mail.SendUsingAccount = account
                    break
        
        # Set recipients
        if to_recipients:
            mail.To = "; ".join(to_recipients)
        if cc_recipients:
            mail.CC = "; ".join(cc_recipients)
        if bcc_recipients:
            mail.BCC = "; ".join(bcc_recipients)
        
        # Generate timestamp
        timestamp = self.get_timestamp(timezone)
        
        # Set subject
        if subject is None:
            subject = f"Excel Report - {timestamp}"
        else:
            subject = f"{subject} - {timestamp}"
        mail.Subject = subject
        
        # Build email body
        html_body = f"""
        <html>
        <body>
        <p>{body_text}</p>
        <p><strong>Generated:</strong> {timestamp}</p>
        <br>
        """
        
        # Process screenshots
        temp_files = []
        embed_count = 0
        
        for idx, config in enumerate(screenshots_config):
            sheet_name = config['sheet_name']
            cell_range = config['cell_range']
            embed = config.get('embed', False)
            attach = config.get('attach', False)
            name = config.get('name', f'screenshot_{idx+1}')
            
            # Capture screenshot
            img = self.capture_range_screenshot(sheet_name, cell_range)
            
            # Save to temporary file
            temp_path = os.path.join(os.environ['TEMP'], f"{name}.png")
            img.save(temp_path, 'PNG')
            temp_files.append(temp_path)
            
            # Embed in body
            if embed:
                cid = f"image_{embed_count}"
                html_body += f'<p><strong>{name}</strong></p>'
                html_body += f'<img src="cid:{cid}" alt="{name}"><br><br>'
                
                # Add as inline attachment
                attachment = mail.Attachments.Add(temp_path)
                attachment.PropertyAccessor.SetProperty(
                    "http://schemas.microsoft.com/mapi/proptag/0x3712001F",
                    cid
                )
                embed_count += 1
            
            # Attach as file
            if attach:
                mail.Attachments.Add(temp_path)
        
        html_body += """
        </body>
        </html>
        """
        
        mail.HTMLBody = html_body
        
        # Send or save as draft
        if send:
            mail.Send()
            result = "Email sent successfully"
        else:
            mail.Save()
            result = "Email draft created successfully"
        
        # Cleanup temp files
        time.sleep(1)  # Wait for Outlook to process
        for temp_file in temp_files:
            try:
                os.remove(temp_file)
            except:
                pass
        
        return result


def main():
    """Example usage"""
    
    # Configuration
    excel_path = r"C:\path\to\your\workbook.xlsx"
    
    # Define screenshots to capture
    screenshots_config = [
        {
            'sheet_name': 'Sheet1',
            'cell_range': 'A1:E20',
            'embed': True,      # Embed in email body
            'attach': False,    # Don't attach as file
            'name': 'Summary_Table'
        },
        {
            'sheet_name': 'Sheet2',
            'cell_range': 'A1:G30',
            'embed': False,     # Don't embed in body
            'attach': True,     # Attach as file
            'name': 'Detailed_Data'
        },
        {
            'sheet_name': 'Sheet3',
            'cell_range': 'B5:F25',
            'embed': True,      # Both embed and attach
            'attach': True,
            'name': 'Chart_Analysis'
        }
    ]
    
    # Create email
    with ExcelOutlookEmailer(excel_path) as emailer:
        # Get available accounts
        accounts = emailer.get_available_accounts()
        print("Available Outlook accounts:")
        for i, account in enumerate(accounts, 1):
            print(f"{i}. {account}")
        
        # Create email draft
        result = emailer.create_email(
            screenshots_config=screenshots_config,
            subject="Weekly Excel Report",
            body_text="Please find the Excel screenshots below and attached.",
            to_recipients=["recipient1@example.com", "recipient2@example.com"],
            cc_recipients=["cc@example.com"],
            bcc_recipients=["bcc@example.com"],
            sender_account=accounts[0] if accounts else None,  # Use first account
            timezone='IST',  # Options: 'IST', 'UK', 'GMT'
            send=False  # Set to True to send immediately
        )
        
        print(result)


if __name__ == "__main__":
    main()