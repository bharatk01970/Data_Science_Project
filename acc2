def run_cli_mode():
    """
    Command-line interface for running tests without GUI.
    This function demonstrates standalone execution.
    """
    print("\n" + "="*60)
    print("CITRIX APPLICATION FUNCTION TESTER - CLI MODE")
    print("="*60 + "\n")
    
    # Define test functions (in real use, load from config file)
    functions = [
        FunctionConfig(
            name="Dashboard",
            click_target="images/dashboard_button.png",
            success_indicator="images/dashboard_loaded.png",
            close_button="images/close_button.png"
        ),
        FunctionConfig(
            name="Reports",
            click_target="images/reports_button.png",
            success_indicator="images/reports_loaded.png",
            close_button="images/close_button.png"
        ),
        FunctionConfig(
            name="Settings",
            click_target="images/settings_button.png",
            success_indicator="images/settings_loaded.png",
            close_button="images/close_button.png"
        )
    ]
    
    # Create configuration
    config = TestConfig(
        screenshot_dir="test_screenshots",
        report_dir="test_reports",
        timeout=30,
        max_retries=3,
        image_confidence=0.8
    )
    
    # Create engine
    engine = CitrixTestEngine(config)
    
    # Countdown
    print("Please ensure the Citrix application is open and visible.")
    print("The automated test will begin in 5 seconds...")
    for i in range(5, 0, -1):
        print(f"{i}...")
        time.sleep(1)
    print("Starting tests!\n")
    
    # Run tests
    try:
        results = engine.run_all_tests(functions)
        
        # Generate reports
        report_gen = ReportGenerator(config.report_dir)
        
        console_report = report_gen.generate_console_report(results)
        print(console_report)
        
        csv_file = report_gen.generate_csv_report(results)
        txt_file = report_gen.generate_text_report(results)
        
        print(f"\nReports generated:")
        print(f"  - CSV: {csv_file}")
        print(f"  - Text: {txt_file}")
        print(f"  - Screenshots: {config.screenshot_dir}/")
        print(f"  - Log file: {config.report_dir}/")
        
    except Exception as e:
        print(f"\nERROR: Test execution failed: {e}")
        raise
    
    print("\nTest execution completed!")


if __name__ == "__main__":
    run_cli_mode()