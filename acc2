' ====================================================================
' HELPER FUNCTION: Find TM1 Instance Configuration Files
' Run this once to find your .opt files locations
' ====================================================================
Sub FindTM1ConfigFiles()
    Dim fso As Object
    Dim folder As Object
    Dim file As Object
    Dim searchPaths As Variant
    Dim i As Integer
    Dim resultMsg As String
    
    Set fso = CreateObject("Scripting.FileSystemObject")
    
    ' Common TM1 configuration locations
    searchPaths = Array( _
        "C:\ProgramData\IBM\TM1", _
        "C:\Program Files\IBM\Cognos\TM1", _
        "C:\TM1Data", _
        Environ("USERPROFILE") & "\Documents\TM1" _
    )
    
    resultMsg = "TM1 Configuration Files Found:" & vbCrLf & vbCrLf
    
    For i = 0 To UBound(searchPaths)
        If fso.FolderExists(searchPaths(i)) Then
            Set folder = fso.GetFolder(searchPaths(i))
            resultMsg = resultMsg & "Location: " & searchPaths(i) & vbCrLf
            
            For Each file In folder.Files
                If LCase(fso.GetExtensionName(file.Name)) = "opt" Then
                    resultMsg = resultMsg & "  - " & file.Path & vbCrLf
                End If
            Next file
            resultMsg = resultMsg & vbCrLf
        End If
    Next i
    
    MsgBox resultMsg, vbInformation, "TM1 Instance Finder"
    
    Set fso = Nothing
End Sub